-- ============================================================================
-- V3_PROJECT.GPR — PROJET DE COMPILATION V3
-- ============================================================================

project V3_Project is

   for Languages use ("Ada");
   for Main use ("V3_Unified_Physics.adb");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";

   package Compiler is
      for Switches ("Ada") use
        ("-gnatwa",           -- All warnings
         "-gnat12",           -- Ada 2012
         "-gnata",            -- Assertions
         "-gnatp",            -- Suppress some checks
         "-O2");              -- Optimization
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-E");
   end Binder;

   package Linker is
      for Switches ("Ada") use ("-lm");
   end Linker;

end V3_Project;
