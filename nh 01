-- ============================================================================
-- Alloy_Fabrication.adb
-- Implementation of the fabrication protocol with real‑mass calculations
-- ============================================================================

package body Alloy_Fabrication with
   SPARK_Mode => On
is

   -- 1. Internal constants (technical engine)
   PSI_INV      : constant := 48016.8;        -- kg·m⁻²
   PHI_INV      : constant := -0.0511;        -- V
   RHO_INV      : constant := 1026.0;         -- kg·m⁻³
   NU_INV       : constant := 6.4e12;         -- Hz
   BETA_INV     : constant := 1_000_000.0;    -- dimensionless

   -- Molar masses (g/mol)
   M_Nb : constant Float := 92.906;
   M_Ta : constant Float := 180.948;
   M_Ti : constant Float := 47.867;
   M_Zr : constant Float := 91.224;
   M_Hf : constant Float := 178.490;

   -- Atomic fractions
   F_Nb : constant Float := 0.30;
   F_Ta : constant Float := 0.20;
   F_Ti : constant Float := 0.20;
   F_Zr : constant Float := 0.15;
   F_Hf : constant Float := 0.05;

   -- 2. Calculate mass fractions from atomic fractions
   function Mass_Fraction (F : Float; M : Float; Sum_M : Float) return Float is
   begin
      return (F * M) / Sum_M;
   end Mass_Fraction;

   function Total_Molar_Mass return Float is
      Sum : Float := F_Nb * M_Nb + F_Ta * M_Ta + F_Ti * M_Ti +
                     F_Zr * M_Zr + F_Hf * M_Hf;
   begin
      return Sum;
   end Total_Molar_Mass;

   -- 3. Public functions
   function Get_Fabrication_Parameters (Total_Mass_g : Float) return Fabrication_Parameters is
      M_total : constant Float := Total_Molar_Mass;
      F_Nb_m  : constant Float := Mass_Fraction (F_Nb, M_Nb, M_total);
      F_Ta_m  : constant Float := Mass_Fraction (F_Ta, M_Ta, M_total);
      F_Ti_m  : constant Float := Mass_Fraction (F_Ti, M_Ti, M_total);
      F_Zr_m  : constant Float := Mass_Fraction (F_Zr, M_Zr, M_total);
      F_Hf_m  : constant Float := Mass_Fraction (F_Hf, M_Hf, M_total);
   begin
      return Fabrication_Parameters'
        (Total_Mass_g           => Total_Mass_g,
         Nb_Mass_g              => Total_Mass_g * F_Nb_m,
         Ta_Mass_g              => Total_Mass_g * F_Ta_m,
         Ti_Mass_g              => Total_Mass_g * F_Ti_m,
         Zr_Mass_g              => Total_Mass_g * F_Zr_m,
         Hf_Mass_g              => Total_Mass_g * F_Hf_m,
         Arc_Melting_Temp_C     => 2550.0,
         Holding_Time_Hours     => 2.0,
         Annealing_Temp_C       => 1960.0,
         Annealing_Time_Hours   => 12.0,
         Cooling_Rate_Cpmin     => 10.0,
         Vacuum_Pressure_mbar   => 1.0e-5,
         Argon_Purity           => 99.999,
         Number_Of_Melts        => 3,
         Arc_Current_A          => 250,
         Arc_Voltage_V          => 40,
         Compaction_Pressure_MPa => 200.0,
         Crucible_Geometry      => "Water‑cooled copper 50 mm diameter",
         Checksum               => 9);
   end Get_Fabrication_Parameters;

   function Get_Alloy_Properties return Alloy_Properties is
   begin
      return Alloy_Properties'
        (Density_gpcm3        => 9.5,
         Elastic_Modulus_GPa  => 210.0,
         Melting_Point_C      => 2450.0,
         Hardness_HV          => 350.0,
         Tensile_Strength_MPa => 1500.0,
         Ductility_Percent    => 15.0,
         Phase_Structure      => "BCC       ",
         Checksum             => 9);
   end Get_Alloy_Properties;

   -- 4. Full procedure text with real masses
   function Get_Procedure_Text (Total_Mass_g : Float) return String is
      P : constant Fabrication_Parameters := Get_Fabrication_Parameters (Total_Mass_g);
      Props : constant Alloy_Properties := Get_Alloy_Properties;
   begin
      return "FABRICATION PROCEDURE — Nb₀.₃ Ta₀.₂ Ti₀.₂ Zr₀.₁₅ Hf₀.₀₅" &
             ASCII.LF &
             "============================================================" &
             ASCII.LF &
             "" &
             ASCII.LF &
             "1. RAW MATERIALS:" &
             ASCII.LF &
             "   - Purity : > 99.9 % for all elements." &
             ASCII.LF &
             "   - Oxygen content : < 100 ppm." &
             ASCII.LF &
             "   - Particle size : 25–30 µm." &
             ASCII.LF &
             "" &
             ASCII.LF &
             "2. COMPOSITION (atomic fractions):" &
             ASCII.LF &
             "   - Nb  : 0.30" &
             ASCII.LF &
             "   - Ta  : 0.20" &
             ASCII.LF &
             "   - Ti  : 0.20" &
             ASCII.LF &
             "   - Zr  : 0.15" &
             ASCII.LF &
             "   - Hf  : 0.05" &
             ASCII.LF &
             "" &
             ASCII.LF &
             "3. MASS CALCULATION (for " & Float'Image (Total_Mass_g) & " g total):" &
             ASCII.LF &
             "   - Nb : " & Float'Image (P.Nb_Mass_g) & " g" &
             ASCII.LF &
             "   - Ta : " & Float'Image (P.Ta_Mass_g) & " g" &
             ASCII.LF &
             "   - Ti : " & Float'Image (P.Ti_Mass_g) & " g" &
             ASCII.LF &
             "   - Zr : " & Float'Image (P.Zr_Mass_g) & " g" &
             ASCII.LF &
             "   - Hf : " & Float'Image (P.Hf_Mass_g) & " g" &
             ASCII.LF &
             "" &
             ASCII.LF &
             "4. PREPARATION:" &
             ASCII.LF &
             "   - Weigh powders to the above masses." &
             ASCII.LF &
             "   - Mix under argon for 30 min." &
             ASCII.LF &
             "   - Compact at " & Float'Image (P.Compaction_Pressure_MPa) & " MPa." &
             ASCII.LF &
             "   - Pre‑form : cylindrical pellet." &
             ASCII.LF &
             "" &
             ASCII.LF &
             "5. ARC MELTING:" &
             ASCII.LF &
             "   - Atmosphere : argon 99.999 %." &
             ASCII.LF &
             "   - Pressure   : 10⁻⁵ mbar (primary vacuum)." &
             ASCII.LF &
             "   - Crucible   : " & P.Crucible_Geometry &
             ASCII.LF &
             "   - Arc power  : " & Integer'Image (P.Arc_Current_A) & " A, " &
                                Integer'Image (P.Arc_Voltage_V) & " V." &
             ASCII.LF &
             "   - Temperature: " & Float'Image (P.Arc_Melting_Temp_C) & " °C." &
             ASCII.LF &
             "   - Cycles     : " & Integer'Image (P.Number_Of_Melts) &
             " (turn over after each)." &
             ASCII.LF &
             "   - Holding    : " & Float'Image (P.Holding_Time_Hours) & " h." &
             ASCII.LF &
             "" &
             ASCII.LF &
             "6. ANNEALING (homogenisation):" &
             ASCII.LF &
             "   - Temperature : " & Float'Image (P.Annealing_Temp_C) & " °C." &
             ASCII.LF &
             "   - Duration    : " & Float'Image (P.Annealing_Time_Hours) & " h." &
             ASCII.LF &
             "   - Atmosphere  : argon 99.999 %." &
             ASCII.LF &
             "" &
             ASCII.LF &
             "7. COOLING:" &
             ASCII.LF &
             "   - Rate : " & Float'Image (P.Cooling_Rate_Cpmin) & " °C/min to 20 °C." &
             ASCII.LF &
             "   - Atmosphere : argon continuous." &
             ASCII.LF &
             "" &
             ASCII.LF &
             "8. CHARACTERISATION:" &
             ASCII.LF &
             "   - XRD : verify BCC phase (expected)." &
             ASCII.LF &
             "   - SEM/EDS : chemical homogeneity." &
             ASCII.LF &
             "   - Hardness : Vickers > " & Float'Image (Props.Hardness_HV) & " HV." &
             ASCII.LF &
             "   - Tensile : > " & Float'Image (Props.Tensile_Strength_MPa) & " MPa, ductility > " &
                                Float'Image (Props.Ductility_Percent) & " %." &
             ASCII.LF &
             "" &
             ASCII.LF &
             "9. THEORETICAL NOTES:" &
             ASCII.LF &
             "   - This procedure is derived from a simulation engine." &
             ASCII.LF &
             "   - The temperatures (2550 °C, 1960 °C) are software predictions." &
             ASCII.LF &
             "   - Experimental validation is required to confirm these values." &
             ASCII.LF &
             "   - The actual melting may require adjustment (±50 °C) based on" &
             ASCII.LF &
             "     crucible geometry and power supply characteristics." &
             ASCII.LF &
             "" &
             ASCII.LF &
             "============================================================" &
             ASCII.LF &
             "END OF PROCEDURE.";
   end Get_Procedure_Text;

