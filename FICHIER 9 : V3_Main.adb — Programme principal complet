   -- ========================================================================
   -- 8. PROCÉDURE D'AFFICHAGE DES STATISTIQUES
   -- ========================================================================

   procedure Print_Statistics is
      Stable_Count : Integer := 0;
      Unstable_Count : Integer := 0;
      Compact_Count : Integer := 0;
      Non_Compact_Count : Integer := 0;
      Total_Valence : Integer := 0;
      Max_Valence : Integer := 0;
      Min_Valence : Integer := 100;
   begin
      for Z in 1 .. 118 loop
         if Nodes (Z).Is_Stable then
            Stable_Count := Stable_Count + 1;
         else
            Unstable_Count := Unstable_Count + 1;
         end if;

         if Nodes (Z).Geometry.Is_Compact then
            Compact_Count := Compact_Count + 1;
         else
            Non_Compact_Count := Non_Compact_Count + 1;
         end if;

         Total_Valence := Total_Valence + Nodes (Z).Geometry.Available_Sites;
         if Nodes (Z).Geometry.Available_Sites > Max_Valence then
            Max_Valence := Nodes (Z).Geometry.Available_Sites;
         end if;
         if Nodes (Z).Geometry.Available_Sites < Min_Valence then
            Min_Valence := Nodes (Z).Geometry.Available_Sites;
         end if;
      end loop;

      New_Line;
      Print_Separator ('=', 80);
      Put_Line ("  STATISTIQUES V3");
      Print_Separator ('-', 80);
      New_Line;

      Put_Line ("  Stabilité :");
      Put_Line ("    Éléments stables      : " & Stable_Count'Image & "  (" &
                (Float (Stable_Count) / 118.0 * 100.0)'Image & " %)");
      Put_Line ("    Éléments instables    : " & Unstable_Count'Image & "  (" &
                (Float (Unstable_Count) / 118.0 * 100.0)'Image & " %)");
      New_Line;

      Put_Line ("  Géométrie :");
      Put_Line ("    Empilements compacts  : " & Compact_Count'Image & "  (" &
                (Float (Compact_Count) / 118.0 * 100.0)'Image & " %)");
      Put_Line ("    Empilements non compacts : " & Non_Compact_Count'Image & "  (" &
                (Float (Non_Compact_Count) / 118.0 * 100.0)'Image & " %)");
      New_Line;

      Put_Line ("  Valence :");
      Put_Line ("    Valence maximale      : " & Max_Valence'Image);
      Put_Line ("    Valence minimale      : " & Min_Valence'Image);
      Put_Line ("    Valence moyenne       : " & (Float (Total_Valence) / 118.0)'Image);
      New_Line;

      Put_Line ("  Nombres magiques V3 (empilements compacts) :");
      Put ("    ");
      for I in 1 .. 7 loop
         Put (Magic_Numbers (I)'Image);
         Put ("  ");
      end loop;
      New_Line;
   end Print_Statistics;

