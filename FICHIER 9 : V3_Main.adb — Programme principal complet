   begin
      New_Line;
      Print_Separator ('=', 80);
      Put_Line ("  V3 HARMONIQUES DE SURFACE (muon, tau)");
      Print_Separator ('-', 80);
      New_Line;

      for I in 0 .. 2 loop
         Put ("  " & Harmonics (I).Kind'Image);
         Put ("  Mode=");
         Put (Harmonics (I).Mode_Number, 1);
         Put ("  Mass_Ratio=");
         Put (Harmonics (I).Mass_Ratio, 2, 4, 0);
         Put ("  Mass=");
         Put (Harmonics (I).Mass_MeV, 2, 4, 0);
         Put (" MeV");
         Put ("  Contraction=");
         Put (Harmonics (I).Contraction, 2, 4, 0);
         Put ("  Decay=" & Harmonics (I).Decay_Channel);
         New_Line;
      end loop;

      New_Line;
      Put_Line ("  ➤ V3 Formule : m_n = m_e / (4π² × α² × K_cycles)");
      Put_Line ("    - Fondamental (électron)  : n = 0");
      Put_Line ("    - Première harmonique     : n = 1 → muon");
      Put_Line ("    - Deuxième harmonique     : n = 2 → tau");
   end Print_Harmonics;

   -- ========================================================================
