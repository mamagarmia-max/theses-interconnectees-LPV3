   -- ========================================================================
   -- 10. PROCÉDURE D'AFFICHAGE DE L'AIDE
   -- ========================================================================

   procedure Print_Help is
   begin
      New_Line;
      Print_Separator ('=', 80);
      Put_Line ("  V3_MAIN — AIDE ET UTILISATION");
      Print_Separator ('-', 80);
      New_Line;

      Put_Line ("  Usage : V3_Main [option]");
      New_Line;
      Put_Line ("  Options :");
      Put_Line ("    --full      : Affiche le tableau complet avec détails");
      Put_Line ("    --details   : Affiche les détails de chaque élément");
      Put_Line ("    --radiation : Affiche les exemples de rayonnements");
      Put_Line ("    --masses    : Affiche les masses V3 du proton et de l'électron");
      Put_Line ("    --harmonics : Affiche les harmoniques (muon, tau)");
      Put_Line ("    --valence   : Affiche la valence géométrique (exemples)");
      Put_Line ("    --proofs    : Affiche les preuves V3");
      Put_Line ("    --stats     : Affiche les statistiques du tableau");
      Put_Line ("    --geometry  : Affiche les géométries des éléments");
      Put_Line ("    --help      : Affiche cette aide");
      Put_Line ("    (sans option) : Affiche le tableau résumé");
      New_Line;
      Put_Line ("  Exemple : V3_Main --full --radiation --masses");
   end Print_Help;

   -- ========================================================================
   -- 11. PROCÉDURE PRINCIPALE
   -- ========================================================================

   procedure Parse_Arguments is
      Show_Full : Boolean := False;
      Show_Details : Boolean := False;
      Show_Radiation : Boolean := False;
      Show_Masses : Boolean := False;
      Show_Harmonics : Boolean := False;
      Show_Valence : Boolean := False;
      Show_Proofs : Boolean := False;
      Show_Stats : Boolean := False;
      Show_Geometry : Boolean := False;
      Show_Help : Boolean := False;
      Any_Option : Boolean := False;
   begin
      -- Analyse des arguments
      for Arg in 1 .. Argument_Count loop
         declare
            Opt : String := Argument (Arg);
         begin
            if Opt = "--full" then
               Show_Full := True;
               Any_Option := True;
            elsif Opt = "--details" then
               Show_Details := True;
               Any_Option := True;
            elsif Opt = "--radiation" then
               Show_Radiation := True;
               Any_Option := True;
            elsif Opt = "--masses" then
               Show_Masses := True;
               Any_Option := True;
            elsif Opt = "--harmonics" then
               Show_Harmonics := True;
               Any_Option := True;
            elsif Opt = "--valence" then
               Show_Valence := True;
               Any_Option := True;
            elsif Opt = "--proofs" then
               Show_Proofs := True;
               Any_Option := True;
            elsif Opt = "--stats" then
               Show_Stats := True;
               Any_Option := True;
            elsif Opt = "--geometry" then
               Show_Geometry := True;
               Any_Option := True;
            elsif Opt = "--help" then
               Show_Help := True;
               Any_Option := True;
            else
               Put_Line ("Option inconnue : " & Opt);
               Show_Help := True;
            end if;
         end;
      end loop;

      -- Affichage de l'aide si demandée ou si aucune option valide
      if Show_Help then
         Print_Help;
         return;
      end if;

      -- Affichage du header
      Print_Header;
      Print_Constants;

      -- Si aucune option, affichage résumé
      if not Any_Option then
         Print_Full_Table (False);
         Print_Statistics;
         Print_Valence_Examples;
         Print_V3_Masses;
         Print_Harmonics;
         Print_Radiation_Examples;
         Print_Proofs;
         return;
      end if;

      -- Options spécifiques
      if Show_Full or Show_Details then
         Print_Full_Table (Show_Details);
      end if;

      if Show_Stats then
         Print_Statistics;
      end if;

      if Show_Geometry then
         Print_Geometries;
      end if;

      if Show_Valence then
         Print_Valence_Examples;
      end if;

      if Show_Masses then
         Print_V3_Masses;
      end if;

      if Show_Harmonics then
         Print_Harmonics;
      end if;

      if Show_Radiation then
         Print_Radiation_Examples;
      end if;

      if Show_Proofs then
         Print_Proofs;
      end if;
   end Parse_Arguments;

-- ============================================================================
-- MAIN
-- ============================================================================

begin
   Parse_Arguments;

