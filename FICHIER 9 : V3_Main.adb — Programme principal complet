   procedure Print_Constants is
   begin
      Put_Line ("  CONSTANTES V3 :");
      Put_Line ("    Ψ_V3          = " & PSI_V3'Image & " kg·m⁻²");
      Put_Line ("    Φ_critical    = " & PHI_CRITICAL'Image & " V  (-51.1 mV)");
      Put_Line ("    K_cycles      = " & K_CYCLES'Image);
      Put_Line ("    ρ_cond        = " & RHO_COND'Image & " kg·m⁻³");
      Put_Line ("    ν_phase       = " & NU_PHASE'Image & " Hz  (6.4 THz)");
      Put_Line ("    β             = " & BETA'Image & "  (1 000 000)");
      Put_Line ("    λ_V3          = " & LAMBDA_V3'Image & " m  (46.8 µm)");
      Put_Line ("    c             = " & C_LIGHT'Image & " m/s  (limite de friction)");
      Put_Line ("    T_cosmic      = " & COSMIC_TEMP_K'Image & " K");
      Put_Line ("");
      Put_Line ("  CONSTANTES PHYSIQUES (mesurées, pas postulées) :");
      Put_Line ("    m_e           = " & M_E'Image & " kg  (électron)");
      Put_Line ("    m_p           = " & M_P'Image & " kg  (proton)");
      Put_Line ("    α             = " & ALPHA_FS'Image & "  (constante de structure fine)");
      Put_Line ("    a_0           = " & BOHR_RADIUS'Image & " m  (rayon de Bohr)");
      Put_Line ("    E_scale_eV    = " & ENERGY_SCALE_eV'Image & " eV  (13.6057 eV)");
      New_Line;
   end Print_Constants;

   procedure Print_Element (Node : V3_Phase_Node; Show_Details : Boolean := False) is
      Packing_Str : String (1 .. 12);
   begin
      -- Nom de l'empilement
      case Node.Geometry.Packing_Type is
         when Single      => Packing_Str := "Single     ";
         when Pair        => Packing_Str := "Pair       ";
         when Octahedron  => Packing_Str := "Octahedron ";
         when Cube        => Packing_Str := "Cube       ";
         when Bipyramid   => Packing_Str := "Bipyramid  ";
         when Icosahedron => Packing_Str := "Icosahedron";
         when None        => Packing_Str := "None       ";
      end case;

      Put (Node.Symbol);
      Put ("  Z=");
      Put (Node.Z, 3);
      Put ("  N=");
      Put (Node.N, 3);
      Put ("  A=");
      Put (Node.A, 3);
      Put ("  Mass=");
      Put (Node.Mass_Kg, 2, 5, 0);
      Put (" kg");
      Put ("  Coh=");
      Put (Node.Coherence, 2, 2, 0);
      Put ("%");
      if Node.Is_Stable then
         Put ("  [STABLE]");
      else
         Put ("  [UNSTABLE]");
      end if;
      Put ("  Geom=");
      Put (Packing_Str);
      Put ("  Valence=");
      Put (Node.Geometry.Available_Sites, 2);

      New_Line;

      if Show_Details then
         Put ("    └─ Phase_Potential=");
         Put (Node.Proton.Phase_Potential_V, 2, 4, 0);
         Put (" V  Pressure=");
         Put (Node.Proton.Pressure_GPa, 2, 4, 0);
         Put (" GPa  Radius=");
         Put (Node.Proton.Radius_Fm, 2, 4, 0);
         Put (" fm");
         New_Line;

         Put ("    └─ Ionization=");
         Put (Node.EM.Ionization_Energy_eV, 2, 4, 0);
         Put (" eV  Affinity=");
         Put (Node.EM.Electron_Affinity_eV, 2, 4, 0);
         Put (" eV  EN=");
         Put (Node.EM.Electronegativity, 2, 2, 0);
         New_Line;

         Put ("    └─ Blackbody T_eff=");
         Put (Node.EM.Blackbody.Temperature_Effective_K, 2, 2, 0);
         Put (" K  λ_peak=");
         Put (Node.EM.Blackbody.Peak_Wavelength_M * 1.0e6, 2, 4, 0);
         Put (" µm");
         New_Line;

         Put ("    └─ Melting=");
         Put (Node.Thermo.Melting_Point_K, 2, 2, 0);
         Put (" K  Boiling=");
         Put (Node.Thermo.Boiling_Point_K, 2, 2, 0);
         Put (" K");
         New_Line;
      end if;
   end Print_Element;

   procedure Print_Period (Title : String; Start_Z, End_Z : Integer; Show_Details : Boolean := False) is
   begin
      New_Line;
      Put_Line ("  " & Title & " (Z=" & Start_Z'Image & ".." & End_Z'Image & ") :");
      for Z in Start_Z .. End_Z loop
         Put ("    ");
         Print_Element (Nodes (Z), Show_Details);
      end loop;
   end Print_Period;

   -- ========================================================================
   -- 2. PROCÉDURE D'AFFICHAGE DES RAYONNEMENTS
   -- ========================================================================

   procedure Print_Radiation_Examples is
   begin
      New_Line;
      Print_Separator ('=', 80);
      Put_Line ("  RAYONNEMENTS V3 — EXEMPLES");
      Print_Separator ('-', 80);
      New_Line;

      -- Corps noir à différentes températures
      Put_Line ("  1. CORPS NOIR (Spectre de Planck) :");
      declare
         Temperatures : constant array (1 .. 5) of Float := (2.7, 300.0, 1000.0, 5778.0, 10000.0);
         Names        : constant array (1 .. 5) of String (1 .. 12) :=
           ("Cosmic      ", "Room        ", "Hot         ", "Sun         ", "Star        ");
      begin
         for I in 1 .. 5 loop
            declare
               BB : Blackbody_Spectrum := Get_Blackbody (Temperatures (I));
            begin
               Put ("    " & Names (I) & "  T=");
               Put (BB.Temperature_Effective_K, 2, 2, 0);
               Put (" K  λ_peak=");
               Put (BB.Peak_Wavelength_M * 1.0e6, 2, 4, 0);
               Put (" µm  I=");
               Put (BB.Total_Intensity_Wpm2, 2, 2, 0);
               Put (" W/m²");
               New_Line;
            end;
         end loop;
      end;
      New_Line;

      -- Bremsstrahlung
      Put_Line ("  2. BREMSSTRAHLUNG (rayonnement de freinage) :");
      declare
         Z_vals : constant array (1 .. 5) of Integer := (1, 6, 26, 47, 92);
         Names  : constant array (1 .. 5) of String (1 .. 12) :=
           ("H           ", "C           ", "Fe          ", "Ag          ", "U           ");
      begin
         for I in 1 .. 5 loop
            declare
               Brems : Bremsstrahlung_Record := Get_Bremsstrahlung (Z_vals (I), Z_vals (I)*2, 100.0, 1000.0);
            begin
               Put ("    " & Names (I) & "  Z=");
               Put (Z_vals (I), 3);
               Put ("  Power=");
               Put (Brems.Power_Watts, 2, 4, 0);
               Put (" W  ν_cutoff=");
               Put (Brems.Cutoff_Frequency_Hz / 1.0e18, 2, 4, 0);
               Put (" EHz");
               New_Line;
            end;
         end loop;
      end;
      New_Line;

      -- Cherenkov
      Put_Line ("  3. CHERENKOV (phase > c) :");
      declare
         Velocities : constant array (1 .. 4) of Float :=
           (C_LIGHT * 1.01, C_LIGHT * 1.05, C_LIGHT * 1.10, C_LIGHT * 1.50);
         Indices    : constant array (1 .. 4) of Float := (1.33, 1.50, 1.80, 2.00);
         Names      : constant array (1 .. 4) of String (1 .. 12) :=
           ("Water 1.01 ", "Glass 1.05 ", "Diamond 1.1", "Dense 1.5  ");
      begin
         for I in 1 .. 4 loop
            declare
               Cheren : Cherenkov_Record := Get_Cherenkov (Velocities (I), Indices (I),
                                                            1.0e12, 1.0e15);
            begin
               Put ("    " & Names (I) & "  v/c=");
               Put (Velocities (I) / C_LIGHT, 2, 4, 0);
               Put ("  n=");
               Put (Indices (I), 2, 4, 0);
               Put ("  θ=");
               Put (Cheren.Emission_Angle_Rad * 180.0 / PI, 2, 4, 0);
               Put ("°  Photons/m=");
               Put (Cheren.Photons_Per_Meter, 2, 4, 0);
               New_Line;
            end;
         end loop;
      end;
      New_Line;

      -- Ondes gravitationnelles
      Put_Line ("  4. ONDES GRAVITATIONNELLES V3 :");
      declare
         Masses : constant array (1 .. 4) of Float :=
           (1.0e30, 1.0e31, 1.0e32, 1.0e33);  -- kg (étoiles)
         Names  : constant array (1 .. 4) of String (1 .. 12) :=
           ("1.0e30 kg  ", "1.0e31 kg  ", "1.0e32 kg  ", "1.0e33 kg  ");
      begin
         for I in 1 .. 4 loop
            declare
               GW : Gravitational_Wave := Get_Gravitational_Wave (Masses (I), Masses (I) * 0.5,
                                                                  1.0e9, 100.0);
            begin
               Put ("    " & Names (I) & "  h=");
               Put (GW.Amplitude_Strain, 2, 4, 0);
               Put ("  P=");
               Put (GW.Power_Watts / 1.0e30, 2, 4, 0);
               Put ("e30 W");
               New_Line;
            end;
         end loop;
      end;
      New_Line;

      -- Rayonnement V3 (ondes de cisaillement) pour quelques éléments
      Put_Line ("  5. ONDES DE CISAILLEMENT (photons V3) :");
      declare
         Z_vals : constant array (1 .. 5) of Integer := (1, 6, 26, 47, 92);
         Names  : constant array (1 .. 5) of String (1 .. 12) :=
           ("H           ", "C           ", "Fe          ", "Ag          ", "U           ");
      begin
         for I in 1 .. 5 loop
            declare
               Node : V3_Phase_Node := Nodes (Z_vals (I));
               Wave : Shear_Wave := Node.EM.Spectral_Series (1);
            begin
               Put ("    " & Names (I) & "  λ=");
               Put (Wave.Wavelength_M * 1.0e9, 2, 4, 0);
               Put (" nm  E=");
               Put (Wave.Energy_eV, 2, 4, 0);
               Put (" eV");
               New_Line;
            end;
         end loop;
      end;
   end Print_Radiation_Examples;

   -- ========================================================================
   -- 3. PROCÉDURE D'AFFICHAGE DES MASSES V3
   -- ========================================================================

   procedure Print_V3_Masses is
      R_p : constant Float := 0.84e-15;  -- 0.84 fm (CODATA)
   begin
      New_Line;
      Print_Separator ('=', 80);
      Put_Line ("  V3 MASSE DU PROTON ET DE L'ÉLECTRON");
      Print_Separator ('-', 80);
      New_Line;

      Put_Line ("  Rayon du proton (CODATA) : " & R_p'Image & " m  (0.84 fm)");
      New_Line;

      -- Masse du proton V3
      declare
         Record_Proton : V3_Proton_Mass_Record := Get_V3_Proton_Mass_Record (R_p);
      begin
         Put_Line ("  PROTON V3 :");
         Put ("    Mass_V3_kg        = ");
         Put (Record_Proton.Mass_Absolute_kg, 2, 5, 0);
         New_Line;
         Put ("    Mass_CODATA_kg     = ");
         Put (Record_Proton.Mass_CODATA_kg, 2, 5, 0);
         New_Line;
         Put ("    Pressure_Ratio     = ");
         Put (Record_Proton.Pressure_Ratio, 2, 4, 0);
         New_Line;
         Put ("    Is_Pressure_Diff   = ");
         Put (Record_Proton.Is_Pressure_Diff'Image);
         New_Line;
         Put ("    V3 Formule         : m_p = β × ρ_cond × V_core");
         Put ("    (V_core = π² × r_p³ / 2)");
         New_Line;
      end;
      New_Line;

      -- Masse de l'électron V3
      declare
         Record_Electron : V3_Electron_Mass_Record := Get_V3_Electron_Mass_Record (R_p, ALPHA_FS);
      begin
         Put_Line ("  ÉLECTRON V3 :");
         Put ("    Mass_V3_kg        = ");
         Put (Record_Electron.Mass_V3_kg, 2, 5, 0);
         New_Line;
         Put ("    Mass_CODATA_kg     = ");
         Put (Record_Electron.Mass_CODATA_kg, 2, 5, 0);
         New_Line;
         Put ("    Boundary_Layer_m   = ");
         Put (Record_Electron.Boundary_Layer_m, 2, 5, 0);
         New_Line;
         Put ("    Shell_Volume_m3    = ");
         Put (Record_Electron.Shell_Volume_m3, 2, 5, 0);
         New_Line;
         Put ("    V3 Formule         : m_e = V_shell × ρ_shell");
         Put ("    (ρ_shell = ρ_cond / β²)");
         New_Line;
      end;
      New_Line;

      -- Rapport m_p/m_e
      declare
         Ratio : Float := Proton_Electron_Mass_Ratio (R_p, ALPHA_FS);
         Ratio_CODATA : constant Float := 1836.15267343;
      begin
         Put_Line ("  RAPPORT m_p/m_e :");
         Put ("    V3 Ratio          = ");
         Put (Ratio, 2, 4, 0);
         New_Line;
         Put ("    CODATA Ratio      = ");
         Put (Ratio_CODATA, 2, 4, 0);
         New_Line;
         Put ("    Différence        = ");
         Put (abs (Ratio - Ratio_CODATA) / Ratio_CODATA * 100.0, 2, 4, 0);
         Put (" %");
         New_Line;
      end;
   end Print_V3_Masses;

