      Put_Line ("    ❌ Pas de spin intrinsèque");
      Put_Line ("    ❌ Pas de charge intrinsèque");
      Put_Line ("    ❌ Pas de masse intrinsèque");
      Put_Line ("");
      Put_Line ("  Il s'appuie UNIQUEMENT sur les concepts V3 :");
      Put_Line ("    ✅ Onde de surface (électron)");
      Put_Line ("    ✅ Vortex de pression (proton)");
