   procedure Print_Valence_Examples is
      Z_vals : constant array (1 .. 10) of Integer := (1, 2, 6, 7, 8, 16, 26, 29, 47, 79);
      Names  : constant array (1 .. 10) of String (1 .. 3) :=
        ("H  ", "He ", "C  ", "N  ", "O  ", "S  ", "Fe ", "Cu ", "Ag ", "Au ");
   begin
      New_Line;
      Print_Separator ('=', 80);
      Put_Line ("  V3 VALENCE GÉOMÉTRIQUE — EXEMPLES");
      Print_Separator ('-', 80);
      New_Line;

      Put_Line ("  La valence n'est pas un nombre quantique.");
      Put_Line ("  C'est le nombre de sites géométriques disponibles sur le cluster.");
      Put_Line ("  La valence est une propriété topologique de l'empilement.");
      New_Line;

      Put_Line ("  Élément  Z  Valence  Empilement      Sites disponibles");
      Put_Line ("  ------- --- -------  ----------      ----------------");

      for I in 1 .. 10 loop
         declare
            Node : V3_Phase_Node := Nodes (Z_vals (I));
            Packing_Str : String (1 .. 12);
         begin
            case Node.Geometry.Packing_Type is
               when Single      => Packing_Str := "Single     ";
               when Pair        => Packing_Str := "Pair       ";
               when Octahedron  => Packing_Str := "Octahedron ";
               when Cube        => Packing_Str := "Cube       ";
               when Bipyramid   => Packing_Str := "Bipyramid  ";
               when Icosahedron => Packing_Str := "Icosahedron";
               when None        => Packing_Str := "None       ";
            end case;

            Put ("  " & Names (I) & "   ");
            Put (Z_vals (I), 3);
            Put ("    ");
            Put (Node.Geometry.Available_Sites, 3);
            Put ("     ");
            Put (Packing_Str);
            Put ("  [");
            for J in 1 .. 20 loop
               if not Node.Valence_Sites (J).Is_Occupied then
                  Put (".");
               else
                  Put (" ");
               end if;
               if J mod 5 = 0 and J < 20 then
                  Put (" ");
               end if;
            end loop;
            Put ("]");
            New_Line;
         end;
      end loop;

      New_Line;
      Put_Line ("  Légende : . = site disponible  (espace) = site occupé");
      Put_Line ("  Exemple : C (Z=6) a 4 sites disponibles → valence 4");
      Put_Line ("            O (Z=8) a 2 sites disponibles → valence 2");
      Put_Line ("            Fe (Z=26) a 6 sites disponibles → valence 6 (Fe²⁺, Fe³⁺)");
   end Print_Valence_Examples;

