   -- ========================================================================
   -- 9. FONCTIONS DE VALIDATION CROISÉE
   -- ========================================================================

   function Cross_Validate_Enzyme
     (Enzyme       : Enzyme_State;
      Experimental : Enzyme_State) return Boolean is
   begin
      -- Comparaison des paramètres clés
      return abs (Enzyme.Km - Experimental.Km) / Enzyme.Km < 0.5 and
             abs (Enzyme.kcat - Experimental.kcat) / Enzyme.kcat < 0.5 and
             abs (Enzyme.Tm - Experimental.Tm) / Enzyme.Tm < 0.1;
   end Cross_Validate_Enzyme;

   -- ========================================================================
   -- 10. AUTO-TEST DU "PETIT CERVEAU"
   -- ========================================================================

   function Run_Auto_Test return Boolean is
      Test_Passed : Boolean := True;
      Enzyme : Enzyme_State;
      DB : Database_Array;
   begin
      -- Créer une enzyme
      Enzyme := Design_Enzyme ("MKKTALIVALATLLSSAVVSA", PET, "Ecoli");

      -- Vérifier les paramètres
      if Enzyme.Length <= 0 then
         Test_Passed := False;
      end if;

      if Enzyme.Km <= 0.0 or Enzyme.kcat <= 0.0 then
         Test_Passed := False;
      end if;

      if Enzyme.Checksum /= MODULO_9 then
         Test_Passed := False;
      end if;

      -- Charger une banque de données
      DB := Load_Database ("BRENDA");

      -- Valider contre la banque
      if Validate_Against_Database (Enzyme, DB) then
         -- OK
         null;
      end if;

      return Test_Passed;
   end Run_Auto_Test;

end V3.Universal_Enzyme_Designer;

