      begin
         Sum := Network.Dermis_Integrity + Network.Cornea_Integrity +
                Network.Gingiva_Integrity + Network.Fascia_Integrity +
                Network.Tendon_Integrity + Network.Ligament_Integrity +
                Network.Bone_Matrix_Integrity + Network.Cartilage_Integrity +
                Network.ECM_Integrity + Network.Vascular_Wall_Integrity +
