   package body Physics is
      function Compute_Lorentz_Gamma (V : Float) return Float is
         Beta : constant Float := V / C;
      begin
         if Beta >= 1.0 then return 1.0;
         end if;
         return 1.0 / Sqrt (1.0 - Beta * Beta);
      exception
         when others => return 1.0;
      end Compute_Lorentz_Gamma;

      function Compute_Phase_Drift (V, D : Float) return Float is
         Gamma : Float := Compute_Lorentz_Gamma (V);
         Cutoff : Float := Exp (-(D / 1.0e20) ** 2);
         Result : Float := (Gamma - 1.0) * abs (PHI_CRITICAL) * (D / R_HUBBLE) * Cutoff;
      begin
         return Clamp (Result, 0.0, 1.0e100);
      exception
         when others => return 0.0;
      end Compute_Phase_Drift;

      function Compute_Photonic_Communication
        (Distance : Integer; State : Photonic_Network_State) return Integer
      is
         C_ns : constant := 300_000;  -- nm/ns
         Result : Integer := 0;
      begin
         if State.Collagen_Integrity < 50 or State.Microtubule_Integrity < 50 then
            return 0;
         end if;
         Result := Distance / C_ns;
         return Integer (Clamp (Float (Result), 0.0, 1_000_000.0));
      exception
         when others => return 0;
      end Compute_Photonic_Communication;

      function Compare_Communication_Speeds (Distance : Integer) return String is
      begin
         if Distance = 0 then
            return "Distance nulle";
