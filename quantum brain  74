         pragma Unreferenced (Length);
         Result : Float := 0.0;
      begin
         if Length <= 0 then return 100.0; end if;
         if Coherence < 0.0 or Coherence > 100.0 then return 100.0; end if;
         if Coherence >= 90.0 then Result := 1.0;
         elsif Coherence >= 70.0 then Result := 5.0;
         elsif Coherence >= 50.0 then Result := 10.0;
         else Result := 100.0;
         end if;
         return Clamp (Result, 0.0, 1000.0);
      exception
         when others => return 100.0;
