   package body Cosmology is
      function Compute_Rebound_Force (Scale : Float) return Float is
         R_Dyn : Float := R_HUBBLE * Scale;
         L_Dyn : Float := LAMBDA_V3_COSMO / (Scale * Scale);
         M_Dyn : Float := PSI_V3 / (R_Dyn * C * C * L_Dyn);
         Result : Float := - (M_Dyn * C * C) / (R_Dyn * R_Dyn) + L_Dyn * (R_Dyn * R_Dyn) * 4.0 * PI_V3;
      begin
         if Scale <= 0.0 then return 0.0; end if;
         return Clamp (Result, -1.0e100, 1.0e100);
      exception
         when others => return 0.0;
      end Compute_Rebound_Force;

      function Compute_Dark_Matter (D : Float) return Float is
         Result : Float := 0.0;
      begin
         if D < 0.0 then return 0.0; end if;
         if D < 1.0e20 then Result := 0.0;
         elsif D < 1.0e21 then Result := 20.0 * (D - 1.0e20) / 9.0e20;
         elsif D < 1.0e22 then Result := 20.0 + 65.0 * (D - 1.0e21) / 9.0e21;
         else Result := 85.0 * (1.0 + (D - 1.0e22) / 1.0e24);
         end if;
         return Clamp (Result, 0.0, 100.0);
      exception
         when others => return 0.0;
      end Compute_Dark_Matter;

      function Compute_Proton_Mass_At_Horizon (Proximity : Float) return Float is
         M_ABSOLUTE : constant Float := 4.1261e-17;
         Result : Float := M_ABSOLUTE * Proximity;
      begin
         if Proximity < 0.0 or Proximity > 1.0 then return 0.0; end if;
         if Result < 0.0 then return 0.0;
         else return Result;
         end if;
      exception
         when others => return 0.0;
      end Compute_Proton_Mass_At_Horizon;

      function Compute_Hydrodynamic_Pressure (Radius_Ratio : Float) return Float is
         P_Center : constant Float := PSI_V3 * C * C / R_HUBBLE;
         Result : Float := 0.0;
      begin
         if Radius_Ratio < 0.0 or Radius_Ratio > 1.0 then return 0.0; end if;
         if Radius_Ratio >= 1.0 then
            Result := 0.0;
         else
            Result := P_Center * (1.0 - Radius_Ratio * Radius_Ratio);
         end if;
         return Clamp (Result, 0.0, 1.0e30);
      exception
         when others => return 0.0;
      end Compute_Hydrodynamic_Pressure;

      function Compute_Collapse_Product (State : Supernova_State) return Stellar_Product is
         Mass : Integer := State.Mass;
      begin
         if Mass = 0 then return White_Dwarf; end if;
         if Mass < LIMIT_CHANDRASEKHAR then
            return White_Dwarf;
         elsif Mass < LIMIT_OPPENHEIMER_VOLKOFF then
            if State.Magnetic_Field > CRITICAL_MAGNETISM / 1000 then
               return Magnetar;
            else
               return Pulsar;
            end if;
         else
            return Black_Hole;
         end if;
      exception
         when others => return White_Dwarf;
      end Compute_Collapse_Product;

      function Compare_With_Observations (State : Supernova_State) return String is
         Product : Stellar_Product := Compute_Collapse_Product (State);
      begin
         case Product is
            when White_Dwarf =>
               return "White Dwarf (≤ 1.44 M☉) — matches observations";
            when Pulsar =>
               return "Pulsar (1.44–2.17 M☉) — matches observed neutron stars";
            when Magnetar =>
               return "Magnetar — extreme magnetic field ~10¹¹ T, matches observations";
            when Black_Hole =>
               return "Black Hole (> 2.17 M☉) — matches gravitational wave detections";
         end case;
      exception
         when others => return "Unknown product";
      end Compare_With_Observations;

      function Answer (Q : String) return String is
