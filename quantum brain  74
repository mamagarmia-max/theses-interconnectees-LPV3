         Sum : Float := 0.0;
         Result : Float := 0.0;
      begin
         if Days < 0.0 then return 0.0; end if;
         for I in 1 .. 7 loop
            pragma Loop_Invariant (I in 1 .. 7);
            Sum := Sum + Compute_Retinal_Layer (I, Days);
         end loop;
         Result := Sum / 7.0;
         return Clamp (Result, 0.0, 100.0);
      exception
         when others => return 0.0;
      end Compute_Avg_Regeneration;

