         if Lower'Length >= 6 and then Lower (1 .. 6) = "lambda" then
            return "Λ V3 = " & Float'Image (LAMBDA_V3_COSMO) & " m⁻²";
         elsif Lower'Length >= 6 and then Lower (1 .. 6) = "rebond" then
