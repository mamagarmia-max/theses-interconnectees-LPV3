      function Compute_Phase_EZ (Potential : Float) return Float is
      begin
         if Potential < -100.0 or Potential > 0.0 then return 0.0; end if;
         if Potential <= PHI_CRITICAL then return 100.0;
         else return Clamp ((Potential - PHI_BASAL) / (PHI_CRITICAL - PHI_BASAL) * 100.0, 0.0, 100.0);
         end if;
      exception
         when others => return 0.0;
      end Compute_Phase_EZ;

