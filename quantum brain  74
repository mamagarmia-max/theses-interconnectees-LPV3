         elsif Lower'Length >= 4 and then Lower (1 .. 4) = "trou" or else Lower (1 .. 4) = "black" then
            return "Trou noir : m_p = " & Float'Image (Compute_Proton_Mass_At_Horizon (0.0)) & " kg";
         elsif Lower'Length >= 5 and then Lower (1 .. 5) = "paroi" then
