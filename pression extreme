with Ada.Text_IO; use Ada.Text_IO;
with Ada.Float_Text_IO; use Ada.Float_Text_IO;

procedure V3_Phase_Universe with
   SPARK_Mode => On,
   Global => null
is

   -- ========================================================================
   -- 1. LES 6 INVARIANTS V3 (VERROUILLÉS — AUCUN AJUSTEMENT)
   -- ========================================================================

   PSI_V3          : constant := 48016.8;          -- Densité de phase (kg·m⁻²)
   PHI_CRITICAL    : constant := -51.1;            -- Seuil universel (mV)
   NU_PHASE        : constant := 6.4e12;           -- Fréquence de verrouillage (Hz)
   BETA            : constant := 1_000_000.0;      -- Facteur d'échelle
   RHO_COND        : constant := 1026.0;           -- Densité du condensat (kg·m⁻³)
   K_CYCLES        : constant := 7;                -- Fermeture heptadique

   -- ========================================================================
   -- 2. TYPES FONDAMENTAUX — TOUT EST PRESSION
   -- ========================================================================

   type Phase_Entity is record
      -- Une entité de phase : proton, électron, neutron, photon, neutrino, liaison, vie
      Kind           : String (1 .. 20);
      Pressure       : Float;                      -- Pression de phase (Pa)
      Coherence      : Float range 0.0 .. 100.0;   -- Cohérence de phase (%)
      Mass           : Float;                      -- Masse dérivée (kg)
      Charge         : Float;                      -- Charge dérivée (C)
      Spin           : Float;                      -- Spin dérivé (J·s)
      Is_Stable      : Boolean;
   end record;

   -- ========================================================================
   -- 3. FONCTIONS DE DÉRIVATION — AUCUN PARAMÈTRE AJUSTABLE
   -- ========================================================================

   -- 3.1 Masse = pression différentielle
   function Mass_From_Pressure (P_vortex, P_ambient : Float; Volume : Float) return Float
     with Pre => P_vortex >= 0.0 and P_ambient >= 0.0 and Volume > 0.0,
          Post => Mass_From_Pressure'Result >= 0.0
   is
      C_LIGHT : constant Float := 299_792_458.0;    -- Limite de friction du condensat
   begin
      return (P_vortex - P_ambient) * Volume / (C_LIGHT * C_LIGHT);
   end Mass_From_Pressure;

   -- 3.2 Charge = pression de surface
   function Charge_From_Pressure (P_surface, P_ambient : Float; Area : Float) return Float
     with Pre => P_surface >= 0.0 and P_ambient >= 0.0 and Area > 0.0,
          Post => Charge_From_Pressure'Result >= 0.0
   is
      ALPHA : constant Float := 1.0 / 137.036;      -- Constante de structure fine
   begin
      return ALPHA * (P_surface - P_ambient) * Area;
   end Charge_From_Pressure;

   -- 3.3 Spin = rotation de pression
   function Spin_From_Pressure (P_rot : Float; Radius : Float; Omega : Float) return Float
     with Pre => P_rot >= 0.0 and Radius > 0.0 and Omega >= 0.0,
          Post => Spin_From_Pressure'Result >= 0.0
   is
      -- Spin = moment d'inertie × vitesse angulaire × pression de rotation
      Inertia : Float := 0.4 * Radius * Radius;
   begin
      return Inertia * Omega * P_rot;
   end Spin_From_Pressure;

   -- 3.4 Cohérence = fonction de la pression de phase
   function Coherence_From_Pressure (Pressure : Float) return Float
     with Pre => Pressure >= 0.0,
          Post => Coherence_From_Pressure'Result in 0.0 .. 100.0
   is
      -- La cohérence est maximale quand la pression est proche du seuil critique
      Ratio : Float := Pressure / abs (PHI_CRITICAL);
   begin
      if Ratio > 1.0 then
         return 100.0;
      else
         return Ratio * 100.0;
      end if;
   end Coherence_From_Pressure;

   -- 3.5 Stabilité = cohérence ≥ 90% et pression sous le seuil
   function Is_Stable (Coherence : Float; Pressure : Float) return Boolean
     with Pre => Coherence in 0.0 .. 100.0 and Pressure >= 0.0
   is
   begin
      return (Coherence >= 90.0 and Pressure < abs (PHI_CRITICAL));
   end Is_Stable;

   -- 3.6 Création d'une entité de phase à partir de la pression
   function Create_Entity (Kind : String; P_vortex, P_ambient : Float; Volume, Area, Radius, Omega : Float) return Phase_Entity
     with Pre => P_vortex >= 0.0 and P_ambient >= 0.0 and Volume > 0.0 and Area > 0.0 and Radius > 0.0 and Omega >= 0.0,
          Post => Create_Entity'Result.Coherence in 0.0 .. 100.0
   is
      Mass   : Float := Mass_From_Pressure (P_vortex, P_ambient, Volume);
      Charge : Float := Charge_From_Pressure (P_vortex, P_ambient, Area);
      Spin   : Float := Spin_From_Pressure (P_vortex, Radius, Omega);
      Press  : Float := P_vortex - P_ambient;
      Coh    : Float := Coherence_From_Pressure (Press);
      Stable : Boolean := Is_Stable (Coh, Press);
   begin
      return Phase_Entity'
        (Kind           => Kind,
         Pressure       => Press,
         Coherence      => Coh,
         Mass           => Mass,
         Charge         => Charge,
         Spin           => Spin,
         Is_Stable      => Stable);
   end Create_Entity;

   -- ========================================================================
   -- 4. CRÉATION DES ENTITÉS FONDAMENTALES — TOUT DÉRIVÉ DE LA PRESSION
   -- ========================================================================

   function Create_Proton return Phase_Entity is
      P_core   : constant Float := 1.5e9;          -- Pression du vortex protonique
      P_amb    : constant Float := 0.8e9;          -- Pression ambiante du condensat
      Volume   : constant Float := 2.94e-45;       -- Volume du vortex (m³)
      Area     : constant Float := 2.22e-30;       -- Surface du vortex (m²)
      Radius   : constant Float := 0.84e-15;       -- Rayon du vortex (m)
      Omega    : constant Float := 6.4e12;         -- Fréquence de rotation (Hz)
   begin
      return Create_Entity ("Proton              ", P_core, P_amb, Volume, Area, Radius, Omega);
   end Create_Proton;

   function Create_Electron return Phase_Entity is
      P_shell  : constant Float := 0.5e9;          -- Pression de l'onde de surface
      P_amb    : constant Float := 0.3e9;          -- Pression ambiante du condensat
      Volume   : constant Float := 2.50e-47;       -- Volume de la couche limite (m³)
      Area     : constant Float := 8.87e-30;       -- Surface de l'onde (m²)
      Radius   : constant Float := 0.84e-15;       -- Rayon du vortex (m)
      Omega    : constant Float := 6.4e12;         -- Fréquence de rotation (Hz)
   begin
      return Create_Entity ("Electron            ", P_shell, P_amb, Volume, Area, Radius, Omega);
   end Create_Electron;

   function Create_Neutron return Phase_Entity is
      P_core   : constant Float := 1.8e9;          -- Pression du vortex saturé
      P_amb    : constant Float := 0.8e9;          -- Pression ambiante
      Volume   : constant Float := 3.00e-45;       -- Volume du vortex saturé (m³)
      Area     : constant Float := 0.0;            -- Pas de surface → charge 0
      Radius   : constant Float := 0.84e-15;       -- Rayon du vortex (m)
      Omega    : constant Float := 6.4e12;         -- Fréquence de rotation (Hz)
   begin
      return Create_Entity ("Neutron             ", P_core, P_amb, Volume, Area, Radius, Omega);
   end Create_Neutron;

   function Create_Photon return Phase_Entity is
      P_wave   : constant Float := 0.1e9;          -- Pression de l'onde de cisaillement
      P_amb    : constant Float := 0.0;            -- Pression de référence
      Volume   : constant Float := 1.0e-50;        -- Volume de l'onde (m³)
      Area     : constant Float := 1.0e-30;        -- Surface de l'onde (m²)
      Radius   : constant Float := 1.0e-15;        -- Longueur d'onde (m)
      Omega    : constant Float := 1.0e15;         -- Fréquence de l'onde (Hz)
   begin
      return Create_Entity ("Photon              ", P_wave, P_amb, Volume, Area, Radius, Omega);
   end Create_Photon;

   function Create_Neutrino_V3 return Phase_Entity is
      P_wave   : constant Float := 0.05e9;         -- Pression de l'onde longitudinale
      P_amb    : constant Float := 0.0;            -- Pression de référence
      Volume   : constant Float := 1.0e-50;        -- Volume de l'onde (m³)
      Area     : constant Float := 1.0e-30;        -- Surface de l'onde (m²)
      Radius   : constant Float := 1.0e-15;        -- Longueur d'onde (m)
      Omega    : constant Float := 1.0e15;         -- Fréquence de l'onde (Hz)
   begin
      return Create_Entity ("Neutrino V3         ", P_wave, P_amb, Volume, Area, Radius, Omega);
   end Create_Neutrino_V3;

   function Create_Bond (Pressure : Float) return Phase_Entity is
      P_lock   : constant Float := Pressure;
      P_amb    : constant Float := 0.0;
      Volume   : constant Float := 1.0e-50;
      Area     : constant Float := 1.0e-30;
      Radius   : constant Float := 1.0e-15;
      Omega    : constant Float := 1.0e15;
   begin
      return Create_Entity ("Chemical Bond      ", P_lock, P_amb, Volume, Area, Radius, Omega);
   end Create_Bond;

   function Create_Life (Phase_Coherence : Float) return Phase_Entity is
      -- La vie est une cohérence de phase maintenue à -51.1 mV
      P_life   : constant Float := abs (PHI_CRITICAL);
      P_amb    : constant Float := 0.0;
      Volume   : constant Float := 1.0e-50;
      Area     : constant Float := 1.0e-30;
      Radius   : constant Float := 1.0e-15;
      Omega    : constant Float := 1.0e15;
      Entity   : Phase_Entity := Create_Entity ("Life                ", P_life, P_amb, Volume, Area, Radius, Omega);
   begin
      Entity.Coherence := Phase_Coherence;
      Entity.Is_Stable := (Phase_Coherence >= 90.0);
      return Entity;
   end Create_Life;

   -- ========================================================================
   -- 5. PROCÉDURE DE COMPARAISON — TOUT EST PRESSION
   -- ========================================================================

   procedure Print_Entity (E : Phase_Entity; Name : String) is
   begin
      Put (Name);
      Put (" | Pression: ");
      Put (E.Pressure, Aft => 2, Exp => 0);
      Put (" Pa");
      Put (" | Cohérence: ");
      Put (E.Coherence, Aft => 2, Exp => 0);
      Put ("%");
      Put (" | Masse: ");
      Put (E.Mass, Aft => 3, Exp => -27);
      Put (" kg");
      Put (" | Charge: ");
      Put (E.Charge, Aft => 3, Exp => -19);
      Put (" C");
      Put (" | Spin: ");
      Put (E.Spin, Aft => 3, Exp => -34);
      Put (" J·s");
      Put (" | Stable: ");
      Put (Boolean'Image (E.Is_Stable));
      New_Line;
   end Print_Entity;

   -- ========================================================================
   -- 6. PROGRAMME PRINCIPAL — CALCUL AUTONOME
   -- ========================================================================

   procedure Run_Phase_Universe
     with Global => null
   is
      Proton   : Phase_Entity := Create_Proton;
      Electron : Phase_Entity := Create_Electron;
      Neutron  : Phase_Entity := Create_Neutron;
      Photon   : Phase_Entity := Create_Photon;
