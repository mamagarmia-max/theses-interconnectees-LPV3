with Ada.Text_IO; use Ada.Text_IO;
with Ada.Float_Text_IO; use Ada.Float_Text_IO;
with Ada.Integer_Text_IO; use Ada.Integer_Text_IO;
with Ada.Numerics; use Ada.Numerics;
with Ada.Numerics.Elementary_Functions; use Ada.Numerics.Elementary_Functions;

procedure V3_SN_Engulfment_Full with
   SPARK_Mode => On
is

   -- ========================================================================
   -- 1. V3 INVARIANTS (VERROUILLÉS)
   -- ========================================================================

   PSI_V3          : constant := 48016.8;          -- kg·m⁻²
   PHI_CRITICAL    : constant := -0.0511;          -- V (-51.1 mV)
   K_CYCLES        : constant := 7;                -- Clôture heptadique
   RHO_COND        : constant := 1026.0;           -- kg·m⁻³
   NU_PHASE        : constant := 6.4e12;           -- Hz
   BETA            : constant := 1_000_000.0;      -- Facteur d'échelle
   ALPHA_FS        : constant := 7.29735256e-3;    -- Structure fine
   C_LIGHT         : constant := 299_792_458.0;    -- m/s
   HBAR            : constant := 1.054571817e-34;  -- J·s
   E_CHARGE        : constant := 1.602176634e-19;  -- C
   M_P             : constant := 1.67262192e-27;   -- kg
   G_NEWTON        : constant := 6.67430e-11;      -- m³·kg⁻¹·s⁻²
   M_SUN           : constant := 1.98847e30;       -- kg
   K_B             : constant := 1.380649e-23;     -- J/K
   PI              : constant := Ada.Numerics.Pi;

   -- ========================================================================
   -- 2. TYPES V3
   -- ========================================================================

   type Engulfment_Stage is (Pre_SN, SN_Explosion, Expansion, Approach, Spiral,
                             Tidal_Disruption, Accretion, Merger, Remnant, Evaporation);

   type V3_SN_Engulfment_State is record
      -- Paramètres de la supernova
      SN_Mass_kg        : Float;
      SN_Radius_m       : Float;
      SN_Temperature_K  : Float;
      SN_Energy_J       : Float;
      SN_Element_Z      : Integer;
      SN_Phase          : Float;

      -- Paramètres du trou noir
      BH_Mass_kg        : Float;
      BH_Radius_m       : Float;
      BH_Spin           : Float range 0.0 .. 1.0;
      BH_Phase          : Float;

      -- Distance et interaction
      Distance_m        : Float;
      Roche_Radius_m    : Float;
      Orbital_Energy_J  : Float;

      -- Ondes gravitationnelles
      GW_Frequency_Hz   : Float;
      GW_Amplitude      : Float;
      GW_Energy_J       : Float;

      -- Rayonnements
      Luminosity_W      : Float;
      XRay_Luminosity_W : Float;
      Gamma_Luminosity_W : Float;
      Neutrino_Luminosity_W : Float;

      -- Paramètres de phase
      Phase_Potential   : Float;
      Coherence         : Float range 0.0 .. 100.0;

      -- Temps
      Time_s            : Float;
      Time_Step_s       : Float;
      Stage             : Engulfment_Stage;

      -- Drapeaux
      Is_Exploding      : Boolean;
      Is_Interacting    : Boolean;
      Is_Merging        : Boolean;
      Has_GW            : Boolean;
      Is_Emitting       : Boolean;
      Checksum          : Integer range 1 .. 9 := 9;
   end record
     with Predicate => V3_SN_Engulfment_State.Checksum = 9;

   -- ========================================================================
   -- 3. FONCTIONS DE SIMULATION V3
   -- ========================================================================

   -- 3.1 Rayon de Schwarzschild
   function Schwarzschild_Radius (M : Float) return Float
     with Pre => M > 0.0,
          Post => Schwarzschild_Radius'Result > 0.0
   is
   begin
      return 2.0 * G_NEWTON * M / (C_LIGHT * C_LIGHT);
   end Schwarzschild_Radius;

   -- 3.2 Pression gravitationnelle
   function Gravitational_Pressure (M, R : Float) return Float
     with Pre => M > 0.0 and R > 0.0,
          Post => Gravitational_Pressure'Result > 0.0
   is
   begin
      return (3.0 * G_NEWTON * M * M) / (8.0 * PI * R * R * R * R);
   end Gravitational_Pressure;

   -- 3.3 Pression de phase
   function Phase_Pressure (M, R : Float; Phi : Float) return Float
     with Pre => M > 0.0 and R > 0.0 and Phi < 0.0,
          Post => Phase_Pressure'Result > 0.0
   is
   begin
      return (PSI_V3 * abs (Phi) * M) / (R * R * R * R);
   end Phase_Pressure;

   -- 3.4 Rayon de Roche
   function Roche_Radius (M_BH, M_SN, R_SN : Float) return Float
     with Pre => M_BH > 0.0 and M_SN > 0.0 and R_SN > 0.0,
          Post => Roche_Radius'Result > 0.0
   is
   begin
      return 2.44 * R_SN * (M_BH / M_SN) ** (1.0 / 3.0);
   end Roche_Radius;

   -- 3.5 Énergie orbitale
   function Orbital_Energy (M1, M2, R : Float) return Float
     with Pre => M1 > 0.0 and M2 > 0.0 and R > 0.0,
          Post => Orbital_Energy'Result < 0.0
   is
   begin
      return -G_NEWTON * M1 * M2 / (2.0 * R);
   end Orbital_Energy;

   -- 3.6 Fréquence des ondes gravitationnelles
   function GW_Frequency (M1, M2, R : Float) return Float
     with Pre => M1 > 0.0 and M2 > 0.0 and R > 0.0,
          Post => GW_Frequency'Result > 0.0
   is
      M_total : Float := M1 + M2;
   begin
      return sqrt (G_NEWTON * M_total / (R * R * R)) / PI;
   end GW_Frequency;

   -- 3.7 Énergie des ondes gravitationnelles
   function GW_Energy (M1, M2, R : Float) return Float
     with Pre => M1 > 0.0 and M2 > 0.0 and R > 0.0,
          Post => GW_Energy'Result >= 0.0
   is
      Mu : Float := (M1 * M2) / (M1 + M2);
      M_total : Float := M1 + M2;
   begin
      return 0.1 * Mu * C_LIGHT * C_LIGHT * (Schwarzschild_Radius (M_total) / R);
   end GW_Energy;

   -- 3.8 Luminosité d'accrétion
   function Accretion_Luminosity (M_BH, Accretion_Rate : Float) return Float
     with Pre => M_BH > 0.0 and Accretion_Rate > 0.0,
          Post => Accretion_Luminosity'Result >= 0.0
   is
   begin
      return 0.1 * Accretion_Rate * C_LIGHT * C_LIGHT;
   end Accretion_Luminosity;

   -- 3.9 Rayonnement X
   function XRay_Luminosity (L : Float) return Float
     with Pre => L >= 0.0,
          Post => XRay_Luminosity'Result >= 0.0
   is
   begin
      return 0.1 * L;
   end XRay_Luminosity;

   -- 3.10 Rayonnement gamma
   function Gamma_Luminosity (L : Float) return Float
     with Pre => L >= 0.0,
          Post => Gamma_Luminosity'Result >= 0.0
   is
   begin
      return 0.01 * L;
   end Gamma_Luminosity;

   -- 3.11 Neutrinos
   function Neutrino_Luminosity (L : Float) return Float
     with Pre => L >= 0.0,
          Post => Neutrino_Luminosity'Result >= 0.0
   is
   begin
      return 0.5 * L;   -- Supernovae et accrétion émettent beaucoup de neutrinos
   end Neutrino_Luminosity;

   -- 3.12 Potentiel de phase
   function Engulfment_Phase (M, R : Float; Is_BH : Boolean) return Float
     with Pre => M > 0.0 and R > 0.0,
          Post => Engulfment_Phase'Result <= 0.0
   is
      R_s : Float := Schwarzschild_Radius (M);
   begin
      if Is_BH then
         return PHI_CRITICAL * (1.0 - R_s / R) * 10.0;  -- BH : phase très négative
      else
         return PHI_CRITICAL * (1.0 - R_s / (R * 1.0e6)); -- SN : phase proche de -51.1 mV
      end if;
   end Engulfment_Phase;

   -- 3.13 Cohérence
   function Engulfment_Coherence (Phi : Float) return Float
     with Pre => Phi <= 0.0,
          Post => Engulfment_Coherence'Result in 0.0 .. 100.0
   is
   begin
      if Phi >= PHI_CRITICAL then
         return 100.0;
      elsif Phi < -10.0 then
         return 0.0;
      else
         return 100.0 * (1.0 - (PHI_CRITICAL - Phi) / abs (PHI_CRITICAL));
      end if;
   end Engulfment_Coherence;

   -- 3.14 Énergie de la supernova
   function SN_Explosion_Energy (M : Float) return Float
     with Pre => M > 0.0,
          Post => SN_Explosion_Energy'Result > 0.0
   is
   begin
      return 0.1 * M * C_LIGHT * C_LIGHT * 0.01;  -- 0.1% de l'énergie de masse
   end SN_Explosion_Energy;

   -- 3.15 Taux d'accrétion de la supernova
   function SN_Accretion_Rate (M_BH, M_SN, R : Float) return Float
     with Pre => M_BH > 0.0 and M_SN > 0.0 and R > 0.0,
          Post => SN_Accretion_Rate'Result > 0.0
   is
      R_Roche : Float := Roche_Radius (M_BH, M_SN, 1.0e9);
   begin
      return 1.0e16 * (R_Roche / R) ** 1.5 * (M_SN / M_SUN);
   end SN_Accretion_Rate;

   -- ========================================================================
   -- 4. SIMULATION DE LA SUPERNOVA AVALÉE
   -- ========================================================================

   function Simulate_SN_Engulfment
     (SN_Mass_Solar, BH_Mass_Solar : Float;
      BH_Spin_Initial : Float)
      return V3_SN_Engulfment_State
     with Pre => SN_Mass_Solar > 0.0 and BH_Mass_Solar > 0.0 and
                 BH_Spin_Initial in 0.0 .. 1.0,
          Post => Simulate_SN_Engulfment'Result.Checksum = 9
   is
      State : V3_SN_Engulfment_State;
      M_SN  : Float := SN_Mass_Solar * M_SUN;
      M_BH  : Float := BH_Mass_Solar * M_SUN;
      Spin_BH : Float := BH_Spin_Initial;
      R_SN  : Float := 1.0e9 * (SN_Mass_Solar / 10.0) ** 0.5;
      R_BH  : Float := Schwarzschild_Radius (M_BH);
      T_SN  : Float := 1.0e9;  -- Température de la supernova (K)
      Z_SN  : Integer := 26;   -- Fer (point final de la fusion)
      E_SN  : Float := SN_Explosion_Energy (M_SN);
      Dist  : Float := Roche_Radius (M_BH, M_SN, R_SN) * 15.0;
      R_Roche : Float := Roche_Radius (M_BH, M_SN, R_SN);
      Time  : Float := 0.0;
      DT    : Float := 1.0e2;  -- Pas de temps (s)
      Stage : Engulfment_Stage := Pre_SN;
      Exploding : Boolean := False;
      Interacting : Boolean := False;
      Merging : Boolean := False;
      GW_Emitting : Boolean := False;
      Emitting : Boolean := False;
      E_orb : Float := 0.0;
      E_GW : Float := 0.0;
      GW_f : Float := 0.0;
      L_Lum : Float := 0.0;
      X_Lum : Float := 0.0;
      G_Lum : Float := 0.0;
      N_Lum : Float := 0.0;
      Phi_SN : Float := 0.0;
      Phi_BH : Float := 0.0;
      Coh_SN : Float := 0.0;
      Coh_BH : Float := 0.0;
      V_orb : Float := 0.0;
      Acc_Rate : Float := 0.0;
      M_rem  : Float := 0.0;
      Spin_rem : Float := 0.0;
      R_rem  : Float := 0.0;
   begin
      -- Initialisation
      State.SN_Mass_kg := M_SN;
      State.SN_Radius_m := R_SN;
      State.SN_Temperature_K := T_SN;
      State.SN_Energy_J := E_SN;
      State.SN_Element_Z := Z_SN;
      State.SN_Phase := Engulfment_Phase (M_SN, R_SN, False);
      State.BH_Mass_kg := M_BH;
      State.BH_Radius_m := R_BH;
      State.BH_Spin := Spin_BH;
      State.BH_Phase := Engulfment_Phase (M_BH, R_BH, True);
      State.Distance_m := Dist;
      State.Roche_Radius_m := R_Roche;
      State.Orbital_Energy_J := Orbital_Energy (M_BH, M_SN, Dist);
      State.GW_Frequency_Hz := 0.0;
      State.GW_Amplitude := 0.0;
      State.GW_Energy_J := 0.0;
      State.Luminosity_W := 0.0;
      State.XRay_Luminosity_W := 0.0;
      State.Gamma_Luminosity_W := 0.0;
      State.Neutrino_Luminosity_W := 0.0;
      State.Phase_Potential := (Phi_SN + Phi_BH) / 2.0;
      State.Coherence := 100.0;
      State.Time_s := Time;
      State.Time_Step_s := DT;
      State.Stage := Stage;
      State.Is_Exploding := Exploding;
      State.Is_Interacting := Interacting;
      State.Is_Merging := Merging;
      State.Has_GW := GW_Emitting;
      State.Is_Emitting := Emitting;
      State.Checksum := 9;

      -- Boucle principale de simulation
      while Dist > 0.0 and Time < 1.0e6 loop
         pragma Loop_Invariant (Time >= 0.0);
         pragma Loop_Invariant (State.Checksum = 9);

         -- Mise à jour de la distance (spirale)
         V_orb := sqrt (G_NEWTON * (M_BH + M_SN) / Dist);
         Dist := Dist - V_orb * DT * 0.01;

         -- 1. Supernova (explosion)
         if not Exploding then
            Exploding := True;
            State.Is_Exploding := True;
            Stage := SN_Explosion;
            State.Stage := Stage;

            -- Expansion de la supernova
            R_SN := R_SN * 1.5;
            T_SN := T_SN * 0.5;
            E_SN := SN_Explosion_Energy (M_SN);
            Phi_SN := Engulfment_Phase (M_SN, R_SN, False);
            Coh_SN := Engulfment_Coherence (Phi_SN);
            Emitting := True;
            State.Is_Emitting := True;
         end if;

         -- 2. Interaction gravitationnelle
         if Dist < R_Roche * 5.0 then
            Interacting := True;
            State.Is_Interacting := True;
            Stage := Approach;
            State.Stage := Stage;
            Emitting := True;
            State.Is_Emitting := True;
         end if;

         -- 3. Spirale
         if Dist < R_Roche * 3.0 then
            GW_Emitting := True;
            GW_f := GW_Frequency (M_BH, M_SN, Dist);
            E_GW := GW_Energy (M_BH, M_SN, Dist);
            State.Has_GW := True;
            Stage := Spiral;
            State.Stage := Stage;
         end if;

         -- 4. Disruption de la supernova
         if Dist < R_Roche then
            Stage := Tidal_Disruption;
            State.Stage := Stage;
            Acc_Rate := SN_Accretion_Rate (M_BH, M_SN, Dist);
            L_Lum := Accretion_Luminosity (M_BH, Acc_Rate);
            X_Lum := XRay_Luminosity (L_Lum);
            G_Lum := Gamma_Luminosity (L_Lum);
            N_Lum := Neutrino_Luminosity (L_Lum);
            Emitting := True;
            State.Is_Emitting := True;

            -- Accrétion
            M_BH := M_BH + Acc_Rate * DT * 0.1;
            R_BH := Schwarzschild_Radius (M_BH);
            Phi_BH := Engulfment_Phase (M_BH, R_BH, True);
            Coh_BH := Engulfment_Coherence (Phi_BH);

            Stage := Accretion;
            State.Stage := Stage;
         end if;

         -- 5. Fusion
         if Dist < R_BH * 2.0 then
            Merging := True;
            State.Is_Merging := True;
            Stage := Merger;
            State.Stage := Stage;

            -- Formation du remnant
            M_rem := M_BH + M_SN * 0.5;
            Spin_rem := (Spin_BH * M_BH + 0.1 * M_SN) / (M_rem);
            R_rem := Schwarzschild_Radius (M_rem);
            Stage := Remnant;
            State.Stage := Stage;

            -- Énergie finale
            L_Lum := Accretion_Luminosity (M_rem, Acc_Rate * 10.0);
            X_Lum := XRay_Luminosity (L_Lum);
            G_Lum := Gamma_Luminosity (L_Lum);
            N_Lum := Neutrino_Luminosity (L_Lum);
            Phi_BH := Engulfment_Phase (M_rem, R_rem, True);
            Coh_BH := Engulfment_Coherence (Phi_BH);
            Emitting := True;
            State.Is_Emitting := True;

            -- Évaporation
            if Time > 1.0e5 then
               Stage := Evaporation;
               State.Stage := Stage;
               M_rem := M_rem - (L_Lum / (C_LIGHT * C_LIGHT)) * DT * 0.01;
            end if;

            exit;
         end if;

         -- Mise à jour de l'état
         State.SN_Mass_kg := M_SN;
         State.SN_Radius_m := R_SN;
         State.SN_Temperature_K := T_SN;
         State.SN_Energy_J := E_SN;
         State.SN_Element_Z := Z_SN;
         State.SN_Phase := Phi_SN;
         State.BH_Mass_kg := M_BH;
         State.BH_Radius_m := R_BH;
         State.BH_Spin := Spin_BH;
         State.BH_Phase := Phi_BH;
         State.Distance_m := Dist;
         State.Roche_Radius_m := R_Roche;
         State.Orbital_Energy_J := Orbital_Energy (M_BH, M_SN, Dist);
         State.GW_Frequency_Hz := GW_f;
         State.GW_Amplitude := 0.0;
         State.GW_Energy_J := E_GW;
         State.Luminosity_W := L_Lum;
         State.XRay_Luminosity_W := X_Lum;
         State.Gamma_Luminosity_W := G_Lum;
         State.Neutrino_Luminosity_W := N_Lum;
         State.Phase_Potential := (Phi_SN + Phi_BH) / 2.0;
         State.Coherence := (Coh_SN + Coh_BH) / 2.0;
         State.Time_s := Time;
         State.Time_Step_s := DT;
         State.Stage := Stage;
         State.Is_Exploding := Exploding;
         State.Is_Interacting := Interacting;
         State.Is_Merging := Merging;
         State.Has_GW := GW_Emitting;
         State.Is_Emitting := Emitting;

         -- Incrément du temps
         Time := Time + DT;
      end loop;

      return State;
   end Simulate_SN_Engulfment;

   -- ========================================================================
   -- 5. FONCTIONS DE TEST
   -- ========================================================================

   function All_Tests_Pass (State : V3_SN_Engulfment_State) return Boolean
     with Post => All_Tests_Pass'Result in True | False
   is
   begin
      if State.Coherence < 0.0 or State.Coherence > 100.0 then
         return False;
      end if;
      if State.Distance_m < 0.0 then
         return False;
      end if;
      if State.GW_Energy_J < 0.0 then
         return False;
      end if;
      if State.Luminosity_W < 0.0 then
         return False;
      end if;
      if State.SN_Energy_J < 0.0 then
         return False;
      end if;
      if State.Phase_Potential > 0.0 then
         return False;
      end if;
      if State.Stage not in Pre_SN .. Evaporation then
         return False;
      end if;
      return True;
   end All_Tests_Pass;

   -- ========================================================================
   -- 6. PROGRAMME PRINCIPAL
   -- ========================================================================

   State : V3_SN_Engulfment_State;
   Passed : Boolean;

begin

   Put_Line ("================================================================================");
   Put_Line ("V3 SUPERNOVA ENGULFMENT SIMULATION — COMPLETE UNIFICATION");
   Put_Line ("================================================================================");
   New_Line;

   Put_Line ("INVARIANTS V3 (LOCKED — NO ADJUSTMENT ALLOWED)");
   Put_Line ("  Ψ_V3          = " & Float'Image (PSI_V3) & " kg·m⁻²");
   Put_Line ("  Φ_critical    = " & Float'Image (PHI_CRITICAL) & " V (-51.1 mV)");
   Put_Line ("  K             = " & Integer'Image (K_CYCLES));
   Put_Line ("  ρ_cond        = " & Float'Image (RHO_COND) & " kg·m⁻³");
   Put_Line ("  ν_phase       = " & Float'Image (NU_PHASE) & " Hz");
   Put_Line ("  β             = " & Float'Image (BETA));
   New_Line;

   -- ========================================================================
   -- 7. SIMULATION
   -- ========================================================================

   Put_Line ("--- SIMULATION D'UNE SUPERNOVA AVALÉE PAR UN TROU NOIR (SN = 20 M☉, BH = 10 M☉, Spin BH = 0.9) ---");
   New_Line;

   State := Simulate_SN_Engulfment (20.0, 10.0, 0.9);

   Put_Line ("Résultats de la simulation :");
   Put_Line ("  SN Masse       = " & Float'Image (State.SN_Mass_kg / M_SUN) & " M☉");
   Put_Line ("  SN Rayon       = " & Float'Image (State.SN_Radius_m / 1.0e9) & " ×10⁹ m");
   Put_Line ("  SN T           = " & Float'Image (State.SN_Temperature_K / 1.0e9) & " ×10⁹ K");
   Put_Line ("  SN Énergie     = " & Float'Image (State.SN_Energy_J / 1.0e44) & " ×10⁴⁴ J");
   Put_Line ("  SN Z           = " & Integer'Image (State.SN_Element_Z));
   Put_Line ("  SN Phase       = " & Float'Image (State.SN_Phase * 1000.0) & " mV");
   Put_Line ("  BH Masse       = " & Float'Image (State.BH_Mass_kg / M_SUN) & " M☉");
   Put_Line ("  BH Rayon       = " & Float'Image (State.BH_Radius_m) & " m");
   Put_Line ("  BH Spin        = " & Float'Image (State.BH_Spin));
   Put_Line ("  BH Phase       = " & Float'Image (State.BH_Phase * 1000.0) & " mV");
   Put_Line ("  Distance       = " & Float'Image (State.Distance_m / 1.0e3) & " km");
   Put_Line ("  Roche Rayon    = " & Float'Image (State.Roche_Radius_m / 1.0e3) & " km");
   Put_Line ("  GW Frequency   = " & Float'Image (State.GW_Frequency_Hz) & " Hz");
   Put_Line ("  GW Energy      = " & Float'Image (State.GW_Energy_J / 1.0e46) & " ×10⁴⁶ J");
   Put_Line ("  Luminosité     = " & Float'Image (State.Luminosity_W / 1.0e46) & " ×10⁴⁶ W");
   Put_Line ("  Rayons X       = " & Float'Image (State.XRay_Luminosity_W / 1.0e46) & " ×10⁴⁶ W");
   Put_Line ("  Rayons gamma   = " & Float'Image (State.Gamma_Luminosity_W / 1.0e46) & " ×10⁴⁶ W");
   Put_Line ("  Neutrinos      = " & Float'Image (State.Neutrino_Luminosity_W / 1.0e46) & " ×10⁴⁶ W");
   Put_Line ("  Phase pot.     = " & Float'Image (State.Phase_Potential * 1000.0) & " mV");
   Put_Line ("  Cohérence      = " & Float'Image (State.Coherence) & " %");
   Put_Line ("  Étape          = " & Engulfment_Stage'Image (State.Stage));
   Put_Line ("  Explosion      = " & Boolean'Image (State.Is_Exploding));
   Put_Line ("  Interaction    = " & Boolean'Image (State.Is_Interacting));
   Put_Line ("  Fusion         = " & Boolean'Image (State.Is_Merging));
   Put_Line ("  GW émis        = " & Boolean'Image (State.Has_GW));
   Put_Line ("  Émission       = " & Boolean'Image (State.Is_Emitting));
   New_Line;

   -- ========================================================================
   -- 8. TESTS
   -- ========================================================================

   Passed := All_Tests_Pass (State);

   Put_Line ("--- TOUS LES TESTS ---");
   New_Line;

   Put_Line ("  Test 1 (Cohérence)      : " & Boolean'Image (State.Coherence >= 0.0 and State.Coherence <= 100.0));
   Put_Line ("  Test 2 (Distance)       : " & Boolean'Image (State.Distance_m >= 0.0));
   Put_Line ("  Test 3 (GW Energy)      : " & Boolean'Image (State.GW_Energy_J >= 0.0));
   Put_Line ("  Test 4 (Luminosité)     : " & Boolean'Image (State.Luminosity_W >= 0.0));
   Put_Line ("  Test 5 (SN Energy)      : " & Boolean'Image (State.SN_Energy_J >= 0.0));
   Put_Line ("  Test 6 (Phase)          : " & Boolean'Image (State.Phase_Potential < 0.0));
   Put_Line ("  Test 7 (Étape)          : " & Boolean'Image (State.Stage in Pre_SN .. Evaporation));
   New_Line;

   Put_Line ("Résultat global : " & Boolean'Image (Passed));
   New_Line;

