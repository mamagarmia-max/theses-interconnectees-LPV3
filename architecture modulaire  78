   package Noyau_Contradiction is
      type Contradiction_State is record
         psi_v3         : Float := PSI_V3;
         phi_critical   : Float := PHI_CRITICAL;
         k              : Integer := K_CYCLES;
         modulo         : Integer := MODULO_9;
         coherence      : Coherence_Type := 100.0;
         checksum       : Checksum_Type := MODULO_9;
      end record
        with Predicate => Contradiction_State.checksum = MODULO_9;

      function Analyser (Q : String) return String
        with Pre  => Q'Length > 0,
             Post => Analyser'Result'Length > 0;

      function Evaluate_State (State : Contradiction_State) return String
        with Pre  => State.checksum = MODULO_9,
             Post => Evaluate_State'Result'Length > 0;
   end Noyau_Contradiction;

   package body Noyau_Contradiction is
      function Evaluate_State (State : Contradiction_State) return String is
         Contradictions : Integer := 0;
      begin
         if State.psi_v3 /= PSI_V3 then
            Contradictions := Contradictions + 1;
         end if;
         if State.phi_critical /= PHI_CRITICAL then
            Contradictions := Contradictions + 1;
         end if;
         if State.k /= K_CYCLES then
            Contradictions := Contradictions + 1;
         end if;
         if State.modulo /= MODULO_9 then
            Contradictions := Contradictions + 1;
         end if;

         if Contradictions = 0 then
            return "NOMINAL : Aucune contradiction détectée.";
         else
            return "CRITIQUE : " & Integer'Image (Contradictions) &
                   " contradiction(s) détectée(s).";
         end if;
      exception
         when others => return "CRITIQUE : Erreur d'évaluation.";
      end Evaluate_State;

      function Analyser (Q : String) return String is
         Lower : String := Q;
         State : Contradiction_State;
      begin
         for I in Lower'Range loop
            if Lower (I) in 'A' .. 'Z' then
               Lower (I) := Character'Val (Character'Pos (Lower (I)) + 32);
            end if;
         end loop;

         if Lower'Length >= 12 and then Lower (1 .. 12) = "contradicti" then
            return Evaluate_State (State);
         else
            return "CONTRADICTION : contradictions";
         end if;
      exception
         when others => return "CONTRADICTION : Erreur.";
      end Analyser;
   end Noyau_Contradiction;

