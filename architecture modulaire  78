   procedure Distributed_Rollback (State : in out NC_State)
     with Pre  => State.Checksum = MODULO_9,
          Post => State.Checksum = MODULO_9 and State.Coherence >= 90.0
   is
   begin
      for I in 1 .. K_CYCLES loop
