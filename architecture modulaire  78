                  return Synthesize (Rapport (1 .. 200));
               else
                  return "Noyau " & Registry (I).Name & " est inactif";
               end if;
            end if;
         end;
      end loop;

      return "Noyau inconnu : " & Noyau_Name;
   exception
      when others => return "Erreur de routage";
   end Query_Universal;

