         end loop;

         if Lower'Length >= 6 and then Lower (1 .. 6) = "lambda" then
            return "Λ V3 = " & Float'Image (LAMBDA_V3_COSMO) & " m⁻²";
         elsif Lower'Length >= 6 and then Lower (1 .. 6) = "rebond" then
            return "Rebond : Force = " & Float'Image (Compute_Rebound_Force (1.0e-15)) & " N";
         elsif Lower'Length >= 8 and then Lower (1 .. 8) = "matière " then
            return "Matière noire = " & Float'Image (Compute_Dark_Matter (R_HUBBLE)) & "%";
         else
            return "COSMOLOGY : lambda, rebond, matière";
         end if;
      exception
