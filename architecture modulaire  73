   package body Physics is
      function Compute_Lorentz_Gamma (V : Float) return Float is
         Beta : constant Float := V / C;
      begin
         if Beta >= 1.0 then return 1.0e100; end if;
         return 1.0 / Sqrt (1.0 - Beta * Beta);
      exception
         when others => return 1.0;
      end Compute_Lorentz_Gamma;

      function Compute_Phase_Drift (V, D : Float) return Float is
         Gamma : Float := Compute_Lorentz_Gamma (V);
         Cutoff : Float := Exp (-(D / 1.0e20) ** 2);
      begin
         return (Gamma - 1.0) * abs (PHI_CRITICAL) * (D / R_HUBBLE) * Cutoff;
      exception
         when others => return 0.0;
      end Compute_Phase_Drift;

      function Compute_Effective_Psi (V : Float) return Float is
      begin
         return PSI_V3 / Compute_Lorentz_Gamma (V);
      exception
         when others => return PSI_V3;
      end Compute_Effective_Psi;

      function Run_Tests return Boolean is
      begin
         return Compute_Phase_Drift (0.99999999 * C, 27000.0) < 1.0e-15 and
                Compute_Phase_Drift (0.999999999999999999999999 * C, 1.0e24) < 1.0e-30 and
                Compute_Phase_Drift (3874.0, 2.0e7) < 1.0e-15;
      exception
         when others => return False;
      end Run_Tests;

