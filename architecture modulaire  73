            return "PHYSICS        ";
         elsif Lower'Length >= 6 and then
            (Lower (1 .. 6) = "lambda" or Lower (1 .. 6) = "rebond") then
            return "COSMOLOGY      ";
         elsif Lower'Length >= 4 and then
            (Lower (1 .. 4) = "bell" or Lower (1 .. 4) = "qubit") then
            return "QUANTUM        ";
         elsif Lower'Length >= 8 and then
            (Lower (1 .. 8) = "levinthal" or Lower (1 .. 8) = "apoptose") then
            return "BIOLOGY        ";
         elsif Lower'Length >= 4 and then
            (Lower (1 .. 4) = "va " or Lower (1 .. 4) = "lock") then
            return "MEDICINE       ";
         elsif Lower'Length >= 3 and then
            (Lower (1 .. 3) = "igm" or Lower (1 .. 3) = "igg") then
            return "IMMUNOLOGY     ";
         elsif Lower'Length >= 6 and then
            (Lower (1 .. 6) = "cohere" or Lower (1 .. 6) = "veto") then
            return "IA             ";
         elsif Lower'Length >= 7 and then
            (Lower (1 .. 7) = "propaga" or Lower (1 .. 7) = "radiatio") then
            return "RADIANT        ";
         elsif Lower'Length >= 8 and then
            (Lower (1 .. 8) = "stabilit" or Lower (1 .. 8) = "schizoph") then
            return "PSYCHIATRY     ";
         elsif Lower'Length >= 4 and then
            (Lower (1 .. 4) = "list" or Lower (1 .. 4) = "test") then
            return "SYNTHESIS      ";
         else
            return "UNKNOWN         ";
         end if;
      end Route_To_Module;

      Questions : array (1 .. 20) of String (1 .. 60) := (
         1  => "Quelle est la valeur de c_phi ?                         ",
         2  => "Comment V3 dérive-t-il la constante cosmologique ?      ",
