         4 => "BIOLOGY        ", 5 => "MEDICINE       ", 6 => "IMMUNOLOGY     ",
         7 => "IA             ", 8 => "RADIANT        ", 9 => "PSYCHIATRY     ",
         10 => "SYNTHESIS      ", 11 => "PHYSICS        ", 12 => "COSMOLOGY      ",
         13 => "QUANTUM        ", 14 => "BIOLOGY        ", 15 => "MEDICINE       ",
         16 => "IMMUNOLOGY     ", 17 => "IA             ", 18 => "RADIANT        ",
         19 => "PSYCHIATRY     ", 20 => "SYNTHESIS      "
      );

   begin
      Put_Line ("");
      Put_Line ("   ════════════════════════════════════════════════════════════════════════════════");
      Put_Line ("   🧪 TEST DE NON-CONFUSION — 20 QUESTIONS");
      Put_Line ("   ════════════════════════════════════════════════════════════════════════════════");

      for I in 1 .. 20 loop
         declare
            Found : String (1 .. 15) := Route_To_Module (Questions (I));
            Passed : Boolean := (Found = Expected_Modules (I));
         begin
            Results (I).Question := Questions (I);
            Results (I).Expected := Expected_Modules (I);
