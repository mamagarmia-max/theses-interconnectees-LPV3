   package Quantum is
      C_PHI_QUANTUM : constant Float := (BETA * ALPHA * C) / Float (K_CYCLES);
      TAU_PHASE     : constant Float := 604_800.0;

      function Compute_Bell_S (D12, D12p, D1p2, D1p2p : Float) return Float
        with Post => Compute_Bell_S'Result >= 0.0;

      function Verify_Tsirelson (S : Float) return Boolean
        with Pre  => S >= 0.0,
             Post => Verify_Tsirelson'Result in True | False;

      function Compute_T1 (Delta_Phi : Float) return Float
        with Pre  => Delta_Phi >= 0.0,
             Post => Compute_T1'Result > 0.0;

      function Compute_T2 (Delta_Phi : Float) return Float
        with Pre  => Delta_Phi >= 0.0,
             Post => Compute_T2'Result > 0.0;

      function Compute_GHZ (D1, D2, D3 : Float) return Float
        with Post => Compute_GHZ'Result in -1.0 .. 1.0;

      function Answer (Q : String) return String
        with Pre  => Q'Length > 0,
             Post => Answer'Result'Length > 0;
   end Quantum;

   package body Quantum is
      function Compute_Bell_S (D12, D12p, D1p2, D1p2p : Float) return Float is
      begin
         return abs (Cos (D12) - Cos (D12p) + Cos (D1p2) + Cos (D1p2p));
      exception
         when others => return 0.0;
      end Compute_Bell_S;

      function Verify_Tsirelson (S : Float) return Boolean is
      begin
         return S <= 2.0 * Sqrt (2.0);
      exception
         when others => return False;
      end Verify_Tsirelson;

      function Compute_T1 (Delta_Phi : Float) return Float is
      begin
         return TAU_PHASE * Exp (Delta_Phi / abs (PHI_CRITICAL));
      exception
         when others => return TAU_PHASE;
      end Compute_T1;

      function Compute_T2 (Delta_Phi : Float) return Float is
      begin
         if Delta_Phi = 0.0 then return Float'Last; end if;
         return TAU_PHASE / (1.0 - Exp (-Delta_Phi / abs (PHI_CRITICAL)));
      exception
         when others => return Float'Last;
      end Compute_T2;

      function Compute_GHZ (D1, D2, D3 : Float) return Float is
      begin
         return Cos (D1 + D2 + D3);
      exception
         when others => return 0.0;
      end Compute_GHZ;

      function Answer (Q : String) return String is
         Lower : String := Q;
      begin
         for I in Lower'Range loop
            if Lower (I) in 'A' .. 'Z' then
               Lower (I) := Character'Val (Character'Pos (Lower (I)) + 32);
            end if;
         end loop;

         if Lower'Length >= 4 and then Lower (1 .. 4) = "bell" then
            declare S : constant Float := Compute_Bell_S (0.3927, 1.1781, 0.3927, 0.3927); begin
               return "S = " & Float'Image (S) &
                      (if Verify_Tsirelson (S) then " (OK)" else " (ÉCHEC)");
            end;
         elsif Lower'Length >= 2 and then Lower (1 .. 2) = "t1" then
            return "T₁ = " & Float'Image (Compute_T1 (10.0)) & " s";
         elsif Lower'Length >= 2 and then Lower (1 .. 2) = "t2" then
            return "T₂ = " & Float'Image (Compute_T2 (10.0)) & " s";
         elsif Lower'Length >= 5 and then Lower (1 .. 5) = "qubit" then
            return "Qubit = état de PHASE, pas superposition";
         else
            return "QUANTUM : bell, t1, t2, qubit";
         end if;
      exception
         when others => return "QUANTUM : Erreur de traitement";
      end Answer;
   end Quantum;

