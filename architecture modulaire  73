         end;
      end loop;

      New_Line;
      Put_Line ("   ✅ Correct : " & Integer'Image (Passed_Count) & "/" & Integer'Image (Total));
      if Passed_Count = Total then
         Put_Line ("   🏆 AUCUNE CONFUSION — Modules parfaitement séparés");
      else
         Put_Line ("   ❌ Confusion détectée");
      end if;
