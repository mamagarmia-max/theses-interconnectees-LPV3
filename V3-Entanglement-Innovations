   -- ========================================================================
   -- 12. AUTO-TEST DE TOUTES LES INNOVATIONS
   -- ========================================================================

   function Run_Innovations_Auto_Test return Boolean is
      Passed : Boolean := True;
      c_phi : Float := 0.0;
      xi_phase : Float := 0.0;
      S : Float := 0.0;
      T2 : Float := 0.0;
      T1 : Float := 0.0;
      GHZ : Float := 0.0;
      Diffs : array (1 .. 100) of Float := (others => 0.0);
   begin
      -- Test 1 : c_φ > 0
      c_phi := Compute_Phase_Velocity;
      if c_phi <= 0.0 then
         Passed := False;
      end if;

      -- Test 2 : ξ_phase > 0
      xi_phase := Compute_Coherence_Length;
      if xi_phase <= 0.0 then
         Passed := False;
      end if;

      -- Test 3 : S > 2 (violation de Bell)
      S := Compute_Bell_S (0.3927, 1.1781, 0.3927, 0.3927);
      if S <= 2.0 then
         Passed := False;
      end if;

      -- Test 4 : T₂ > 0
      T2 := Compute_T2 (10.0);
      if T2 <= 0.0 then
         Passed := False;
      end if;

      -- Test 5 : T₁ > 0
      T1 := Compute_T1 (10.0);
      if T1 <= 0.0 then
         Passed := False;
      end if;

      -- Test 6 : GHZ dans [-1, 1]
      GHZ := Compute_GHZ_Correlation (Diffs, 3);
      if GHZ < -1.0 or GHZ > 1.0 then
         Passed := False;
      end if;

      -- Test 7 : Tsirelson vérifié
      if not Verify_Tsirelson (S) then
         Passed := False;
      end if;

      return Passed;
   end Run_Innovations_Auto_Test;

end V3.Entanglement_Innovations;

