project V3 is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Main use ("v3_main.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnatwa",    --  All warnings
         "-gnatVa",    --  Validity checks
         "-gnat2022",  --  Ada 2022
         "-O2");       --  Optimization
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use
        ("--level=2",        --  Level 2: absence of exceptions + contracts
         "--report=all",     --  Full report
         "--warnings=error", --  Warnings treated as errors
         "--checks-as-errors");
   end Prove;
end V3;
