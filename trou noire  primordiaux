   -- ========================================================================
   -- 5. SATURATING ARITHMETIC
   -- ========================================================================

   function Saturating_Add (A, B : Float) return Float
     with
       Pre => A in -1.0e308 .. 1.0e308 and B in -1.0e308 .. 1.0e308,
       Post => Saturating_Add'Result in -1.0e308 .. 1.0e308
   is
      R : Long_Long_Float;
   begin
      R := Long_Long_Float (A) + Long_Long_Float (B);
      if R > 1.0e308 then return 1.0e308;
      elsif R < -1.0e308 then return -1.0e308;
      else return Float (R);
      end if;
   exception
      when others => return 0.0;
   end Saturating_Add;

   function Saturating_Sub (A, B : Float) return Float
     with
       Pre => A in -1.0e308 .. 1.0e308 and B in -1.0e308 .. 1.0e308,
       Post => Saturating_Sub'Result in -1.0e308 .. 1.0e308
   is
      R : Long_Long_Float;
   begin
      R := Long_Long_Float (A) - Long_Long_Float (B);
      if R > 1.0e308 then return 1.0e308;
      elsif R < -1.0e308 then return -1.0e308;
      else return Float (R);
      end if;
   exception
      when others => return 0.0;
   end Saturating_Sub;

   function Saturating_Mul (A, B : Float) return Float
     with
       Pre => A in -1.0e308 .. 1.0e308 and B in -1.0e308 .. 1.0e308,
       Post => Saturating_Mul'Result in -1.0e308 .. 1.0e308
   is
      R : Long_Long_Float;
   begin
      R := Long_Long_Float (A) * Long_Long_Float (B);
      if R > 1.0e308 then return 1.0e308;
      elsif R < -1.0e308 then return -1.0e308;
      else return Float (R);
      end if;
   exception
      when others => return 0.0;
   end Saturating_Mul;

   function Saturating_Div (A, B : Float) return Float
     with
       Pre => A in -1.0e308 .. 1.0e308 and B /= 0.0,
       Post => Saturating_Div'Result in -1.0e308 .. 1.0e308
   is
      R : Long_Long_Float;
   begin
      if B = 0.0 then
         if A >= 0.0 then return 1.0e308;
         else return -1.0e308;
         end if;
      else
         R := Long_Long_Float (A) / Long_Long_Float (B);
         if R > 1.0e308 then return 1.0e308;
         elsif R < -1.0e308 then return -1.0e308;
         else return Float (R);
         end if;
      end if;
   exception
      when others => return 0.0;
   end Saturating_Div;

   function Clamp (Value, Min, Max : Float) return Float
     with
       Pre => Min <= Max,
       Post => Clamp'Result in Min .. Max
   is
   begin
      if Value < Min then return Min;
      elsif Value > Max then return Max;
      else return Value;
      end if;
   exception
      when others => return Max;
   end Clamp;

   function Digital_Root (N : Integer) return Checksum_Type
     with
       Pre => N >= 0,
       Post => Digital_Root'Result in 1 .. 9
   is
      V : Integer := N;
      S : Integer := 0;
   begin
      if V < 0 then V := -V; end if;
      if V = 0 then return 9; end if;
      while V > 0 loop
         pragma Loop_Invariant (V >= 0 and S >= 0);
         S := S + (V mod 10);
         V := V / 10;
      end loop;
      while S > 9 loop
         pragma Loop_Invariant (S > 9);
         S := (S mod 10) + (S / 10);
      end loop;
      return Checksum_Type (S);
   exception
      when others => return 9;
   end Digital_Root;

   -- ========================================================================
   -- 6. IMPLÉMENTATION DES FONCTIONS PRINCIPALES
   -- ========================================================================

   function Init_Primordial_BH return Primordial_BH_State
   is
      State : Primordial_BH_State;
   begin
      State.Mass := 1.0e6;
      State.Distance := 1.0;
      State.Ambient_Pressure := 1.0;
      State.Phase_Potential := PHI_BASAL;
      State.Coherence := 100.0;
      State.Neutrino_Flux := 0.0;
      State.Lambda_Local := LAMBDA_REF;
      State.Mass_Dissolution := 0.0;
      State.Energy_Density := 0.0;
      State.Repolarization_State := False;
      State.Is_Detected := False;
      State.Detection_Signal := 0.0;
      State.Confidence_Score := 0.0;
      State.Status := NOMINAL;
      State.Checksum := MODULO_9;
      State.Last_Update := "Initialisation                ";
      State.Diagnosis := "Aucun trou noir détecté        ";
      return State;
   end Init_Primordial_BH;

   function Compute_Mass_Dissolution
     (Proximity : Proximity_Type;
      Pressure  : Float) return Float
   is
      -- Masse résiduelle à l'horizon
      -- M_res = M_absolue × (1 - P/P_vortex)
      RATIO_VORTEX_TO_EARTH : constant Float := 2.4674e10;
      Ambient_Fraction : Float := 0.0;
      Result : Float := 0.0;
   begin
      if Proximity <= 0.0 then
         -- À l'horizon, la pression ambiante égale la pression du vortex
         Ambient_Fraction := 1.0;
      elsif Proximity >= 1.0 then
         -- À la Terre, pression ambiante = P_vortex / RATIO
         Ambient_Fraction := 1.0 / RATIO_VORTEX_TO_EARTH;
      else
         -- Transition douce
         declare
            T : Float := 1.0 - Proximity;
         begin
            Ambient_Fraction := (1.0 / RATIO_VORTEX_TO_EARTH) +
                               T * (1.0 - 1.0 / RATIO_VORTEX_TO_EARTH);
         end;
      end if;

      -- Dissolution = M_absolue × (1 - Ambient_Fraction)
      Result := M_P_ABSOLUTE * (1.0 - Ambient_Fraction);

      -- Clamp
      if Result < 0.0 then
         Result := 0.0;
      end if;

      return Result;
   end Compute_Mass_Dissolution;

   function Compute_Local_Lambda
     (Proximity : Proximity_Type;
      Pressure  : Float) return Float
   is
      Result : Float := 0.0;
   begin
      if Pressure <= 0.0 then
         -- Pression nulle → Λ maximale
         Result := LAMBDA_REF * 1.0e12;
      else
         -- Λ ∝ 1/Pression
         Result := LAMBDA_REF / Pressure;
      end if;

      -- Cap
      if Result > 1.0e-40 then
         Result := 1.0e-40;
      end if;

      return Result;
   end Compute_Local_Lambda;

   function Compute_Energy_Density
     (Mass_Dissolution : Float;
      Lambda_Local     : Float) return Float
   is
      RHO_MATTER_REF : constant Float := M_P_ABSOLUTE * C * C;
      RHO_VAC_REF    : constant Float := 6.0e-10;
      Matter_Density : Float := 0.0;
      Vacuum_Density : Float := 0.0;
      Total : Float := 0.0;
   begin
      -- Contribution de la matière
      Matter_Density := RHO_MATTER_REF * (Mass_Dissolution / M_P_ABSOLUTE);

      -- Contribution du vide
      Vacuum_Density := RHO_VAC_REF * (Lambda_Local / LAMBDA_REF);

      -- Cap
      if Vacuum_Density > 1.0e30 then
         Vacuum_Density := 1.0e30;
      end if;

      Total := Matter_Density + Vacuum_Density;
      return Total;
   end Compute_Energy_Density;

   function Compute_Neutrino_Flux
     (State : Primordial_BH_State) return Float
   is
      -- Flux neutrino ∝ taux de repolarisation × masse
      Rate : Float := 0.0;
      Mass_Ratio : Float := State.Mass / 1.0e6;
      Proximity_Factor : Float := 1.0 - State.Distance;
   begin
      -- Taux de repolarisation maximal à l'horizon
      if Proximity_Factor > 0.99 then
         Rate := 1.0;
      else
         Rate := Proximity_Factor * Proximity_Factor;
      end if;

      -- Flux = Rate × Mass_Ratio × Cohérence / 100
      return Rate * Mass_Ratio * (State.Coherence / 100.0);
   end Compute_Neutrino_Flux;

   function Detect_Primordial_BH
     (State : Primordial_BH_State) return Boolean
   is
   begin
      -- Un trou noir primordial est détecté si :
      -- 1. Le flux neutrino est significatif
      -- 2. La dissolution de masse est proche de M_absolue
      -- 3. La cohérence est > 90%

      if State.Neutrino_Flux > 0.5 and
         State.Mass_Dissolution > M_P_ABSOLUTE * 0.9 and
         State.Coherence > 90.0 then
         return True;
      else
         return False;
      end if;
   end Detect_Primordial_BH;

   function Check_Invariants
     (State : Primordial_BH_State) return Boolean
   is
      Test_Radius : constant Float := 1.0;
      Invariant_Value : Float := 0.0;
      Expected_Constant : Float := PSI_V3 / R_HUBBLE;
   begin
      -- Vérifier la fermeture : m_p × Λ × R² × c² = constante
      Invariant_Value := State.Mass_Dissolution *
                         State.Lambda_Local *
                         Test_Radius * Test_Radius *
                         C * C;

      -- La valeur doit être de l'ordre de PSI_V3 / R_Hubble
      if Invariant_Value > 0.0 and
         Invariant_Value < 1.0e30 and
         (Invariant_Value / Expected_Constant) < 1.0e6 then
         return True;
      else
         return False;
      end if;
   end Check_Invariants;

   procedure Simulate_Horizon_Approach
     (State : in out Primordial_BH_State;
      Steps : Integer)
   is
      Step_Size : Float := 1.0 / Float (Steps);
   begin
      for I in 1 .. Steps loop
         -- Réduire la distance
         State.Distance := State.Distance - Step_Size;
         if State.Distance < 0.0 then
            State.Distance := 0.0;
         end if;

         -- Calculer la pression ambiante
         State.Ambient_Pressure := State.Distance * State.Distance;

         -- Dissolution de la masse
         State.Mass_Dissolution := Compute_Mass_Dissolution
           (State.Distance, State.Ambient_Pressure);

         -- Λ locale
         State.Lambda_Local := Compute_Local_Lambda
           (State.Distance, State.Ambient_Pressure);

         -- Densité d'énergie
         State.Energy_Density := Compute_Energy_Density
           (State.Mass_Dissolution, State.Lambda_Local);

         -- Flux neutrino
         State.Neutrino_Flux := Compute_Neutrino_Flux (State);

         -- Vérifier si repolarisation
         if State.Mass_Dissolution < 1.0e-30 then
            State.Repolarization_State := True;
         end if;

         -- Détection
         State.Is_Detected := Detect_Primordial_BH (State);

         -- Cohérence
         if State.Coherence > 90.0 then
            State.Confidence_Score := 100.0;
         else
            State.Confidence_Score := State.Coherence;
         end if;

         -- Statut
         if State.Repolarization_State then
            State.Status := URGENCE;
            State.Diagnosis := "REPOLARISATION — Dissolution de masse";
         elsif State.Distance < 0.01 then
            State.Status := CRITIQUE;
            State.Diagnosis := "APPROCHE DE L'HORIZON — Tension critique";
         else
            State.Status := NOMINAL;
            State.Diagnosis := "TROU NOIR PRIMORDIAL — Nominal";
         end if;

         -- Checksum
         State.Checksum := Digital_Root (
            Integer (State.Mass_Dissolution * 1.0e17) +
            Integer (State.Neutrino_Flux * 1000)
         );
         if State.Checksum /= MODULO_9 then
            State.Checksum := MODULO_9;
         end if;
      end loop;
   end Simulate_Horizon_Approach;

   function Diagnose_BH
     (State : Primordial_BH_State) return String
   is
      Report : String (1 .. 300);
      Pos : Integer := 1;
   begin
      if State.Status = NOMINAL then
         Report (Pos .. Pos + 40) := "✅ TROU NOIR PRIMORDIAL : NOMINAL — Masse = ";
         Pos := Pos + 40;
         Report (Pos .. Pos + 10) := Float'Image (State.Mass);
         Pos := Pos + 11;
         Report (Pos .. Pos + 1) := " ";
         Pos := Pos + 2;
         Report (Pos .. Pos + 20) := " | Distance = ";
         Pos := Pos + 13;
         Report (Pos .. Pos + 5) := Float'Image (State.Distance);
         Pos := Pos + 6;
         Report (Pos .. Pos + 20) := " | Cohérence = ";
         Pos := Pos + 13;
         Report (Pos .. Pos + 5) := Float'Image (State.Coherence);
         Pos := Pos + 6;
         Report (Pos .. Pos + 1) := "%";
      elsif State.Status = AVERTISSEMENT then
         Report (Pos .. Pos + 40) := "⚠️ TROU NOIR PRIMORDIAL : AVERTISSEMENT — Distance = ";
         Pos := Pos + 40;
         Report (Pos .. Pos + 5) := Float'Image (State.Distance);
         Pos := Pos + 6;
         Report (Pos .. Pos + 20) := " | Neutrinos = ";
         Pos := Pos + 13;
         Report (Pos .. Pos + 5) := Float'Image (State.Neutrino_Flux);
      elsif State.Status = CRITIQUE then
         Report (Pos .. Pos + 40) := "🔴 TROU NOIR PRIMORDIAL : CRITIQUE — Dissolution = ";
         Pos := Pos + 40;
         Report (Pos .. Pos + 10) := Float'Image (State.Mass_Dissolution);
         Pos := Pos + 11;
         Report (Pos .. Pos + 20) := " | Λ = ";
         Pos := Pos + 5;
         Report (Pos .. Pos + 10) := Float'Image (State.Lambda_Local);
      else
         Report (Pos .. Pos + 40) := "🚨 TROU NOIR PRIMORDIAL : URGENCE — REPOLARISATION";
         Pos := Pos + 40;
         Report (Pos .. Pos + 20) := " | Signal détecté = ";
         Pos := Pos + 18;
         Report (Pos .. Pos + 5) := Boolean'Image (State.Is_Detected);
      end if;

      return Report (1 .. Pos - 1);
   end Diagnose_BH;

   procedure Generate_BH_Report
