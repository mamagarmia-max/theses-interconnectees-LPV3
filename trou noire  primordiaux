   -- ========================================================================
   -- 1. INVARIANTS V3 (COMMUNS AVEC L'ARCHITECTURE V22.1)
   -- ========================================================================

   PSI_V3          : constant := 48016.8;          -- kg·m⁻²
   PHI_CRITICAL    : constant := -51.10;           -- mV
   PHI_BASAL       : constant := -70.00;           -- mV
   K_CYCLES        : constant := 7;                -- Fermeture heptadique
   MODULO_9        : constant := 9;                -- Intégrité structurelle
   RHO_COND        : constant := 1026.0;           -- kg·m⁻³
   BETA            : constant := 1_000_000.0;      -- 10⁶
   C               : constant := 299_792_458.0;    -- m/s
   R_HUBBLE        : constant := 1.38e26;          -- m
   LAMBDA_REF      : constant := 1.1056e-52;       -- m⁻²
   M_P_ABSOLUTE    : constant := 4.1261e-17;       -- kg

   -- ========================================================================
   -- 2. TYPES DE BASE
   -- ========================================================================

   subtype Percentage is Float range 0.0 .. 100.0;
   subtype Coherence_Type is Float range 0.0 .. 100.0;
   subtype Phase_Potential_Type is Float range -100.0 .. 0.0;
   subtype Checksum_Type is Integer range 1 .. 9;
   subtype Noyau_Status is (NOMINAL, AVERTISSEMENT, CRITIQUE, URGENCE, VETO);
   subtype Mass_Solar is Float range 1.0e5 .. 1.0e10;
   subtype Proximity_Type is Float range 0.0 .. 1.0;

   -- ========================================================================
   -- 3. STRUCTURE DU TROU NOIR PRIMORDIAL
   -- ========================================================================

   type Primordial_BH_State is record
      -- Paramètres d'entrée
      Mass                 : Mass_Solar := 1.0e6;       -- M☉
      Distance             : Proximity_Type := 1.0;     -- 1.0 = Terre, 0.0 = Horizon
      Ambient_Pressure     : Float := 1.0;              -- P/P_Terre
      Phase_Potential      : Phase_Potential_Type := PHI_BASAL;
      Coherence            : Coherence_Type := 100.0;

      -- Paramètres V3
      Neutrino_Flux        : Float := 0.0;              -- Signal longitudinal
      Lambda_Local         : Float := LAMBDA_REF;       -- m⁻²
      Mass_Dissolution     : Float := 0.0;              -- kg
      Energy_Density       : Float := 0.0;              -- J/m³
      Repolarization_State : Boolean := False;

      -- Détection
      Is_Detected          : Boolean := False;
      Detection_Signal     : Float := 0.0;
      Confidence_Score     : Percentage := 0.0;

      -- Statut
      Status               : Noyau_Status := NOMINAL;
      Checksum             : Checksum_Type := MODULO_9;
      Last_Update          : String (1 .. 30) := (others => ' ');
      Diagnosis            : String (1 .. 200) := (others => ' ');
   end record
     with Predicate => Primordial_BH_State.Checksum = MODULO_9;

   -- ========================================================================
   -- 4. FONCTIONS PRINCIPALES
   -- ========================================================================

   -- 4.1. Initialiser l'état du trou noir primordial
   function Init_Primordial_BH return Primordial_BH_State
     with
       Post => Init_Primordial_BH'Result.Checksum = MODULO_9;

   -- 4.2. Calculer la dissolution de masse à l'horizon
   function Compute_Mass_Dissolution
     (Proximity : Proximity_Type;
      Pressure  : Float) return Float
     with
       Pre => Proximity in 0.0 .. 1.0 and Pressure >= 0.0,
       Post => Compute_Mass_Dissolution'Result >= 0.0;

   -- 4.3. Calculer la constante cosmologique locale
   function Compute_Local_Lambda
     (Proximity : Proximity_Type;
      Pressure  : Float) return Float
     with
       Pre => Proximity in 0.0 .. 1.0 and Pressure >= 0.0,
       Post => Compute_Local_Lambda'Result > 0.0;

   -- 4.4. Calculer la densité d'énergie
   function Compute_Energy_Density
     (Mass_Dissolution : Float;
      Lambda_Local     : Float) return Float
     with
       Pre => Mass_Dissolution >= 0.0 and Lambda_Local > 0.0,
       Post => Compute_Energy_Density'Result >= 0.0;

   -- 4.5. Calculer le flux neutrino longitudinal
   function Compute_Neutrino_Flux
     (State : Primordial_BH_State) return Float
     with
       Pre => State.Checksum = MODULO_9,
       Post => Compute_Neutrino_Flux'Result >= 0.0;

   -- 4.6. Détecter un trou noir primordial
   function Detect_Primordial_BH
     (State : Primordial_BH_State) return Boolean
     with
       Pre => State.Checksum = MODULO_9,
       Post => Detect_Primordial_BH'Result in True | False;

   -- 4.7. Vérifier la cohérence des invariants
   function Check_Invariants
     (State : Primordial_BH_State) return Boolean
     with
       Pre => State.Checksum = MODULO_9,
       Post => Check_Invariants'Result in True | False;

   -- 4.8. Simuler l'approche de l'horizon
   procedure Simulate_Horizon_Approach
     (State : in out Primordial_BH_State;
      Steps : Integer)
     with
       Pre => State.Checksum = MODULO_9 and Steps >= 0,
       Post => State.Checksum = MODULO_9;

   -- 4.9. Diagnostiquer l'état du trou noir
   function Diagnose_BH
     (State : Primordial_BH_State) return String
     with
       Pre => State.Checksum = MODULO_9,
       Post => Diagnose_BH'Result'Length > 0;

   -- 4.10. Générer un rapport
   procedure Generate_BH_Report
     (State : in Primordial_BH_State;
      Report : out String)
     with
       Pre => State.Checksum = MODULO_9,
       Post => Report'Length > 0;

   -- 4.11. Interface IA
   function Analyser (Q : String) return String
     with
       Pre => Q'Length > 0,
       Post => Analyser'Result'Length > 0;

end Noyau_Trou_Noir_Primordial;

