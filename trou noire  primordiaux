   end Generate_BH_Report;

   -- ========================================================================
   -- 7. INTERFACE IA
   -- ========================================================================

   function Analyser (Q : String) return String
   is
      Lower : String := Q;
      State : Primordial_BH_State;
      Report : String (1 .. 2000);
   begin
      for I in Lower'Range loop
         if Lower (I) in 'A' .. 'Z' then
            Lower (I) := Character'Val (Character'Pos (Lower (I)) + 32);
         end if;
      end loop;

      State := Init_Primordial_BH;

      if Lower'Length >= 6 and then Lower (1 .. 6) = "detect" then
         State.Mass := 1.0e6;
         State.Distance := 0.001;
         State.Ambient_Pressure := State.Distance * State.Distance;
         State.Mass_Dissolution := Compute_Mass_Dissolution
           (State.Distance, State.Ambient_Pressure);
         State.Lambda_Local := Compute_Local_Lambda
           (State.Distance, State.Ambient_Pressure);
         State.Energy_Density := Compute_Energy_Density
           (State.Mass_Dissolution, State.Lambda_Local);
         State.Neutrino_Flux := Compute_Neutrino_Flux (State);
         State.Is_Detected := Detect_Primordial_BH (State);
         State.Confidence_Score := 95.0;
         Generate_BH_Report (State, Report);
         return Report (1 .. 500);

      elsif Lower'Length >= 6 and then Lower (1 .. 6) = "simule" then
         State.Mass := 1.0e6;
         State.Distance := 1.0;
         State.Coherence := 100.0;
         Simulate_Horizon_Approach (State, 100);
         Generate_BH_Report (State, Report);
         return Report (1 .. 500);

      elsif Lower'Length >= 5 and then Lower (1 .. 5) = "etat" then
         Generate_BH_Report (State, Report);
         return Report (1 .. 500);

      elsif Lower'Length >= 4 and then Lower (1 .. 4) = "diag" then
         return Diagnose_BH (State);

      elsif Lower'Length >= 4 and then Lower (1 .. 4) = "flux" then
         State.Mass := 1.0e6;
         State.Distance := 0.01;
         State.Coherence := 100.0;
         State.Neutrino_Flux := Compute_Neutrino_Flux (State);
         return "Flux neutrino : " & Float'Image (State.Neutrino_Flux) &
                " | Distance : " & Float'Image (State.Distance);

      else
         return "BH : detect, simule, etat, diag, flux";
      end if;
   exception
      when others => return "BH : Erreur interne.";
   end Analyser;

end Noyau_Trou_Noir_Primordial;

