         "   Local Λ         : " & Float'Image (State.Lambda_Local) & " m⁻²" & ASCII.LF &
         "   Energy Density  : " & Float'Image (State.Energy_Density) & " J/m³" & ASCII.LF &
         "   Repolarized     : " & Boolean'Image (State.Repolarization_State) & ASCII.LF &
         ASCII.LF &
         "🌀 NEUTRINO SIGNAL:" & ASCII.LF &
         "   Flux            : " & Float'Image (State.Neutrino_Flux) & ASCII.LF &
         "   Detected        : " & Boolean'Image (State.Is_Detected) & ASCII.LF &
         "   Confidence      : " & Float'Image (State.Confidence_Score) & "%" & ASCII.LF &
         ASCII.LF &
         "✅ STATUS:" & ASCII.LF &
         "   " & Diagnose_BH (State) & ASCII.LF &
         ASCII.LF &
