   -- ========================================================================
   -- 2. CORE TYPES
   -- ========================================================================

   -- Proton vortex structure
   type Proton_Config is record
      Z                 : Integer range 0 .. 118;   -- Atomic number
      Radius_Fm         : Float;                    -- Nuclear radius (fm, 1e-15 m)
      Pressure_GPa      : Float;                    -- Internal pressure (GPa)
      Phase_Potential_V : Float;                    -- Φ in volts
   end record;

   -- Neutron (pressure regulator)
   type Neutron_Config is record
      N                      : Integer range 0 .. 200;   -- Neutron count
      Absorbtion_Cross_Section : Float;                  -- m² (phase absorbtion)
   end record;

   -- Electron shell type (standing wave on sphere)
   type Shell_Type is (S, P, D, F);

   type Electron_Shell is record
      Kind          : Shell_Type;            -- s, p, d, f
      Principal_N   : Integer range 1 .. 7;  -- n quantum
      Subshell_L    : Integer range 0 .. 3;  -- l quantum
      Occupancy     : Integer range 0 .. 14; -- 2*(2l+1)
      Radius_Bohr   : Float;                 -- in multiples of a₀
      Phase_Shift   : Float;                 -- radians
   end record;

   type Shell_Array is array (1 .. 7) of Electron_Shell;

   -- Complete atom (V3 description)
   type Atom_V3 is record
      Symbol        : String (1 .. 3);
      Z             : Integer range 1 .. 118;
      N             : Integer range 0 .. 200;
      A             : Integer;                 -- Z + N
      Mass_Kg       : Float;                   -- Total mass (kg)
      Proton        : Proton_Config;
      Neutron       : Neutron_Config;
      Shells        : Shell_Array;
      Coherence     : Float range 0.0 .. 100.0; -- Phase coherence (%)
      Is_Stable     : Boolean;
      Phase_Group   : Integer range 1 .. 18;   -- Column in periodic table
      Phase_Period  : Integer range 1 .. 7;    -- Row in periodic table
      Checksum      : Integer range 1 .. 9 := 9;
   end record
     with Predicate => Atom_V3.Checksum = 9;

   -- Table of all 118 elements
   type Element_Table is array (1 .. 118) of Atom_V3;

   -- ========================================================================
   -- 3. CORE FUNCTIONS (Deterministic — no free parameters)
   -- ========================================================================

   -- 3.1 Nuclear radius from mass number A
   function Nuclear_Radius (A : Integer) return Float
     with Pre => A > 0,
          Post => Nuclear_Radius'Result > 0.0;

   -- 3.2 Internal pressure (V3 equation: Ψ_V3 * A² / (4π R³))
   function Internal_Pressure (Z, N : Integer; R_m : Float) return Float
     with Pre => Z >= 0 and N >= 0 and R_m > 0.0,
          Post => Internal_Pressure'Result >= 0.0;

   -- 3.3 Phase potential from radius ratio
   function Phase_Potential (R_Nucleus, R_Reference : Float) return Float
     with Pre => R_Reference > 0.0,
          Post => Phase_Potential'Result <= 0.0;

   -- 3.4 Coherence level (%)
   function Compute_Coherence (Phi : Float) return Float
     with Post => Compute_Coherence'Result in 0.0 .. 100.0;

   -- 3.5 Shell radius (Bohr-like with V3 correction)
   function Shell_Radius (n, l : Integer; Z_eff : Float) return Float
     with Pre => n > 0 and l >= 0 and Z_eff > 0.0,
          Post => Shell_Radius'Result > 0.0;

   -- 3.6 Shell occupancy (2*(2l+1))
   function Shell_Occupancy (l : Integer) return Integer
     with Pre => l in 0 .. 3,
          Post => Shell_Occupancy'Result in 0 .. 14;

   -- 3.7 Determine phase group (column) from Z
   function Phase_Group (Z : Integer) return Integer
     with Pre => Z in 1 .. 118,
          Post => Phase_Group'Result in 1 .. 18;

   -- 3.8 Determine phase period (row) from Z
   function Phase_Period (Z : Integer) return Integer
     with Pre => Z in 1 .. 118,
          Post => Phase_Period'Result in 1 .. 7;

   -- 3.9 Total electrons from shells
   function Total_Electrons (Shells : Shell_Array) return Integer
     with Post => Total_Electrons'Result >= 0;

   -- 3.10 Critical pressure for stability
   function Critical_Pressure (R_m : Float) return Float
     with Pre => R_m > 0.0,
          Post => Critical_Pressure'Result > 0.0;

   -- ========================================================================
   -- 4. PROOF OBLIGATIONS (5 hard constraints)
   -- ========================================================================

   -- Obligation 1: Nucleon number conservation (A = Z + N)
   function Check_Nucleon_Conservation (Atom : Atom_V3) return Boolean
     with Post => Check_Nucleon_Conservation'Result = (Atom.A = Atom.Z + Atom.N);

   -- Obligation 2: Charge neutrality (protons = electrons)
   function Check_Charge_Neutrality (Atom : Atom_V3) return Boolean
     with Post => Check_Charge_Neutrality'Result = (Atom.Z = Total_Electrons (Atom.Shells));

   -- Obligation 3: Stability implies coherence ≥ 90%
   function Check_Stability_Condition (Atom : Atom_V3) return Boolean
     with Post => Check_Stability_Condition'Result =
       (if Atom.Is_Stable then Atom.Coherence >= 90.0);

   -- Obligation 4: Pressure below critical threshold for stable atoms
   function Check_Pressure_Limit (Atom : Atom_V3) return Boolean
     with Post => Check_Pressure_Limit'Result =
       (if Atom.Is_Stable then Atom.Proton.Pressure_GPa < Critical_Pressure (Atom.Proton.Radius_Fm * 1.0e-15));

   -- Obligation 5: Periodicity matches 2n² rule
   function Check_Periodicity (Atom : Atom_V3) return Boolean
     with Post => Check_Periodicity'Result =
       (Atom.Phase_Period = Phase_Period (Atom.Z) and
        Atom.Phase_Group = Phase_Group (Atom.Z));

