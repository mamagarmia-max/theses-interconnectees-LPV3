   Proofs (3).Reference := 2.828;  -- Tsirelson bound
   Proofs (3).Error_Pct := abs (Proofs (3).Value - Proofs (3).Reference) /
                            Proofs (3).Reference * 100.0;
   Proofs (3).Is_Valid := Verify_Tsirelson (S_Value);
