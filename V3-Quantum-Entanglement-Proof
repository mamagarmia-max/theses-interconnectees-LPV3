                            Proofs (5).Reference * 100.0;
   Proofs (5).Is_Valid := Proofs (5).Error_Pct < 1.0;
   Proofs (5).Description := "Relaxation pour ΔΦ = 10 mV";
   Proofs (5).Checksum := MODULO_9;

   -- ========================================================================
   -- CALCUL 6 : GHZ (N corps)
   -- ========================================================================

   GHZ_Value := Compute_GHZ_Correlation (Diffs, 3);
   Proofs (6).Name := "GHZ (N corps)                ";
   Proofs (6).Value := GHZ_Value;
   Proofs (6).Reference := 1.0;
   Proofs (6).Error_Pct := abs (Proofs (6).Value - Proofs (6).Reference) /
                            Proofs (6).Reference * 100.0;
