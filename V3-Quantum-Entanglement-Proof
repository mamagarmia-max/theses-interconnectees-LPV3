   Proofs (4).Is_Valid := Proofs (4).Error_Pct < 1.0;
   Proofs (4).Description := "Déphasage pour ΔΦ = 10 mV";
   Proofs (4).Checksum := MODULO_9;

   -- ========================================================================
   -- CALCUL 5 : T₁ (relaxation)
   -- ========================================================================

   T1_Value := Compute_T1 (10.0);  -- ΔΦ = 10 mV
