pragma SPARK_Mode (On);
pragma Assertion_Policy (Check);
pragma Overflow_Mode (Strict);

with Ada.Numerics; use Ada.Numerics;
with Ada.Numerics.Elementary_Functions; use Ada.Numerics.Elementary_Functions;
with Ada.Text_IO; use Ada.Text_IO;

package V3_EM_Unified with
   SPARK_Mode => On
is

   -- ========================================================================
   -- 1. INVARIANTS V3 (constants)
   -- ========================================================================

   PSI_V3          : constant := 48016.8;          -- kg·m⁻²
   PHI_CRITICAL    : constant := -0.0511;          -- V
   RHO_COND        : constant := 1026.0;           -- kg·m⁻³
   NU_PHASE        : constant := 6.4e12;           -- Hz
   BETA            : constant := 1_000_000.0;
   C_LIGHT         : constant := 299_792_458.0;    -- m/s
   K_CYCLES        : constant := 7;

   -- Constantes physiques (CODATA)
   E_CHARGE        : constant := 1.602176634e-19;  -- C
   HBAR            : constant := 1.054571817e-34;  -- J·s
   M_P             : constant := 1.67262192e-27;   -- kg
   M_E             : constant := 9.1093837e-31;    -- kg
   K_B             : constant := 1.380649e-23;     -- J/K
   AMU             : constant := 1.66053906660e-27; -- kg

   -- ========================================================================
   -- 2. TYPES V3
   -- ========================================================================

   type Field_Type is (Electric, Magnetic, Electromagnetic);

   type Vortex_State is record
      Z               : Integer;        -- Numéro atomique
      N               : Integer;        -- Neutrons
      Radius_Fm       : Float;          -- Rayon du vortex (fm)
      Pressure_GPa    : Float;          -- Pression interne
      Phase_Potential_V : Float;        -- Potentiel de phase
      Coherence       : Float;          -- Cohérence (%)
      E_Field_Vpm     : Float;          -- Champ électrique (V/m)
      B_Field_T       : Float;          -- Champ magnétique (T)
      EM_Wavelength_m : Float;          -- Longueur d'onde EM (m)
      EM_Frequency_Hz : Float;          -- Fréquence EM (Hz)
   end record;

   type Observable_State is (Atom, Molecule, Solid, Neutron_Star, Magnetar);

   type Stress_Level is (Normal, High, Critical, Divergent);

   -- ========================================================================
   -- 3. FONCTIONS PRINCIPALES
   -- ========================================================================

   -- 3.1 Dérivation du vortex
   function Compute_Vortex (Z, N : Integer) return Vortex_State
     with Pre => Z in 1 .. 118 and N in 0 .. 200,
          Post => Compute_Vortex'Result.Coherence >= 0.0 and
                  Compute_Vortex'Result.Coherence <= 100.0;

   -- 3.2 Calcul du champ électrique (E = pression différentielle)
   function Electric_Field (V : Vortex_State) return Float
     with Post => Electric_Field'Result >= 0.0;

   -- 3.3 Calcul du champ magnétique (B = rotation de phase)
   function Magnetic_Field (V : Vortex_State) return Float
     with Post => Magnetic_Field'Result >= 0.0;

   -- 3.4 Calcul de l'onde électromagnétique (combinaison E + B)
   function EM_Wave (V : Vortex_State) return Vortex_State
     with Post => EM_Wave'Result.EM_Wavelength_m > 0.0;

   -- 3.5 Détection du stress (cohérence, pression, divergence)
   function Detect_Stress (V : Vortex_State) return Stress_Level
     with Post => Detect_Stress'Result in Normal .. Divergent;

   -- 3.6 Test à l'aveugle (prédiction pour Z, N donné)
   function Blind_Test (Z, N : Integer) return Boolean
     with Pre => Z in 1 .. 118 and N in 0 .. 200,
          Post => Blind_Test'Result = True or Blind_Test'Result = False;

   -- 3.7 Simulation jusqu'à l'état observable (magnétar)
   function Propagate_To_Observable (V : Vortex_State) return Observable_State
     with Post => Propagate_To_Observable'Result in Atom .. Magnetar;

   -- 3.8 Stress test (limite critique)
   function Stress_Test (V : Vortex_State; Factor : Float) return Boolean
     with Pre => Factor > 0.0,
          Post => Stress_Test'Result = True or Stress_Test'Result = False;

end V3_EM_Unified;

-- ============================================================================
-- IMPLÉMENTATION
-- ============================================================================

package body V3_EM_Unified with
   SPARK_Mode => On
is

   -- ========================================================================
   -- 3.1 Compute_Vortex
   -- ========================================================================

   function Compute_Vortex (Z, N : Integer) return Vortex_State is
      A        : constant Integer := Z + N;
      R_fm     : Float := 1.2 * Float (A) ** (1.0 / 3.0);
      Phi      : Float := PHI_CRITICAL * (1.0 - (R_fm * 1.0e-15) / 1.0e-10);
      Coh      : Float := 100.0;
      P_GPa    : Float := 0.0;
   begin
      if Phi < PHI_CRITICAL then
         Coh := 100.0 * (1.0 - (PHI_CRITICAL - Phi) / abs (PHI_CRITICAL));
      end if;
      if Coh > 100.0 then
         Coh := 100.0;
      end if;

      -- Pression interne (simplifiée)
      P_GPa := 1.0e6 * Float (Z * N) / Float (A);

      return Vortex_State'
        (Z => Z,
         N => N,
         Radius_Fm => R_fm,
         Pressure_GPa => P_GPa,
         Phase_Potential_V => Phi,
         Coherence => Coh,
         E_Field_Vpm => 0.0,
         B_Field_T => 0.0,
         EM_Wavelength_m => 0.0,
         EM_Frequency_Hz => 0.0);
   end Compute_Vortex;

   -- ========================================================================
   -- 3.2 Electric_Field (E = pression différentielle)
   -- ========================================================================

   function Electric_Field (V : Vortex_State) return Float is
      P_diff : Float := abs (V.Pressure_GPa - 1.0e5);  -- Différence de pression
   begin
      return P_diff * E_CHARGE / (K_B * 300.0);  -- Approximation V3
   end Electric_Field;

   -- ========================================================================
   -- 3.3 Magnetic_Field (B = rotation de phase)
   -- ========================================================================

   function Magnetic_Field (V : Vortex_State) return Float is
      Omega : Float := NU_PHASE * (Float (V.Z + V.N) / Float (V.Z)) ** 0.5;
   begin
      return Omega * V.Coherence / 1.0e12;  -- Approximation V3
   end Magnetic_Field;

   -- ========================================================================
   -- 3.4 EM_Wave (combinaison E + B)
   -- ========================================================================

   function EM_Wave (V : Vortex_State) return Vortex_State is
      E      : Float := Electric_Field (V);
      B      : Float := Magnetic_Field (V);
      Freq   : Float := NU_PHASE * (E / B) ** 0.5;
      Wav    : Float := C_LIGHT / Freq;
      Vout   : Vortex_State := V;
   begin
      Vout.E_Field_Vpm := E;
      Vout.B_Field_T := B;
      Vout.EM_Frequency_Hz := Freq;
      Vout.EM_Wavelength_m := Wav;
      return Vout;
   end EM_Wave;

   -- ========================================================================
   -- 3.5 Detect_Stress
   -- ========================================================================

   function Detect_Stress (V : Vortex_State) return Stress_Level is
   begin
      if V.Coherence < 90.0 then
         return Critical;
      elsif V.Pressure_GPa > 1.0e12 then
         return Divergent;
      elsif V.Coherence < 95.0 then
         return High;
      else
         return Normal;
      end if;
   end Detect_Stress;

   -- ========================================================================
   -- 3.6 Blind_Test (prédiction à l'aveugle)
   -- ========================================================================

   function Blind_Test (Z, N : Integer) return Boolean is
      V : Vortex_State := Compute_Vortex (Z, N);
      E : Float := Electric_Field (V);
      B : Float := Magnetic_Field (V);
      Stress : Stress_Level := Detect_Stress (V);
   begin
      -- Le test est réussi si la cohérence est > 90% et le stress n'est pas critique
      return V.Coherence > 90.0 and Stress /= Critical and Stress /= Divergent;
   end Blind_Test;

   -- ========================================================================
   -- 3.7 Propagate_To_Observable
   -- ========================================================================

   function Propagate_To_Observable (V : Vortex_State) return Observable_State is
      A : constant Integer := V.Z + V.N;
   begin
      if A <= 4 then
         return Atom;
      elsif A <= 100 then
         return Molecule;
      elsif A <= 1000 then
         return Solid;
      elsif A <= 1_000_000 then
         return Neutron_Star;
      else
         return Magnetar;
      end if;
   end Propagate_To_Observable;

   -- ========================================================================
   -- 3.8 Stress_Test (limite critique)
   -- ========================================================================

   function Stress_Test (V : Vortex_State; Factor : Float) return Boolean is
      V_Stress : Vortex_State := V;
   begin
      V_Stress.Pressure_GPa := V.Pressure_GPa * Factor;
      V_Stress.Coherence := V.Coherence / Factor;
      return Detect_Stress (V_Stress) /= Divergent;
   end Stress_Test;

end V3_EM_Unified;

-- ============================================================================
-- MAIN — EXÉCUTION DES TESTS
-- ============================================================================

with V3_EM_Unified; use V3_EM_Unified;
with Ada.Text_IO; use Ada.Text_IO;

procedure V3_EM_Main is

   -- Test à l'aveugle : 100 paires aléatoires
   function Random_Z return Integer is
      (Integer (Float'Random (Random_Seed) * 118.0) + 1);

   function Random_N (Z : Integer) return Integer is
      (Integer (Float'Random (Random_Seed) * Float (Z)));

   Seed : Ada.Numerics.Float_Random.Generator;

begin
   Ada.Numerics.Float_Random.Reset (Seed, 1);

   Put_Line ("=== TEST V3 ÉLECTRIQUE / MAGNÉTIQUE / ÉLECTROMAGNÉTIQUE ===");
   Put_Line ("Invariant Ψ_V3 = " & Float'Image (PSI_V3));
   New_Line;

   -- Test 1 : Hydrogène (Z=1, N=0)
   declare
      V : Vortex_State := Compute_Vortex (1, 0);
      EM : Vortex_State := EM_Wave (V);
   begin
      Put_Line ("1. Hydrogène (Z=1, N=0)");
      Put_Line ("   Rayon     : " & Float'Image (V.Radius_Fm) & " fm");
      Put_Line ("   Pression  : " & Float'Image (V.Pressure_GPa) & " GPa");
      Put_Line ("   Cohérence : " & Float'Image (V.Coherence) & " %");
      Put_Line ("   E (V/m)   : " & Float'Image (EM.E_Field_Vpm));
      Put_Line ("   B (T)     : " & Float'Image (EM.B_Field_T));
      Put_Line ("   λ (m)     : " & Float'Image (EM.EM_Wavelength_m));
      Put_Line ("   f (Hz)    : " & Float'Image (EM.EM_Frequency_Hz));
      Put_Line ("   Stress    : " & Stress_Level'Image (Detect_Stress (V)));
      Put_Line ("   BlindTest : " & Boolean'Image (Blind_Test (1, 0)));
      New_Line;
   end;

   -- Test 2 : Fer (Z=26, N=30)
   declare
      V : Vortex_State := Compute_Vortex (26, 30);
      EM : Vortex_State := EM_Wave (V);
   begin
      Put_Line ("2. Fer (Z=26, N=30)");
      Put_Line ("   Rayon     : " & Float'Image (V.Radius_Fm) & " fm");
      Put_Line ("   Pression  : " & Float'Image (V.Pressure_GPa) & " GPa");
      Put_Line ("   Cohérence : " & Float'Image (V.Coherence) & " %");
      Put_Line ("   E (V/m)   : " & Float'Image (EM.E_Field_Vpm));
      Put_Line ("   B (T)     : " & Float'Image (EM.B_Field_T));
      Put_Line ("   λ (m)     : " & Float'Image (EM.EM_Wavelength_m));
      Put_Line ("   f (Hz)    : " & Float'Image (EM.EM_Frequency_Hz));
      Put_Line ("   Stress    : " & Stress_Level'Image (Detect_Stress (V)));
      Put_Line ("   BlindTest : " & Boolean'Image (Blind_Test (26, 30)));
      New_Line;
   end;

   -- Test 3 : Stress Test (facteur 1000)
   declare
      V : Vortex_State := Compute_Vortex (26, 30);
      OK : Boolean := Stress_Test (V, 1000.0);
   begin
      Put_Line ("3. Stress Test (facteur 1000)");
      Put_Line ("   Résultat : " & Boolean'Image (OK));
      New_Line;
   end;

   -- Test 4 : 100 tests à l'aveugle
   declare
      Pass : Integer := 0;
      Fail : Integer := 0;
      Z, N : Integer;
   begin
      Put_Line ("4. Blind Test (100 paires aléatoires)");
      for I in 1 .. 100 loop
         Z := Random_Z;
         N := Random_N (Z);
         if Blind_Test (Z, N) then
            Pass := Pass + 1;
         else
            Fail := Fail + 1;
         end if;
      end loop;
      Put_Line ("   Pass : " & Integer'Image (Pass));
      Put_Line ("   Fail : " & Integer'Image (Fail));
      New_Line;
   end;

   -- Test 5 : Propagation jusqu'au Magnétar
   declare
      V : Vortex_State := Compute_Vortex (118, 157);  -- Og
      Obs : Observable_State := Propagate_To_Observable (V);
   begin
      Put_Line ("5. Propagation jusqu'à l'observable");
      Put_Line ("   État : " & Observable_State'Image (Obs));
      New_Line;
   end;

   Put_Line ("=== FIN DU TEST ===");
end V3_EM_Main;
