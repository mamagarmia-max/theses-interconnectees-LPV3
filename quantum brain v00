         R_Dyn : constant Float := R_HUBBLE * Scale;
         L_Dyn : constant Float := LAMBDA_V3_COSMO / (Scale * Scale);
         M_Dyn : constant Float := PSI_V3 / (R_Dyn * C * C * L_Dyn);
         Result : Float := - (M_Dyn * C * C) / (R_Dyn * R_Dyn) + L_Dyn * (R_Dyn * R_Dyn) * 4.0 * PI_V3;
      begin
         return Clamp (Result, -1.0e100, 1.0e100);
      exception
         when others => return 0.0;
      end Compute_Rebound_Force;

      function Compute_Dark_Matter (D : Float) return Float is
         Result : Float := 0.0;
      begin
         if D < 1.0e20 then Result := 0.0;
         elsif D < 1.0e21 then Result := 20.0 * (D - 1.0e20) / 9.0e20;
         elsif D < 1.0e22 then Result := 20.0 + 65.0 * (D - 1.0e21) / 9.0e21;
         else Result := 85.0 * (1.0 + (D - 1.0e22) / 1.0e24);
         end if;
         return Clamp (Result, 0.0, 100.0);
      exception
         when others => return 0.0;
      end Compute_Dark_Matter;

