         elsif Lower'Length >= 2 and then Lower (1 .. 2) = "t2" then
            return "T₂ = " & Float'Image (Compute_T2 (10.0)) & " s";
         elsif Lower'Length >= 3 and then Lower (1 .. 3) = "ghz" then
