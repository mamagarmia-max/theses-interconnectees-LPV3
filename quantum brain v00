         Result : Float := 0.0;
      begin
         if Radius_Ratio >= 1.0 then
            Result := 0.0;
         else
            Result := P_Center * (1.0 - Radius_Ratio * Radius_Ratio);
         end if;
         return Clamp (Result, 0.0, 1.0e30);
      exception
         when others => return 0.0;
      end Compute_Hydrodynamic_Pressure;

