         end loop;

         if Lower'Length >= 4 and then Lower (1 .. 4) = "bell" then
            declare S : constant Float := Compute_Bell_S (0.3927, 1.1781, 0.3927, 0.3927); begin
               return "S = " & Float'Image (S) &
