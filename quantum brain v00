         M_ABSOLUTE : constant Float := 4.1261e-17;
         Result : Float := M_ABSOLUTE * Proximity;
      begin
         if Result < 0.0 then return 0.0;
         else return Result;
         end if;
      exception
         when others => return 0.0;
      end Compute_Proton_Mass_At_Horizon;

