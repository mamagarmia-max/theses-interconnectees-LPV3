   package body Quantum is
      function Compute_Bell_S (D12, D12p, D1p2, D1p2p : Float) return Float is
         Result : Float := abs (Cos (D12) - Cos (D12p) + Cos (D1p2) + Cos (D1p2p));
      begin
         return Clamp (Result, 0.0, 10.0);
      exception
         when others => return 0.0;
      end Compute_Bell_S;

      function Verify_Tsirelson (S : Float) return Boolean is
      begin
         return S <= 2.0 * Sqrt (2.0);
      exception
         when others => return False;
      end Verify_Tsirelson;

      function Compute_T1 (Delta_Phi : Float) return Float is
         Result : Float := TAU_PHASE * Exp (Delta_Phi / abs (PHI_CRITICAL));
      begin
         return Clamp (Result, 0.0, Float'Last);
      exception
         when others => return TAU_PHASE;
      end Compute_T1;

      function Compute_T2 (Delta_Phi : Float) return Float is
         Result : Float := 0.0;
      begin
         if Delta_Phi = 0.0 then return Float'Last;
         Result := TAU_PHASE / (1.0 - Exp (-Delta_Phi / abs (PHI_CRITICAL)));
         return Clamp (Result, 0.0, Float'Last);
      exception
         when others => return Float'Last;
      end Compute_T2;

      function Compute_GHZ (D1, D2, D3 : Float) return Float is
         Result : Float := Cos (D1 + D2 + D3);
      begin
         return Clamp (Result, -1.0, 1.0);
      exception
         when others => return 0.0;
      end Compute_GHZ;

