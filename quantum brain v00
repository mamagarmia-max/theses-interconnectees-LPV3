   package body Physics is
      function Compute_Lorentz_Gamma (V : Float) return Float is
         Beta : constant Float := V / C;
      begin
         if Beta >= 1.0 then return 1.0e100; end if;
         return 1.0 / Sqrt (1.0 - Beta * Beta);
      exception
         when others => return 1.0;
      end Compute_Lorentz_Gamma;

      function Compute_Phase_Drift (V, D : Float) return Float is
         Gamma : Float := Compute_Lorentz_Gamma (V);
         Cutoff : Float := Exp (-(D / 1.0e20) ** 2);
