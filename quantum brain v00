      begin
         return Clamp (Result, 0.0, 1.0e100);
      exception
         when others => return 0.0;
      end Compute_Phase_Drift;

      function Run_Tests return Boolean is
      begin
         return Compute_Phase_Drift (0.99999999 * C, 27000.0) < 1.0e-15 and
                Compute_Phase_Drift (0.999999999999999999999999 * C, 1.0e24) < 1.0e-30 and
                Compute_Phase_Drift (3874.0, 2.0e7) < 1.0e-15;
      exception
