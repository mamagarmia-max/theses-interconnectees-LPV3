      Put_Line ("   K_CYCLES      = 7               (Fermeture heptadique)");
      Put_Line ("   RHO_COND      = 1026.0 kg·m⁻³  (Densité du condensat)");
      Put_Line ("   NU_PHASE      = 6.4e12 Hz       (Fréquence de verrouillage)");
      Put_Line ("   BETA          = 1_000_000       (Facteur d'échelle)");
      New_Line;

      Put_Line ("   📋 ANALYSE DES 100 MATÉRIAUX");
      Put_Line ("   ----------------------------------------------------------------------------");

      -- Boucle sur les 100 matériaux
      for I in 1 .. 100 loop
         Total_Count := Total_Count + 1;

         if Materials (I).Is_Valid then
            Valid_Count := Valid_Count + 1;
            Sum_Deviation := Sum_Deviation + Materials (I).Deviation;
            if Materials (I).Deviation > Max_Deviation then
               Max_Deviation := Materials (I).Deviation;
            end if;
         end if;
      end loop;

      Avg_Deviation := Sum_Deviation / Float (Valid_Count);

      -- ====================================================================
      -- 7. AFFICHAGE DES RÉSULTATS
      -- ====================================================================

