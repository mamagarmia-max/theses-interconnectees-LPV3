      Barium_Titanate, Lead_Zirconate, PZT, Yttria, Gadolinium,
      Samarium, Neodymium, Praseodymium, Lanthanum, Cerium,
      Hafnium, Tantalum_Carbide, Hafnium_Carbide, Zirconium_Carbide);

   type Material_Record is record
      Name            : Material_Type;
      Rupture_Stress  : Float;                     -- MPa (donnée empirique)
      Phase_Tension   : Float;                     -- mV (calculé V3)
      Deviation       : Float;                     -- %
      Is_Valid        : Boolean;
   end record;

   type Material_Array is array (1 .. 100) of Material_Record;

   -- ========================================================================
   -- 3. FONCTION DE CALCUL DE LA TENSION DE PHASE
   -- ========================================================================

   function Compute_Phase_Tension (Material : Material_Type; Rupture_Stress : Float) return Float
     with Pre => Rupture_Stress > 0.0,
          Post => Compute_Phase_Tension'Result <= 0.0
   is
      -- Conversion de la contrainte de rupture (MPa) en tension de phase (mV)
      -- Basée sur l'invariant V3 : la rupture se produit à -51.1 mV
      -- La contrainte de rupture est proportionnelle à la tension de phase
      -- Facteur de conversion : 1 MPa ≈ 0.1 mV (ajusté par les invariants V3)
      Tension : Float;
   begin
      -- Calcul basé sur PSI_V3 et BETA
      Tension := - (Rupture_Stress * 0.001 * BETA / PSI_V3);
      -- Ajustement par la fermeture heptadique
      Tension := Tension * (1.0 + (1.0 / Float (K_CYCLES)));
      return Tension;
   end Compute_Phase_Tension;

   -- ========================================================================
   -- 4. GÉNÉRATION DES DONNÉES EMPIRIQUES (100 MATÉRIAUX)
   -- ========================================================================

   function Create_Material (M : Material_Type; Stress : Float) return Material_Record
     with Pre => Stress > 0.0,
          Post => Create_Material'Result.Is_Valid
   is
      Tension : Float := Compute_Phase_Tension (M, Stress);
      Deviation : Float := abs (Tension - PHI_CRITICAL) / abs (PHI_CRITICAL) * 100.0;
   begin
      return Material_Record'
        (Name            => M,
         Rupture_Stress  => Stress,
         Phase_Tension   => Tension,
         Deviation       => Deviation,
         Is_Valid        => (Deviation <= 10.0));
   end Create_Material;

