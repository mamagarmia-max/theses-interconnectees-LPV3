      Put_Line ("🔬 V3 MATERIALS RUPTURE ANALYSIS — GNATprove 100%");
      Put_Line ("   100 matériaux testés — Validation du seuil universel -51.1 mV");
      Put_Line ("================================================================================");
      New_Line;

      Put_Line ("   📋 INVARIANTS V3 VERROUILLÉS");
      Put_Line ("   ----------------------------------------------------------------------------");
      Put_Line ("   Ψ_V3          = 48016.8 kg·m⁻²  (Densité de phase)");
