      Put_Line ("   Total des matériaux      : " & Integer'Image (Total_Count));
      Put_Line ("   Matériaux valides        : " & Integer'Image (Valid_Count));
      Put_Line ("   Matériaux invalides      : " & Integer'Image (Total_Count - Valid_Count));
      Put_Line ("   Écart moyen             : " & Float'Image (Avg_Deviation) & " %");
      Put_Line ("   Écart maximal           : " & Float'Image (Max_Deviation) & " %");
      New_Line;

