   -- ========================================================================

   procedure Run_Materials_Analysis
     with Global => null
   is
      Valid_Count   : Integer := 0;
      Total_Count   : Integer := 0;
      Avg_Deviation : Float := 0.0;
      Max_Deviation : Float := 0.0;
      Sum_Deviation : Float := 0.0;
