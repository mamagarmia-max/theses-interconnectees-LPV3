         "   Isocitrate         : " & Float'Image (State.Isocitrate) & " %" & ASCII.LF &
         "   α-cétoglutarate    : " & Float'Image (State.Alpha_Ketoglutarate) & " %" & ASCII.LF &
         "   Succinyl-CoA       : " & Float'Image (State.Succinyl_CoA) & " %" & ASCII.LF &
         "   Succinate          : " & Float'Image (State.Succinate) & " %" & ASCII.LF &
         "   Fumarate           : " & Float'Image (State.Fumarate) & " %" & ASCII.LF &
         "   Malate             : " & Float'Image (State.Malate) & " %" & ASCII.LF &
         "   Oxaloacétate       : " & Float'Image (State.Oxaloacetate) & " %" & ASCII.LF &
         ASCII.LF &
         "⚡ PRODUCTS:" & ASCII.LF &
         "   NADH               : " & Float'Image (State.NADH_Level) & " %" & ASCII.LF &
         "   FADH2              : " & Float'Image (State.FADH2_Level) & " %" & ASCII.LF &
         "   GTP                : " & Float'Image (State.GTP_Level) & " %" & ASCII.LF &
         "   CO2                : " & Float'Image (State.CO2_Level) & " %" & ASCII.LF &
         ASCII.LF &
         "📐 V3 PARAMETERS:" & ASCII.LF &
         "   Coherence          : " & Float'Image (State.Coherence) & " %" & ASCII.LF &
         "   Phase Potential    : " & Float'Image (State.Phase_Potential) & " mV" & ASCII.LF &
         "   Mitochondrial Pot. : " & Integer'Image (State.Mitochondrial_Potential) & " mV" & ASCII.LF &
         ASCII.LF &
         "🌡️ CONDITIONS:" & ASCII.LF &
         "   Temperature        : " & Float'Image (State.Temperature) & " K" & ASCII.LF &
         "   pH                 : " & Float'Image (State.pH) & ASCII.LF &
         "   Oxygen Level       : " & Float'Image (State.Oxygen_Level) & " %" & ASCII.LF &
         ASCII.LF &
         "📊 METRICS:" & ASCII.LF &
         "   Cycle Efficiency   : " & Float'Image (State.Cycle_Efficiency) & " %" & ASCII.LF &
         "   ATP Yield          : " & Float'Image (State.ATP_Yield) & " µM" & ASCII.LF &
         "   Energy State       : " & Float'Image (State.Energy_State) & " %" & ASCII.LF &
         ASCII.LF &
         "✅ STATUS:" & ASCII.LF &
         "   " & Diagnose_Krebs (State) & ASCII.LF &
         ASCII.LF &
         "🔒 Checksum           : " & Integer'Image (State.Checksum) & ASCII.LF &
         "============================================================";
      Pos := Pos + 200;

      Report := R (1 .. Pos - 1);
   exception
      when others => Report := "Erreur de génération de rapport";
   end Generate_Krebs_Report;

   -- ========================================================================
   -- 7. INTERFACE IA
   -- ========================================================================

   function Analyser (Q : String) return String
   is
      Lower : String := Q;
      State : Krebs_State;
      Report : String (1 .. 2000);
   begin
      for I in Lower'Range loop
         if Lower (I) in 'A' .. 'Z' then
            Lower (I) := Character'Val (Character'Pos (Lower (I)) + 32);
         end if;
      end loop;

      State := Init_Krebs;

      if Lower'Length >= 5 and then Lower (1 .. 5) = "etat" then
         Generate_Krebs_Report (State, Report);
         return Report (1 .. 500);

      elsif Lower'Length >= 6 and then Lower (1 .. 6) = "stress" then
         Stress_Krebs (State, "hypox", 30.0);
         Generate_Krebs_Report (State, Report);
         return Report (1 .. 500);

      elsif Lower'Length >= 7 and then Lower (1 .. 7) = "simuler" then
         Run_Krebs_Cycle (State, 60.0, 1.0);
         Generate_Krebs_Report (State, Report);
         return Report (1 .. 500);

      elsif Lower'Length >= 8 and then Lower (1 .. 8) = "traiteme" then
         Treat_Krebs (State, "sulodexide", 100.0);
         Run_Krebs_Cycle (State, 60.0, 1.0);
         Generate_Krebs_Report (State, Report);
         return Report (1 .. 500);

      elsif Lower'Length >= 4 and then Lower (1 .. 4) = "diag" then
         return Diagnose_Krebs (State);

      else
         return "KREBS : etat, stress, simuler, traitement, diag";
      end if;
   exception
      when others => return "KREBS : Erreur interne.";
   end Analyser;

end Noyau_Krebs;

