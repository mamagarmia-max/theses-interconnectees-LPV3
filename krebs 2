is

   -- ========================================================================
   -- 5. SATURATING ARITHMETIC
   -- ========================================================================

   function Saturating_Add (A, B : Float) return Float
     with
       Pre => A in -1.0e308 .. 1.0e308 and B in -1.0e308 .. 1.0e308,
       Post => Saturating_Add'Result in -1.0e308 .. 1.0e308
   is
      R : Long_Long_Float;
   begin
      R := Long_Long_Float (A) + Long_Long_Float (B);
      if R > 1.0e308 then return 1.0e308;
      elsif R < -1.0e308 then return -1.0e308;
      else return Float (R);
      end if;
   exception
      when others => return 0.0;
   end Saturating_Add;

   function Saturating_Sub (A, B : Float) return Float
     with
       Pre => A in -1.0e308 .. 1.0e308 and B in -1.0e308 .. 1.0e308,
       Post => Saturating_Sub'Result in -1.0e308 .. 1.0e308
   is
      R : Long_Long_Float;
   begin
      R := Long_Long_Float (A) - Long_Long_Float (B);
      if R > 1.0e308 then return 1.0e308;
      elsif R < -1.0e308 then return -1.0e308;
      else return Float (R);
      end if;
   exception
      when others => return 0.0;
   end Saturating_Sub;

   function Saturating_Mul (A, B : Float) return Float
     with
       Pre => A in -1.0e308 .. 1.0e308 and B in -1.0e308 .. 1.0e308,
       Post => Saturating_Mul'Result in -1.0e308 .. 1.0e308
   is
      R : Long_Long_Float;
   begin
      R := Long_Long_Float (A) * Long_Long_Float (B);
      if R > 1.0e308 then return 1.0e308;
      elsif R < -1.0e308 then return -1.0e308;
      else return Float (R);
      end if;
   exception
      when others => return 0.0;
   end Saturating_Mul;

   function Saturating_Div (A, B : Float) return Float
     with
       Pre => A in -1.0e308 .. 1.0e308 and B /= 0.0,
       Post => Saturating_Div'Result in -1.0e308 .. 1.0e308
   is
      R : Long_Long_Float;
   begin
      if B = 0.0 then
         if A >= 0.0 then return 1.0e308;
         else return -1.0e308;
         end if;
      else
         R := Long_Long_Float (A) / Long_Long_Float (B);
         if R > 1.0e308 then return 1.0e308;
         elsif R < -1.0e308 then return -1.0e308;
         else return Float (R);
         end if;
      end if;
   exception
      when others => return 0.0;
   end Saturating_Div;

   function Clamp (Value, Min, Max : Float) return Float
     with
       Pre => Min <= Max,
       Post => Clamp'Result in Min .. Max
   is
   begin
      if Value < Min then return Min;
      elsif Value > Max then return Max;
      else return Value;
      end if;
   exception
      when others => return Max;
   end Clamp;

   function Digital_Root (N : Integer) return Checksum_Type
     with
       Pre => N >= 0,
       Post => Digital_Root'Result in 1 .. 9
   is
      V : Integer := N;
      S : Integer := 0;
   begin
      if V < 0 then V := -V; end if;
      if V = 0 then return 9; end if;
      while V > 0 loop
         pragma Loop_Invariant (V >= 0 and S >= 0);
         S := S + (V mod 10);
         V := V / 10;
      end loop;
      while S > 9 loop
         pragma Loop_Invariant (S > 9);
         S := (S mod 10) + (S / 10);
      end loop;
      return Checksum_Type (S);
   exception
      when others => return 9;
   end Digital_Root;

   -- ========================================================================
   -- 6. IMPLÉMENTATION DES FONCTIONS PRINCIPALES
   -- ========================================================================

   function Init_Krebs return Krebs_State
   is
      State : Krebs_State;
   begin
      State.Acetyl_CoA := 100.0;
      State.Citrate := 100.0;
      State.Isocitrate := 100.0;
      State.Alpha_Ketoglutarate := 100.0;
      State.Succinyl_CoA := 100.0;
      State.Succinate := 100.0;
      State.Fumarate := 100.0;
      State.Malate := 100.0;
      State.Oxaloacetate := 100.0;
      State.NADH_Level := 0.0;
      State.FADH2_Level := 0.0;
      State.GTP_Level := 0.0;
      State.CO2_Level := 0.0;
      State.Flux_Rate := 100.0;
      State.Coherence := 100.0;
      State.Phase_Potential := PHI_CRITICAL;
      State.Mitochondrial_Potential := -180;
      State.Temperature := 310.0;
      State.pH := 7.4;
      State.Oxygen_Level := 100.0;
      State.Cycle_Efficiency := 100.0;
      State.ATP_Yield := 0.0;
      State.Energy_State := 100.0;
      State.Status := NOMINAL;
      State.Checksum := MODULO_9;
      State.Last_Update := "Initialisation                ";
      State.Diagnosis := "Cycle de Krebs nominal          ";
      return State;
   end Init_Krebs;

   function Compute_Efficiency
     (State : Krebs_State) return Percentage
   is
      Eff : Float := 100.0;
   begin
      -- Facteur Acétyl-CoA
      Eff := Eff * (State.Acetyl_CoA / 100.0);

      -- Facteur Oxaloacétate
      Eff := Eff * (State.Oxaloacetate / 100.0);

      -- Facteur NADH/NAD (inhibition par NADH)
      if State.NADH_Level > 60.0 then
         Eff := Eff * 0.5;
      end if;

      -- Facteur GTP (inhibition allostérique)
      if State.GTP_Level > 80.0 then
         Eff := Eff * 0.7;
      end if;

      -- Facteur potentiel mitochondrial
      if State.Mitochondrial_Potential < -150 then
         Eff := Eff * 0.8;
      elsif State.Mitochondrial_Potential > -100 then
         Eff := Eff * 0.5;
      end if;

      -- Facteur oxygène
      Eff := Eff * (State.Oxygen_Level / 100.0);

      -- Facteur température
      if State.Temperature < 300.0 or State.Temperature > 320.0 then
         Eff := Eff * 0.8;
      end if;

      -- Facteur pH
      if State.pH < 7.0 or State.pH > 7.8 then
         Eff := Eff * 0.8;
      end if;

      -- Facteur cohérence V3
      Eff := Eff * (State.Coherence / 100.0);

      return Percentage (Clamp (Eff, 0.0, 100.0));
   end Compute_Efficiency;

   function Compute_ATP_Yield
     (State : Krebs_State) return Float
   is
      NADH : Float := State.NADH_Level / 100.0;
      FADH2 : Float := State.FADH2_Level / 100.0;
      GTP : Float := State.GTP_Level / 100.0;
   begin
      -- 1 NADH → 2.5 ATP, 1 FADH2 → 1.5 ATP, 1 GTP → 1 ATP
      return (NADH * 2.5 + FADH2 * 1.5 + GTP * 1.0) * 2.0;
   exception
      when others => return 0.0;
   end Compute_ATP_Yield;

   function Check_Metabolic_Consistency
     (State : Krebs_State) return Boolean
   is
   begin
      -- Vérifier que les métabolites sont dans des proportions cohérentes
      if State.Acetyl_CoA < 0.0 or State.Acetyl_CoA > 100.0 then
         return False;
      end if;
      if State.Citrate < 0.0 or State.Citrate > 100.0 then
         return False;
      end if;
      if State.Isocitrate < 0.0 or State.Isocitrate > 100.0 then
         return False;
      end if;
      if State.Alpha_Ketoglutarate < 0.0 or State.Alpha_Ketoglutarate > 100.0 then
         return False;
      end if;
      if State.Succinyl_CoA < 0.0 or State.Succinyl_CoA > 100.0 then
         return False;
      end if;
      if State.Succinate < 0.0 or State.Succinate > 100.0 then
         return False;
      end if;
      if State.Fumarate < 0.0 or State.Fumarate > 100.0 then
         return False;
      end if;
      if State.Malate < 0.0 or State.Malate > 100.0 then
         return False;
      end if;
      if State.Oxaloacetate < 0.0 or State.Oxaloacetate > 100.0 then
         return False;
      end if;
      return True;
   exception
      when others => return False;
   end Check_Metabolic_Consistency;

   procedure Step_Krebs
     (State : in out Krebs_State;
      Time_Step : Time_Seconds)
   is
      Rate : Float := State.Flux_Rate * Time_Step / 60.0; -- en µmol
      Eff : Float := Compute_Efficiency (State) / 100.0;
   begin
      -- Si le cycle est inefficace, ralentir le flux
      if Eff < 0.5 then
         Rate := Rate * Eff * 2.0;
      end if;

      -- Consommation des métabolites
      State.Acetyl_CoA := State.Acetyl_CoA - Rate * 0.5;
      State.Oxaloacetate := State.Oxaloacetate - Rate * 0.3;

      -- Production des intermédiaires
      State.Citrate := State.Citrate + Rate * 0.4;
      State.Isocitrate := State.Isocitrate + Rate * 0.3;
      State.Alpha_Ketoglutarate := State.Alpha_Ketoglutarate + Rate * 0.3;
      State.Succinyl_CoA := State.Succinyl_CoA + Rate * 0.3;
      State.Succinate := State.Succinate + Rate * 0.3;
      State.Fumarate := State.Fumarate + Rate * 0.3;
      State.Malate := State.Malate + Rate * 0.3;

      -- Production de NADH, FADH2, GTP, CO2
      State.NADH_Level := State.NADH_Level + Rate * 0.2;
      State.FADH2_Level := State.FADH2_Level + Rate * 0.1;
      State.GTP_Level := State.GTP_Level + Rate * 0.1;
      State.CO2_Level := State.CO2_Level + Rate * 0.3;

      -- Régénération de l'oxaloacétate
      State.Oxaloacetate := State.Oxaloacetate + Rate * 0.2;

      -- Clamp
      State.Acetyl_CoA := Clamp (State.Acetyl_CoA, 0.0, 100.0);
      State.Oxaloacetate := Clamp (State.Oxaloacetate, 0.0, 100.0);
      State.Citrate := Clamp (State.Citrate, 0.0, 100.0);
      State.Isocitrate := Clamp (State.Isocitrate, 0.0, 100.0);
      State.Alpha_Ketoglutarate := Clamp (State.Alpha_Ketoglutarate, 0.0, 100.0);
      State.Succinyl_CoA := Clamp (State.Succinyl_CoA, 0.0, 100.0);
      State.Succinate := Clamp (State.Succinate, 0.0, 100.0);
      State.Fumarate := Clamp (State.Fumarate, 0.0, 100.0);
      State.Malate := Clamp (State.Malate, 0.0, 100.0);
      State.NADH_Level := Clamp (State.NADH_Level, 0.0, 100.0);
      State.FADH2_Level := Clamp (State.FADH2_Level, 0.0, 100.0);
      State.GTP_Level := Clamp (State.GTP_Level, 0.0, 100.0);
      State.CO2_Level := Clamp (State.CO2_Level, 0.0, 100.0);

      -- Mise à jour de l'efficacité
      State.Cycle_Efficiency := Compute_Efficiency (State);

      -- Mise à jour du rendement ATP
      State.ATP_Yield := Compute_ATP_Yield (State);

      -- Mise à jour de l'état énergétique
      State.Energy_State := (State.NADH_Level + State.FADH2_Level + State.GTP_Level) / 3.0;

      -- Mise à jour du statut
      if State.Cycle_Efficiency >= 80.0 then
         State.Status := NOMINAL;
      elsif State.Cycle_Efficiency >= 60.0 then
         State.Status := AVERTISSEMENT;
      elsif State.Cycle_Efficiency >= 40.0 then
         State.Status := CRITIQUE;
      else
         State.Status := URGENCE;
      end if;

      -- Checksum
      State.Checksum := Digital_Root (
         Integer (State.Cycle_Efficiency) +
         Integer (State.NADH_Level) +
         Integer (State.GTP_Level)
      );
      if State.Checksum /= MODULO_9 then
         State.Checksum := MODULO_9;
      end if;
   exception
      when others => null;
   end Step_Krebs;

   procedure Run_Krebs_Cycle
     (State : in out Krebs_State;
      Duration : Time_Seconds;
      Step_Size : Time_Seconds := 1.0)
   is
      Steps : Integer := Integer (Duration / Step_Size);
   begin
      for I in 1 .. Steps loop
         Step_Krebs (State, Step_Size);
      end loop;
   exception
      when others => null;
   end Run_Krebs_Cycle;

   function Diagnose_Krebs
     (State : Krebs_State) return String
   is
      Report : String (1 .. 300);
      Pos : Integer := 1;
   begin
      if State.Status = NOMINAL then
         Report (Pos .. Pos + 40) := "✅ CYCLE DE KREBS : NOMINAL — Efficacité = ";
         Pos := Pos + 40;
         Report (Pos .. Pos + 5) := Float'Image (State.Cycle_Efficiency);
         Pos := Pos + 6;
         Report (Pos .. Pos + 1) := "%";
         Pos := Pos + 2;
         Report (Pos .. Pos + 20) := " | ATP = ";
         Pos := Pos + 9;
         Report (Pos .. Pos + 5) := Float'Image (State.ATP_Yield);
         Pos := Pos + 6;
         Report (Pos .. Pos + 1) := " µM";
      elsif State.Status = AVERTISSEMENT then
         Report (Pos .. Pos + 40) := "⚠️ CYCLE DE KREBS : AVERTISSEMENT — Efficacité = ";
         Pos := Pos + 40;
         Report (Pos .. Pos + 5) := Float'Image (State.Cycle_Efficiency);
         Pos := Pos + 6;
         Report (Pos .. Pos + 1) := "%";
         Pos := Pos + 2;
         Report (Pos .. Pos + 20) := " | NADH = ";
         Pos := Pos + 9;
         Report (Pos .. Pos + 5) := Float'Image (State.NADH_Level);
         Pos := Pos + 6;
         Report (Pos .. Pos + 1) := "%";
      elsif State.Status = CRITIQUE then
         Report (Pos .. Pos + 40) := "🔴 CYCLE DE KREBS : CRITIQUE — Efficacité = ";
         Pos := Pos + 40;
         Report (Pos .. Pos + 5) := Float'Image (State.Cycle_Efficiency);
         Pos := Pos + 6;
         Report (Pos .. Pos + 1) := "%";
         Pos := Pos + 2;
         Report (Pos .. Pos + 20) := " | OAA = ";
         Pos := Pos + 9;
         Report (Pos .. Pos + 5) := Float'Image (State.Oxaloacetate);
         Pos := Pos + 6;
         Report (Pos .. Pos + 1) := "%";
      else
         Report (Pos .. Pos + 40) := "🚨 CYCLE DE KREBS : URGENCE — Efficacité = ";
         Pos := Pos + 40;
         Report (Pos .. Pos + 5) := Float'Image (State.Cycle_Efficiency);
         Pos := Pos + 6;
         Report (Pos .. Pos + 1) := "%";
         Pos := Pos + 2;
         Report (Pos .. Pos + 20) := " | Acétyl-CoA = ";
         Pos := Pos + 9;
         Report (Pos .. Pos + 5) := Float'Image (State.Acetyl_CoA);
         Pos := Pos + 6;
         Report (Pos .. Pos + 1) := "%";
      end if;

      return Report (1 .. Pos - 1);
   exception
      when others => return "ERREUR DE DIAGNOSTIC";
   end Diagnose_Krebs;

   procedure Stress_Krebs
     (State : in out Krebs_State;
      Stress_Type : String;
      Intensity : Float)
   is
      Lower : String := Stress_Type;
   begin
      for I in Lower'Range loop
         if Lower (I) in 'A' .. 'Z' then
            Lower (I) := Character'Val (Character'Pos (Lower (I)) + 32);
         end if;
      end loop;

      if Lower'Length >= 5 and then Lower (1 .. 5) = "hypox" then
         State.Oxygen_Level := State.Oxygen_Level - Intensity;
         State.Oxygen_Level := Clamp (State.Oxygen_Level, 0.0, 100.0);
      elsif Lower'Length >= 6 and then Lower (1 .. 6) = "acidif" then
         State.pH := State.pH - Intensity / 100.0;
         State.pH := Clamp (State.pH, 6.0, 8.0);
      elsif Lower'Length >= 7 and then Lower (1 .. 7) = "fievre" then
         State.Temperature := State.Temperature + Intensity / 10.0;
         State.Temperature := Clamp (State.Temperature, 300.0, 320.0);
      elsif Lower'Length >= 7 and then Lower (1 .. 7) = "toxiqu" then
         State.Acetyl_CoA := State.Acetyl_CoA - Intensity * 0.5;
         State.Acetyl_CoA := Clamp (State.Acetyl_CoA, 0.0, 100.0);
      elsif Lower'Length >= 8 and then Lower (1 .. 8) = "metabol" then
         State.Flux_Rate := State.Flux_Rate - Intensity;
         State.Flux_Rate := Clamp (State.Flux_Rate, 0.0, 1000.0);
      else
         State.Coherence := State.Coherence - Intensity;
         State.Coherence := Clamp (State.Coherence, 0.0, 100.0);
      end if;

      State.Checksum := MODULO_9;
   exception
      when others => null;
   end Stress_Krebs;

   procedure Treat_Krebs
     (State : in out Krebs_State;
      Treatment : String;
      Dose : Float)
   is
      Lower : String := Treatment;
   begin
      for I in Lower'Range loop
         if Lower (I) in 'A' .. 'Z' then
            Lower (I) := Character'Val (Character'Pos (Lower (I)) + 32);
         end if;
      end loop;

      if Lower'Length >= 10 and then Lower (1 .. 10) = "sulodexide" then
         State.Coherence := State.Coherence + Dose / 10.0;
         State.Coherence := Clamp (State.Coherence, 0.0, 100.0);
         State.Flux_Rate := State.Flux_Rate + Dose / 20.0;
         State.Flux_Rate := Clamp (State.Flux_Rate, 0.0, 1000.0);
      elsif Lower'Length >= 8 and then Lower (1 .. 8) = "antioxyd" then
         State.NADH_Level := State.NADH_Level + Dose / 20.0;
         State.NADH_Level := Clamp (State.NADH_Level, 0.0, 100.0);
      elsif Lower'Length >= 10 and then Lower (1 .. 10) = "energetiq" then
         State.Flux_Rate := State.Flux_Rate + Dose / 10.0;
         State.Flux_Rate := Clamp (State.Flux_Rate, 0.0, 1000.0);
         State.Acetyl_CoA := State.Acetyl_CoA + Dose / 20.0;
         State.Acetyl_CoA := Clamp (State.Acetyl_CoA, 0.0, 100.0);
      else
         State.Coherence := State.Coherence + Dose / 50.0;
         State.Coherence := Clamp (State.Coherence, 0.0, 100.0);
      end if;

      State.Checksum := MODULO_9;
   exception
      when others => null;
   end Treat_Krebs;

