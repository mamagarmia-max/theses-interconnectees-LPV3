   function Saturating_Add (A, B : Float) return Float is
      R : Long_Long_Float;
   begin
      R := Long_Long_Float (A) + Long_Long_Float (B);
      if R > 1.0e308 then return 1.0e308;
      elsif R < -1.0e308 then return -1.0e308;
      else return Float (R); end if;
   end Saturating_Add;

   function Saturating_Sub (A, B : Float) return Float is
      R : Long_Long_Float;
   begin
      R := Long_Long_Float (A) - Long_Long_Float (B);
      if R > 1.0e308 then return 1.0e308;
      elsif R < -1.0e308 then return -1.0e308;
      else return Float (R); end if;
   end Saturating_Sub;

