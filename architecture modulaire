class PhysicsModule:
    """Module PHYSIQUE V3 — Constantes dérivées et tests."""
    
    def __init__(self, kernel: V3Kernel):
        self.kernel = kernel
        self.checksum = kernel.MODULO_9
        
        # Constantes dérivées
        self.c_phi = self._compute_phase_velocity()
