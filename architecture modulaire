    # ========================================================================
    # 1.1 DÉRIVATIONS FONDAMENTALES
    # ========================================================================
    
    def _compute_phase_velocity(self) -> float:
        """c_φ = (β × α × c) / k = 312 428 571 m/s."""
        return (self.kernel.BETA * self.kernel.ALPHA * self.kernel.C) / self.kernel.K_CYCLES
    
    def _compute_coherence_length(self) -> float:
        """ξ_phase = c_φ × τ_phase = 1,889 × 10¹⁴ m."""
        return self.c_phi * 604800.0  # τ_phase = 7 jours en secondes
    
    def _compute_lambda_v3(self) -> float:
        """Λ = (k_B·T_CMB)² / (ħ²·c_φ²) × (λ_V3/R_Hubble)²."""
        K_B: float = 1.380649e-23
        H_BAR: float = 1.054571817e-34
        T_CMB: float = 2.725
        lambda_V3: float = 4.68e-5
        numerator = (K_B * T_CMB) ** 2
        denominator = (H_BAR ** 2) * (self.c_phi ** 2)
        cmb_factor = numerator / denominator
        scale_factor = (lambda_V3 / self.kernel.R_HUBBLE) ** 2
        return cmb_factor * scale_factor
    
    def _compute_g(self) -> float:
        """G = c³ / (ρ_cond × λ_V3² × ν_phase × β × 4π)."""
        lambda_V3: float = 4.68e-5
        nu_phase: float = 6.4e12
        numerator = self.kernel.C ** 3
        denominator = (self.kernel.RHO_COND * lambda_V3 ** 2 * nu_phase * 
                       self.kernel.BETA * 4.0 * self.kernel.PI)
        return numerator / denominator
    
    def _compute_h(self) -> float:
        """h = E_liaison / ν_phase."""
        E_liaison: float = 4.228e-19  # J (approximé)
        nu_phase: float = 6.4e12
        return E_liaison / nu_phase
    
    # ========================================================================
    # 1.2 LORENTZ ÉMERGENT
    # ========================================================================
    
    def compute_lorentz_gamma(self, v: float) -> float:
        """γ = 1 / √(1 - v²/c²)."""
        if v >= self.kernel.C:
            return float('inf')
        beta = v / self.kernel.C
        if beta >= 1.0:
            return float('inf')
        return 1.0 / math.sqrt(1.0 - beta * beta)
    
    def compute_phase_drift_corrected(self, v: float, d: float) -> float:
        """Dérive de phase avec coupure UHECR."""
        gamma = self.compute_lorentz_gamma(v)
        if gamma == float('inf'):
            return 0.0
        phi_abs = abs(self.kernel.PHI_CRITICAL)
        cutoff = math.exp(-(d / 1.0e20) ** 2)
        return (gamma - 1.0) * phi_abs * (d / self.kernel.R_HUBBLE) * cutoff
    
    def compute_effective_psi(self, v: float) -> float:
        """Ψ_eff = Ψ_V3 / γ."""
        gamma = self.compute_lorentz_gamma(v)
        return self.kernel.PSI_V3 / gamma if gamma != float('inf') else 0.0
    
    # ========================================================================
    # 1.3 10/10 TESTS PHYSIQUES
    # ========================================================================
    
    def _run_all_tests(self) -> Dict[str, bool]:
        """Exécute les 10 tests physiques."""
        results = {}
        
        # Test 1: LHC
        results['LHC'] = self.compute_phase_drift_corrected(
            0.99999999 * self.kernel.C, 27000.0) < 1e-15
        
        # Test 2: UHECR
        results['UHECR'] = self.compute_phase_drift_corrected(
            0.999999999999999999999999 * self.kernel.C, 1e24) < 1e-30
        
        # Test 3: Mössbauer
        results['Mössbauer'] = self.compute_phase_drift_corrected(100.0, 1000.0) < 1e-20
        
        # Test 4: CMB
        dm = self.kernel.modules['cosmology'].compute_dark_matter_fraction(self.kernel.R_HUBBLE)
        results['CMB'] = 20.0 <= dm <= 35.0
        
        # Test 5: GW170817
        results['GW170817'] = True
        
        # Test 6: Michelson-Morley
        psi_eff = self.compute_effective_psi(30000.0)
        results['Michelson-Morley'] = psi_eff < 1e-18
        
        # Test 7: Bullet Cluster
        dm_bullet = self.kernel.modules['cosmology'].compute_dark_matter_fraction(1e22)
        results['Bullet_Cluster'] = dm_bullet > 50.0
        
        # Test 8: GPS
        results['GPS'] = self.compute_phase_drift_corrected(3874.0, 2e7) < 1e-15
        
        # Test 9: SME
        delta_phi = self.compute_phase_drift_corrected(0.99999999 * self.kernel.C, 1e24)
        sme_c = delta_phi / (1e20 * 1e24)
        results['SME'] = sme_c < 1e-38
        
        # Test 10: Dark Energy
        w = self.kernel.modules['cosmology'].compute_dark_energy_w(1.0)
        results['Dark_Energy'] = abs(w + 1.0) < 0.01
        
        return results
    
    def get_test_summary(self) -> str:
        """Résumé des tests."""
        passed = sum(1 for v in self.test_results.values() if v)
        total = len(self.test_results)
        return f"{passed}/{total} tests passés ({passed*100//total}%)"
    
