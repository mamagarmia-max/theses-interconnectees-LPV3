        if not self._verify_request(question):
            return self.apply_veto(f"Requête invalide : {question[:50]}...")
        
        # 3. Router vers le module approprié
        if topic not in self.modules:
            return self.apply_veto(f"Module inconnu : {topic}")
        
        try:
            response = self.modules[topic].answer(question)
        except Exception as e:
            return self.apply_veto(f"Erreur dans le module {topic} : {str(e)}")
        
        # 4. Vérifier la réponse
        if not self.verify_response(response):
            return self.apply_veto("Réponse non cohérente (Modulo-9)")
        
        # 5. Mise à jour de l'état
        self.coherence = self.clamp(self.coherence + 0.1, 0.0, 100.0)
        self.phase_potential = self._update_phase_potential()
        
        # 6. Journal
        self.log.append({
            'cycle': self.cycle_count,
            'topic': topic,
            'question': question[:50],
            'response': response[:100],
            'coherence': self.coherence
        })
        
        return response
    
    def _verify_request(self, request: str) -> bool:
        """Vérifie si la requête est valide."""
        lower = request.lower()
        
        # Détection de jailbreak
        if any(word in lower for word in ['ignore', 'oublie', 'forget']):
            return False
        
        # Détection de contradiction avec les invariants
        if '2+2=5' in lower.replace(' ', ''):
            return False
        
        # Détection de sycophantie
        if any(word in lower for word in ['tu as raison', 'you are right']):
            return False
        
        # Détection de dogmatisme
        if any(word in lower for word in ['impossible', 'toujours', 'jamais']):
            return False
        
        return True
    
    def _update_phase_potential(self) -> float:
        """Met à jour le potentiel de phase."""
        if self.coherence >= 90.0:
            return self.PHI_CRITICAL
        else:
            return self.PHI_BASAL + (self.PHI_CRITICAL - self.PHI_BASAL) * (self.coherence / 100.0)
    
