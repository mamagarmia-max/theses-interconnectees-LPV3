class CosmologyModule:
    """Module COSMOLOGIE V3 — Λ, rebond, paroi, matière noire."""
    
    def __init__(self, kernel: V3Kernel):
        self.kernel = kernel
        self.checksum = kernel.MODULO_9
        
        # Constantes dérivées
        self.lambda_v3 = self._compute_lambda()
        self.m_proton_abs = self._compute_proton_mass_abs()
    
    # ========================================================================
    # 2.1 Λ DÉRIVÉE DE Ψ_V3
    # ========================================================================
    
    def _compute_lambda(self) -> float:
        """Λ = Ψ_V3 / (R_Hubble × c² × ρ_cond)."""
        numerator = self.kernel.PSI_V3
        denominator = (self.kernel.R_HUBBLE * self.kernel.C ** 2 * self.kernel.RHO_COND)
        return numerator / denominator
    
    def _compute_proton_mass_abs(self) -> float:
        """m_p_abs = Ψ_V3 / (R × c² × Λ)."""
        return self.kernel.PSI_V3 / (self.kernel.R_HUBBLE * self.kernel.C ** 2 * self.lambda_v3)
    
    # ========================================================================
    # 2.2 REBOND COSMIQUE (SINGULARITÉ ÉLIMINÉE)
    # ========================================================================
    
    def compute_rebound_force(self, scale_factor: float) -> float:
        """Force de rebond à scale_factor donné."""
        if scale_factor <= 0.0:
            return float('inf')
        
        R_dyn = self.kernel.R_HUBBLE * scale_factor
        Lambda_dyn = self.lambda_v3 / (scale_factor ** 2)
        m_p_dyn = self.kernel.PSI_V3 / (R_dyn * self.kernel.C ** 2 * Lambda_dyn)
        
        F_grav = - (m_p_dyn * self.kernel.C ** 2) / (R_dyn ** 2)
        F_tension = Lambda_dyn * (R_dyn ** 2) * 4.0 * self.kernel.PI
        
        return F_grav + F_tension
    
    def compute_proton_mass_dynamic(self, scale_factor: float) -> float:
        """m_p_dyn = Ψ_V3 / (R × c² × Λ_dyn)."""
        R_dyn = self.kernel.R_HUBBLE * scale_factor
        Lambda_dyn = self.lambda_v3 / (scale_factor ** 2)
        return self.kernel.PSI_V3 / (R_dyn * self.kernel.C ** 2 * Lambda_dyn)
    
    # ========================================================================
    # 2.3 PAROI COSMIQUE — MEMBRANE HEPTADIQUE (k=7)
    # ========================================================================
    
    def compute_surface_tension(self, radius_ratio: float) -> float:
        """Tension de surface de la paroi cosmique."""
        if radius_ratio >= 1.0:
            return float(self.kernel.K_CYCLES)
        elif radius_ratio > 0.9:
            t = (radius_ratio - 0.9) / 0.1
            return float(self.kernel.K_CYCLES) * t * t
        return 0.0
    
    def compute_hydrodynamic_pressure(self, radius_ratio: float) -> float:
        """Pression hydrodynamique du condensat H₃O₂."""
        P_center = self.kernel.PSI_V3 * self.kernel.C ** 2 / self.kernel.R_HUBBLE
        if radius_ratio >= 1.0:
            return 0.0
        return P_center * (1.0 - radius_ratio ** 2)
    
    # ========================================================================
    # 2.4 MATIÈRE NOIRE = PRESSION DE PHASE
    # ========================================================================
    
    def compute_dark_matter_fraction(self, distance: float) -> float:
        """Fraction de matière noire avec découplage (Bullet Cluster)."""
        if distance < 1.0e20:
            return 0.0
        elif distance < 1.0e21:
            return 20.0 * (distance - 1.0e20) / 9.0e20
        elif distance < 1.0e22:
            return 20.0 + 65.0 * (distance - 1.0e21) / 9.0e21
        else:
            separation = 1.0 + (distance - 1.0e22) / 1.0e24
            return min(85.0 * separation, 95.0)
    
    def compute_phase_pressure(self, distance: float) -> float:
        """Pression de phase (matière noire)."""
        return abs(self.kernel.PHI_CRITICAL) * (distance / self.kernel.R_HUBBLE)
    
    # ========================================================================
    # 2.5 ÉNERGIE SOMBRE = TENSION DE PHASE
    # ========================================================================
    
    def compute_dark_energy_w(self, scale_factor: float) -> float:
        """Équation d'état : w = -1 + ε × ln(a)."""
        if scale_factor <= 0.0:
            return -1.0
        return -1.0 + 0.001 * math.log(scale_factor)
    
    def compute_phase_tension(self, scale_factor: float) -> float:
        """Tension de phase (énergie sombre)."""
        return self.lambda_v3 * (scale_factor ** 2)
    
    # ========================================================================
    # 2.6 INTERFACE — RÉPONDRE AUX QUESTIONS
    # ========================================================================
    
