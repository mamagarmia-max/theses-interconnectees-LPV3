    @staticmethod
    def digital_root(n: float) -> int:
        """Racine numérique (Modulo-9). Retourne 1..9."""
        val: int = int(abs(n))
        if val == 0:
            return 9
        return 1 + (val - 1) % 9
    
    @staticmethod
    def clamp(x: float, min_val: float, max_val: float) -> float:
        """Saturation d'une valeur entre min et max."""
        return max(min_val, min(max_val, x))
    
    @staticmethod
    def saturating_add(a: float, b: float, max_val: float = 1e308) -> float:
        """Addition saturée."""
        r = a + b
        return V3Kernel.clamp(r, -max_val, max_val)
    
    @staticmethod
    def saturating_mul(a: float, b: float, max_val: float = 1e308) -> float:
        """Multiplication saturée."""
        r = a * b
        return V3Kernel.clamp(r, -max_val, max_val)
    
