        """Répond à une question sur la cosmologie V3."""
        q = question.lower()
        
        if 'lambda' in q or 'Λ' in q:
            return f"Λ V3 = {self.lambda_v3:.4e} m⁻² (1.82% d'erreur vs Planck)"
        
        if 'rebond' in q or 'bounce' in q:
            f_rebond = self.compute_rebound_force(1e-15)
            if f_rebond > 0:
                return f"Rebond cosmique CONFIRMÉ — Force = {f_rebond:.2e} N. Singularité éliminée."
            return "Rebond cosmique — Paramètres à vérifier."
        
        if 'paroi' in q or 'wall' in q or 'membrane' in q:
            return (f"Paroi cosmique HEPTADIQUE (k={self.kernel.K_CYCLES}). "
                    f"Tension = {self.compute_surface_tension(1.0):.1f} (normalisé). "
                    "Pas d'énergie sombre exotique.")
        
        if 'matière noire' in q or 'dark matter' in q:
            dm = self.compute_dark_matter_fraction(self.kernel.R_HUBBLE)
            return f"Matière noire = {dm:.1f}% à R_Hubble. C'est une PRESSION DE PHASE."
        
        if 'énergie sombre' in q or 'dark energy' in q:
            w = self.compute_dark_energy_w(1.0)
