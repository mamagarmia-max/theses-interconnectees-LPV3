# RÔLE : ADN = ANTENNE, MICROTUBULES = FIBRES OPTIQUES
#   - ADN solénoïde (inductance = 12)
#   - Microtubules = réseau heptadique (k=7)
#   - Ionos-Shield à Φ_critical
#   - Rollback distribué (pas de contrôle global)
# ============================================================================

class RadiantModule:
    """Module GÉNOME RADIANT — ADN, microtubules, Ionos-Shield."""
    
    def __init__(self, kernel: V3Kernel, n_nodes: int = 1000):
        self.kernel = kernel
        self.checksum = kernel.MODULO_9
        
        # Paramètres
        self.n_nodes = n_nodes
        self.inductance = 1.2
        
        # ADN Solénoïde (antenne quantique)
        self.photon_signal = 0.0
        
        # Réseau de microtubules
        self.potentials = [kernel.PHI_CRITICAL] * n_nodes
        self.neighbors = self._build_heptadic_topology()
        
        # État
        self.coherence = 100.0
        self.stability = 100.0
        self.cycle_count = 0
        self.radiation_detected = False
        self.rollback_cycles = 0
    
    # ========================================================================
    # 7.1 TOPOLOGIE HEPTADIQUE (k=7)
    # ========================================================================
    
    def _build_heptadic_topology(self) -> List[List[int]]:
        """Construit un réseau heptadique (k=7 voisins par nœud)."""
        neighbors = [[] for _ in range(self.n_nodes)]
        for i in range(self.n_nodes):
            for offset in range(1, self.kernel.K_CYCLES // 2 + 1):
                right = (i + offset) % self.n_nodes
                if right not in neighbors[i]:
                    neighbors[i].append(right)
                left = (i - offset) % self.n_nodes
                if left not in neighbors[i]:
                    neighbors[i].append(left)
            while len(neighbors[i]) < self.kernel.K_CYCLES:
                far = (i + self.kernel.K_CYCLES) % self.n_nodes
                if far not in neighbors[i]:
                    neighbors[i].append(far)
        return neighbors
    
    # ========================================================================
    # 7.2 ADN SOLÉNOÏDE — ANTENNE QUANTIQUE
    # ========================================================================
    
    def metabolize(self, energy_input: float) -> float:
        """Conversion de l'énergie métabolique en signal photonique."""
        self.photon_signal = energy_input * self.inductance
        return self.photon_signal
    
    # ========================================================================
    # 7.3 PROPAGATION DE L'ONDE DE COHÉRENCE
    # ========================================================================
    
    def propagate(self, energy: float = 10.0):
        """Propagation de l'onde de cohérence solitonique."""
        self.cycle_count += 1
        
        # 1. Métabolisme → signal photonique
        signal = self.metabolize(energy)
        
        # 2. Propagation dans les microtubules (locale, sans forçage)
        new_potentials = self.potentials[:]
        for i in range(self.n_nodes):
            diff_sum = sum(self.potentials[nb] - self.potentials[i] 
                          for nb in self.neighbors[i])
            delta = 0.3 * diff_sum / self.kernel.K_CYCLES
            new_potentials[i] += delta + signal * 0.01
        self.potentials = new_potentials
        
        # 3. Mise à jour de la stabilité
        self.stability = self.compute_stability_index()
        self.coherence = self.stability
    
    # ========================================================================
    # 7.4 RADIATION ET ROLLBACK DISTRIBUÉ
    # ========================================================================
    
    def inject_radiation(self, start_idx: int, end_idx: int):
        """Injection de radiation (perturbation externe)."""
        for i in range(start_idx, min(end_idx, self.n_nodes)):
            self.potentials[i] = random.uniform(-500.0, 500.0)
        self.radiation_detected = True
    
    def distributed_rollback(self):
        """
        Rollback distribué — chaque nœud avec ses 7 voisins.
        PAS de contrôle global. PAS de facteur *0.5.
        """
        corrections = [0.0] * self.n_nodes
        for i in range(self.n_nodes):
            neighbor_avg = sum(self.potentials[nb] for nb in self.neighbors[i]) / self.kernel.K_CYCLES
            diff_to_target = self.kernel.PHI_CRITICAL - self.potentials[i]
            corrections[i] = 0.2 * diff_to_target + 0.3 * (neighbor_avg - self.potentials[i])
        for i in range(self.n_nodes):
            self.potentials[i] += corrections[i]
        self.rollback_cycles += 1
    
    def restore_after_radiation(self) -> int:
        """
        Restauration complète après radiation.
        Retourne le nombre de cycles nécessaires (≤ 7).
        """
        cycles = 0
        while cycles < self.kernel.K_CYCLES and not self.is_converged():
            self.distributed_rollback()
            cycles += 1
            # Propagation continue pendant le rollback
            self.propagate(10.0)
        return cycles
    
    # ========================================================================
    # 7.5 STABILITÉ ET CONVERGENCE
    # ========================================================================
    
    def compute_stability_index(self) -> float:
        """Indice de stabilité (% de nœuds à moins de 1 mV de Φ_critical)."""
        stable = sum(1 for p in self.potentials 
                    if abs(p - self.kernel.PHI_CRITICAL) < 1.0)
        return (stable / self.n_nodes) * 100.0
    
    def is_converged(self) -> bool:
        """Vérifie la convergence (stabilité > 95%)."""
        return self.compute_stability_index() >= 95.0
    
    # ========================================================================
    # 7.6 INTERFACE — RÉPONDRE AUX QUESTIONS
    # ========================================================================
    
    def answer(self, question: str) -> str:
        """Répond à une question sur le génome radiant."""
        q = question.lower()
        
        if 'stabilité' in q or 'stability' in q:
            return f"Stabilité de l'Ionos-Shield : {self.stability:.1f}%"
        
        if 'radiation' in q:
            if not self.radiation_detected:
                return "Aucune radiation détectée. Système stable."
            cycles = self.restore_after_radiation()
            return f"Radiation détectée. Restauration en {cycles} cycles (≤ k=7)."
        
        if 'rollback' in q:
            return (f"Rollback distribué — {self.rollback_cycles} cycles. "
                    f"Chaque nœud se corrige avec ses 7 voisins.")
        
        if 'adn' in q or 'dna' in q:
            return (f"ADN Solénoïde — Inductance = {self.inductance}. "
                    f"Signal photonique = {self.photon_signal:.2f}")
        
        if 'microtubule' in q or 'tubuline' in q:
            return (f"Réseau de {self.n_nodes} microtubules. "
                    f"Topologie heptadique (k={self.kernel.K_CYCLES}). "
                    f"Propagation de l'onde de cohérence.")
        
        if 'ionos' in q or 'shield' in q:
            return (f"Ionos-Shield à Φ_critical = {self.kernel.PHI_CRITICAL:.2f} mV. "
                    f"Stabilité : {self.stability:.1f}%")
        
        if 'coherence' in q:
            return f"Cohérence du génome radiant : {self.coherence:.1f}%"
        
        return ("Questions disponibles : stabilité, radiation, rollback, adn, "
                "microtubule, ionos, coherence")


