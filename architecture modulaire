    def verify_checksum(self, value: Any) -> bool:
        """Vérifie que le checksum Modulo-9 = 9."""
        if hasattr(value, 'checksum'):
            return getattr(value, 'checksum') == self.MODULO_9
        if isinstance(value, str):
            return self.digital_root(len(value)) == self.MODULO_9
        if isinstance(value, (int, float)):
            return self.digital_root(value) == self.MODULO_9
        return True
    
    def verify_response(self, response: str) -> bool:
