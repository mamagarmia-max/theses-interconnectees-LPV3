   procedure Configure_Diamond (Cell : in out Unit_Cell)
     with Pre => True,
          Post => Cell.Atom_Count > 0
   is
   begin
      -- Structure diamant (FCC + base tétraédrique)
      Add_Atom (Cell, 0.0, 0.0, 0.0, 'C', 4, 99.5);
      Add_Atom (Cell, 0.5, 0.5, 0.0, 'C', 4, 99.5);
      Add_Atom (Cell, 0.5, 0.0, 0.5, 'C', 4, 99.5);
