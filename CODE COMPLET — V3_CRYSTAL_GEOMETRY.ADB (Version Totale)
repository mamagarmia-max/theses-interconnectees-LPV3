      Add_Atom (Cell, 0.0, 0.0, 0.5, 'C', 3, 95.0);
      Add_Atom (Cell, 0.333, 0.667, 0.5, 'C', 3, 95.0);
      Add_Atom (Cell, 0.667, 0.333, 0.5, 'C', 3, 95.0);
   end Configure_Graphite;

