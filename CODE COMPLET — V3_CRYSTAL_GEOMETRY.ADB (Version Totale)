   type Cell_Array is array (1 .. 20) of Unit_Cell;

   -- ========================================================================
   -- 5. FONCTIONS DE CALCUL
   -- ========================================================================

   -- 5.1 Cohérence de phase (avec pression et température)
   function Compute_Phase_Coherence
     (Temperature_K : Float;
      Pressure_Pa   : Float) return Float
     with Pre => Temperature_K >= 0.0 and Pressure_Pa >= 0.0,
          Post => Compute_Phase_Coherence'Result in 0.0 .. 100.0
   is
      -- Facteur température : plus T est élevée, plus la cohérence diminue
      T_factor : Float := 1.0 - (Temperature_K - T_REF) / 1000.0;

      -- Facteur pression : plus P est élevée, plus la cohérence augmente
      P_factor : Float := 1.0 + (Pressure_Pa / P_ATM) * 0.001;

      Coh : Float;
   begin
      if T_factor < 0.0 then
         T_factor := 0.0;
      end if;

      if P_factor > 2.0 then
         P_factor := 2.0;
      end if;

      Coh := 100.0 * T_factor * P_factor;

      if Coh > 100.0 then
         return 100.0;
      else
         return Coh;
      end if;
   end Compute_Phase_Coherence;

   -- 5.2 Détermination de l'état de stabilité
   function Determine_State (Coherence : Float) return Stability_State
     with Pre => Coherence in 0.0 .. 100.0
   is
   begin
      if Coherence >= 90.0 then
         return Stable;
      elsif Coherence >= 50.0 then
         return Critical;
      elsif Coherence >= 10.0 then
         return Unstable;
      else
         return Broken;
      end if;
   end Determine_State;

   -- 5.3 Calcul du potentiel de phase
   function Compute_Phase_Potential (Coherence : Float) return Float
     with Pre => Coherence in 0.0 .. 100.0,
          Post => Compute_Phase_Potential'Result <= 0.0
   is
   begin
      -- Φ = -51.1 mV × (1 - Coh/100)
      return PHI_CRITICAL * (1.0 - Coherence / 100.0);
   end Compute_Phase_Potential;

   -- 5.4 Création d'une maille cristalline
   function Create_Cell
     (Sys      : Crystal_System;
      Form     : Crystal_Form;
      Mol      : Molecule_Type;
      a, b, c  : Float;
      Alpha, Beta, Gamma : Float;
      T_K      : Float;
      P_Pa     : Float) return Unit_Cell
     with Pre => a > 0.0 and b > 0.0 and c > 0.0 and T_K >= 0.0 and P_Pa >= 0.0,
          Post => Create_Cell'Result.Coherence >= 0.0
   is
      Cell     : Unit_Cell;
      Coh      : Float := Compute_Phase_Coherence (T_K, P_Pa);
      State    : Stability_State := Determine_State (Coh);
      Angle_Count : Integer := 0;
   begin
      Cell.System := Sys;
      Cell.Form := Form;
      Cell.Molecule := Mol;
      Cell.a := a;
      Cell.b := b;
      Cell.c := c;
      Cell.Alpha := Alpha;
      Cell.Beta := Beta;
      Cell.Gamma := Gamma;
      Cell.Volume := a * b * c;
      Cell.Temperature_K := T_K;
      Cell.Pressure_Pa := P_Pa;
      Cell.Coherence := Coh;
      Cell.State := State;
      Cell.Is_Stable := (State = Stable);
      Cell.Atom_Count := 0;
      Cell.Angle_Count := 0;

      -- Ajout des angles caractéristiques
      Angle_Count := Angle_Count + 1;
      Cell.Angles (Angle_Count) :=
        ("Tetrahedral       ", ANGLE_TETRAEDRIQUE,
         ANGLE_TETRAEDRIQUE * PI / 180.0, 0.01, True, -50.0);

      Angle_Count := Angle_Count + 1;
      Cell.Angles (Angle_Count) :=
        ("Octahedral        ", ANGLE_OCTAHEDRIQUE,
         ANGLE_OCTAHEDRIQUE * PI / 180.0, 0.01, True, -48.0);

      Angle_Count := Angle_Count + 1;
      Cell.Angles (Angle_Count) :=
        ("Hexagonal         ", ANGLE_HEXAGONAL,
         ANGLE_HEXAGONAL * PI / 180.0, 0.01, True, -46.0);

      Cell.Angle_Count := Angle_Count;

      return Cell;
   end Create_Cell;

   -- 5.5 Ajout d'atomes
   procedure Add_Atom
     (Cell    : in out Unit_Cell;
      X, Y, Z : Float;
      El      : Character;
      Valence : Integer;
      Coh     : Float)
     with Pre => Cell.Atom_Count < 100 and Valence in 0 .. 20 and Coh in 0.0 .. 100.0,
          Post => Cell.Atom_Count <= 100
   is
      Idx : Integer := Cell.Atom_Count + 1;
   begin
      Cell.Atoms (Idx) := (X, Y, Z, El, Valence, Coh);
      Cell.Atom_Count := Idx;
   end Add_Atom;

   -- 5.6 Calcul des angles de liaison
   function Compute_Bond_Angle (V1, V2, V3 : Atom_Position) return Float
     with Pre => True,
          Post => Compute_Bond_Angle'Result in 0.0 .. 180.0
   is
      Dx1 : Float := V1.X - V2.X;
      Dy1 : Float := V1.Y - V2.Y;
      Dz1 : Float := V1.Z - V2.Z;
      Dx2 : Float := V3.X - V2.X;
      Dy2 : Float := V3.Y - V2.Y;
      Dz2 : Float := V3.Z - V2.Z;
      Norm1 : Float;
      Norm2 : Float;
      Dot   : Float;
      CosTheta : Float;
   begin
      Norm1 := Dx1 * Dx1 + Dy1 * Dy1 + Dz1 * Dz1;
      Norm2 := Dx2 * Dx2 + Dy2 * Dy2 + Dz2 * Dz2;

      if Norm1 = 0.0 or Norm2 = 0.0 then
         return 0.0;
      end if;

      Norm1 := Float'Square_Root (Norm1);
      Norm2 := Float'Square_Root (Norm2);

      Dot := Dx1 * Dx2 + Dy1 * Dy2 + Dz1 * Dz2;
      CosTheta := Dot / (Norm1 * Norm2);

      if CosTheta > 1.0 then
         CosTheta := 1.0;
      elsif CosTheta < -1.0 then
         CosTheta := -1.0;
      end if;

      return (Float'Arc_Cos (CosTheta) * 180.0) / PI;
   end Compute_Bond_Angle;

