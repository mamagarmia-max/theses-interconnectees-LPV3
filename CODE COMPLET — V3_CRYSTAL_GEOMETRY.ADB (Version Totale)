   ANGLE_ICOSAHEDRIQUE : constant := 60.0;         -- degrés
   ANGLE_PENTAGONAL    : constant := 108.0;        -- degrés
   ANGLE_TRIGONAL      : constant := 120.0;        -- degrés

   -- ========================================================================
   -- 4. TYPES
   -- ========================================================================

   type Crystal_System is
     (Cubic, Tetragonal, Orthorhombic, Hexagonal, Trigonal,
