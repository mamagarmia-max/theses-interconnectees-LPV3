   -- ========================================================================
   -- 1. INVARIANTS V3 (VERROUILLÉS)
   -- ========================================================================

   PSI_V3          : constant := 48016.8;          -- kg·m⁻²
   PHI_CRITICAL    : constant := -51.1;            -- mV (seuil universel)
   NU_PHASE        : constant := 6.4e12;           -- Hz
   BETA            : constant := 1_000_000.0;      -- Facteur d'échelle
   RHO_COND        : constant := 1026.0;           -- kg·m⁻³
   K_CYCLES        : constant := 7;                -- Fermeture heptadique
   PI              : constant := 3.141592653589793;

   -- ========================================================================
   -- 2. CONSTANTES PHYSIQUES
   -- ========================================================================

   P_ATM           : constant := 101325.0;         -- Pa (1 atm)
   P_1GPa          : constant := 1.0e9;            -- Pa (1 GPa)
   P_10GPa         : constant := 10.0e9;           -- Pa (10 GPa)
   P_100GPa        : constant := 100.0e9;          -- Pa (100 GPa)

   T_REF           : constant := 273.15;           -- K (0°C)
   T_ROOM          : constant := 300.0;            -- K (27°C)
   T_HIGH          : constant := 400.0;            -- K (127°C)
   T_MELT          : constant := 500.0;            -- K (227°C)

