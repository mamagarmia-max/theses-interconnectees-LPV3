   is
   begin
      -- Structure perovskite (cubique, octaédrique)
      Add_Atom (Cell, 0.0, 0.0, 0.0, 'A', 12, 90.0);  -- Ca
      Add_Atom (Cell, 0.5, 0.5, 0.5, 'B', 6, 92.0);   -- Ti
      Add_Atom (Cell, 0.5, 0.5, 0.0, 'X', 2, 88.0);   -- O
      Add_Atom (Cell, 0.5, 0.0, 0.5, 'X', 2, 88.0);   -- O
      Add_Atom (Cell, 0.0, 0.5, 0.5, 'X', 2, 88.0);   -- O
   end Configure_Perovskite;

   procedure Configure_Zeolite (Cell : in out Unit_Cell)
     with Pre => True,
          Post => Cell.Atom_Count > 0
   is
   begin
      -- Structure zéolite (cages tétraédriques)
      Add_Atom (Cell, 0.0, 0.0, 0.0, 'S', 4, 92.0);
      Add_Atom (Cell, 0.25, 0.25, 0.25, 'A', 4, 90.0);
      Add_Atom (Cell, 0.5, 0.5, 0.5, 'S', 4, 91.0);
      Add_Atom (Cell, 0.75, 0.75, 0.75, 'A', 4, 89.0);
      Add_Atom (Cell, 0.0, 0.5, 0.5, 'X', 2, 85.0);
      Add_Atom (Cell, 0.5, 0.0, 0.5, 'X', 2, 85.0);
      Add_Atom (Cell, 0.5, 0.5, 0.0, 'X', 2, 85.0);
      Add_Atom (Cell, 0.0, 0.0, 0.5, 'X', 2, 85.0);
      Add_Atom (Cell, 0.0, 0.5, 0.0, 'X', 2, 85.0);
      Add_Atom (Cell, 0.5, 0.0, 0.0, 'X', 2, 85.0);
   end Configure_Zeolite;

   procedure Configure_Ice (Cell : in out Unit_Cell)
     with Pre => True,
          Post => Cell.Atom_Count > 0
   is
   begin
      -- Structure glace Ih (hexagonale)
      Add_Atom (Cell, 0.0, 0.0, 0.0, 'O', 2, 95.0);
      Add_Atom (Cell, 0.333, 0.667, 0.0, 'O', 2, 95.0);
      Add_Atom (Cell, 0.667, 0.333, 0.0, 'O', 2, 95.0);
      Add_Atom (Cell, 0.0, 0.0, 0.5, 'O', 2, 95.0);
