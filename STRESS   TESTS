   -- ========================================================================
   -- 12. COMBINAISON DE STRESS (effets synergiques)
   -- ========================================================================

   function Apply_Combined_Stress
     (S : Signal_Record;
      Mechanical : Float;
      Oxidative  : Float;
      Thermal    : Float;
      Osmotic    : Float;
      Immune     : Float) return Signal_Record
     with Pre  => Mechanical >= 0.0 and Oxidative >= 0.0 and
                  Thermal >= 0.0 and Osmotic >= 0.0 and Immune >= 0.0,
          Post => Apply_Combined_Stress'Result.State in
                    Stress_Response | Apoptosis_Signal | Necrosis_Signal | Blocked
   is
      R : Signal_Record := S;
      Total_Stress : Float;
   begin
      R := Enforce_Phase_Threshold (R);
      if R.State = Blocked then return R; end if;

      Total_Stress := Mechanical + Oxidative + Thermal + Osmotic + Immune;

      if Total_Stress > 400.0 then
         R.State := Necrosis_Signal;
         R.Coherence := 0.0;
         R.Lethal_Flag := True;
         R.Location := "NECROSE (stress combine letal)                   ";
      elsif Total_Stress > 200.0 then
         R.State := Apoptosis_Signal;
         R.Coherence := R.Coherence * 0.40;
         R.Phase_Potential := R.Phase_Potential - 25.0;
         R.Location := "APOPTOSE (stress combine severe)                 ";
      elsif Total_Stress > 100.0 then
         R.State := Stress_Response;
         R.Coherence := R.Coherence * 0.60;
         R.Phase_Potential := R.Phase_Potential - 15.0;
         R.Location := "Stress combine modere                            ";
      else
         R.State := Stress_Response;
         R.Location := "Stress combine normal                            ";
      end if;

      R.Stress_Level := (Total_Stress / 500.0) * 100.0;
      if R.Stress_Level > 100.0 then R.Stress_Level := 100.0; end if;

      R := Apply_V3_Invariants (R);
      return R;
   end Apply_Combined_Stress;

