      if O2_Percent < O2_HYPOXIC then
         R.State := Hypoxic_Adaptation;
         R.Coherence := R.Coherence * 0.70;
         R.Phase_Potential := R.Phase_Potential - 8.0;
         R.Location := "ADAPTATION HYPOXIQUE (HIF-1alpha)                ";
