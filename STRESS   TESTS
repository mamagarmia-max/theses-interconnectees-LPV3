   function Apply_Heat_Shock_Extreme
     (S : Signal_Record;
      Temperature : Float) return Signal_Record
     with Pre  => Temperature >= -273.15,
          Post => Apply_Heat_Shock_Extreme'Result.State in
                    Stress_Response | Heat_Shock_Response | Apoptosis_Signal | Necrosis_Signal | Blocked
   is
      R : Signal_Record := S;
   begin
      R := Enforce_Phase_Threshold (R);
      if R.State = Blocked then return R; end if;

      if Temperature > TEMP_HEAT_EXTREME then
         R.State := Necrosis_Signal;
         R.Coherence := 0.0;
         R.Lethal_Flag := True;
         R.Location := "NECROSE (hyperthermie extreme > 45 C)            ";
      elsif Temperature > 42.0 then
         R.State := Heat_Shock_Response;
         R.Coherence := R.Coherence * 0.70;
         R.Phase_Potential := R.Phase_Potential - 8.0;
