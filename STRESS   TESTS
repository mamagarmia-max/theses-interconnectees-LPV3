   function Apply_Cytokine_Storm
     (S : Signal_Record;
      TNF : Float;
      IL1 : Float;
      IL6 : Float;
      IFNG : Float) return Signal_Record
     with Pre  => TNF >= 0.0 and IL1 >= 0.0 and IL6 >= 0.0 and IFNG >= 0.0,
          Post => Apply_Cytokine_Storm'Result.State in
                    Stress_Response | Inflammatory_Storm | Apoptosis_Signal | Blocked
   is
      R : Signal_Record := S;
      Total_Cyto : Float;
   begin
      R := Enforce_Phase_Threshold (R);
      if R.State = Blocked then return R; end if;

      Total_Cyto := TNF + IL1 + IL6 + IFNG;

      if TNF > TNF_EXTREME or IL1 > IL1_EXTREME or
         IL6 > IL6_EXTREME or IFNG > IFNG_EXTREME then
         R.State := Inflammatory_Storm;
         R.Coherence := R.Coherence * 0.40;
         R.Phase_Potential := R.Phase_Potential - 20.0;
         R.Lethal_Flag := True;
         R.Location := "ORAGE CYTOKINIQUE (choc septique)                ";
      elsif Total_Cyto > 500.0 then
         R.State := Stress_Response;
         R.Coherence := R.Coherence * 0.65;
         R.Phase_Potential := R.Phase_Potential - 10.0;
         R.Location := "Stress immunitaire severe                        ";
      else
         R.State := Stress_Response;
         R.Location := "Stress immunitaire normal                        ";
      end if;

      R.Stress_Level := (Total_Cyto / (TNF_EXTREME + IL1_EXTREME + IL6_EXTREME + IFNG_EXTREME)) * 100.0;
      if R.Stress_Level > 100.0 then R.Stress_Level := 100.0; end if;

      R := Apply_V3_Invariants (R);
      return R;
   end Apply_Cytokine_Storm;

