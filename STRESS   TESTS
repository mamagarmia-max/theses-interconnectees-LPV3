     (S : Signal_Record;
      pH : Float) return Signal_Record
     with Pre  => pH >= 0.0 and pH <= 14.0,
          Post => Apply_Acidosis_Extreme'Result.State in
                    Stress_Response | Metabolic_Reprogramming | Apoptosis_Signal | Blocked
   is
      R : Signal_Record := S;
   begin
      R := Enforce_Phase_Threshold (R);
      if R.State = Blocked then return R; end if;

      if pH < PH_ACIDIC then
         R.State := Apoptosis_Signal;
         R.Coherence := R.Coherence * 0.55;
         R.Phase_Potential := R.Phase_Potential - 12.0;
         R.Location := "APOPTOSE (acidose extreme pH < 6.0)               ";
      elsif pH < 6.8 then
         R.State := Metabolic_Reprogramming;
         R.Coherence := R.Coherence * 0.75;
         R.Phase_Potential := R.Phase_Potential - 6.0;
         R.Location := "Stress acidose (microenvironnement tumoral)      ";
      else
         R.State := Stress_Response;
         R.Location := "pH normal                                        ";
      end if;

      R := Apply_V3_Invariants (R);
      return R;
   end Apply_Acidosis_Extreme;

