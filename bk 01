with Ada.Text_IO; use Ada.Text_IO;
with Ada.Integer_Text_IO; use Ada.Integer_Text_IO;
with Ada.Float_Text_IO; use Ada.Float_Text_IO;
with Ada.Numerics; use Ada.Numerics;
with Ada.Numerics.Elementary_Functions; use Ada.Numerics.Elementary_Functions;
with Ada.Exceptions; use Ada.Exceptions;

package V3_Banking_Ultimate with
   SPARK_Mode => On
is

   -- ========================================================================
   -- 1. INVARIANTS V3 (SEULEMENT POUR L'INTÉGRITÉ DU SYSTÈME)
   -- ========================================================================

   PSI_V3          : constant := 48_016.8;          -- kg·m⁻² (intégrité système)
   PHI_CRITICAL    : constant := -51.10;            -- mV (cohérence)
   K_CYCLES        : constant := 7;                 -- Rollback heptadique
   MODULO_9        : constant := 9;                 -- Checksum global

   -- ========================================================================
   -- 2. TYPES BANCAIRES (DOMAINE MÉTIER)
   -- ========================================================================

   subtype Amount_Cents is Integer range -1_000_000_000 .. 1_000_000_000;
   subtype Account_ID is Integer range 1 .. 10_000;
   subtype Transaction_ID is Integer range 1 .. 10_000_000;
   subtype Client_ID is Integer range 1 .. 100_000;
   subtype Checksum_Type is Integer range 1 .. 9;
   subtype Interest_Rate is Float range 0.0 .. 100.0;
   subtype Percentage is Float range 0.0 .. 100.0;

   type Account_Type is (COURANT, EPARGNE, PROFESSIONNEL, JEUNE);
   type Transaction_Type is (VIR, PRELEVEMENT, DEPOT, RETRAIT, FRAIS, INTERET);
   type Account_Status is (ACTIF, BLOQUE, FERME, SUSPENDU);

   -- ========================================================================
   -- 3. COMPTES
   -- ========================================================================

   type Account_Record is record
      ID          : Account_ID := 0;
      Client      : Client_ID := 0;
      Type_Compte : Account_Type := COURANT;
      Status      : Account_Status := ACTIF;
      Balance     : Amount_Cents := 0;
      Overdraft   : Amount_Cents := 0;           -- Découvert autorisé
      Plafond     : Amount_Cents := 1_000_000;   -- Plafond virement
      Taux_Interet: Interest_Rate := 2.0;         -- % annuel
      Frais_Mensuel : Amount_Cents := 500;        -- Frais mensuels
      Date_Ouverture : Integer := 0;
      Checksum    : Checksum_Type := MODULO_9;
   end record
     with Predicate => Account_Record.Checksum = MODULO_9;

   -- ========================================================================
   -- 4. TRANSACTIONS
   -- ========================================================================

   type Transaction_Record is record
      ID          : Transaction_ID := 0;
      Type_Op     : Transaction_Type := VIR;
      From_ID     : Account_ID := 0;
      To_ID       : Account_ID := 0;
      Amount      : Amount_Cents := 0;
      Timestamp   : Integer := 0;
      Reference   : String (1 .. 20) := (others => ' ');
      Is_Valid    : Boolean := False;
      Is_Processed : Boolean := False;
      Checksum    : Checksum_Type := MODULO_9;
   end record
     with Predicate => Transaction_Record.Checksum = MODULO_9;

   -- ========================================================================
   -- 5. SNAPSHOT POUR ROLLBACK TRANSACTIONNEL
   -- ========================================================================

   type Snapshot_Record is record
      Account_ID   : Account_ID := 0;
      Balance_Avant : Amount_Cents := 0;
      Balance_Apres : Amount_Cents := 0;
      Timestamp    : Integer := 0;
      Checksum     : Checksum_Type := MODULO_9;
   end record
     with Predicate => Snapshot_Record.Checksum = MODULO_9;

   -- ========================================================================
   -- 6. ÉTAT COMPLET DU SYSTÈME
   -- ========================================================================

   type Banking_State is record
      -- Noyau Central
      Veto_Active      : Boolean := False;
      Coherence        : Percentage := 100.0;
      Checksum         : Checksum_Type := MODULO_9;
      Rollback_Count   : Integer := 0;

      -- Comptes
      Account_Count    : Integer := 0;
      Accounts         : array (1 .. 10_000) of Account_Record;

      -- Transactions
      Transaction_Count : Integer := 0;
      Transactions     : array (1 .. 10_000_000) of Transaction_Record;

      -- Snapshots (pour rollback)
      Snapshot_Count   : Integer := 0;
      Snapshots        : array (1 .. 10_000) of Snapshot_Record;

      -- Statistiques
      Total_Transactions : Integer := 0;
      Rejected_Count   : Integer := 0;
      Last_Transaction_ID : Transaction_ID := 0;
   end record
     with Predicate => Banking_State.Checksum = MODULO_9;

   -- ========================================================================
   -- 7. FONCTIONS DE BASE (SÉPARÉES DES INVARIANTS V3)
   -- ========================================================================

   -- 7.1 Modulo-9 (intégrité système)
   function Digital_Root (N : Integer) return Checksum_Type
     with Pre  => N >= 0,
          Post => Digital_Root'Result in 1 .. 9;

   -- 7.2 Arithmétique saturante (sécurité financière)
   function Safe_Add (A, B : Amount_Cents) return Amount_Cents
     with Pre  => A in -1_000_000_000 .. 1_000_000_000 and
                  B in -1_000_000_000 .. 1_000_000_000,
          Post => Safe_Add'Result in -1_000_000_000 .. 1_000_000_000;

   function Safe_Sub (A, B : Amount_Cents) return Amount_Cents
     with Pre  => A in -1_000_000_000 .. 1_000_000_000 and
                  B in -1_000_000_000 .. 1_000_000_000,
          Post => Safe_Sub'Result in -1_000_000_000 .. 1_000_000_000;

   -- ========================================================================
   -- 8. FONCTIONS MÉTIER (BANCAIRES)
   -- ========================================================================

   -- 8.1 Gestion des comptes
   function Create_Account
     (State  : in out Banking_State;
      Client : Client_ID;
      Type_Compte : Account_Type;
      Balance_Init : Amount_Cents) return Account_ID
     with Pre  => State.Checksum = MODULO_9 and
                  Balance_Init in -1_000_000_000 .. 1_000_000_000,
          Post => State.Checksum = MODULO_9;

   function Get_Account (State : Banking_State; ID : Account_ID) return Account_Record
     with Pre  => ID in 1 .. State.Account_Count and State.Checksum = MODULO_9,
          Post => Get_Account'Result.ID = ID;

   function Get_Balance (State : Banking_State; ID : Account_ID) return Amount_Cents
     with Pre  => ID in 1 .. State.Account_Count and State.Checksum = MODULO_9,
          Post => Get_Balance'Result >= -1_000_000_000 and
                  Get_Balance'Result <= 1_000_000_000;

   -- 8.2 Virement (transactionnel avec snapshot)
   function Transfer
     (State    : in out Banking_State;
      From_ID  : Account_ID;
      To_ID    : Account_ID;
      Amount   : Amount_Cents;
      Reference : String) return Boolean
     with Pre  => State.Checksum = MODULO_9 and
                  From_ID in 1 .. State.Account_Count and
                  To_ID in 1 .. State.Account_Count and
                  Amount > 0 and
                  Reference'Length > 0,
          Post => State.Checksum = MODULO_9 and
                  Transfer'Result in True | False;

   -- 8.3 Prélèvement (débit)
   function Debit
     (State    : in out Banking_State;
      Account_ID : Account_ID;
      Amount   : Amount_Cents;
      Reason   : String) return Boolean
     with Pre  => State.Checksum = MODULO_9 and
                  Account_ID in 1 .. State.Account_Count and
                  Amount > 0,
          Post => State.Checksum = MODULO_9 and
                  Debit'Result in True | False;

   -- 8.4 Dépôt (crédit)
   function Credit
     (State    : in out Banking_State;
      Account_ID : Account_ID;
      Amount   : Amount_Cents;
      Reason   : String) return Boolean
     with Pre  => State.Checksum = MODULO_9 and
                  Account_ID in 1 .. State.Account_Count and
                  Amount > 0,
          Post => State.Checksum = MODULO_9 and
                  Credit'Result in True | False;

   -- 8.5 Rollback transactionnel réel
   procedure Transactional_Rollback
     (State    : in out Banking_State;
      Trans_ID : Transaction_ID)
     with Pre  => State.Checksum = MODULO_9 and
                  Trans_ID >= 1 and
                  Trans_ID <= State.Transaction_Count,
          Post => State.Checksum = MODULO_9 and
                  State.Rollback_Count = State.Rollback_Count'Old + 1;

   -- 8.6 Calcul des intérêts
   procedure Apply_Interest (State : in out Banking_State; Account_ID : Account_ID)
     with Pre  => State.Checksum = MODULO_9 and
                  Account_ID in 1 .. State.Account_Count,
          Post => State.Checksum = MODULO_9;

   -- 8.7 Application des frais
   procedure Apply_Fees (State : in out Banking_State; Account_ID : Account_ID)
     with Pre  => State.Checksum = MODULO_9 and
                  Account_ID in 1 .. State.Account_Count,
          Post => State.Checksum = MODULO_9;

   -- ========================================================================
   -- 9. FONCTIONS DE SÉCURITÉ (VETO / AUDIT)
   -- ========================================================================

   procedure Apply_Veto (State : in out Banking_State; Reason : String)
     with Pre  => State.Checksum = MODULO_9,
          Post => State.Veto_Active = True and State.Checksum = MODULO_9;

   procedure Clear_Veto (State : in out Banking_State)
     with Pre  => State.Checksum = MODULO_9,
          Post => State.Veto_Active = False and State.Checksum = MODULO_9;

   function Verify_System_Integrity (State : Banking_State) return Boolean
     with Post => Verify_System_Integrity'Result in True | False;

   -- ========================================================================
   -- 10. RAPPORTS D'AUDIT
   -- ========================================================================

   procedure Generate_Account_Statement
     (State    : Banking_State;
      Acc_ID   : Account_ID;
      Statement : out String)
     with Pre  => State.Checksum = MODULO_9 and
                  Acc_ID in 1 .. State.Account_Count,
          Post => Statement'Length > 0;

   procedure Generate_Transaction_History
     (State    : Banking_State;
      Acc_ID   : Account_ID;
      History  : out String)
     with Pre  => State.Checksum = MODULO_9 and
                  Acc_ID in 1 .. State.Account_Count,
          Post => History'Length > 0;

   procedure Generate_System_Report (State : Banking_State; Report : out String)
     with Pre  => State.Checksum = MODULO_9,
          Post => Report'Length > 0;

   -- ========================================================================
   -- 11. POINT D'ENTRÉE (API)
   -- ========================================================================

   function API (State : in out Banking_State; Command : String; Args : String) return String
     with Pre  => State.Checksum = MODULO_9,
          Post => API'Result'Length > 0 and State.Checksum = MODULO_9;

   -- ========================================================================
   -- 12. INITIALISATION
   -- ========================================================================

   procedure Initialize_Banking_System (State : out Banking_State)
     with Post => State.Checksum = MODULO_9;

end V3_Banking_Ultimate;
