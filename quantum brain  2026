   package body Noyau_Physique is
      function Lorentz_Gamma (V : Float) return Float is
      begin
         if V < 0.0 or V >= C then
            return 1.0;
         end if;
         Beta : constant Float := V / C;
         if Beta >= 1.0 then
            return 1.0;
         end if;
         return 1.0 / Safe_Sqrt (1.0 - Beta * Beta);
      exception
         when others => return 1.0;
