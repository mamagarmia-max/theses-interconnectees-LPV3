with Ada.Text_IO; use Ada.Text_IO;
with Ada.Float_Text_IO; use Ada.Float_Text_IO;
with Ada.Integer_Text_IO; use Ada.Integer_Text_IO;
with Ada.Numerics; use Ada.Numerics;
with Ada.Numerics.Elementary_Functions; use Ada.Numerics.Elementary_Functions;

procedure V3_BH_Collision_Full with
   SPARK_Mode => On
is

   -- ========================================================================
   -- 1. V3 INVARIANTS (VERROUILLÉS)
   -- ========================================================================

   PSI_V3          : constant := 48016.8;          -- kg·m⁻²
   PHI_CRITICAL    : constant := -0.0511;          -- V (-51.1 mV)
   K_CYCLES        : constant := 7;                -- Clôture heptadique
   RHO_COND        : constant := 1026.0;           -- kg·m⁻³
   NU_PHASE        : constant := 6.4e12;           -- Hz
   BETA            : constant := 1_000_000.0;      -- Facteur d'échelle
   ALPHA_FS        : constant := 7.29735256e-3;    -- Structure fine
   C_LIGHT         : constant := 299_792_458.0;    -- m/s
   HBAR            : constant := 1.054571817e-34;  -- J·s
   G_NEWTON        : constant := 6.67430e-11;      -- m³·kg⁻¹·s⁻²
   M_SUN           : constant := 1.98847e30;       -- kg
   PI              : constant := Ada.Numerics.Pi;

   -- ========================================================================
   -- 2. TYPES V3
   -- ========================================================================

   type Collision_Stage is (Approach, Merger, Ringdown, Remnant, Evaporation);

   type BH_Collision_State is record
      -- Paramètres des deux trous noirs
      BH1_Mass_kg        : Float;
      BH1_Spin           : Float range 0.0 .. 1.0;
      BH1_Position_X     : Float;                     -- Position (m)
      BH1_Position_Y     : Float;
      BH2_Mass_kg        : Float;
      BH2_Spin           : Float range 0.0 .. 1.0;
      BH2_Position_X     : Float;
      BH2_Position_Y     : Float;

      -- Distance et interaction
      Distance_m         : Float;
      Orbital_Energy_J   : Float;
      Angular_Momentum   : Float;

      -- Ondes gravitationnelles
      GW_Frequency_Hz    : Float;
      GW_Amplitude       : Float;
      GW_Energy_J        : Float;

      -- Merger et remnant
      Remnant_Mass_kg    : Float;
      Remnant_Spin       : Float range 0.0 .. 1.0;
      Remnant_Radius_m   : Float;

      -- Rayonnements
      Luminosity_W       : Float;
      XRay_Luminosity_W  : Float;
      Gamma_Luminosity_W : Float;
      Neutrino_Luminosity_W : Float;

      -- Paramètres de phase
      Phase_Potential    : Float;
      Coherence          : Float range 0.0 .. 100.0;
      Magnetic_Field_T   : Float;

      -- Temps
      Time_s             : Float;
      Time_Step_s        : Float;
      Stage              : Collision_Stage;

      -- Drapeaux
      Is_Merging         : Boolean;
      Has_GW             : Boolean;
      Is_Emitting        : Boolean;
      Checksum           : Integer range 1 .. 9 := 9;
   end record
     with Predicate => BH_Collision_State.Checksum = 9;

   -- ========================================================================
   -- 3. FONCTIONS DE SIMULATION V3
   -- ========================================================================

   -- 3.1 Rayon de Schwarzschild
   function Schwarzschild_Radius (M : Float) return Float
     with Pre => M > 0.0,
          Post => Schwarzschild_Radius'Result > 0.0
   is
   begin
      return 2.0 * G_NEWTON * M / (C_LIGHT * C_LIGHT);
   end Schwarzschild_Radius;

   -- 3.2 Distance de fusion (dernière orbite stable)
   function Innermost_Stable_Orbit (M1, M2 : Float) return Float
     with Pre => M1 > 0.0 and M2 > 0.0,
          Post => Innermost_Stable_Orbit'Result > 0.0
   is
      M_total : Float := M1 + M2;
   begin
      return 3.0 * Schwarzschild_Radius (M_total);
   end Innermost_Stable_Orbit;

   -- 3.3 Énergie orbitale
   function Orbital_Energy (M1, M2, R : Float) return Float
     with Pre => M1 > 0.0 and M2 > 0.0 and R > 0.0,
          Post => Orbital_Energy'Result < 0.0
   is
   begin
      return -G_NEWTON * M1 * M2 / (2.0 * R);
   end Orbital_Energy;

   -- 3.4 Fréquence des ondes gravitationnelles
   function GW_Frequency (M1, M2, R : Float) return Float
     with Pre => M1 > 0.0 and M2 > 0.0 and R > 0.0,
          Post => GW_Frequency'Result > 0.0
   is
      M_total : Float := M1 + M2;
   begin
      return sqrt (G_NEWTON * M_total / (R * R * R)) / PI;
   end GW_Frequency;

   -- 3.5 Amplitude des ondes gravitationnelles
   function GW_Amplitude (M1, M2, R, Dist : Float) return Float
     with Pre => M1 > 0.0 and M2 > 0.0 and R > 0.0 and Dist > 0.0,
          Post => GW_Amplitude'Result >= 0.0
   is
      M_total : Float := M1 + M2;
   begin
      return (4.0 * G_NEWTON * M1 * M2) /
             (Dist * C_LIGHT * C_LIGHT * R) * (1.0 / (1.0 + 0.5));
   end GW_Amplitude;

   -- 3.6 Énergie des ondes gravitationnelles
   function GW_Energy (M1, M2, R : Float) return Float
     with Pre => M1 > 0.0 and M2 > 0.0 and R > 0.0,
          Post => GW_Energy'Result >= 0.0
   is
      Mu : Float := (M1 * M2) / (M1 + M2);
      M_total : Float := M1 + M2;
   begin
      return 0.1 * Mu * C_LIGHT * C_LIGHT * (Schwarzschild_Radius (M_total) / R);
   end GW_Energy;

   -- 3.7 Masse du remnant
   function Remnant_Mass (M1, M2, E_GW : Float) return Float
     with Pre => M1 > 0.0 and M2 > 0.0 and E_GW >= 0.0,
          Post => Remnant_Mass'Result > 0.0
   is
   begin
      return (M1 + M2) - E_GW / (C_LIGHT * C_LIGHT);
   end Remnant_Mass;

   -- 3.8 Spin du remnant
   function Remnant_Spin (M1, M2, Spin1, Spin2 : Float) return Float
     with Pre => M1 > 0.0 and M2 > 0.0 and Spin1 in 0.0 .. 1.0 and Spin2 in 0.0 .. 1.0,
          Post => Remnant_Spin'Result in 0.0 .. 1.0
   is
      J1 : Float := Spin1 * G_NEWTON * M1 * M1 / C_LIGHT;
      J2 : Float := Spin2 * G_NEWTON * M2 * M2 / C_LIGHT;
      J  : Float := J1 + J2;
      M  : Float := M1 + M2;
   begin
      return J * C_LIGHT / (G_NEWTON * M * M);
   end Remnant_Spin;

   -- 3.9 Luminosité totale (accrétion + merger)
   function Merger_Luminosity (M1, M2, R : Float) return Float
     with Pre => M1 > 0.0 and M2 > 0.0 and R > 0.0,
          Post => Merger_Luminosity'Result >= 0.0
   is
      Accretion_L : Float := 0.1 * (M1 + M2) / (R) * C_LIGHT * C_LIGHT;
      Merger_L    : Float := 0.01 * (M1 + M2) * C_LIGHT * C_LIGHT / (R / 1.0e9);
   begin
      return Accretion_L + Merger_L;
   end Merger_Luminosity;

   -- 3.10 Rayonnement X
   function Merger_XRay_Luminosity (L : Float) return Float
     with Pre => L >= 0.0,
          Post => Merger_XRay_Luminosity'Result >= 0.0
   is
   begin
      return 0.1 * L;
   end Merger_XRay_Luminosity;

   -- 3.11 Rayonnement gamma
   function Merger_Gamma_Luminosity (L : Float; Spin : Float) return Float
     with Pre => L >= 0.0 and Spin in 0.0 .. 1.0,
          Post => Merger_Gamma_Luminosity'Result >= 0.0
   is
   begin
      return 0.05 * L * Spin;
   end Merger_Gamma_Luminosity;

   -- 3.12 Neutrinos du merger
   function Merger_Neutrino_Luminosity (L : Float) return Float
     with Pre => L >= 0.0,
          Post => Merger_Neutrino_Luminosity'Result >= 0.0
   is
   begin
      return 0.01 * L;
   end Merger_Neutrino_Luminosity;

   -- 3.13 Champ magnétique du merger
   function Merger_Magnetic_Field (M, R : Float) return Float
     with Pre => M > 0.0 and R > 0.0,
          Post => Merger_Magnetic_Field'Result >= 0.0
   is
      B0 : constant Float := 1.0e4;
   begin
      return B0 * (Schwarzschild_Radius (M) / R) ** 1.5;
   end Merger_Magnetic_Field;

   -- 3.14 Potentiel de phase du merger
   function Merger_Phase_Potential (M, R : Float) return Float
     with Pre => M > 0.0 and R > 0.0,
          Post => Merger_Phase_Potential'Result <= 0.0
   is
   begin
      return PHI_CRITICAL * (1.0 - Schwarzschild_Radius (M) / R);
   end Merger_Phase_Potential;

   -- 3.15 Cohérence du merger
   function Merger_Coherence (Phi : Float) return Float
     with Pre => Phi <= 0.0,
          Post => Merger_Coherence'Result in 0.0 .. 100.0
   is
   begin
      if Phi >= PHI_CRITICAL then
         return 100.0;
      elsif Phi < -10.0 then
         return 0.0;
      else
         return 100.0 * (1.0 - (PHI_CRITICAL - Phi) / abs (PHI_CRITICAL));
      end if;
   end Merger_Coherence;

   -- 3.16 Vitesse d'approche
   function Approach_Velocity (M1, M2, R : Float) return Float
     with Pre => M1 > 0.0 and M2 > 0.0 and R > 0.0,
          Post => Approach_Velocity'Result > 0.0
   is
      M_total : Float := M1 + M2;
   begin
      return sqrt (2.0 * G_NEWTON * M_total / R);
   end Approach_Velocity;

   -- ========================================================================
   -- 4. SIMULATION DE LA COLLISION
   -- ========================================================================

   function Simulate_BH_Collision
     (M1_Initial, M2_Initial : Float;
      Spin1_Initial, Spin2_Initial : Float)
      return BH_Collision_State
     with Pre => M1_Initial > 0.0 and M2_Initial > 0.0 and
                 Spin1_Initial in 0.0 .. 1.0 and Spin2_Initial in 0.0 .. 1.0,
          Post => Simulate_BH_Collision'Result.Checksum = 9
   is
      State : BH_Collision_State;
      M1    : Float := M1_Initial * M_SUN;
      M2    : Float := M2_Initial * M_SUN;
      Spin1 : Float := Spin1_Initial;
      Spin2 : Float := Spin2_Initial;
      R     : Float := Innermost_Stable_Orbit (M1, M2) * 100.0;
      X1    : Float := -R / 2.0;
      X2    : Float := R / 2.0;
      Y1    : Float := 0.0;
      Y2    : Float := 0.0;
      Time  : Float := 0.0;
      DT    : Float := 1.0e3;  -- Pas de temps (s)
      Stage : Collision_Stage := Approach;
      Merging : Boolean := False;
      GW_Emitting : Boolean := False;
      Emitting : Boolean := False;
      E_orb : Float := 0.0;
      E_GW : Float := 0.0;
      GW_f : Float := 0.0;
      GW_A : Float := 0.0;
      M_rem : Float := 0.0;
      Spin_rem : Float := 0.0;
      R_rem : Float := 0.0;
      L_Lum : Float := 0.0;
      X_Lum : Float := 0.0;
      G_Lum : Float := 0.0;
      N_Lum : Float := 0.0;
      B_Field : Float := 0.0;
      Phi    : Float := 0.0;
      Coh    : Float := 0.0;
      V_approach : Float := 0.0;
   begin
      -- Initialisation
      State.BH1_Mass_kg := M1;
      State.BH1_Spin := Spin1;
      State.BH1_Position_X := X1;
      State.BH1_Position_Y := Y1;
      State.BH2_Mass_kg := M2;
      State.BH2_Spin := Spin2;
      State.BH2_Position_X := X2;
      State.BH2_Position_Y := Y2;
      State.Distance_m := R;
      State.Orbital_Energy_J := Orbital_Energy (M1, M2, R);
      State.Angular_Momentum := 0.0;
      State.GW_Frequency_Hz := 0.0;
      State.GW_Amplitude := 0.0;
      State.GW_Energy_J := 0.0;
      State.Remnant_Mass_kg := M1 + M2;
      State.Remnant_Spin := 0.0;
      State.Remnant_Radius_m := 0.0;
      State.Luminosity_W := 0.0;
      State.XRay_Luminosity_W := 0.0;
      State.Gamma_Luminosity_W := 0.0;
      State.Neutrino_Luminosity_W := 0.0;
      State.Phase_Potential := PHI_CRITICAL;
      State.Coherence := 100.0;
      State.Magnetic_Field_T := 0.0;
      State.Time_s := Time;
      State.Time_Step_s := DT;
      State.Stage := Stage;
      State.Is_Merging := Merging;
      State.Has_GW := GW_Emitting;
      State.Is_Emitting := Emitting;
      State.Checksum := 9;

      -- Boucle principale de simulation
      while R > 0.0 and Time < 1.0e8 loop
         pragma Loop_Invariant (Time >= 0.0);
         pragma Loop_Invariant (State.Checksum = 9);

         -- Mise à jour de la distance
         V_approach := Approach_Velocity (M1, M2, R);
         R := R - V_approach * DT * 0.1;

         -- Mise à jour des positions
         X1 := -R / 2.0;
         X2 := R / 2.0;

         -- 1. Calcul de l'énergie orbitale
         E_orb := Orbital_Energy (M1, M2, R);

         -- 2. Calcul des ondes gravitationnelles
         if R < Innermost_Stable_Orbit (M1, M2) * 10.0 then
            GW_Emitting := True;
            GW_f := GW_Frequency (M1, M2, R);
            GW_A := GW_Amplitude (M1, M2, R, 1.0e22);
            E_GW := GW_Energy (M1, M2, R);
            State.Has_GW := True;
            Stage := Merger;
            State.Stage := Stage;
            Merging := True;
            State.Is_Merging := True;
         end if;

         -- 3. Fusion des trous noirs
         if R < Innermost_Stable_Orbit (M1, M2) then
            -- Formation du remnant
            M_rem := Remnant_Mass (M1, M2, E_GW);
            Spin_rem := Remnant_Spin (M1, M2, Spin1, Spin2);
            R_rem := Schwarzschild_Radius (M_rem);
            Stage := Ringdown;
            State.Stage := Stage;

            -- 4. Énergie libérée
            L_Lum := Merger_Luminosity (M1, M2, R);
            X_Lum := Merger_XRay_Luminosity (L_Lum);
            G_Lum := Merger_Gamma_Luminosity (L_Lum, Spin_rem);
            N_Lum := Merger_Neutrino_Luminosity (L_Lum);
            B_Field := Merger_Magnetic_Field (M_rem, R_rem);
            Phi := Merger_Phase_Potential (M_rem, R_rem);
            Coh := Merger_Coherence (Phi);
            Emitting := True;
            State.Is_Emitting := True;

            -- 5. Évaporation du remnant
            if Time > 1.0e6 then
               Stage := Evaporation;
               State.Stage := Stage;
               M_rem := M_rem - (L_Lum / (C_LIGHT * C_LIGHT)) * DT * 0.01;
            end if;

            -- Sortie
            exit;
         end if;

         -- Mise à jour de l'état
         State.BH1_Mass_kg := M1;
         State.BH1_Spin := Spin1;
         State.BH1_Position_X := X1;
         State.BH1_Position_Y := Y1;
         State.BH2_Mass_kg := M2;
         State.BH2_Spin := Spin2;
         State.BH2_Position_X := X2;
         State.BH2_Position_Y := Y2;
         State.Distance_m := R;
         State.Orbital_Energy_J := E_orb;
         State.Angular_Momentum := M1 * M2 * sqrt (G_NEWTON * (M1 + M2) / R);
         State.GW_Frequency_Hz := GW_f;
         State.GW_Amplitude := GW_A;
         State.GW_Energy_J := E_GW;
         State.Remnant_Mass_kg := M_rem;
         State.Remnant_Spin := Spin_rem;
         State.Remnant_Radius_m := R_rem;
         State.Luminosity_W := L_Lum;
         State.XRay_Luminosity_W := X_Lum;
         State.Gamma_Luminosity_W := G_Lum;
         State.Neutrino_Luminosity_W := N_Lum;
         State.Phase_Potential := Phi;
         State.Coherence := Coh;
         State.Magnetic_Field_T := B_Field;
         State.Time_s := Time;
         State.Time_Step_s := DT;
         State.Stage := Stage;
         State.Is_Merging := Merging;
         State.Has_GW := GW_Emitting;
         State.Is_Emitting := Emitting;

         -- Incrément du temps
         Time := Time + DT;
      end loop;

      return State;
   end Simulate_BH_Collision;

   -- ========================================================================
   -- 5. FONCTIONS DE TEST
   -- ========================================================================

   function All_Tests_Pass (State : BH_Collision_State) return Boolean
     with Post => All_Tests_Pass'Result in True | False
   is
   begin
      -- Test 1 : Cohérence
      if State.Coherence < 0.0 or State.Coherence > 100.0 then
         return False;
      end if;

      -- Test 2 : Distance
      if State.Distance_m < 0.0 then
         return False;
      end if;

      -- Test 3 : Ondes gravitationnelles
      if State.GW_Energy_J < 0.0 then
         return False;
      end if;

      -- Test 4 : Luminosité
      if State.Luminosity_W < 0.0 then
         return False;
      end if;

      -- Test 5 : Masse du remnant
      if State.Remnant_Mass_kg < 0.0 then
         return False;
      end if;

      -- Test 6 : Phase potentielle
      if State.Phase_Potential > 0.0 then
         return False;
      end if;

      -- Test 7 : Étape
      if State.Stage not in Approach .. Evaporation then
         return False;
      end if;

      return True;
   end All_Tests_Pass;

   -- ========================================================================
   -- 6. PROGRAMME PRINCIPAL
   -- ========================================================================

   State : BH_Collision_State;
   Passed : Boolean;

begin

   Put_Line ("================================================================================");
   Put_Line ("V3 BLACK HOLE COLLISION SIMULATION — COMPLETE UNIFICATION");
   Put_Line ("================================================================================");
   New_Line;

   Put_Line ("INVARIANTS V3 (LOCKED — NO ADJUSTMENT ALLOWED)");
   Put_Line ("  Ψ_V3          = " & Float'Image (PSI_V3) & " kg·m⁻²");
   Put_Line ("  Φ_critical    = " & Float'Image (PHI_CRITICAL) & " V (-51.1 mV)");
   Put_Line ("  K             = " & Integer'Image (K_CYCLES));
   Put_Line ("  ρ_cond        = " & Float'Image (RHO_COND) & " kg·m⁻³");
   Put_Line ("  ν_phase       = " & Float'Image (NU_PHASE) & " Hz");
   Put_Line ("  β             = " & Float'Image (BETA));
   New_Line;

   -- ========================================================================
   -- 7. SIMULATION
   -- ========================================================================

   Put_Line ("--- SIMULATION DE COLLISION (M1 = 30 M☉, M2 = 30 M☉, Spin1 = 0.9, Spin2 = 0.9) ---");
   New_Line;

   State := Simulate_BH_Collision (30.0, 30.0, 0.9, 0.9);

   Put_Line ("Résultats de la simulation :");
   Put_Line ("  BH1 Masse     = " & Float'Image (State.BH1_Mass_kg / M_SUN) & " M☉");
   Put_Line ("  BH1 Spin      = " & Float'Image (State.BH1_Spin));
   Put_Line ("  BH1 Position  = (" & Float'Image (State.BH1_Position_X / 1.0e3) & ", " &
              Float'Image (State.BH1_Position_Y / 1.0e3) & ") km");
   Put_Line ("  BH2 Masse     = " & Float'Image (State.BH2_Mass_kg / M_SUN) & " M☉");
   Put_Line ("  BH2 Spin      = " & Float'Image (State.BH2_Spin));
   Put_Line ("  BH2 Position  = (" & Float'Image (State.BH2_Position_X / 1.0e3) & ", " &
              Float'Image (State.BH2_Position_Y / 1.0e3) & ") km");
   Put_Line ("  Distance      = " & Float'Image (State.Distance_m / 1.0e3) & " km");
   Put_Line ("  Orbital E     = " & Float'Image (State.Orbital_Energy_J) & " J");
   Put_Line ("  GW Frequency  = " & Float'Image (State.GW_Frequency_Hz) & " Hz");
   Put_Line ("  GW Amplitude  = " & Float'Image (State.GW_Amplitude));
   Put_Line ("  GW Energy     = " & Float'Image (State.GW_Energy_J / 1.0e46) & " ×10⁴⁶ J");
   Put_Line ("  Remnant Masse = " & Float'Image (State.Remnant_Mass_kg / M_SUN) & " M☉");
   Put_Line ("  Remnant Spin  = " & Float'Image (State.Remnant_Spin));
   Put_Line ("  Remnant Rayon = " & Float'Image (State.Remnant_Radius_m) & " m");
   Put_Line ("  Luminosité    = " & Float'Image (State.Luminosity_W / 1.0e46) & " ×10⁴⁶ W");
   Put_Line ("  Rayons X      = " & Float'Image (State.XRay_Luminosity_W / 1.0e46) & " ×10⁴⁶ W");
   Put_Line ("  Rayons gamma  = " & Float'Image (State.Gamma_Luminosity_W / 1.0e46) & " ×10⁴⁶ W");
   Put_Line ("  Neutrinos     = " & Float'Image (State.Neutrino_Luminosity_W / 1.0e46) & " ×10⁴⁶ W");
   Put_Line ("  Cohérence     = " & Float'Image (State.Coherence) & " %");
   Put_Line ("  Phase potentiel = " & Float'Image (State.Phase_Potential * 1000.0) & " mV");
   Put_Line ("  Champ B       = " & Float'Image (State.Magnetic_Field_T) & " T");
   Put_Line ("  Étape         = " & Collision_Stage'Image (State.Stage));
   Put_Line ("  Fusion        = " & Boolean'Image (State.Is_Merging));
   Put_Line ("  GW émis       = " & Boolean'Image (State.Has_GW));
   Put_Line ("  Émission      = " & Boolean'Image (State.Is_Emitting));
   New_Line;

   -- ========================================================================
   -- 8. TESTS
   -- ========================================================================

   Passed := All_Tests_Pass (State);

   Put_Line ("--- TOUS LES TESTS ---");
   New_Line;

   Put_Line ("  Test 1 (Cohérence)      : " & Boolean'Image (State.Coherence >= 0.0 and State.Coherence <= 100.0));
   Put_Line ("  Test 2 (Distance)       : " & Boolean'Image (State.Distance_m >= 0.0));
   Put_Line ("  Test 3 (GW Energy)      : " & Boolean'Image (State.GW_Energy_J >= 0.0));
   Put_Line ("  Test 4 (Luminosité)     : " & Boolean'Image (State.Luminosity_W >= 0.0));
   Put_Line ("  Test 5 (Remnant)        : " & Boolean'Image (State.Remnant_Mass_kg >= 0.0));
   Put_Line ("  Test 6 (Phase)          : " & Boolean'Image (State.Phase_Potential < 0.0));
   Put_Line ("  Test 7 (Étape)          : " & Boolean'Image (State.Stage in Approach .. Evaporation));
   New_Line;

   Put_Line ("Résultat global : " & Boolean'Image (Passed));
   New_Line;

   if Passed then
      Put_Line ("✅ TOUS LES TESTS PASSÉS — COLLISION V3 VALIDÉE");
   else
      Put_Line ("⚠️ CERTAINS TESTS ÉCHOUÉS — VÉRIFIER LES PARAMÈTRES");
   end if;

   New_Line;

   -- ========================================================================
   -- 9. DÉTAILS DE L'ÉVOLUTION
   -- ========================================================================

   Put_Line ("--- DÉTAILS DE L'ÉVOLUTION ---");
   New_Line;

   Put_Line ("  1. Approche :");
   Put_Line ("     Deux trous noirs en orbite → énergie perdue par GW");
   New_Line;

   Put_Line ("  2. Fusion :");
   Put_Line ("     Distance → ISO → formation du remnant");
   New_Line;

   Put_Line ("  3. Ringdown :");
   Put_Line ("     Oscillations du remnant → émission de GW");
   New_Line;

   Put_Line ("  4. Rayonnements :");
