with Ada.Text_IO; use Ada.Text_IO;
with Ada.Float_Text_IO; use Ada.Float_Text_IO;
with Ada.Integer_Text_IO; use Ada.Integer_Text_IO;
with Ada.Numerics; use Ada.Numerics;
with Ada.Numerics.Elementary_Functions; use Ada.Numerics.Elementary_Functions;

procedure V3_BH_Pulsar_Engulfment_Full with
   SPARK_Mode => On
is

   -- ========================================================================
   -- 1. V3 INVARIANTS (VERROUILLÉS)
   -- ========================================================================

   PSI_V3          : constant := 48016.8;          -- kg·m⁻²
   PHI_CRITICAL    : constant := -0.0511;          -- V (-51.1 mV)
   K_CYCLES        : constant := 7;                -- Clôture heptadique
   RHO_COND        : constant := 1026.0;           -- kg·m⁻³
   NU_PHASE        : constant := 6.4e12;           -- Hz
   BETA            : constant := 1_000_000.0;      -- Facteur d'échelle
   ALPHA_FS        : constant := 7.29735256e-3;    -- Structure fine
   C_LIGHT         : constant := 299_792_458.0;    -- m/s
   HBAR            : constant := 1.054571817e-34;  -- J·s
   G_NEWTON        : constant := 6.67430e-11;      -- m³·kg⁻¹·s⁻²
   M_SUN           : constant := 1.98847e30;       -- kg
   PI              : constant := Ada.Numerics.Pi;

   -- ========================================================================
   -- 2. TYPES V3
   -- ========================================================================

   type Engulfment_Stage is (Orbit, Spiral, Tidal_Disruption, Merger, Remnant, Evaporation);

   type V3_Engulfment_State is record
      -- Paramètres du trou noir
      BH_Mass_kg       : Float;
      BH_Spin          : Float range 0.0 .. 1.0;
      BH_Radius_m      : Float;

      -- Paramètres du pulsar
      Pulsar_Mass_kg   : Float;
      Pulsar_Radius_m  : Float;
      Pulsar_Period_s  : Float;
      Pulsar_Magnetic_T: Float;
      Pulsar_Spin      : Float range 0.0 .. 1.0;

      -- Orbite
      Distance_m       : Float;
      Orbital_Energy_J : Float;
      Angular_Momentum : Float;

      -- Ondes gravitationnelles
      GW_Frequency_Hz  : Float;
      GW_Amplitude     : Float;
      GW_Energy_J      : Float;

      -- Tidal disruption
      Roche_Radius_m   : Float;
      Is_Disrupted     : Boolean;

      -- Merger et remnant
      Remnant_Mass_kg  : Float;
      Remnant_Spin     : Float range 0.0 .. 1.0;
      Remnant_Radius_m : Float;

      -- Rayonnements
      Luminosity_W     : Float;
      XRay_Luminosity_W: Float;
      Gamma_Luminosity_W: Float;
      Neutrino_Luminosity_W : Float;

      -- Paramètres de phase
      Phase_Potential  : Float;
      Coherence        : Float range 0.0 .. 100.0;
      Magnetic_Field_T : Float;

      -- Temps
      Time_s           : Float;
      Time_Step_s      : Float;
      Stage            : Engulfment_Stage;

      -- Drapeaux
      Is_Spiraling     : Boolean;
      Is_Merging       : Boolean;
      Has_GW           : Boolean;
      Is_Emitting      : Boolean;
      Checksum         : Integer range 1 .. 9 := 9;
   end record
     with Predicate => V3_Engulfment_State.Checksum = 9;

   -- ========================================================================
   -- 3. FONCTIONS DE SIMULATION V3
   -- ========================================================================

   -- 3.1 Rayon de Schwarzschild
   function Schwarzschild_Radius (M : Float) return Float
     with Pre => M > 0.0,
          Post => Schwarzschild_Radius'Result > 0.0
   is
   begin
      return 2.0 * G_NEWTON * M / (C_LIGHT * C_LIGHT);
   end Schwarzschild_Radius;

   -- 3.2 Rayon du pulsar (étoile à neutrons)
   function Pulsar_Radius (M : Float) return Float
     with Pre => M > 0.0,
          Post => Pulsar_Radius'Result > 0.0
   is
   begin
      return 1.0e4 * (M / M_SUN) ** (-1.0 / 3.0);
   end Pulsar_Radius;

   -- 3.3 Période du pulsar (en fonction du spin)
   function Pulsar_Period (Spin : Float) return Float
     with Pre => Spin in 0.0 .. 1.0,
          Post => Pulsar_Period'Result > 0.0
   is
   begin
      return 0.001 / (1.0 + 9.0 * Spin);
   end Pulsar_Period;

   -- 3.4 Champ magnétique du pulsar
   function Pulsar_Magnetic_Field (M, R : Float; Period : Float) return Float
     with Pre => M > 0.0 and R > 0.0 and Period > 0.0,
          Post => Pulsar_Magnetic_Field'Result > 0.0
   is
   begin
      return 1.0e12 * (M / M_SUN) ** 0.5 * (0.001 / Period) ** 2.0;
   end Pulsar_Magnetic_Field;

   -- 3.5 Rayon de Roche (limite de disruption)
   function Roche_Radius (M_BH, M_Pulsar, R_Pulsar : Float) return Float
     with Pre => M_BH > 0.0 and M_Pulsar > 0.0 and R_Pulsar > 0.0,
          Post => Roche_Radius'Result > 0.0
   is
   begin
      return 2.44 * R_Pulsar * (M_BH / M_Pulsar) ** (1.0 / 3.0);
   end Roche_Radius;

   -- 3.6 Énergie orbitale
   function Orbital_Energy (M1, M2, R : Float) return Float
     with Pre => M1 > 0.0 and M2 > 0.0 and R > 0.0,
          Post => Orbital_Energy'Result < 0.0
   is
   begin
      return -G_NEWTON * M1 * M2 / (2.0 * R);
   end Orbital_Energy;

   -- 3.7 Fréquence des ondes gravitationnelles
   function GW_Frequency (M1, M2, R : Float) return Float
     with Pre => M1 > 0.0 and M2 > 0.0 and R > 0.0,
          Post => GW_Frequency'Result > 0.0
   is
      M_total : Float := M1 + M2;
   begin
      return sqrt (G_NEWTON * M_total / (R * R * R)) / PI;
   end GW_Frequency;

   -- 3.8 Amplitude des ondes gravitationnelles
   function GW_Amplitude (M1, M2, R, Dist : Float) return Float
     with Pre => M1 > 0.0 and M2 > 0.0 and R > 0.0 and Dist > 0.0,
          Post => GW_Amplitude'Result >= 0.0
   is
   begin
      return (4.0 * G_NEWTON * M1 * M2) / (Dist * C_LIGHT * C_LIGHT * R);
   end GW_Amplitude;

   -- 3.9 Énergie des ondes gravitationnelles
   function GW_Energy (M1, M2, R : Float) return Float
     with Pre => M1 > 0.0 and M2 > 0.0 and R > 0.0,
          Post => GW_Energy'Result >= 0.0
   is
      Mu : Float := (M1 * M2) / (M1 + M2);
      M_total : Float := M1 + M2;
   begin
      return 0.1 * Mu * C_LIGHT * C_LIGHT * (Schwarzschild_Radius (M_total) / R);
   end GW_Energy;

   -- 3.10 Luminosité d'accrétion
   function Accretion_Luminosity (M_BH, Accretion_Rate : Float) return Float
     with Pre => M_BH > 0.0 and Accretion_Rate > 0.0,
          Post => Accretion_Luminosity'Result >= 0.0
   is
   begin
      return 0.1 * Accretion_Rate * C_LIGHT * C_LIGHT;
   end Accretion_Luminosity;

   -- 3.11 Rayonnement X
   function XRay_Luminosity (L : Float) return Float
     with Pre => L >= 0.0,
          Post => XRay_Luminosity'Result >= 0.0
   is
   begin
      return 0.1 * L;
   end XRay_Luminosity;

   -- 3.12 Rayonnement gamma
   function Gamma_Luminosity (L : Float; Spin : Float) return Float
     with Pre => L >= 0.0 and Spin in 0.0 .. 1.0,
          Post => Gamma_Luminosity'Result >= 0.0
   is
   begin
      return 0.05 * L * Spin;
   end Gamma_Luminosity;

   -- 3.13 Neutrinos
   function Neutrino_Luminosity (L : Float) return Float
     with Pre => L >= 0.0,
          Post => Neutrino_Luminosity'Result >= 0.0
   is
   begin
      return 0.01 * L;
   end Neutrino_Luminosity;

   -- 3.14 Champ magnétique du trou noir
   function BH_Magnetic_Field (M, R : Float) return Float
     with Pre => M > 0.0 and R > 0.0,
          Post => BH_Magnetic_Field'Result > 0.0
   is
   begin
      return 1.0e4 * (Schwarzschild_Radius (M) / R) ** 1.5;
   end BH_Magnetic_Field;

   -- 3.15 Potentiel de phase
   function Engulfment_Phase_Potential (M, R : Float) return Float
     with Pre => M > 0.0 and R > 0.0,
          Post => Engulfment_Phase_Potential'Result <= 0.0
   is
   begin
      return PHI_CRITICAL * (1.0 - Schwarzschild_Radius (M) / R);
   end Engulfment_Phase_Potential;

   -- 3.16 Cohérence
   function Engulfment_Coherence (Phi : Float) return Float
     with Pre => Phi <= 0.0,
          Post => Engulfment_Coherence'Result in 0.0 .. 100.0
   is
   begin
      if Phi >= PHI_CRITICAL then
         return 100.0;
      elsif Phi < -10.0 then
         return 0.0;
      else
         return 100.0 * (1.0 - (PHI_CRITICAL - Phi) / abs (PHI_CRITICAL));
      end if;
   end Engulfment_Coherence;

   -- 3.17 Spin du pulsar (évolution)
   function Pulsar_Spin_Evolution (Spin_Initial : Float; Age_s : Float) return Float
     with Pre => Spin_Initial in 0.0 .. 1.0 and Age_s >= 0.0,
          Post => Pulsar_Spin_Evolution'Result in 0.0 .. 1.0
   is
   begin
      return Spin_Initial * exp (-Age_s / 1.0e12);
   end Pulsar_Spin_Evolution;

   -- ========================================================================
   -- 4. SIMULATION DE L'ENFOUISSEMENT
   -- ========================================================================

   function Simulate_Engulfment
     (BH_Mass_Solar, Pulsar_Mass_Solar : Float;
      BH_Spin_Initial, Pulsar_Spin_Initial : Float)
      return V3_Engulfment_State
     with Pre => BH_Mass_Solar > 0.0 and Pulsar_Mass_Solar > 0.0 and
                 BH_Spin_Initial in 0.0 .. 1.0 and Pulsar_Spin_Initial in 0.0 .. 1.0,
          Post => Simulate_Engulfment'Result.Checksum = 9
   is
      State : V3_Engulfment_State;
      M_BH  : Float := BH_Mass_Solar * M_SUN;
      M_Pul : Float := Pulsar_Mass_Solar * M_SUN;
      Spin_BH : Float := BH_Spin_Initial;
      Spin_Pul : Float := Pulsar_Spin_Initial;
      R_BH  : Float := Schwarzschild_Radius (M_BH);
      R_Pul : Float := Pulsar_Radius (M_Pul);
      Per   : Float := Pulsar_Period (Spin_Pul);
      B_Pul : Float := Pulsar_Magnetic_Field (M_Pul, R_Pul, Per);
      Dist  : Float := Roche_Radius (M_BH, M_Pul, R_Pul) * 10.0;
      R_Roche : Float := Roche_Radius (M_BH, M_Pul, R_Pul);
      Time  : Float := 0.0;
      DT    : Float := 1.0e3;  -- Pas de temps (s)
      Stage : Engulfment_Stage := Orbit;
      Spiraling : Boolean := True;
      Merging : Boolean := False;
      GW_Emitting : Boolean := False;
      Emitting : Boolean := False;
      Disrupted : Boolean := False;
      E_orb : Float := 0.0;
      E_GW : Float := 0.0;
      GW_f : Float := 0.0;
      GW_A : Float := 0.0;
      L_Lum : Float := 0.0;
      X_Lum : Float := 0.0;
      G_Lum : Float := 0.0;
      N_Lum : Float := 0.0;
      B_Field : Float := 0.0;
      Phi    : Float := 0.0;
      Coh    : Float := 0.0;
      M_rem  : Float := 0.0;
      Spin_rem : Float := 0.0;
      R_rem  : Float := 0.0;
      V_orb  : Float := 0.0;
      Acc_Rate : Float := 0.0;
   begin
      -- Initialisation
      State.BH_Mass_kg := M_BH;
      State.BH_Spin := Spin_BH;
      State.BH_Radius_m := R_BH;
      State.Pulsar_Mass_kg := M_Pul;
      State.Pulsar_Radius_m := R_Pul;
      State.Pulsar_Period_s := Per;
      State.Pulsar_Magnetic_T := B_Pul;
      State.Pulsar_Spin := Spin_Pul;
      State.Distance_m := Dist;
      State.Orbital_Energy_J := Orbital_Energy (M_BH, M_Pul, Dist);
      State.Angular_Momentum := 0.0;
      State.GW_Frequency_Hz := 0.0;
      State.GW_Amplitude := 0.0;
      State.GW_Energy_J := 0.0;
      State.Roche_Radius_m := R_Roche;
      State.Is_Disrupted := False;
      State.Remnant_Mass_kg := M_BH + M_Pul;
      State.Remnant_Spin := 0.0;
      State.Remnant_Radius_m := 0.0;
      State.Luminosity_W := 0.0;
      State.XRay_Luminosity_W := 0.0;
      State.Gamma_Luminosity_W := 0.0;
      State.Neutrino_Luminosity_W := 0.0;
      State.Phase_Potential := PHI_CRITICAL;
      State.Coherence := 100.0;
      State.Magnetic_Field_T := 0.0;
      State.Time_s := Time;
      State.Time_Step_s := DT;
      State.Stage := Stage;
      State.Is_Spiraling := Spiraling;
      State.Is_Merging := Merging;
      State.Has_GW := GW_Emitting;
      State.Is_Emitting := Emitting;
      State.Checksum := 9;

      -- Boucle principale de simulation
      while Dist > 0.0 and Time < 1.0e8 loop
         pragma Loop_Invariant (Time >= 0.0);
         pragma Loop_Invariant (State.Checksum = 9);

         -- Mise à jour de la distance (spirale)
         V_orb := sqrt (G_NEWTON * (M_BH + M_Pul) / Dist);
         Dist := Dist - V_orb * DT * 0.01;

         -- 1. Vérification de la disruption
         if Dist < R_Roche and not Disrupted then
            Disrupted := True;
            State.Is_Disrupted := True;
            Stage := Tidal_Disruption;
            State.Stage := Stage;
            -- Le pulsar est déchiré par les forces de marée
            Emitting := True;
            State.Is_Emitting := True;
            -- Accrétion massive
            Acc_Rate := 1.0e15 * (R_Roche / Dist) ** 1.5;
         end if;

         -- 2. Calcul de l'énergie orbitale
         E_orb := Orbital_Energy (M_BH, M_Pul, Dist);

         -- 3. Ondes gravitationnelles
         if Dist < R_Roche * 5.0 then
            GW_Emitting := True;
            GW_f := GW_Frequency (M_BH, M_Pul, Dist);
            GW_A := GW_Amplitude (M_BH, M_Pul, Dist, 1.0e22);
            E_GW := GW_Energy (M_BH, M_Pul, Dist);
            State.Has_GW := True;
            State.Is_Spiraling := True;
            Stage := Spiral;
            State.Stage := Stage;
         end if;

         -- 4. Luminosité d'accrétion
         if Disrupted then
            L_Lum := Accretion_Luminosity (M_BH, Acc_Rate);
            X_Lum := XRay_Luminosity (L_Lum);
            G_Lum := Gamma_Luminosity (L_Lum, Spin_BH);
            N_Lum := Neutrino_Luminosity (L_Lum);
            B_Field := BH_Magnetic_Field (M_BH, Dist);
            Phi := Engulfment_Phase_Potential (M_BH, Dist);
            Coh := Engulfment_Coherence (Phi);
            Emitting := True;
            State.Is_Emitting := True;

            -- Croissance du trou noir par accrétion
            M_BH := M_BH + Acc_Rate * DT * 0.1;
            R_BH := Schwarzschild_Radius (M_BH);
         end if;

         -- 5. Fusion
         if Dist < R_BH * 2.0 then
            Merging := True;
            State.Is_Merging := True;
            Stage := Merger;
            State.Stage := Stage;

            -- Formation du remnant
            M_rem := M_BH + M_Pul * 0.5;
            Spin_rem := (Spin_BH * M_BH + Spin_Pul * M_Pul * 0.1) / (M_rem);
            R_rem := Schwarzschild_Radius (M_rem);
            Stage := Remnant;
            State.Stage := Stage;

            -- Énergie finale
            L_Lum := Accretion_Luminosity (M_rem, Acc_Rate * 10.0);
            X_Lum := XRay_Luminosity (L_Lum);
            G_Lum := Gamma_Luminosity (L_Lum, Spin_rem);
            N_Lum := Neutrino_Luminosity (L_Lum);
            B_Field := BH_Magnetic_Field (M_rem, R_rem);
            Phi := Engulfment_Phase_Potential (M_rem, R_rem);
            Coh := Engulfment_Coherence (Phi);
            Emitting := True;
            State.Is_Emitting := True;

            -- 6. Évaporation
            if Time > 1.0e7 then
               Stage := Evaporation;
               State.Stage := Stage;
               M_rem := M_rem - (L_Lum / (C_LIGHT * C_LIGHT)) * DT * 0.01;
            end if;

            exit;
         end if;

         -- Mise à jour de l'état
         State.BH_Mass_kg := M_BH;
         State.BH_Spin := Spin_BH;
         State.BH_Radius_m := R_BH;
         State.Pulsar_Mass_kg := M_Pul;
         State.Pulsar_Radius_m := R_Pul;
         State.Pulsar_Period_s := Pulsar_Period (Spin_Pul);
         State.Pulsar_Magnetic_T := Pulsar_Magnetic_Field (M_Pul, R_Pul, State.Pulsar_Period_s);
         State.Pulsar_Spin := Spin_Pul;
         State.Distance_m := Dist;
         State.Orbital_Energy_J := E_orb;
         State.Angular_Momentum := M_BH * M_Pul * sqrt (G_NEWTON * (M_BH + M_Pul) / Dist);
         State.GW_Frequency_Hz := GW_f;
         State.GW_Amplitude := GW_A;
         State.GW_Energy_J := E_GW;
         State.Roche_Radius_m := Roche_Radius (M_BH, M_Pul, R_Pul);
         State.Remnant_Mass_kg := M_rem;
         State.Remnant_Spin := Spin_rem;
         State.Remnant_Radius_m := R_rem;
         State.Luminosity_W := L_Lum;
         State.XRay_Luminosity_W := X_Lum;
         State.Gamma_Luminosity_W := G_Lum;
         State.Neutrino_Luminosity_W := N_Lum;
         State.Phase_Potential := Phi;
         State.Coherence := Coh;
         State.Magnetic_Field_T := B_Field;
         State.Time_s := Time;
         State.Time_Step_s := DT;
         State.Stage := Stage;
         State.Is_Spiraling := Spiraling;
         State.Is_Merging := Merging;
         State.Has_GW := GW_Emitting;
         State.Is_Emitting := Emitting;

         -- Incrément du temps
         Time := Time + DT;
      end loop;

      return State;
   end Simulate_Engulfment;

   -- ========================================================================
   -- 5. FONCTIONS DE TEST
   -- ========================================================================

   function All_Tests_Pass (State : V3_Engulfment_State) return Boolean
     with Post => All_Tests_Pass'Result in True | False
   is
   begin
      if State.Coherence < 0.0 or State.Coherence > 100.0 then
         return False;
      end if;
      if State.Distance_m < 0.0 then
         return False;
      end if;
      if State.GW_Energy_J < 0.0 then
         return False;
      end if;
      if State.Luminosity_W < 0.0 then
         return False;
      end if;
      if State.Remnant_Mass_kg < 0.0 then
         return False;
      end if;
      if State.Phase_Potential > 0.0 then
         return False;
      end if;
      if State.Stage not in Orbit .. Evaporation then
         return False;
      end if;
      return True;
   end All_Tests_Pass;

   -- ========================================================================
   -- 6. PROGRAMME PRINCIPAL
   -- ========================================================================

   State : V3_Engulfment_State;
   Passed : Boolean;

begin

   Put_Line ("================================================================================");
   Put_Line ("V3 BH + PULSAR ENGULFMENT SIMULATION — COMPLETE UNIFICATION");
   Put_Line ("================================================================================");
   New_Line;

   Put_Line ("INVARIANTS V3 (LOCKED — NO ADJUSTMENT ALLOWED)");
   Put_Line ("  Ψ_V3          = " & Float'Image (PSI_V3) & " kg·m⁻²");
   Put_Line ("  Φ_critical    = " & Float'Image (PHI_CRITICAL) & " V (-51.1 mV)");
   Put_Line ("  K             = " & Integer'Image (K_CYCLES));
   Put_Line ("  ρ_cond        = " & Float'Image (RHO_COND) & " kg·m⁻³");
   Put_Line ("  ν_phase       = " & Float'Image (NU_PHASE) & " Hz");
   Put_Line ("  β             = " & Float'Image (BETA));
   New_Line;

   -- ========================================================================
   -- 7. SIMULATION
   -- ========================================================================

   Put_Line ("--- SIMULATION DE L'ENFOUISSEMENT (BH = 10 M☉, Pulsar = 1.4 M☉, Spin BH = 0.9, Spin Pulsar = 0.9) ---");
   New_Line;

   State := Simulate_Engulfment (10.0, 1.4, 0.9, 0.9);

   Put_Line ("Résultats de la simulation :");
   Put_Line ("  BH Masse      = " & Float'Image (State.BH_Mass_kg / M_SUN) & " M☉");
   Put_Line ("  BH Spin       = " & Float'Image (State.BH_Spin));
   Put_Line ("  BH Rayon      = " & Float'Image (State.BH_Radius_m) & " m");
   Put_Line ("  Pulsar Masse  = " & Float'Image (State.Pulsar_Mass_kg / M_SUN) & " M☉");
   Put_Line ("  Pulsar Rayon  = " & Float'Image (State.Pulsar_Radius_m) & " km");
   Put_Line ("  Pulsar Période= " & Float'Image (State.Pulsar_Period_s * 1000.0) & " ms");
   Put_Line ("  Pulsar B      = " & Float'Image (State.Pulsar_Magnetic_T / 1.0e12) & " ×10¹² T");
   Put_Line ("  Distance      = " & Float'Image (State.Distance_m / 1.0e3) & " km");
   Put_Line ("  Roche Rayon   = " & Float'Image (State.Roche_Radius_m / 1.0e3) & " km");
   Put_Line ("  Disruption    = " & Boolean'Image (State.Is_Disrupted));
   Put_Line ("  GW Frequency  = " & Float'Image (State.GW_Frequency_Hz) & " Hz");
   Put_Line ("  GW Amplitude  = " & Float'Image (State.GW_Amplitude));
   Put_Line ("  GW Energy     = " & Float'Image (State.GW_Energy_J / 1.0e46) & " ×10⁴⁶ J");
   Put_Line ("  Remnant Masse = " & Float'Image (State.Remnant_Mass_kg / M_SUN) & " M☉");
   Put_Line ("  Remnant Spin  = " & Float'Image (State.Remnant_Spin));
   Put_Line ("  Remnant Rayon = " & Float'Image (State.Remnant_Radius_m) & " m");
   Put_Line ("  Luminosité    = " & Float'Image (State.Luminosity_W / 1.0e46) & " ×10⁴⁶ W");
   Put_Line ("  Rayons X      = " & Float'Image (State.XRay_Luminosity_W / 1.0e46) & " ×10⁴⁶ W");
   Put_Line ("  Rayons gamma  = " & Float'Image (State.Gamma_Luminosity_W / 1.0e46) & " ×10⁴⁶ W");
   Put_Line ("  Neutrinos     = " & Float'Image (State.Neutrino_Luminosity_W / 1.0e46) & " ×10⁴⁶ W");
   Put_Line ("  Cohérence     = " & Float'Image (State.Coherence) & " %");
   Put_Line ("  Phase pot.    = " & Float'Image (State.Phase_Potential * 1000.0) & " mV");
   Put_Line ("  Champ B       = " & Float'Image (State.Magnetic_Field_T) & " T");
   Put_Line ("  Étape         = " & Engulfment_Stage'Image (State.Stage));
   Put_Line ("  Spirale       = " & Boolean'Image (State.Is_Spiraling));
   Put_Line ("  Fusion        = " & Boolean'Image (State.Is_Merging));
   Put_Line ("  GW émis       = " & Boolean'Image (State.Has_GW));
   Put_Line ("  Émission      = " & Boolean'Image (State.Is_Emitting));
   New_Line;

   -- ========================================================================
   -- 8. TESTS
   -- ========================================================================

