# 7. TESTS IA (UTM Collision)
# ============================================================

class TestIA:
    """Tests du module IA (UTM)"""
    
    @staticmethod
    def test_utm_safety():
        """Test des règles de sécurité UTM"""
        def compute_utm(state):
            combined = abs(state.relative_x) + abs(state.relative_y) + abs(state.relative_z)
            
            # Règle 1 : Défaillance des capteurs
            if state.sensor_reliability < 400:
                return UTM_State(integrity=3, braking=100, evasion_z=-1000)
            
            # Règle 2 : Collision imminente
            if combined < 5000 and state.approach_velocity > 2000:
                evasion = 5000 if state.relative_z >= 0 else -5000
                return UTM_State(integrity=2, braking=100, evasion_z=evasion)
            
            # Règle 3 : Alerte de proximité
            if 5000 <= combined < 20000:
                braking = min(state.approach_velocity // 500, 100)
                evasion = state.relative_z // 20
                return UTM_State(integrity=1, braking=braking, evasion_z=evasion)
            
            # Règle 4 : Nominal
            return UTM_State(integrity=0, braking=0, evasion_z=0)
        
        # Test Règle 1
        s = UTM_State(sensor_reliability=300)
        r = compute_utm(s)
        assert r.integrity == 3, "Sensor failure devrait déclencher Integrity=3"
        
        # Test Règle 2
        s = UTM_State(relative_x=2000, relative_y=1000, relative_z=500,
                      approach_velocity=3000)
        r = compute_utm(s)
        assert r.integrity == 2, "Collision imminente devrait déclencher Integrity=2"
        assert r.evasion_z == 5000, "Devrait monter pour éviter l'obstacle"
        
        # Test Règle 3
        s = UTM_State(relative_x=8000, relative_y=4000, relative_z=2000,
                      approach_velocity=1500)
        r = compute_utm(s)
        assert r.integrity == 1, "Alerte de proximité devrait déclencher Integrity=1"
        
        # Test Règle 4
        s = UTM_State(relative_x=20000, relative_y=0, relative_z=0)
        r = compute_utm(s)
        assert r.integrity == 0, "Nominal devrait être Integrity=0"
        
        print("✅ UTM Safety : OK")

