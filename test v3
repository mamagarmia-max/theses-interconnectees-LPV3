# 4. TESTS PHYSIQUE (c_phi, Lorentz, Photonic)
# ============================================================

class TestPhysics:
    """Tests du module Physics"""
    
    @staticmethod
    def test_c_phi():
        """Test de la vitesse de phase"""
        c_phi = (BETA * ALPHA * C) / K_CYCLES
        expected = 2.93e6
        error = abs(c_phi - expected) / expected * 100
        assert error < 5, f"c_phi = {c_phi:.2e}, attendu {expected:.2e}, erreur {error:.2f}%"
        print(f"✅ c_phi = {c_phi:.2e} m/s")
    
    @staticmethod
    def test_lorentz_gamma():
        """Test du facteur de Lorentz"""
        def gamma(v):
            if v >= C:
                return 1.0
            beta = v / C
            return 1.0 / math.sqrt(1.0 - beta * beta)
        
        assert gamma(0.0) == 1.0, "γ(0) devrait être 1.0"
        print("✅ Lorentz Gamma : OK")
    
    @staticmethod
    def test_photonic_communication():
        """Test de la communication photonique (collagène)"""
        distance = 1800  # mm (1.8 m)
        c_ns = 300_000   # nm/ns
        photonic_time = distance // c_ns  # ns
        chemical_time = distance * distance // 2  # ns
        assert photonic_time < chemical_time, "La communication photonique devrait être plus rapide"
        print(f"✅ Photonic : {photonic_time} ns vs {chemical_time} ns")

