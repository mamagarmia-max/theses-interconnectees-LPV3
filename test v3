# 10. Z3 (SMT) — VÉRIFICATION DE COHÉRENCE
# ============================================================

class TestZ3:
    """Tests avec le solveur SMT Z3"""
    
    @staticmethod
    def test_no_contradiction():
        """Vérification qu'aucune contradiction n'existe"""
        s = Solver()
        
        # Déclaration des constantes
        psi, phi, k, modulo = Reals('psi phi'), Int('k'), Int('modulo')
        
        # Axiomes
        s.add(psi == 48016.8)
        s.add(phi == -51.1)
        s.add(k == 7)
        s.add(modulo == 9)
        
        # Vérification de cohérence
        assert s.check() == sat, "Z3 détecte une contradiction !"
        print("✅ Z3 : Aucune contradiction détectée")
    
    @staticmethod
    def test_invariant_modulo_9():
        """Vérification que Modulo-9 = 9 est un invariant"""
        s = Solver()
        
        # Déclaration des variables
        n = Int('n')
        dr = Int('dr')
        
        # Digital Root formula
        s.add(n >= 0)
        s.add(dr == 1 + ((n - 1) % 9))
        s.add(n == 48016)  # Ψ_V3 partie entière
        
        # Vérification que dr = 9
        s.add(dr != 9)
        
        # Si unsat, alors dr = 9 est un invariant
        assert s.check() == unsat, "Modulo-9 n'est pas un invariant !"
        print("✅ Z3 : Modulo-9 = 9 est un invariant")

