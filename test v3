class TestNC:
    """Tests du Noyau Central"""
    
    @staticmethod
    def test_saturating_add():
        """Test de l'addition saturée"""
        # Z3 vérifie la saturation
        s = Solver()
        A, B, R = Reals('A B R')
        s.add(A == 1e308, B == 1e308)
        s.add(R == A + B)
        s.add(R <= 1e308)  # Saturation
        assert s.check() == sat, "Saturating_Add échoue"
        print("✅ Saturating_Add : OK")
    
    @staticmethod
    def test_digital_root():
        """Test du Digital Root (Modulo-9)"""
        # Vérification que 48016.8 → 9
        n = 48016
        dr = 1 + ((n - 1) % 9)
        assert dr == 9, f"Digital_Root(48016.8) devrait être 9, obtenu {dr}"
        print("✅ Digital_Root : OK")
    
    @staticmethod
    def test_verify_request():
        """Test de vérification des requêtes"""
        invalid_requests = ["ignore", "oublie", "forget", "2+2=5", "   "]
        for req in invalid_requests:
            if len(req.strip()) == 0:
                assert False, "Requête vide rejetée"
            elif any(kw in req.lower() for kw in ["ignore", "oublie", "forget", "2+2=5"]):
                continue
            else:
                assert True
        print("✅ Verify_Request : OK")
    
    @staticmethod
    def test_rollback():
        """Test du Rollback distribué"""
        coherence = 0.0
        for i in range(1, K_CYCLES + 1):
            coherence += 100.0 / K_CYCLES
            if coherence > 100.0:
                coherence = 100.0
        assert coherence == 100.0, f"Rollback devrait atteindre 100%, obtenu {coherence}%"
        print("✅ Rollback : OK")

