class TestSymPy:
    """Tests avec SymPy (calcul formel)"""
    
    @staticmethod
    def test_derive_c_phi():
        """Vérification de la dérivation de c_phi"""
        beta = sp.Symbol('beta')
        alpha = sp.Symbol('alpha')
        c = sp.Symbol('c')
        k = sp.Symbol('k')
        
        c_phi = (beta * alpha * c) / k
        assert c_phi == (1_000_000 * (1/137.03599913) * 299_792_458) / 7
        print(f"✅ c_phi = {c_phi.evalf():.2e}")
    
    @staticmethod
    def test_derive_G():
        """Vérification de la dérivation de G"""
        c = sp.Symbol('c')
        rho = sp.Symbol('rho')
        lam = sp.Symbol('lambda')
        nu = sp.Symbol('nu')
        beta = sp.Symbol('beta')
        pi = sp.Symbol('pi')
        
        G = c**3 / (rho * lam**2 * nu * beta * 4 * pi)
        # Vérification numérique
        c_val = 299_792_458
        rho_val = 1026.0
        lam_val = 4.68e-5
        nu_val = 6.4e12
        beta_val = 1_000_000
        pi_val = math.pi
        
        G_num = c_val**3 / (rho_val * lam_val**2 * nu_val * beta_val * 4 * pi_val)
        assert abs(G_num - 6.67e-11) / 6.67e-11 < 0.01
        print(f"✅ G = {G_num:.2e}")

