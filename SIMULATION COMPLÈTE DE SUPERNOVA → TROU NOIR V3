with Ada.Text_IO; use Ada.Text_IO;
with Ada.Float_Text_IO; use Ada.Float_Text_IO;
with Ada.Integer_Text_IO; use Ada.Integer_Text_IO;
with Ada.Numerics; use Ada.Numerics;
with Ada.Numerics.Elementary_Functions; use Ada.Numerics.Elementary_Functions;

procedure V3_SN_to_BH_Full with
   SPARK_Mode => On
is

   -- ========================================================================
   -- 1. V3 INVARIANTS (VERROUILLÉS)
   -- ========================================================================

   PSI_V3          : constant := 48016.8;          -- kg·m⁻²
   PHI_CRITICAL    : constant := -0.0511;          -- V (-51.1 mV)
   K_CYCLES        : constant := 7;                -- Clôture heptadique
   RHO_COND        : constant := 1026.0;           -- kg·m⁻³
   NU_PHASE        : constant := 6.4e12;           -- Hz
   BETA            : constant := 1_000_000.0;      -- Facteur d'échelle
   ALPHA_FS        : constant := 7.29735256e-3;    -- Structure fine
   C_LIGHT         : constant := 299_792_458.0;    -- m/s
   HBAR            : constant := 1.054571817e-34;  -- J·s
   E_CHARGE        : constant := 1.602176634e-19;  -- C
   M_P             : constant := 1.67262192e-27;   -- kg
   G_NEWTON        : constant := 6.67430e-11;      -- m³·kg⁻¹·s⁻²
   M_SUN           : constant := 1.98847e30;       -- kg
   K_B             : constant := 1.380649e-23;     -- J/K
   PI              : constant := Ada.Numerics.Pi;

   -- ========================================================================
   -- 2. TYPES V3
   -- ========================================================================

   type SN_Stage is (Main_Sequence, Core_Helium, Core_Carbon, Core_Neon, Core_Oxygen,
                     Core_Silicon, Core_Collapse, Bounce, Explosion, BH_Formation, Remnant);

   type V3_SN_to_BH_State is record
      -- Paramètres de l'étoile
      Mass_Solar       : Float;
      Radius_m         : Float;
      Core_Temperature : Float;                     -- K
      Core_Density     : Float;                     -- kg/m³
      Core_Element_Z   : Integer;                   -- Élément du cœur (Z)
      Mass_Remaining   : Float;                     -- Masse restante (kg)

      -- Paramètres du trou noir
      BH_Mass_kg       : Float;
      BH_Radius_m      : Float;
      BH_Spin          : Float range 0.0 .. 1.0;

      -- Énergie de fusion
      Fusion_Energy_J  : Float;

      -- Explosion
      Ejecta_Mass_kg   : Float;
      Explosion_Energy_J : Float;

      -- Rayonnements
      Luminosity_W     : Float;
      XRay_Luminosity_W: Float;
      Gamma_Luminosity_W : Float;
      Neutrino_Luminosity_W : Float;

      -- Paramètres de phase
      Phase_Potential  : Float;
      Coherence        : Float range 0.0 .. 100.0;

      -- Temps
      Time_s           : Float;
      Time_Step_s      : Float;
      Stage            : SN_Stage;

      -- Drapeaux
      Is_Collapsing    : Boolean;
      Is_Exploding     : Boolean;
      Has_BH           : Boolean;
      Is_Emitting      : Boolean;
      Checksum         : Integer range 1 .. 9 := 9;
   end record
     with Predicate => V3_SN_to_BH_State.Checksum = 9;

   -- ========================================================================
   -- 3. FONCTIONS DE SIMULATION V3
   -- ========================================================================

   -- 3.1 Rayon de Schwarzschild
   function Schwarzschild_Radius (M : Float) return Float
     with Pre => M > 0.0,
          Post => Schwarzschild_Radius'Result > 0.0
   is
   begin
      return 2.0 * G_NEWTON * M / (C_LIGHT * C_LIGHT);
   end Schwarzschild_Radius;

   -- 3.2 Pression gravitationnelle
   function Gravitational_Pressure (M, R : Float) return Float
     with Pre => M > 0.0 and R > 0.0,
          Post => Gravitational_Pressure'Result > 0.0
   is
   begin
      return (3.0 * G_NEWTON * M * M) / (8.0 * PI * R * R * R * R);
   end Gravitational_Pressure;

   -- 3.3 Pression de phase
   function Phase_Pressure (M, R : Float; Phi : Float) return Float
     with Pre => M > 0.0 and R > 0.0 and Phi < 0.0,
          Post => Phase_Pressure'Result > 0.0
   is
   begin
      return (PSI_V3 * abs (Phi) * M) / (R * R * R * R);
   end Phase_Pressure;

   -- 3.4 Pression de fusion
   function Fusion_Pressure (T, Rho : Float; Z : Integer) return Float
     with Pre => T >= 0.0 and Rho > 0.0 and Z > 0,
          Post => Fusion_Pressure'Result >= 0.0
   is
   begin
      if T < 1.0e7 then
         return 0.0;
      else
         return Rho * K_B * T / (M_P * Float (Z) * (1.0 + ALPHA_FS / Float (K_CYCLES)));
      end if;
   end Fusion_Pressure;

   -- 3.5 Élément du cœur (synthèse)
   function Core_Element_Synthesis (T : Float) return Integer
     with Pre => T >= 0.0,
          Post => Core_Element_Synthesis'Result in 1 .. 26
   is
   begin
      if T < 1.0e7 then
         return 1;   -- Hydrogène
      elsif T < 1.0e8 then
         return 6;   -- Carbone
      elsif T < 5.0e8 then
         return 8;   -- Oxygène
      elsif T < 1.0e9 then
         return 14;  -- Silicium
      elsif T < 2.0e9 then
         return 26;  -- Fer
      else
         return 26;  -- Fer (point final)
      end if;
   end Core_Element_Synthesis;

   -- 3.6 Énergie de fusion
   function Fusion_Energy_Rate (T, Rho : Float; Z : Integer) return Float
     with Pre => T >= 0.0 and Rho > 0.0 and Z > 0,
          Post => Fusion_Energy_Rate'Result >= 0.0
   is
      E_bind : Float := 8.8e6 * E_CHARGE * Float (Z + Z);
      Rate   : Float := T ** 4.0 / (1.0e56) * (Rho / 1.0e5) ** 2.0;
   begin
      return E_bind * Rate;
   end Fusion_Energy_Rate;

   -- 3.7 Luminosité de la supernova
   function SN_Luminosity (M, T, Rho : Float) return Float
     with Pre => M > 0.0 and T >= 0.0 and Rho > 0.0,
          Post => SN_Luminosity'Result >= 0.0
   is
   begin
      return 1.0e38 * (M / M_SUN) ** 2.5 * (T / 1.0e9) ** 4.0 * (Rho / 1.0e5) ** 0.5;
   end SN_Luminosity;

   -- 3.8 Rayonnement X
   function SN_XRay_Luminosity (L : Float) return Float
     with Pre => L >= 0.0,
          Post => SN_XRay_Luminosity'Result >= 0.0
   is
   begin
      return 0.1 * L;
   end SN_XRay_Luminosity;

   -- 3.9 Rayonnement gamma
   function SN_Gamma_Luminosity (L : Float) return Float
     with Pre => L >= 0.0,
          Post => SN_Gamma_Luminosity'Result >= 0.0
   is
   begin
      return 0.01 * L;
   end SN_Gamma_Luminosity;

   -- 3.10 Neutrinos de supernova
   function SN_Neutrino_Luminosity (L : Float) return Float
     with Pre => L >= 0.0,
          Post => SN_Neutrino_Luminosity'Result >= 0.0
   is
   begin
      return 0.5 * L;   -- Les supernovae émettent 50% de leur énergie en neutrinos
   end SN_Neutrino_Luminosity;

   -- 3.11 Potentiel de phase
   function SN_Phase_Potential (M, R : Float) return Float
     with Pre => M > 0.0 and R > 0.0,
          Post => SN_Phase_Potential'Result <= 0.0
   is
   begin
      return PHI_CRITICAL * (1.0 - Schwarzschild_Radius (M) / R);
   end SN_Phase_Potential;

   -- 3.12 Cohérence
   function SN_Coherence (Phi : Float) return Float
     with Pre => Phi <= 0.0,
          Post => SN_Coherence'Result in 0.0 .. 100.0
   is
   begin
      if Phi >= PHI_CRITICAL then
         return 100.0;
      elsif Phi < -10.0 then
         return 0.0;
      else
         return 100.0 * (1.0 - (PHI_CRITICAL - Phi) / abs (PHI_CRITICAL));
      end if;
   end SN_Coherence;

   -- 3.13 Temps de vie de l'étoile
   function Stellar_Lifetime (M : Float) return Float
     with Pre => M > 0.0,
          Post => Stellar_Lifetime'Result > 0.0
   is
   begin
      return 1.0e10 * (M / M_SUN) ** (-2.5);
   end Stellar_Lifetime;

   -- 3.14 Masse du trou noir
   function BH_Mass_From_SN (M_Initial, M_Ejecta : Float) return Float
     with Pre => M_Initial > 0.0 and M_Ejecta >= 0.0,
          Post => BH_Mass_From_SN'Result >= 0.0
   is
   begin
      return M_Initial - M_Ejecta;
   end BH_Mass_From_SN;

   -- ========================================================================
   -- 4. SIMULATION DE LA SUPERNOVA → TROU NOIR
   -- ========================================================================

   function Simulate_SN_to_BH (Initial_Mass : Float) return V3_SN_to_BH_State
     with Pre => Initial_Mass > 0.0,
          Post => Simulate_SN_to_BH'Result.Checksum = 9
   is
      State : V3_SN_to_BH_State;
      M_kg  : Float := Initial_Mass * M_SUN;
      M_rem : Float := M_kg;
      R     : Float := 1.0e9 * (Initial_Mass / 10.0) ** 0.5;
      T     : Float := 1.0e7;  -- Température initiale (K)
      Rho   : Float := 1.0e5;  -- Densité initiale (kg/m³)
      Z     : Integer := 1;    -- Élément du cœur
      Time  : Float := 0.0;
      DT    : Float := 1.0e6;  -- Pas de temps (s)
      Stage : SN_Stage := Main_Sequence;
      Collapsing : Boolean := False;
      Exploding : Boolean := False;
      Has_BH : Boolean := False;
      Emitting : Boolean := False;
      P_grav : Float := 0.0;
      P_phase : Float := 0.0;
      P_fusion : Float := 0.0;
      E_fusion : Float := 0.0;
      L_Lum : Float := 0.0;
      X_Lum : Float := 0.0;
      G_Lum : Float := 0.0;
      N_Lum : Float := 0.0;
      Phi    : Float := 0.0;
      Coh    : Float := 0.0;
      M_ejecta : Float := 0.0;
      M_BH   : Float := 0.0;
      R_BH   : Float := 0.0;
      Spin_BH : Float := 0.0;
      Lifetime : Float := Stellar_Lifetime (M_kg);
      SN_Energy : Float := 0.0;
   begin
      -- Initialisation
      State.Mass_Solar := Initial_Mass;
      State.Radius_m := R;
      State.Core_Temperature := T;
      State.Core_Density := Rho;
      State.Core_Element_Z := Z;
      State.Mass_Remaining := M_rem;
      State.BH_Mass_kg := 0.0;
      State.BH_Radius_m := 0.0;
      State.BH_Spin := 0.0;
      State.Fusion_Energy_J := 0.0;
      State.Ejecta_Mass_kg := 0.0;
      State.Explosion_Energy_J := 0.0;
      State.Luminosity_W := 0.0;
      State.XRay_Luminosity_W := 0.0;
      State.Gamma_Luminosity_W := 0.0;
      State.Neutrino_Luminosity_W := 0.0;
      State.Phase_Potential := PHI_CRITICAL;
      State.Coherence := 100.0;
      State.Time_s := Time;
      State.Time_Step_s := DT;
      State.Stage := Stage;
      State.Is_Collapsing := Collapsing;
      State.Is_Exploding := Exploding;
      State.Has_BH := Has_BH;
      State.Is_Emitting := Emitting;
      State.Checksum := 9;

      -- Boucle principale de simulation
      while Time < Lifetime * 1.1 and M_rem > 0.0 and R > 0.0 loop
         pragma Loop_Invariant (Time >= 0.0);
         pragma Loop_Invariant (State.Checksum = 9);

         -- Mise à jour des paramètres
         P_grav := Gravitational_Pressure (M_rem, R);
         Phi := SN_Phase_Potential (M_rem, R);
         P_phase := Phase_Pressure (M_rem, R, Phi);
         P_fusion := Fusion_Pressure (T, Rho, Z);
         E_fusion := Fusion_Energy_Rate (T, Rho, Z);

         -- 1. Évolution de la température et de la densité
         T := T + E_fusion / (Rho * 1.0e3) * DT;
         Rho := Rho + E_fusion / (1.0e10) * DT;

         -- 2. Synthèse des éléments
         Z := Core_Element_Synthesis (T);
         State.Core_Element_Z := Z;

         -- 3. Évolution du rayon (légère contraction)
         R := R * (1.0 - 1.0e-10 * DT);

         -- 4. Vérification de l'effondrement
         if P_grav > (P_phase + P_fusion) * 1.1 then
            Collapsing := True;
            State.Is_Collapsing := True;
            Stage := Core_Collapse;
            State.Stage := Stage;

            -- Effondrement rapide
            R := R * 0.99;
            Rho := Rho * 1.01;
            T := T * 1.02;

            -- 5. Rebond
            if R < 1.0e6 then  -- Rayon ~1000 km
               Exploding := True;
               State.Is_Exploding := True;
               Stage := Bounce;
               State.Stage := Stage;

               -- Explosion
               SN_Energy := 0.1 * M_rem * C_LIGHT * C_LIGHT * 0.01;
               M_ejecta := M_rem * 0.8;
               M_BH := BH_Mass_From_SN (M_rem, M_ejecta);
               R_BH := Schwarzschild_Radius (M_BH);
               Spin_BH := 0.9;
               Has_BH := True;
               State.Has_BH := True;
               Stage := BH_Formation;
               State.Stage := Stage;

               -- Rayonnements
               L_Lum := SN_Luminosity (M_rem, T, Rho);
               X_Lum := SN_XRay_Luminosity (L_Lum);
               G_Lum := SN_Gamma_Luminosity (L_Lum);
               N_Lum := SN_Neutrino_Luminosity (L_Lum);
               Emitting := True;
               State.Is_Emitting := True;

               -- Potentiel de phase
               Phi := SN_Phase_Potential (M_BH, R_BH);
               Coh := SN_Coherence (Phi);
               State.Phase_Potential := Phi;
               State.Coherence := Coh;

               -- Mise à jour de l'état
               M_rem := M_BH;
               R := R_BH;
               Stage := Remnant;
               State.Stage := Stage;

               exit;
            end if;
         else
            -- Évolution normale
            Collapsing := False;
            State.Is_Collapsing := False;

            -- Fusion lente
            E_fusion := Fusion_Energy_Rate (T, Rho, Z);
            State.Fusion_Energy_J := E_fusion;

            -- Changement d'étape
            if Z = 6 and Stage = Main_Sequence then
               Stage := Core_Helium;
               State.Stage := Stage;
            elsif Z = 8 and Stage = Core_Helium then
               Stage := Core_Carbon;
               State.Stage := Stage;
            elsif Z = 14 and Stage = Core_Carbon then
               Stage := Core_Neon;
               State.Stage := Stage;
            elsif Z = 26 and Stage = Core_Neon then
               Stage := Core_Silicon;
               State.Stage := Stage;
            end if;
         end if;

         -- Mise à jour de l'état
         State.Mass_Solar := M_rem / M_SUN;
         State.Radius_m := R;
         State.Core_Temperature := T;
         State.Core_Density := Rho;
         State.Core_Element_Z := Z;
         State.Mass_Remaining := M_rem;
         State.BH_Mass_kg := M_BH;
         State.BH_Radius_m := R_BH;
         State.BH_Spin := Spin_BH;
         State.Ejecta_Mass_kg := M_ejecta;
         State.Explosion_Energy_J := SN_Energy;
         State.Luminosity_W := L_Lum;
         State.XRay_Luminosity_W := X_Lum;
         State.Gamma_Luminosity_W := G_Lum;
         State.Neutrino_Luminosity_W := N_Lum;
         State.Phase_Potential := Phi;
         State.Coherence := Coh;
         State.Time_s := Time;
         State.Time_Step_s := DT;
         State.Stage := Stage;
         State.Is_Collapsing := Collapsing;
         State.Is_Exploding := Exploding;
         State.Has_BH := Has_BH;
         State.Is_Emitting := Emitting;

         -- Incrément du temps
         Time := Time + DT;

         -- Sortie si le trou noir est formé
         exit when Has_BH;
      end loop;

      return State;
   end Simulate_SN_to_BH;

   -- ========================================================================
   -- 5. FONCTIONS DE TEST
   -- ========================================================================

   function All_Tests_Pass (State : V3_SN_to_BH_State) return Boolean
     with Post => All_Tests_Pass'Result in True | False
   is
   begin
      if State.Coherence < 0.0 or State.Coherence > 100.0 then
         return False;
      end if;
      if State.Radius_m < 0.0 then
         return False;
      end if;
      if State.Fusion_Energy_J < 0.0 then
         return False;
      end if;
      if State.Luminosity_W < 0.0 then
         return False;
      end if;
      if State.Explosion_Energy_J < 0.0 then
         return False;
      end if;
      if State.Phase_Potential > 0.0 then
         return False;
      end if;
      if State.Stage not in Main_Sequence .. Remnant then
         return False;
      end if;
      if State.Has_BH and State.BH_Mass_kg <= 0.0 then
         return False;
      end if;
      return True;
   end All_Tests_Pass;

   -- ========================================================================
   -- 6. PROGRAMME PRINCIPAL
   -- ========================================================================

   State : V3_SN_to_BH_State;
   Passed : Boolean;

begin

   Put_Line ("================================================================================");
   Put_Line ("V3 SUPERNOVA → BLACK HOLE SIMULATION — COMPLETE UNIFICATION");
   Put_Line ("================================================================================");
   New_Line;

   Put_Line ("INVARIANTS V3 (LOCKED — NO ADJUSTMENT ALLOWED)");
   Put_Line ("  Ψ_V3          = " & Float'Image (PSI_V3) & " kg·m⁻²");
   Put_Line ("  Φ_critical    = " & Float'Image (PHI_CRITICAL) & " V (-51.1 mV)");
   Put_Line ("  K             = " & Integer'Image (K_CYCLES));
   Put_Line ("  ρ_cond        = " & Float'Image (RHO_COND) & " kg·m⁻³");
   Put_Line ("  ν_phase       = " & Float'Image (NU_PHASE) & " Hz");
   Put_Line ("  β             = " & Float'Image (BETA));
   New_Line;

   -- ========================================================================
   -- 7. SIMULATION
   -- ========================================================================

   Put_Line ("--- SIMULATION D'UNE SUPERNOVA → TROU NOIR (Masse = 25 M☉) ---");
   New_Line;

   State := Simulate_SN_to_BH (25.0);

   Put_Line ("Résultats de la simulation :");
   Put_Line ("  Masse initiale = " & Float'Image (State.Mass_Solar) & " M☉");
   Put_Line ("  Rayon final    = " & Float'Image (State.Radius_m) & " m");
   Put_Line ("  T cœur         = " & Float'Image (State.Core_Temperature / 1.0e9) & " ×10⁹ K");
   Put_Line ("  Densité        = " & Float'Image (State.Core_Density) & " kg/m³");
   Put_Line ("  Élément cœur   = Z = " & Integer'Image (State.Core_Element_Z));
   Put_Line ("  Énergie fusion = " & Float'Image (State.Fusion_Energy_J / 1.0e44) & " ×10⁴⁴ J");
   Put_Line ("  Masse ejecta   = " & Float'Image (State.Ejecta_Mass_kg / M_SUN) & " M☉");
   Put_Line ("  Énergie SN     = " & Float'Image (State.Explosion_Energy_J / 1.0e44) & " ×10⁴⁴ J");
   Put_Line ("  BH Masse       = " & Float'Image (State.BH_Mass_kg / M_SUN) & " M☉");
   Put_Line ("  BH Rayon       = " & Float'Image (State.BH_Radius_m) & " m");
   Put_Line ("  BH Spin        = " & Float'Image (State.BH_Spin));
   Put_Line ("  Luminosité     = " & Float'Image (State.Luminosity_W / 1.0e46) & " ×10⁴⁶ W");
   Put_Line ("  Rayons X       = " & Float'Image (State.XRay_Luminosity_W / 1.0e46) & " ×10⁴⁶ W");
   Put_Line ("  Rayons gamma   = " & Float'Image (State.Gamma_Luminosity_W / 1.0e46) & " ×10⁴⁶ W");
   Put_Line ("  Neutrinos      = " & Float'Image (State.Neutrino_Luminosity_W / 1.0e46) & " ×10⁴⁶ W");
   Put_Line ("  Cohérence      = " & Float'Image (State.Coherence) & " %");
   Put_Line ("  Phase pot.     = " & Float'Image (State.Phase_Potential * 1000.0) & " mV");
   Put_Line ("  Étape          = " & SN_Stage'Image (State.Stage));
   Put_Line ("  Effondrement   = " & Boolean'Image (State.Is_Collapsing));
   Put_Line ("  Explosion      = " & Boolean'Image (State.Is_Exploding));
   Put_Line ("  Trou noir      = " & Boolean'Image (State.Has_BH));
   Put_Line ("  Émission       = " & Boolean'Image (State.Is_Emitting));
   New_Line;

   -- ========================================================================
   -- 8. TESTS
   -- ========================================================================

   Passed := All_Tests_Pass (State);

   Put_Line ("--- TOUS LES TESTS ---");
   New_Line;

   Put_Line ("  Test 1 (Cohérence)      : " & Boolean'Image (State.Coherence >= 0.0 and State.Coherence <= 100.0));
   Put_Line ("  Test 2 (Rayon)          : " & Boolean'Image (State.Radius_m >= 0.0));
   Put_Line ("  Test 3 (Fusion)         : " & Boolean'Image (State.Fusion_Energy_J >= 0.0));
   Put_Line ("  Test 4 (Luminosité)     : " & Boolean'Image (State.Luminosity_W >= 0.0));
   Put_Line ("  Test 5 (Explosion)      : " & Boolean'Image (State.Explosion_Energy_J >= 0.0));
   Put_Line ("  Test 6 (Phase)          : " & Boolean'Image (State.Phase_Potential < 0.0));
   Put_Line ("  Test 7 (Étape)          : " & Boolean'Image (State.Stage in Main_Sequence .. Remnant));
   Put_Line ("  Test 8 (BH)             : " & Boolean'Image (if State.Has_BH then State.BH_Mass_kg > 0.0 else True));
   New_Line;

   Put_Line ("Résultat global : " & Boolean'Image (Passed));
   New_Line;

   if Passed then
      Put_Line ("✅ TOUS LES TESTS PASSÉS — SUPERNOVA → TROU NOIR V3 VALIDÉ");
   else
      Put_Line ("⚠️ CERTAINS TESTS ÉCHOUÉS — VÉRIFIER LES PARAMÈTRES");
   end if;

   New_Line;

   -- ========================================================================
   -- 9. DÉTAILS DE L'ÉVOLUTION
   -- ========================================================================

   Put_Line ("--- DÉTAILS DE L'ÉVOLUTION ---");
   New_Line;

   Put_Line ("  1. Séquence principale :");
   Put_Line ("     Fusion H → He (Z = 1 → 2)");
   New_Line;

   Put_Line ("  2. Cœur hélium :");
   Put_Line ("     Fusion He → C (Z = 2 → 6)");
   New_Line;

   Put_Line ("  3. Cœur carbone :");
   Put_Line ("     Fusion C → Ne, O (Z = 6 → 8, 10)");
   New_Line;

   Put_Line ("  4. Cœur oxygène/silicium :");
   Put_Line ("     Fusion O, Si → Fe (Z = 26)");
   New_Line;

   Put_Line ("  5. Effondrement :");
   Put_Line ("     P_grav > P_phase + P_fusion → effondrement");
   New_Line;

   Put_Line ("  6. Rebond et explosion :");
   Put_Line ("     Cœur se comprime → rebond → explosion");
   New_Line;

   Put_Line ("  7. Formation du trou noir :");
   Put_Line ("     Cœur restant → trou noir (M_BH = " & Float'Image (State.BH_Mass_kg / M_SUN) & " M☉)");
   New_Line;

   Put_Line ("  8. Cohérence V3 :");
   Put_Line ("     Phase potentiel = -51.1 mV");
   New_Line;

   -- ========================================================================
   -- 10. CONCLUSION
   -- ========================================================================

   Put_Line ("================================================================================");
   Put_Line ("CONCLUSION");
   Put_Line ("================================================================================");
   New_Line;

