   -- ========================================================================
   -- 5. SATURATING ARITHMETIC
   -- ========================================================================

   function Saturating_Add (A, B : Float) return Float
     with
       Pre => A in -1.0e308 .. 1.0e308 and B in -1.0e308 .. 1.0e308,
       Post => Saturating_Add'Result in -1.0e308 .. 1.0e308
   is
      R : Long_Long_Float;
   begin
      R := Long_Long_Float (A) + Long_Long_Float (B);
      if R > 1.0e308 then return 1.0e308;
      elsif R < -1.0e308 then return -1.0e308;
      else return Float (R);
      end if;
   exception
      when others => return 0.0;
   end Saturating_Add;

   function Saturating_Sub (A, B : Float) return Float
     with
       Pre => A in -1.0e308 .. 1.0e308 and B in -1.0e308 .. 1.0e308,
       Post => Saturating_Sub'Result in -1.0e308 .. 1.0e308
   is
      R : Long_Long_Float;
   begin
      R := Long_Long_Float (A) - Long_Long_Float (B);
      if R > 1.0e308 then return 1.0e308;
      elsif R < -1.0e308 then return -1.0e308;
      else return Float (R);
      end if;
   exception
      when others => return 0.0;
   end Saturating_Sub;

   function Saturating_Mul (A, B : Float) return Float
     with
       Pre => A in -1.0e308 .. 1.0e308 and B in -1.0e308 .. 1.0e308,
       Post => Saturating_Mul'Result in -1.0e308 .. 1.0e308
   is
      R : Long_Long_Float;
   begin
      R := Long_Long_Float (A) * Long_Long_Float (B);
      if R > 1.0e308 then return 1.0e308;
      elsif R < -1.0e308 then return -1.0e308;
      else return Float (R);
      end if;
   exception
      when others => return 0.0;
   end Saturating_Mul;

   function Saturating_Div (A, B : Float) return Float
     with
       Pre => A in -1.0e308 .. 1.0e308 and B /= 0.0,
       Post => Saturating_Div'Result in -1.0e308 .. 1.0e308
   is
      R : Long_Long_Float;
   begin
      if B = 0.0 then
         if A >= 0.0 then return 1.0e308;
         else return -1.0e308;
         end if;
      else
         R := Long_Long_Float (A) / Long_Long_Float (B);
         if R > 1.0e308 then return 1.0e308;
         elsif R < -1.0e308 then return -1.0e308;
         else return Float (R);
         end if;
      end if;
   exception
      when others => return 0.0;
   end Saturating_Div;

   function Clamp (Value, Min, Max : Float) return Float
     with
       Pre => Min <= Max,
       Post => Clamp'Result in Min .. Max
   is
   begin
      if Value < Min then return Min;
      elsif Value > Max then return Max;
      else return Value;
      end if;
   exception
      when others => return Max;
   end Clamp;

   function Digital_Root (N : Integer) return Checksum_Type
     with
       Pre => N >= 0,
       Post => Digital_Root'Result in 1 .. 9
   is
      V : Integer := N;
      S : Integer := 0;
   begin
      if V < 0 then V := -V; end if;
      if V = 0 then return 9; end if;
      while V > 0 loop
         pragma Loop_Invariant (V >= 0 and S >= 0);
         S := S + (V mod 10);
         V := V / 10;
      end loop;
      while S > 9 loop
         pragma Loop_Invariant (S > 9);
         S := (S mod 10) + (S / 10);
      end loop;
      return Checksum_Type (S);
   exception
      when others => return 9;
   end Digital_Root;

   -- ========================================================================
   -- 6. IMPLÉMENTATION DES FONCTIONS PRINCIPALES
   -- ========================================================================

   function Init_WDM return WDM_State
   is
      State : WDM_State;
   begin
      State.Mass_WDM := 7.0;
      State.Velocity := 0.1;
      State.Phase_Density := 100.0;
      State.Coherence := 100.0;
      State.Redshift := 0.0;
      State.Flux_Longitudinal := 0.0;
      State.Mass_Effective := 0.0;
      State.Velocity_Dispersion := 0.0;
      State.Free_Streaming_Length := 0.0;
      State.Structure_Scale := 0.0;
      State.Neutrino_Flux := 0.0;
      State.Is_Detected := False;
      State.Detection_Signal := 0.0;
      State.Confidence_Score := 0.0;
      State.Status := NOMINAL;
      State.Checksum := MODULO_9;
      State.Last_Update := "Initialisation                ";
      State.Diagnosis := "Aucune WDM détectée           ";
      return State;
   end Init_WDM;

   function Compute_Effective_Mass
     (Mass_WDM : Mass_WDM_keV;
      Coherence : Coherence_Type) return Float
   is
   begin
      -- La masse effective dépend de la cohérence V3
      -- m_eff = m_WDM × (Cohérence / 100) × (1 + Ψ_V3 / 1e5)
      return Mass_WDM * (Coherence / 100.0) * (1.0 + PSI_V3 / 1.0e5);
   end Compute_Effective_Mass;

   function Compute_Velocity_Dispersion
     (Mass_Effective : Float;
      Redshift : Redshift_Type) return Float
   is
   begin
      -- σ_v ∝ (1 / m_eff) × (1 + z)
      if Mass_Effective <= 0.0 then
         return 0.0;
      end if;
      return (1.0 / Mass_Effective) * (1.0 + Redshift) * 1000.0;
   end Compute_Velocity_Dispersion;

   function Compute_Free_Streaming_Length
     (Velocity_Dispersion : Float;
      Redshift : Redshift_Type) return Float
   is
   begin
      -- L_fs = ∫ v(t) dt = σ_v / H(z) × (1 + z)
      -- Approximation : L_fs ≈ σ_v / H0 × (1 + z)^(-1/2)
      H0 : constant Float := 67.4;  -- km/s/Mpc
      if Velocity_Dispersion <= 0.0 then
         return 0.0;
      end if;
      return Velocity_Dispersion / H0 * (1.0 + Redshift) ** (-0.5);
   end Compute_Free_Streaming_Length;

   function Compute_Structure_Scale
     (Free_Streaming_Length : Float) return Float
   is
   begin
      -- L_structure ≈ L_fs (les structures se forment à l'échelle du free streaming)
      return Free_Streaming_Length;
   end Compute_Structure_Scale;

   function Compute_Sterile_Neutrino_Flux
     (State : WDM_State) return Float
   is
      -- Flux ∝ (m_WDM / 1 keV) × (Phase_Density / 100) × (Coherence / 100)
      Mass_Ratio : Float := State.Mass_WDM / 7.0;
      Phase_Factor : Float := State.Phase_Density / 100.0;
      Coherence_Factor : Float := State.Coherence / 100.0;
   begin
      return Mass_Ratio * Phase_Factor * Coherence_Factor * 0.5;
   end Compute_Sterile_Neutrino_Flux;

   function Detect_WDM
     (State : WDM_State) return Boolean
   is
   begin
      -- Détection si :
      -- 1. Flux de neutrinos stériles > 0.1
      -- 2. Cohérence > 80%
      -- 3. Longueur de free streaming > 0.1 Mpc
      if State.Neutrino_Flux > 0.1 and
         State.Coherence > 80.0 and
         State.Free_Streaming_Length > 0.1 then
         return True;
      else
         return False;
      end if;
   end Detect_WDM;

   procedure Simulate_Redshift_Evolution
     (State : in out WDM_State;
      Steps : Integer)
   is
      Step_Size : Float := 0.1;
   begin
      for I in 1 .. Steps loop
         -- Augmenter le redshift
         State.Redshift := State.Redshift + Step_Size;
         if State.Redshift > 10.0 then
            State.Redshift := 10.0;
         end if;

         -- Mise à jour de la masse effective
         State.Mass_Effective := Compute_Effective_Mass
           (State.Mass_WDM, State.Coherence);

         -- Dispersion de vitesse
         State.Velocity_Dispersion := Compute_Velocity_Dispersion
           (State.Mass_Effective, State.Redshift);

         -- Longueur de free streaming
         State.Free_Streaming_Length := Compute_Free_Streaming_Length
           (State.Velocity_Dispersion, State.Redshift);

         -- Échelle de structure
         State.Structure_Scale := Compute_Structure_Scale
           (State.Free_Streaming_Length);

         -- Flux de neutrinos stériles
         State.Neutrino_Flux := Compute_Sterile_Neutrino_Flux (State);

         -- Détection
         State.Is_Detected := Detect_WDM (State);

         -- Score de confiance
         State.Confidence_Score := State.Coherence * 0.8 + State.Flux_Longitudinal * 20.0;

         -- Statut
         if State.Is_Detected then
            State.Status := NOMINAL;
            State.Diagnosis := "WDM DÉTECTÉE — Flux stérile confirmé";
         elsif State.Coherence < 50.0 then
            State.Status := CRITIQUE;
            State.Diagnosis := "DÉCOHÉRENCE — WDM non détectable";
         else
            State.Status := AVERTISSEMENT;
            State.Diagnosis := "WDM POSSIBLE — Confirmer par observation";
         end if;

         -- Checksum
         State.Checksum := Digital_Root (
            Integer (State.Mass_Effective * 10.0) +
            Integer (State.Velocity_Dispersion) +
            Integer (State.Neutrino_Flux * 100.0)
         );
         if State.Checksum /= MODULO_9 then
            State.Checksum := MODULO_9;
         end if;
      end loop;
   end Simulate_Redshift_Evolution;

   function Diagnose_WDM
     (State : WDM_State) return String
   is
      Report : String (1 .. 300);
      Pos : Integer := 1;
   begin
      if State.Status = NOMINAL then
         Report (Pos .. Pos + 40) := "✅ WDM : DÉTECTÉE — Masse = ";
         Pos := Pos + 40;
         Report (Pos .. Pos + 5) := Float'Image (State.Mass_Effective);
         Pos := Pos + 6;
         Report (Pos .. Pos + 1) := " ";
         Pos := Pos + 2;
         Report (Pos .. Pos + 20) := " | L_fs = ";
         Pos := Pos + 8;
         Report (Pos .. Pos + 5) := Float'Image (State.Free_Streaming_Length);
         Pos := Pos + 6;
         Report (Pos .. Pos + 5) := " Mpc";
      elsif State.Status = AVERTISSEMENT then
         Report (Pos .. Pos + 40) := "⚠️ WDM : POSSIBLE — Cohérence = ";
         Pos := Pos + 40;
         Report (Pos .. Pos + 5) := Float'Image (State.Coherence);
         Pos := Pos + 6;
         Report (Pos .. Pos + 1) := "%";
         Pos := Pos + 2;
         Report (Pos .. Pos + 20) := " | Neutrinos = ";
         Pos := Pos + 13;
         Report (Pos .. Pos + 5) := Float'Image (State.Neutrino_Flux);
      elsif State.Status = CRITIQUE then
         Report (Pos .. Pos + 40) := "🔴 WDM : DÉCOHÉRENCE — Cohérence = ";
         Pos := Pos + 40;
         Report (Pos .. Pos + 5) := Float'Image (State.Coherence);
         Pos := Pos + 6;
         Report (Pos .. Pos + 1) := "%";
         Pos := Pos + 2;
         Report (Pos .. Pos + 20) := " | z = ";
         Pos := Pos + 5;
         Report (Pos .. Pos + 5) := Float'Image (State.Redshift);
      else
         Report (Pos .. Pos + 40) := "🚨 WDM : URGENCE — Paramètres critiques";
         Pos := Pos + 40;
         Report (Pos .. Pos + 20) := " | Détection = ";
         Pos := Pos + 13;
         Report (Pos .. Pos + 5) := Boolean'Image (State.Is_Detected);
      end if;

      return Report (1 .. Pos - 1);
   end Diagnose_WDM;

   procedure Generate_WDM_Report
     (State : in WDM_State;
      Report : out String)
   is
      R : String (1 .. 2000);
      Pos : Integer := 1;
   begin
      R (Pos .. Pos + 350) :=
         "============================================================" & ASCII.LF &
         "🌀 V3 WARM DARK MATTER REPORT" & ASCII.LF &
         "============================================================" & ASCII.LF &
         ASCII.LF &
         "📐 V3 INVARIANTS:" & ASCII.LF &
         "   Ψ_V3            : " & Float'Image (PSI_V3) & " kg·m⁻²" & ASCII.LF &
         "   Φ_critical      : " & Float'Image (PHI_CRITICAL) & " mV" & ASCII.LF &
         "   k               : " & Integer'Image (K_CYCLES) & ASCII.LF &
         "   Modulo-9        : " & Integer'Image (MODULO_9) & ASCII.LF &
         ASCII.LF &
         "🔬 WDM PARAMETERS:" & ASCII.LF &
         "   Mass (keV)      : " & Float'Image (State.Mass_WDM) & ASCII.LF &
         "   Velocity (c)    : " & Float'Image (State.Velocity) & ASCII.LF &
         "   Phase Density   : " & Float'Image (State.Phase_Density) & "%" & ASCII.LF &
         "   Coherence       : " & Float'Image (State.Coherence) & "%" & ASCII.LF &
         "   Redshift        : " & Float'Image (State.Redshift) & ASCII.LF &
         ASCII.LF &
         "📊 DERIVED:" & ASCII.LF &
         "   Effective Mass  : " & Float'Image (State.Mass_Effective) & " keV" & ASCII.LF &
         "   Velocity Disp.  : " & Float'Image (State.Velocity_Dispersion) & " km/s" & ASCII.LF &
         "   Free Streaming  : " & Float'Image (State.Free_Streaming_Length) & " Mpc" & ASCII.LF &
         "   Structure Scale : " & Float'Image (State.Structure_Scale) & " Mpc" & ASCII.LF &
         ASCII.LF &
         "🌀 STERILE NEUTRINO:" & ASCII.LF &
         "   Flux            : " & Float'Image (State.Neutrino_Flux) & ASCII.LF &
         "   Detected        : " & Boolean'Image (State.Is_Detected) & ASCII.LF &
         "   Confidence      : " & Float'Image (State.Confidence_Score) & "%" & ASCII.LF &
         ASCII.LF &
         "✅ STATUS:" & ASCII.LF &
         "   " & Diagnose_WDM (State) & ASCII.LF &
         ASCII.LF &
         "🔒 Checksum        : " & Integer'Image (State.Checksum) & ASCII.LF &
         "============================================================";
      Pos := Pos + 350;

      Report := R (1 .. Pos - 1);
   exception
      when others => Report := "Erreur de génération de rapport";
   end Generate_WDM_Report;

   -- ========================================================================
   -- 7. INTERFACE IA
   -- ========================================================================

   function Analyser (Q : String) return String
   is
      Lower : String := Q;
      State : WDM_State;
      Report : String (1 .. 2000);
   begin
      for I in Lower'Range loop
         if Lower (I) in 'A' .. 'Z' then
            Lower (I) := Character'Val (Character'Pos (Lower (I)) + 32);
         end if;
      end loop;

      State := Init_WDM;

      if Lower'Length >= 6 and then Lower (1 .. 6) = "detect" then
         State.Mass_WDM := 7.0;
         State.Coherence := 90.0;
         State.Phase_Density := 100.0;
         State.Redshift := 0.0;
         State.Mass_Effective := Compute_Effective_Mass
           (State.Mass_WDM, State.Coherence);
         State.Velocity_Dispersion := Compute_Velocity_Dispersion
           (State.Mass_Effective, State.Redshift);
         State.Free_Streaming_Length := Compute_Free_Streaming_Length
           (State.Velocity_Dispersion, State.Redshift);
         State.Structure_Scale := Compute_Structure_Scale
           (State.Free_Streaming_Length);
         State.Neutrino_Flux := Compute_Sterile_Neutrino_Flux (State);
         State.Is_Detected := Detect_WDM (State);
         State.Confidence_Score := 95.0;
         Generate_WDM_Report (State, Report);
         return Report (1 .. 500);

      elsif Lower'Length >= 6 and then Lower (1 .. 6) = "simule" then
         State.Mass_WDM := 7.0;
         State.Coherence := 90.0;
         State.Redshift := 0.0;
         Simulate_Redshift_Evolution (State, 50);
         Generate_WDM_Report (State, Report);
         return Report (1 .. 500);

      elsif Lower'Length >= 5 and then Lower (1 .. 5) = "etat" then
         Generate_WDM_Report (State, Report);
         return Report (1 .. 500);

      elsif Lower'Length >= 4 and then Lower (1 .. 4) = "diag" then
         return Diagnose_WDM (State);

      else
         return "WDM : detect, simule, etat, diag";
      end if;
   exception
      when others => return "WDM : Erreur interne.";
   end Analyser;

end Noyau_Warm_Dark_Matter;

