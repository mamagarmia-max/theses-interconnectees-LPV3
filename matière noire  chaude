package Noyau_Warm_Dark_Matter with
   SPARK_Mode => On
is

   -- ========================================================================
   -- 1. INVARIANTS V3
   -- ========================================================================

   PSI_V3          : constant := 48016.8;          -- kg·m⁻²
   PHI_CRITICAL    : constant := -51.10;           -- mV
   K_CYCLES        : constant := 7;                -- Fermeture heptadique
   MODULO_9        : constant := 9;                -- Intégrité structurelle
   C               : constant := 299_792_458.0;    -- m/s
   R_HUBBLE        : constant := 1.38e26;          -- m
   RHO_COND        : constant := 1026.0;           -- kg·m⁻³
   M_P_ABSOLUTE    : constant := 4.1261e-17;       -- kg

   -- ========================================================================
   -- 2. TYPES DE BASE
   -- ========================================================================

   subtype Percentage is Float range 0.0 .. 100.0;
   subtype Coherence_Type is Float range 0.0 .. 100.0;
   subtype Phase_Potential_Type is Float range -100.0 .. 0.0;
   subtype Checksum_Type is Integer range 1 .. 9;
   subtype Noyau_Status is (NOMINAL, AVERTISSEMENT, CRITIQUE, URGENCE, VETO);
   subtype Mass_WDM_keV is Float range 0.5 .. 20.0;
   subtype Redshift_Type is Float range 0.0 .. 10.0;

   -- ========================================================================
   -- 3. STRUCTURE DE LA MATIÈRE NOIRE CHAUDE
   -- ========================================================================

   type WDM_State is record
      -- Paramètres physiques
      Mass_WDM           : Mass_WDM_keV := 7.0;        -- keV
      Velocity           : Float := 0.1;               -- fraction de c
      Phase_Density      : Percentage := 100.0;        -- % de Ψ_V3
      Coherence          : Coherence_Type := 100.0;
      Redshift           : Redshift_Type := 0.0;       -- z
      Flux_Longitudinal  : Float := 0.0;               -- % du flux total

      -- Paramètres dérivés
      Mass_Effective     : Float := 0.0;               -- keV
      Velocity_Dispersion : Float := 0.0;              -- km/s
      Free_Streaming_Length : Float := 0.0;            -- Mpc
      Structure_Scale    : Float := 0.0;               -- Mpc
      Neutrino_Flux      : Float := 0.0;               -- flux de neutrinos stériles

      -- Détection
      Is_Detected        : Boolean := False;
      Detection_Signal   : Float := 0.0;
      Confidence_Score   : Percentage := 0.0;

      -- Statut
      Status             : Noyau_Status := NOMINAL;
      Checksum           : Checksum_Type := MODULO_9;
      Last_Update        : String (1 .. 30) := (others => ' ');
      Diagnosis          : String (1 .. 200) := (others => ' ');
   end record
     with Predicate => WDM_State.Checksum = MODULO_9;

   -- ========================================================================
   -- 4. FONCTIONS PRINCIPALES
   -- ========================================================================

   -- 4.1. Initialiser l'état de la matière noire chaude
   function Init_WDM return WDM_State
     with
       Post => Init_WDM'Result.Checksum = MODULO_9;

   -- 4.2. Calculer la masse effective
   function Compute_Effective_Mass
     (Mass_WDM : Mass_WDM_keV;
      Coherence : Coherence_Type) return Float
     with
       Pre => Mass_WDM in 0.5 .. 20.0 and Coherence in 0.0 .. 100.0,
       Post => Compute_Effective_Mass'Result >= 0.0;

   -- 4.3. Calculer la dispersion de vitesse
   function Compute_Velocity_Dispersion
     (Mass_Effective : Float;
      Redshift : Redshift_Type) return Float
     with
       Pre => Mass_Effective >= 0.0 and Redshift >= 0.0,
       Post => Compute_Velocity_Dispersion'Result >= 0.0;

   -- 4.4. Calculer la longueur de libre parcours
   function Compute_Free_Streaming_Length
     (Velocity_Dispersion : Float;
      Redshift : Redshift_Type) return Float
     with
       Pre => Velocity_Dispersion >= 0.0 and Redshift >= 0.0,
       Post => Compute_Free_Streaming_Length'Result >= 0.0;

   -- 4.5. Calculer l'échelle de formation des structures
   function Compute_Structure_Scale
     (Free_Streaming_Length : Float) return Float
     with
       Pre => Free_Streaming_Length >= 0.0,
       Post => Compute_Structure_Scale'Result >= 0.0;

   -- 4.6. Calculer le flux de neutrinos stériles
   function Compute_Sterile_Neutrino_Flux
     (State : WDM_State) return Float
     with
       Pre => State.Checksum = MODULO_9,
       Post => Compute_Sterile_Neutrino_Flux'Result >= 0.0;

   -- 4.7. Détecter la matière noire chaude
   function Detect_WDM
     (State : WDM_State) return Boolean
     with
       Pre => State.Checksum = MODULO_9,
       Post => Detect_WDM'Result in True | False;

   -- 4.8. Simuler l'évolution avec le redshift
   procedure Simulate_Redshift_Evolution
     (State : in out WDM_State;
      Steps : Integer)
     with
       Pre => State.Checksum = MODULO_9 and Steps >= 0,
       Post => State.Checksum = MODULO_9;

   -- 4.9. Diagnostiquer l'état de la WDM
   function Diagnose_WDM
     (State : WDM_State) return String
     with
       Pre => State.Checksum = MODULO_9,
       Post => Diagnose_WDM'Result'Length > 0;

   -- 4.10. Générer un rapport
   procedure Generate_WDM_Report
     (State : in WDM_State;
      Report : out String)
     with
       Pre => State.Checksum = MODULO_9,
       Post => Report'Length > 0;

   -- 4.11. Interface IA
   function Analyser (Q : String) return String
     with
       Pre => Q'Length > 0,
       Post => Analyser'Result'Length > 0;

end Noyau_Warm_Dark_Matter;

