   -- ========================================================================
   -- 12. VALIDATION PROCEDURE
   -- ========================================================================
   procedure Validate_Species (Index : Integer) is
      Org : constant Organism := Species_DB (Index);
   begin
      Put_Line ("================================================================");
      Put ("  Species : ");
      Put_Line (Org.Name);
      Put_Line ("  Layer Validation:");
      
      for Layer in Oceanic_Layer loop
         declare
            Depth : constant Depth_Meters := 
              (case Layer is
                 when Epipelagic    => 100.0,
                 when Mesopelagic   => 500.0,
                 when Bathypelagic  => 2000.0,
                 when Abyssopelagic => 5000.0,
                 when Hadal         => 9000.0);
            Eco_Score : constant Resistance_Score := Compute_Ecological_Score (Org, Depth);
            Unified : constant Resistance_Score := Compute_Unified_Score (Org, Depth);
            Biomass : constant Biomass_Index := Compute_Biomass_Index (Org, Depth);
            Integrity : constant Integer := Compute_Integrity (Unified);
         begin
            Put ("    ");
            Put (Oceanic_Layer'Image (Layer));
            Put (" -> Eco: ");
            Put (Float (Eco_Score), 1, 1, 0);
            Put (" | V3 Unified: ");
            Put (Float (Unified), 1, 1, 0);
            Put (" | Integrity: ");
            Put (Integrity, 1);
            if Org.Is_Commercial then
               Put (" | Biomass: ");
               Put (Float (Biomass), 1, 1, 0);
            end if;
            if Unified > 50.0 then
               Put (" | Predicted: PRESENT");
            else
               Put (" | Predicted: ABSENT");
            end if;
            New_Line;
         end;
      end loop;
      New_Line;
   end Validate_Species;

