   -- 12. FONCTIONS DE CHARGE V3 (pression différentielle)
   -- ========================================================================

   -- 12.1 Charge comme pression différentielle
   -- q = α_c × (P_wave - P₀) × A_surface
   function Charge_As_Pressure (P_wave, P_ambient : Float; A_surface : Float) return Float
     with Pre => P_wave >= 0.0 and P_ambient >= 0.0 and A_surface > 0.0,
          Post => Charge_As_Pressure'Result >= 0.0;

   -- 12.2 Force de Coulomb comme gradient de pression
   function Coulomb_As_Pressure_Gradient (q1, q2 : Float; R_m : Float; Epsilon_eff : Float) return Float
     with Pre => q1 >= 0.0 and q2 >= 0.0 and R_m > 0.0 and Epsilon_eff > 0.0,
          Post => Coulomb_As_Pressure_Gradient'Result >= 0.0;

