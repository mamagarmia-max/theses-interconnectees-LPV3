   function Analyser (Q : String) return String
   is
      Lower : String := Q;
      Enzyme : Enzyme_State;
      Report : String (1 .. 2000);
      Results : Extreme_Test_Array;
   begin
      for I in Lower'Range loop
         if Lower (I) in 'A' .. 'Z' then
            Lower (I) := Character'Val (Character'Pos (Lower (I)) + 32);
         end if;
      end loop;

      if Lower'Length >= 6 and then Lower (1 .. 6) = "design" then
         Enzyme := Design_Enzyme ("MKKTALIVALATLLSSAVVSA", PET, "Ecoli");
         Generate_Design_Report (Enzyme, Report);
         return Report (1 .. 500);

      elsif Lower'Length >= 5 and then Lower (1 .. 5) = "test" then
         Results := Run_All_Extreme_Tests;
         return "Tests extrêmes lancés. Consultez les résultats.";

      elsif Lower'Length >= 6 and then Lower (1 .. 6) = "export" then
         Enzyme := Design_Enzyme ("MKKTALIVALATLLSSAVVSA", PET, "Ecoli");
         Export_Design (Enzyme, "JSON", Report);
         return Report (1 .. 200);

      elsif Lower'Length >= 4 and then Lower (1 .. 4) = "help" then
         return "ENZYME : design, test, export, status";

      else
         return "ENZYME : design, test, export, help";
      end if;
   exception
      when others => return "ENZYME : Erreur interne.";
   end Analyser;

