package body Alloy_V10_Ultimate with
   SPARK_Mode => On
is

   -- Molar masses (g/mol)
   M_Nb   : constant Float := 92.906;
   M_Ta   : constant Float := 180.948;
   M_Ti   : constant Float := 47.867;
   M_Zr   : constant Float := 91.224;
   M_Hf   : constant Float := 178.490;
   M_Y2O3 : constant Float := 225.81;  -- Y₂O₃ molar mass

   F_Nb   : constant Float := 0.35;
   F_Ta   : constant Float := 0.20;
   F_Ti   : constant Float := 0.20;
   F_Zr   : constant Float := 0.10;
   F_Hf   : constant Float := 0.15;
   F_Y2O3 : constant Float := 0.005;   -- 0.5 % atomic

   function Mass_Fraction (F : Float; M : Float; Sum_M : Float) return Float is
   begin
      return (F * M) / Sum_M;
   end Mass_Fraction;

   function Total_Molar_Mass return Float is
      Sum : Float := F_Nb * M_Nb + F_Ta * M_Ta + F_Ti * M_Ti +
                     F_Zr * M_Zr + F_Hf * M_Hf + F_Y2O3 * M_Y2O3;
   begin
      return Sum;
   end Total_Molar_Mass;

   function Get_V10_Params (Total_Mass_g : Float) return V10_Params is
      M_total : constant Float := Total_Molar_Mass;
      F_Nb_m  : constant Float := Mass_Fraction (F_Nb, M_Nb, M_total);
      F_Ta_m  : constant Float := Mass_Fraction (F_Ta, M_Ta, M_total);
      F_Ti_m  : constant Float := Mass_Fraction (F_Ti, M_Ti, M_total);
      F_Zr_m  : constant Float := Mass_Fraction (F_Zr, M_Zr, M_total);
      F_Hf_m  : constant Float := Mass_Fraction (F_Hf, M_Hf, M_total);
      F_Y2O3_m : constant Float := Mass_Fraction (F_Y2O3, M_Y2O3, M_total);
   begin
      return V10_Params'
        (Total_Mass_g           => Total_Mass_g,
         Nb_Mass_g              => Total_Mass_g * F_Nb_m,
         Ta_Mass_g              => Total_Mass_g * F_Ta_m,
         Ti_Mass_g              => Total_Mass_g * F_Ti_m,
         Zr_Mass_g              => Total_Mass_g * F_Zr_m,
         Hf_Mass_g              => Total_Mass_g * F_Hf_m,
         Y2O3_Mass_g            => Total_Mass_g * F_Y2O3_m,
         HEBM_Time_h            => 15.0,
         HEBM_Atmosphere        => "Ar/H2 ",
         SPS_Type               => "Hybrid     ",
         SPS_Temp_C             => 1425.0,
         SPS_Time_min           => 20,
         SPS_Pressure_MPa       => 50.0,
         SPS_Ramp_Cpmin         => 100.0,
         SPS_Pulse_Current      => "Pulse+DC ",
         HIP_Temp_C             => 1300.0,
         HIP_Time_h             => 5.0,
         HIP_Pressure_MPa       => 200.0,
         HIP_Atmosphere         => "Ar/Sup",
         Quench_Temp_C          => -80.0,
         Quench_Medium          => "LN2        ",
         Annealing_Relax_1_Temp_C => 800.0,
         Annealing_Relax_1_Time_h => 2.0,
         Annealing_Relax_2_Temp_C => 600.0,
         Annealing_Relax_2_Time_h => 4.0,
         Annealing_Relax_3_Temp_C => 400.0,
         Annealing_Relax_3_Time_h => 6.0,
         Post_HIP_Forge_Temp_C  => 1000.0,
         Post_HIP_Forge_Strain  => 0.1,
         Final_Cooling_Rate_Cpmin => 5.0,
         Electropolishing       => True,
         Inline_LIBS            => True,
         Mold_Coating           => "BN     ",
         Checksum               => 9);
   end Get_V10_Params;

   function Get_Alloy_Properties_Ultimate return Alloy_Properties is
   begin
      return Alloy_Properties'
        (Density_gpcm3        => 10.2,
         Elastic_Modulus_GPa  => 125.0,   -- +5 GPa due to Y₂O₃ dispersion
         Melting_Point_C      => 2550.0,
         Hardness_HV          => 420.0,   -- +40 HV due to grain refinement
         Tensile_Strength_MPa => 1350.0,  -- +150 MPa (Hall‑Petch + Y₂O₃)
         Ductility_Percent    => 15.0,    -- +3 % due to relaxation annealing
         Phase_Structure      => "BCC       ",
         Grain_Size_um        => 2.5,     -- ultrafine grain (cryogenic + HIP)
         Oxygen_ppm           => 15,      -- < 20 ppm (Y₂O₃ getter)
         Checksum             => 9);
   end Get_Alloy_Properties_Ultimate;

