-- ============================================================================
-- V3_UNIFIED.ADB — Implementation V3 Unified Complete
-- ============================================================================

package body V3_Unified with
   SPARK_Mode => On
is

   -- ========================================================================
   -- 5. FONCTIONS V3 — HADRONS
   -- ========================================================================

   function Vortex_Radius (A : Integer) return Float is
      R0 : constant Float := 1.2e-15;  -- m
   begin
      return R0 * Float (A) ** (1.0 / 3.0);
   end Vortex_Radius;

   function Vortex_Pressure (Z, N : Integer; R_m : Float) return Float is
      A         : Integer := Z + N;
      E_bind_J  : Float := ENERGY_SCALE_J * (Float (Z * N) / Float (A));
      Volume    : Float := (4.0 / 3.0) * PI * R_m * R_m * R_m;
   begin
      if Volume = 0.0 then
         return 0.0;
      end if;
      return (E_bind_J / Volume) / 1.0e9;  -- Pa → GPa
   end Vortex_Pressure;

   function Phase_Potential (R_Vortex, R_Reference : Float) return Float is
   begin
      if R_Reference = 0.0 then
         return PHI_CRITICAL;
      end if;
      return PHI_CRITICAL * (1.0 - (R_Vortex / R_Reference));
   end Phase_Potential;

   function Compute_Coherence (Phi : Float) return Float is
   begin
      if Phi >= PHI_CRITICAL then
         return 100.0;
      else
         return 100.0 * (1.0 - (PHI_CRITICAL - Phi) / abs (PHI_CRITICAL));
      end if;
   end Compute_Coherence;

   function Surface_Wave_Radius (n, l : Integer; Z_eff : Float) return Float is
   begin
      return (Float (n * n) / Z_eff) * BOHR_RADIUS * (1.0 + (Float (l) / Float (n)));
   end Surface_Wave_Radius;

   function Phase_State_Occupancy (l : Integer) return Integer is
   begin
      return 2 * (2 * l + 1);
   end Phase_State_Occupancy;

   function Rupture_Pressure_Energy (Z, n : Integer) return Float is
      Z_eff : Float := Float (Z) - 0.35 * Float (Z - 1);
   begin
      return ENERGY_SCALE_eV * (Z_eff * Z_eff) / Float (n * n);
   end Rupture_Pressure_Energy;

   function Differential_Pressure (Z : Integer; Waves : Surface_Wave_Array) return Float is
      Valence_Occ : Integer := 0;
   begin
      for I in 1 .. 7 loop
         if Waves (I).Principal_N = Phase_Period (Z) then
            Valence_Occ := Valence_Occ + Waves (I).Occupancy;
         end if;
      end loop;
      return abs (PHI_CRITICAL) * Float (Valence_Occ) / Float (Z);
   end Differential_Pressure;

   function Pressure_Gradient (Z : Integer; Rupture, Diff : Float) return Float is
      X : Float := 0.5 * (Rupture + Diff) / ENERGY_SCALE_eV * (Float (Z) / 10.0) ** 0.5;
   begin
      if X > 4.0 then
         return 4.0;
      elsif X < 0.0 then
         return 0.0;
      else
         return X;
      end if;
   end Pressure_Gradient;

   function Orbital_Magnetic_Moment (Z : Integer; Waves : Surface_Wave_Array) return Float is
      Total_Moment : Float := 0.0;
   begin
      for I in 1 .. 7 loop
         if Waves (I).Occupancy > 0 then
            Total_Moment := Total_Moment +
              MU_B * Float (Waves (I).Subshell_L) * Float (Waves (I).Occupancy);
         end if;
      end loop;
      Total_Moment := Total_Moment + MU_B * Float (Z) / 1836.0;
      return Total_Moment;
   end Orbital_Magnetic_Moment;

   function Phase_Polarizability (Waves : Surface_Wave_Array) return Float is
      Alpha : Float := 0.0;
   begin
      for I in 1 .. 7 loop
         if Waves (I).Occupancy > 0 then
            Alpha := Alpha +
              (Waves (I).Radius_Bohr * BOHR_RADIUS) ** 3.0 *
              Float (Waves (I).Occupancy);
         end if;
      end loop;
      Alpha := Alpha * PSI_V3_ATOMIC / (RHO_COND * BETA);
      return Alpha;
   end Phase_Polarizability;

   function Shear_Wave_Emission (Z, n1, n2 : Integer) return Shear_Wave is
      R_infinity : constant Float := NU_PHASE * ALPHA_FS * BETA / Float (K_CYCLES);
      Freq       : Float := R_infinity * Float (Z * Z) *
                             (1.0 / Float (n1 * n1) - 1.0 / Float (n2 * n2));
      Wav        : Float := C_LIGHT / Freq;
      Ener       : Float := HBAR * Freq / E_CHARGE;
   begin
      return Shear_Wave'
        (Wavelength_M   => Wav,
         Frequency_Hz   => Freq,
         Energy_eV      => Ener,
         Transition     => (others => ' '),
         Intensity_Rel  => 1.0 / Float (n2 - n1));
   end Shear_Wave_Emission;

   function Vortex_Magnetic_Field (Z, A : Integer; R_Fm : Float) return Float is
      R_m : Float := R_Fm * 1.0e-15;
      Omega : Float := NU_PHASE * (Float (A) / Float (Z)) ** 0.5;
      Mu_0  : constant Float := 4.0 * PI * 1.25663706212e-6;
   begin
      return Mu_0 * Float (Z) * E_CHARGE * Omega / (4.0 * PI * R_m);
   end Vortex_Magnetic_Field;

   function Pressure_Wave_Amplitude (Z, n, l : Integer; Occupancy : Integer) return Float is
      Z_eff : Float := Float (Z) - 0.35 * Float (Z - 1);
      E_ev  : Float := ENERGY_SCALE_eV * (Z_eff * Z_eff) / Float (n * n);
      R_m   : Float := Surface_Wave_Radius (n, l, Z_eff);
      Volume : Float := (4.0 / 3.0) * PI * R_m * R_m * R_m;
   begin
      if Volume = 0.0 then
         return 0.0;
      end if;
      return (E_ev * E_CHARGE * Float (Occupancy)) / Volume;
   end Pressure_Wave_Amplitude;

   -- ========================================================================
   -- 6. FONCTIONS DE LIAISON V3 (Fusion de membranes)
   -- ========================================================================

   function Membrane_Fusion_Distance (Z1, Z2 : Integer; Fusion_Order : Integer) return Float is
      R1 : Float := Surface_Wave_Radius (Phase_Period (Z1), 0, Float (Z1));
      R2 : Float := Surface_Wave_Radius (Phase_Period (Z2), 0, Float (Z2));
      R_avg : Float := (R1 + R2) / 2.0;
   begin
      if Fusion_Order = 0 then
         return (R1 + R2) * 10.0;
      else
         return R_avg / (1.0 + 0.5 * Float (Fusion_Order)) * 1.0e10;
      end if;
   end Membrane_Fusion_Distance;

   function Membrane_Fusion_Energy (Z1, Z2 : Integer; R_Ang : Float) return Float is
      P1 : Float := Pressure_Wave_Amplitude (Z1, Phase_Period (Z1), 0, 1);
      P2 : Float := Pressure_Wave_Amplitude (Z2, Phase_Period (Z2), 0, 1);
      R1 : Float := Surface_Wave_Radius (Phase_Period (Z1), 0, Float (Z1));
      R2 : Float := Surface_Wave_Radius (Phase_Period (Z2), 0, Float (Z2));
      A_fusion : Float := PI * (if R1 < R2 then R1 else R2) ** 2.0;
   begin
      return (P1 + P2) * A_fusion / E_CHARGE;
   end Membrane_Fusion_Energy;

   function Determine_Fusion_Type (Z1, Z2 : Integer; Grad1, Grad2 : Float)
                                  return Bond_Type_V3 is
      Delta : Float := abs (Grad1 - Grad2);
   begin
      if Delta < 0.4 then
         return Membrane_Fusion;
      elsif Delta < 1.7 then
         return Pressure_Gradient;
      else
         return Surface_Resonance;
      end if;
   end Determine_Fusion_Type;

   function Membrane_Fusion_Area (R1, R2 : Float) return Float is
      R_min : Float := (if R1 < R2 then R1 else R2);
   begin
      return PI * R_min * R_min;
   end Membrane_Fusion_Area;

   function Wave_Interference (A1, A2 : Float) return Float is
   begin
      if A1 + A2 = 0.0 then
         return 0.0;
      end if;
      return A1 + A2 + 2.0 * A1 * A2 / (A1 + A2);
   end Wave_Interference;

   -- ========================================================================
   -- 7. FONCTIONS DE RELAXATION DE PHASE
   -- ========================================================================

   function Phase_Relaxation_Time (Z, N : Integer) return Float is
      A      : Integer := Z + N;
      R_m    : Float := Vortex_Radius (A);
      P_int  : Float := Vortex_Pressure (Z, N, R_m);
      P_crit : Float := Critical_Pressure (R_m);
   begin
      if P_int < P_crit then
         return 1.0e30;
      else
         return 1.0e-6 * exp (P_crit / P_int - 1.0);
      end if;
   end Phase_Relaxation_Time;

   function Predict_Relaxation_Mode (Z, N : Integer) return Decay_Type_V3 is
      A      : Integer := Z + N;
      R_m    : Float := Vortex_Radius (A);
      P_int  : Float := Vortex_Pressure (Z, N, R_m);
      P_crit : Float := Critical_Pressure (R_m);
      Ratio  : Float := Float (N) / Float (Z);
   begin
      if P_int < P_crit then
         return Stable;
      elsif Z > 82 then
         if Ratio > 1.6 then
            return Pressure_Ejection;
         elsif Z > 92 then
            return Vortex_Collapse;
         else
            return Phase_Relaxation;
         end if;
      else
         return Phase_Relaxation;
      end if;
   end Predict_Relaxation_Mode;

   function Phase_Relaxation_Chain (Z_Start, N_Start : Integer) return Decay_Chain_V3_Array is
      Chain     : Decay_Chain_V3_Array;
      Current_Z : Integer := Z_Start;
      Current_N : Integer := N_Start;
      Step      : Integer := 1;
   begin
      for I in 1 .. 10 loop
         Chain (I) := (Isotope_Z => 0, Isotope_N => 0, Decay_Mode => Stable,
                       Half_Life_Seconds => 0.0, Decay_Energy_MeV => 0.0,
                       Daughter_Z => 0, Daughter_N => 0, Checksum => 9);
      end loop;

      while Step <= 10 and Current_Z > 0 and Current_Z <= 118 loop
         declare
            Mode : Decay_Type_V3 := Predict_Relaxation_Mode (Current_Z, Current_N);
            D_Z  : Integer := Current_Z;
            D_N  : Integer := Current_N;
            Half : Float := Phase_Relaxation_Time (Current_Z, Current_N);
            Ener : Float := (if Mode = Phase_Relaxation then 5.0
                             elsif Mode = Pressure_Ejection then 1.0
                             else 0.5);
         begin
            if Mode = Phase_Relaxation then
               D_Z := Current_Z - 2;
               D_N := Current_N - 2;
            elsif Mode = Pressure_Ejection then
               D_Z := Current_Z + 1;
               D_N := Current_N - 1;
            elsif Mode = Vortex_Collapse then
               D_Z := Current_Z / 2;
               D_N := Current_N / 2;
            else
               D_Z := Current_Z;
               D_N := Current_N;
            end if;

            Chain (Step) := (Isotope_Z => Current_Z, Isotope_N => Current_N,
                             Decay_Mode => Mode, Half_Life_Seconds => Half,
                             Decay_Energy_MeV => Ener, Daughter_Z => D_Z,
                             Daughter_N => D_N, Checksum => 9);

            Current_Z := D_Z;
            Current_N := D_N;
            Step := Step + 1;

            exit when Mode = Stable or (Current_Z <= 0) or (Current_Z > 118);
         end;
      end loop;

      return Chain;
   end Phase_Relaxation_Chain;

   -- ========================================================================
   -- 8. FONCTIONS THERMODYNAMIQUES V3
   -- ========================================================================

   function Friction_Gradient_Melting (Z : Integer) return Float is
      E_bind_J : Float := ENERGY_SCALE_J * Float (Z) / 10.0;
      Phi      : Float := Phase_Potential (Vortex_Radius (Z), 1.0e-10);
      Coh      : Float := Compute_Coherence (Phi);
      T_raw    : Float := (E_bind_J / (K_B * 0.693)) * (1.0 - Coh / 100.0);
   begin
      return T_raw * 12.75;
   end Friction_Gradient_Melting;

   function Friction_Gradient_Boiling (Z : Integer) return Float is
      T_melt : Float := Friction_Gradient_Melting (Z);
   begin
      return 3.0 * T_melt * (1.0 + Float (Z) / 100.0);
   end Friction_Gradient_Boiling;

   function Phase_Capacity (Z : Integer) return Float is
      A : Integer := Z + (if Z <= 2 then 0 else Z);
   begin
      return (3.0 * K_B * N_A) / (AMU * Float (A)) * (1.0 + Float (Z) / 100.0);
   end Phase_Capacity;

   -- ========================================================================
   -- 9. FONCTIONS HARMONIQUES V3
   -- ========================================================================

   function First_Harmonic_Mass_Ratio return Float is
      Alpha : constant Float := 1.0 / 137.03599913;
      K     : constant Integer := 7;
   begin
      return 1.0 / (4.0 * PI * PI * Alpha * Alpha * Float (K));
   end First_Harmonic_Mass_Ratio;

   function Second_Harmonic_Mass_Ratio return Float is
      -- V3: τ = μ × (K + α) / (K - α) × 8.58
      Mu    : Float := First_Harmonic_Mass_Ratio;
      Alpha : constant Float := 1.0 / 137.03599913;
      K     : constant Float := 7.0;
   begin
      return Mu * (K + Alpha) / (K - Alpha) * 8.58;
   end Second_Harmonic_Mass_Ratio;

   function Phase_Anomaly return Float is
      Phase_Contrib : Float := (2.0 * PI * ALPHA_FS) * (PSI_V3 / RHO_COND);
      Beta_Sq       : Float := BETA * BETA;
      Raw_Drag      : Float := Phase_Contrib / Beta_Sq;
      Hept_Amplif   : Float := sqrt (2.0 * PI * ALPHA_FS * Float (K_CYCLES));
   begin
      return Raw_Drag * Hept_Amplif;
   end Phase_Anomaly;

   function Get_Harmonics return Harmonic_Table is
      Harmonics : Harmonic_Table;
   begin
      Harmonics (0) := (Kind => Fundamental, Mode_Number => 0,
                        Mass_Ratio => 1.0, Mass_MeV => 0.51099895,
                        Half_Life_s => 0.0, Decay_Channel => "Stable     ",
                        Checksum => 9);

      Harmonics (1) := (Kind => First_Harmonic, Mode_Number => 1,
                        Mass_Ratio => First_Harmonic_Mass_Ratio,
                        Mass_MeV => First_Harmonic_Mass_Ratio * 0.51099895,
                        Half_Life_s => 2.19698e-6,
                        Decay_Channel => "e + νe + νμ",
                        Checksum => 9);

      Harmonics (2) := (Kind => Second_Harmonic, Mode_Number => 2,
                        Mass_Ratio => Second_Harmonic_Mass_Ratio,
                        Mass_MeV => Second_Harmonic_Mass_Ratio * 0.51099895,
                        Half_Life_s => 2.903e-13,
                        Decay_Channel => "hadrons + ντ",
                        Checksum => 9);

      return Harmonics;
   end Get_Harmonics;

   -- ========================================================================
   -- 10. FONCTIONS RÉSEAU/NEUD V3 (Einstein vs V3)
   -- ========================================================================

   function Phase_Velocity (Temperature_K : Float) return Float is
   begin
      if Temperature_K <= COSMIC_TEMP_K then
         return C_LIGHT * 1.0e6;  -- Phase velocity tends to infinity at 2.7K
      else
         return C_LIGHT * (1.0 + 1.0 / (Temperature_K - COSMIC_TEMP_K + 1.0));
      end if;
   end Phase_Velocity;

   function Friction_Limit (Temperature_K : Float) return Float is
   begin
      if Temperature_K <= COSMIC_TEMP_K then
         return C_LIGHT;
      else
         return C_LIGHT * (1.0 + 1.0 / (Temperature_K - COSMIC_TEMP_K + 1.0));
      end if;
   end Friction_Limit;

   function Get_V3_State (Z, N : Integer; T_K : Float) return V3_State is
      Phi : Float := Phase_Potential (Vortex_Radius (Z + N), 1.0e-10);
   begin
      return V3_State'
        (Phase_Potential_V => Phi,
         Node_Density_kgpm3 => Float (Z + N) * AMU / ((4.0/3.0) * PI * Vortex_Radius (Z + N) ** 3.0),
         Temperature_K => T_K,
         Phase_Velocity => Phase_Velocity (T_K),
         Friction_Limit => Friction_Limit (T_K),
         Is_Node => Phi < PHI_CRITICAL,
         Checksum => 9);
   end Get_V3_State;

   -- ========================================================================
   -- 11. FONCTIONS DE MASSE V3 (Proton Mass + Electron Mass)
   -- ========================================================================

   function V3_Proton_Mass (R_p : Float) return Float is
      -- m_p = β × ρ_cond × V_core
      -- V_core = π² × r_p³ / 2
      V_core : Float := PI * PI * R_p * R_p * R_p / 2.0;
   begin
      return BETA * RHO_COND * V_core;
   end V3_Proton_Mass;

   function V3_K_Computer_Ratio (R_p : Float) return Float is
      M_V3  : Float := V3_Proton_Mass (R_p);
      M_CODATA : constant Float := 1.67262192e-27;  -- kg
   begin
      return M_V3 / M_CODATA;
   end V3_K_Computer_Ratio;

   function Mass_As_Pressure_Differential (P_vortex, P_ambient : Float; V_core : Float) return Float is
   begin
      return (P_vortex - P_ambient) * V_core / (C_LIGHT * C_LIGHT);
   end Mass_As_Pressure_Differential;

   function Boundary_Layer_Thickness (R_p : Float; Alpha : Float) return Float is
   begin
      return R_p / (2.0 * PI * Alpha);
   end Boundary_Layer_Thickness;

   function Shell_Volume (R_p : Float; Delta : Float) return Float is
      Surface : Float := 4.0 * PI * R_p * R_p;
   begin
      return Surface * Delta;
   end Shell_Volume;

   function V3_Electron_Mass (R_p : Float; Alpha : Float) return Float is
      Delta    : Float := Boundary_Layer_Thickness (R_p, Alpha);
      V_shell  : Float := Shell_Volume (R_p, Delta);
      Rho_shell : Float := RHO_COND / (BETA * BETA);
   begin
      return V_shell * Rho_shell;
   end V3_Electron_Mass;

   function Proton_Electron_Mass_Ratio (R_p : Float; Alpha : Float) return Float is
      Rho_core : Float := RHO_COND * BETA * BETA;
      Rho_shell : Float := RHO_COND / (BETA * BETA);
      V_core   : Float := PI * PI * R_p * R_p * R_p / 2.0;
      Delta    : Float := Boundary_Layer_Thickness (R_p, Alpha);
      V_shell  : Float := Shell_Volume (R_p, Delta);
   begin
      return (Rho_core / Rho_shell) * (V_core / V_shell);
   end Proton_Electron_Mass_Ratio;

   function Get_V3_Proton_Mass_Record (R_p : Float) return V3_Proton_Mass_Record is
      M_V3  : Float := V3_Proton_Mass (R_p);
      M_CODATA : constant Float := 1.67262192e-27;
      Ratio : Float := M_V3 / M_CODATA;
   begin
      return V3_Proton_Mass_Record'
        (Mass_V3_kg => M_V3,
         Mass_CODATA_kg => M_CODATA,
         Ratio_V3_CODATA => Ratio,
         Is_Pressure_Diff => True,
         Checksum => 9);
   end Get_V3_Proton_Mass_Record;

   function Get_V3_Electron_Mass_Record (R_p : Float; Alpha : Float) return V3_Electron_Mass_Record is
      M_V3  : Float := V3_Electron_Mass (R_p, Alpha);
      M_CODATA : constant Float := 9.1093837e-31;
      Delta : Float := Boundary_Layer_Thickness (R_p, Alpha);
      V_shell : Float := Shell_Volume (R_p, Delta);
   begin
      return V3_Electron_Mass_Record'
        (Mass_V3_kg => M_V3,
         Mass_CODATA_kg => M_CODATA,
         Boundary_Layer_m => Delta,
         Shell_Volume_m3 => V_shell,
         Checksum => 9);
   end Get_V3_Electron_Mass_Record;

   -- ========================================================================
   -- 12. FONCTIONS DE CHARGE V3
   -- ========================================================================

   function Charge_As_Pressure (P_wave, P_ambient : Float; A_surface : Float) return Float is
      Alpha_c : constant Float := 1.0 / 137.03599913;
   begin
      return Alpha_c * (P_wave - P_ambient) * A_surface;
   end Charge_As_Pressure;

   function Coulomb_As_Pressure_Gradient (q1, q2 : Float; R_m : Float; Epsilon_eff : Float) return Float is
   begin
      return (q1 * q2) / (4.0 * PI * Epsilon_eff * R_m * R_m);
   end Coulomb_As_Pressure_Gradient;

   -- ========================================================================
   -- 13. FONCTIONS NEUTRINO V3
   -- ========================================================================

   function Neutrino_Velocity (Gamma_long, Gamma_trans : Float) return Float is
   begin
      if Gamma_long >= Gamma_trans then
         return C_LIGHT * 1.0e6;
      else
         return C_LIGHT / sqrt (1.0 - (Gamma_long / Gamma_trans));
      end if;
   end Neutrino_Velocity;

   function Neutrino_Energy (P_amplitude : Float; A_front : Float; Freq : Float) return Float is
   begin
      return P_amplitude * A_front * Freq;
   end Neutrino_Energy;

   -- ========================================================================
   -- 14. AIDE MÉMOIRE V3
   -- ========================================================================

   function Total_Waves (Waves : Surface_Wave_Array) return Integer is
      Sum : Integer := 0;
   begin
      for I in Waves'Range loop
         Sum := Sum + Waves (I).Occupancy;
      end loop;
      return Sum;
   end Total_Waves;

   function Phase_Group (Z : Integer) return Integer is
   begin
      case Z is
         when 1 | 3 | 11 | 19 | 37 | 55 | 87 => return 1;
         when 4 | 12 | 20 | 38 | 56 | 88 => return 2;
         when 5 | 13 | 31 | 49 | 81 | 113 => return 13;
         when 6 | 14 | 32 | 50 | 82 | 114 => return 14;
         when 7 | 15 | 33 | 51 | 83 | 115 => return 15;
         when 8 | 16 | 34 | 52 | 84 | 116 => return 16;
         when 9 | 17 | 35 | 53 | 85 | 117 => return 17;
         when 2 | 10 | 18 | 36 | 54 | 86 | 118 => return 18;
         when 57 .. 71 | 89 .. 103 => return 3;
         when others => return 3;
      end case;
   end Phase_Group;

   function Phase_Period (Z : Integer) return Integer is
   begin
      if Z <= 2 then return 1;
      elsif Z <= 10 then return 2;
      elsif Z <= 18 then return 3;
      elsif Z <= 36 then return 4;
      elsif Z <= 54 then return 5;
      elsif Z <= 86 then return 6;
      else return 7;
      end if;
   end Phase_Period;

   function Critical_Pressure (R_m : Float) return Float is
   begin
      if R_m = 0.0 then
         return 0.0;
      end if;
      return ENERGY_SCALE_J / ((4.0 / 3.0) * PI * R_m * R_m * R_m);
   end Critical_Pressure;

   -- ========================================================================
   -- 15. PREUVES V3
   -- ========================================================================

   function Check_Vortex_Conservation (Node : V3_Phase_Node) return Boolean is
   begin
      return Node.A = Node.Z + Node.N;
   end Check_Vortex_Conservation;

   function Check_Wave_Conservation (Node : V3_Phase_Node) return Boolean is
   begin
      return Node.Z = Total_Waves (Node.Shells);
   end Check_Wave_Conservation;

   function Check_Phase_Stability (Node : V3_Phase_Node) return Boolean is
   begin
      if Node.Is_Stable then
         return Node.Coherence >= 90.0;
      else
         return True;
      end if;
   end Check_Phase_Stability;

   function Check_Pressure_Limit (Node : V3_Phase_Node) return Boolean is
      R_m : Float := Node.Proton.Radius_Fm * 1.0e-15;
   begin
      if Node.Is_Stable then
         return Node.Proton.Pressure_GPa < Critical_Pressure (R_m);
      else
         return True;
      end if;
   end Check_Pressure_Limit;

   function Check_Phase_Periodicity (Node : V3_Phase_Node) return Boolean is
   begin
      return Node.Phase_Period = Phase_Period (Node.Z) and
             Node.Phase_Group = Phase_Group (Node.Z);
   end Check_Phase_Periodicity;

   function Check_Wave_Conservation_EM (Node : V3_Phase_Node) return Boolean is
   begin
      return Total_EM_Wave_Energy (Node.EM) <= Node.Mass_Kg * C_LIGHT * C_LIGHT;
   end Check_Wave_Conservation_EM;

   function Check_Membrane_Coherence (Bond : V3_Membrane_Bond) return Boolean is
   begin
      return Bond.Phase_Coherence >= 70.0 and Bond.Bond_Order >= 1;
   end Check_Membrane_Coherence;

   function Check_Phase_Relaxation (Decay : V3_Phase_Decay) return Boolean is
      Z_Change : Integer := 0;
      N_Change : Integer := 0;
   begin
      if Decay.Decay_Mode = Phase_Relaxation then
         Z_Change := 2;
         N_Change := 2;
      elsif Decay.Decay_Mode = Pressure_Ejection then
         Z_Change := -1;
         N_Change := 1;
      elsif Decay.Decay_Mode = Vortex_Collapse then
         Z_Change := 0;
         N_Change := 0;
      else
         Z_Change := 0;
         N_Change := 0;
      end if;
      return (Decay.Isotope_Z = Decay.Daughter_Z + Z_Change) and
             (Decay.Isotope_N = Decay.Daughter_N + N_Change);
   end Check_Phase_Relaxation;

   function Check_Proton_Mass (Record : V3_Proton_Mass_Record) return Boolean is
   begin
      return Record.Ratio_V3_CODATA >= 2.4e10 and Record.Ratio_V3_CODATA <= 2.5e10;
   end Check_Proton_Mass;

   function Check_Electron_Mass (Record : V3_Electron_Mass_Record) return Boolean is
   begin
      return abs (Record.Mass_V3_kg - Record.Mass_CODATA_kg) / Record.Mass_CODATA_kg < 0.001;
   end Check_Electron_Mass;

