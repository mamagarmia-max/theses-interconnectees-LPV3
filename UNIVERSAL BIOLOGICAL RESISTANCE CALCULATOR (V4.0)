            Temp_Min => 5.0, Temp_Max => 18.0,
            Pressure_Tol_Min => 1.0, Pressure_Tol_Max => 50.0,
            Lifestyle => Benthic, Needs_Light => False, Is_Bioluminescent => False),
      3 => (Name => "Coryphaenoides armatus (Abyssal Grenadier)",
            Max_Depth => 4000.0, TMAO_Level => 180.0, Hydration => 1.8,
            Osmoconformity => 0.0, DHA_Ratio => 0.8, Is_Osmoconformer => False,
            Temp_Min => 2.0, Temp_Max => 6.0,
