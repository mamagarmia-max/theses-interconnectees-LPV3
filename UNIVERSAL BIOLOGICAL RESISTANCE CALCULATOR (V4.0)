            Lifestyle => Pelagic, Needs_Light => False, Is_Bioluminescent => False),
      2 => (Name => "Liparis florae (Tidepool Snailfish)",
            Max_Depth => 500.0, TMAO_Level => 60.0, Hydration => 1.1,
