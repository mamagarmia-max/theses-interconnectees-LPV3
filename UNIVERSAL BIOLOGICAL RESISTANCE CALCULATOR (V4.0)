            Lifestyle => Pelagic, Needs_Light => False, Is_Bioluminescent => True),
      4 => (Name => "Pseudoliparis swirei (Hadal Snailfish)",
            Max_Depth => 8200.0, TMAO_Level => 350.0, Hydration => 2.5,
            Osmoconformity => 0.0, DHA_Ratio => 0.9, Is_Osmoconformer => False,
            Temp_Min => 1.0, Temp_Max => 4.0,
            Pressure_Tol_Min => 200.0, Pressure_Tol_Max => 820.0,
            Lifestyle => Benthic, Needs_Light => False, Is_Bioluminescent => False),
      5 => (Name => "Hirondellea gigas (Hadal Amphipod)  ",
            Max_Depth => 11000.0, TMAO_Level => 200.0, Hydration => 1.5,
            Osmoconformity => 1.0, DHA_Ratio => 0.85, Is_Osmoconformer => True,
            Temp_Min => 1.0, Temp_Max => 4.0,
            Pressure_Tol_Min => 300.0, Pressure_Tol_Max => 1100.0,
            Lifestyle => Benthic, Needs_Light => False, Is_Bioluminescent => False),
      6 => (Name => "Bathynomus giganteus (Giant Isopod)",
            Max_Depth => 2000.0, TMAO_Level => 120.0, Hydration => 1.4,
            Osmoconformity => 0.5, DHA_Ratio => 0.7, Is_Osmoconformer => False,
            Temp_Min => 2.0, Temp_Max => 8.0,
            Pressure_Tol_Min => 50.0, Pressure_Tol_Max => 200.0,
            Lifestyle => Benthic, Needs_Light => False, Is_Bioluminescent => False),
      7 => (Name => "Piezophile Microorganism (Archaea)  ",
            Max_Depth => 11000.0, TMAO_Level => 100.0, Hydration => 1.2,
            Osmoconformity => 1.0, DHA_Ratio => 0.95, Is_Osmoconformer => True,
            Temp_Min => 0.0, Temp_Max => 30.0,
            Pressure_Tol_Min => 1.0, Pressure_Tol_Max => 1100.0,
            Lifestyle => Benthic, Needs_Light => False, Is_Bioluminescent => False),
      8 => (Name => "Xenophyophore (Giant Protist)       ",
            Max_Depth => 10000.0, TMAO_Level => 80.0, Hydration => 1.8,
            Osmoconformity => 1.0, DHA_Ratio => 0.6, Is_Osmoconformer => True,
            Temp_Min => 1.0, Temp_Max => 5.0,
            Pressure_Tol_Min => 100.0, Pressure_Tol_Max => 1000.0,
            Lifestyle => Benthic, Needs_Light => False, Is_Bioluminescent => False),
      9 => (Name => "Macrocystis pyrifera (Giant Kelp)   ",
