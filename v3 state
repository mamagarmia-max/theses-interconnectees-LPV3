def compute_lorentz_gamma(v: float) -> float:
    """γ = 1 / √(1 - v²/c²)"""
    if v >= C:
        return float('inf')
    beta = v / C
    if beta >= 1.0:
        return float('inf')
    return 1.0 / math.sqrt(1.0 - beta * beta)

