package V3.Lorentz_Invariance_Explainer with SPARK_Mode => On is

   -- ========================================================================
   -- 1. INVARIANTS V3 (VERROUILLÉS — CONSTANTES UNIVERSELLES)
   -- ========================================================================

   PSI_V3          : constant := 48_016.8;          -- kg·m⁻²
   PHI_CRITICAL    : constant := -51.10;            -- mV
   K_CYCLES        : constant := 7;                 -- Fermeture heptadique
   MODULO_9        : constant := 9;                 -- Intégrité structurelle
   RHO_COND        : constant := 1026.0;            -- kg·m⁻³
   C               : constant := 299_792_458.0;     -- m/s
   R_HUBBLE        : constant := 1.38e26;           -- m (rayon de Hubble)
   PI              : constant := 3.141592653589793; -- Pi

   -- ========================================================================
   -- 2. TYPES DE BASE
   -- ========================================================================

   subtype Velocity_ms is Float range 0.0 .. 1.0e9;
   subtype Distance_m is Float range 0.0 .. 1.0e27;
   subtype Scale_Factor is Float range 0.0 .. 100.0;

   -- ========================================================================
   -- 3. STRUCTURE DE L'EXPLICATION
   -- ========================================================================

   type Lorentz_Explanation is record
      -- Paramètres fondamentaux
      Psi_V3           : Float := PSI_V3;
      Phi_Critical     : Float := PHI_CRITICAL;
      K                : Integer := K_CYCLES;
      Modulo_9         : Integer := MODULO_9;

      -- Variables de Lorentz
      Velocity         : Velocity_ms := 0.0;
      Gamma            : Float := 1.0;               -- Facteur de Lorentz
      Delta_Phi        : Float := 0.0;               -- Dérive de phase

      -- Écarts cosmiques
      Scale            : Distance_m := 0.0;
      Psi_Effective    : Float := 0.0;
      Delta_G          : Float := 0.0;               -- Écart gravitationnel
      DM_Fraction      : Float := 0.0;               -- % matière noire

      -- Statut
      Lorentz_Valid    : Boolean := True;
      Cosmic_Break     : Boolean := False;
      Checksum         : Integer := MODULO_9;
   end record
     with Predicate => Lorentz_Explanation.Checksum = MODULO_9;

   -- ========================================================================
   -- 4. FONCTIONS DE CALCUL
   -- ========================================================================

   -- 4.1 Calcul du facteur de Lorentz γ
   function Compute_Gamma
     (Velocity : Velocity_ms) return Float
     with Pre  => Velocity >= 0.0 and Velocity < C,
          Post => Compute_Gamma'Result >= 1.0;

   -- 4.2 Dérive de phase sous transformation de Lorentz
   function Compute_Phase_Drift
     (Velocity   : Velocity_ms;
      Distance   : Distance_m) return Float
     with Pre  => Velocity >= 0.0 and Distance >= 0.0,
          Post => Compute_Phase_Drift'Result >= -100.0;

   -- 4.3 Ψ_V3 effective sous Lorentz
   function Compute_Effective_Psi
     (Psi_Base   : Float;
      Gamma      : Float) return Float
     with Pre  => Psi_Base > 0.0 and Gamma >= 1.0,
          Post => Compute_Effective_Psi'Result > 0.0;

   -- 4.4 Écart gravitationnel (Δg) à l'échelle cosmique
   function Compute_Cosmic_Gravity_Deviation
     (Distance : Distance_m) return Float
     with Pre  => Distance >= 0.0,
          Post => Compute_Cosmic_Gravity_Deviation'Result >= 0.0;

   -- 4.5 Fraction de matière noire à une distance donnée
   function Compute_Dark_Matter_Fraction
     (Distance : Distance_m) return Float
     with Pre  => Distance >= 0.0,
          Post => Compute_Dark_Matter_Fraction'Result in 0.0 .. 100.0;

   -- ========================================================================
   -- 5. EXPLICATION COMPLÈTE
   -- ========================================================================

   procedure Explain_Lorentz_Invariance
     (Velocity   : in     Velocity_ms;
      Distance   : in     Distance_m;
      State      :    out Lorentz_Explanation;
      Report     :    out String)
     with Pre  => Velocity >= 0.0 and Velocity < C and Distance >= 0.0,
          Post => State.Checksum = MODULO_9 and Report'Length > 0;

end V3.Lorentz_Invariance_Explainer;

