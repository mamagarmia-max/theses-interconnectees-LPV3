      Phase_Drift : Float := Compute_Phase_Drift (Velocity, Distance);
      Psi_Eff : Float := Compute_Effective_Psi (PSI_V3, Gamma);
      Delta_G : Float := Compute_Cosmic_Gravity_Deviation (Distance);
      DM_Frac : Float := Compute_Dark_Matter_Fraction (Distance);
      Lorentz_OK : Boolean := (Velocity < 0.1 * C) and (Distance < 1.0e20);
   begin
      R := (others => ' ');

      -- Remplir l'état
      State.Velocity := Velocity;
