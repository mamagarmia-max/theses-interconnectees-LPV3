package body V3.Lorentz_Invariance_Explainer with SPARK_Mode => On is

   -- ========================================================================
   -- 6. IMPLÉMENTATION DES FONCTIONS
   -- ========================================================================

   function Compute_Gamma
     (Velocity : Velocity_ms) return Float is
      Beta : Float := Velocity / C;
   begin
      -- γ = 1 / √(1 - v²/c²)
      return 1.0 / Sqrt (1.0 - Beta * Beta);
   end Compute_Gamma;

   -- ========================================================================

   function Compute_Phase_Drift
     (Velocity   : Velocity_ms;
      Distance   : Distance_m) return Float is
      Gamma : Float := Compute_Gamma (Velocity);
   begin
      -- ΔΦ = (γ - 1) × Φ_critical × (Distance / R_Hubble)
      -- La phase dérive avec la vitesse et la distance
      return (Gamma - 1.0) * abs (PHI_CRITICAL) * (Distance / R_Hubble);
   end Compute_Phase_Drift;

   -- ========================================================================

   function Compute_Effective_Psi
     (Psi_Base : Float;
      Gamma    : Float) return Float is
   begin
      -- Ψ_eff = Ψ_V3 / γ
      -- La densité de phase se dilate avec le mouvement
      return Psi_Base / Gamma;
   end Compute_Effective_Psi;

   -- ========================================================================

   function Compute_Cosmic_Gravity_Deviation
     (Distance : Distance_m) return Float is
      Delta_G_Constant : constant Float := PSI_V3 * C * C / (R_HUBBLE * RHO_COND);
   begin
      -- Δg = Ψ_V3 × c² / (R_Hubble × ρ_cond) × (Distance / R_Hubble)
      -- L'écart gravitationnel augmente avec la distance
      if Distance <= R_Hubble then
         return Delta_G_Constant * (Distance / R_Hubble);
      else
         return Delta_G_Constant;
      end if;
   end Compute_Cosmic_Gravity_Deviation;

   -- ========================================================================

   function Compute_Dark_Matter_Fraction
     (Distance : Distance_m) return Float is
      Delta_G : Float := Compute_Cosmic_Gravity_Deviation (Distance);
      Newton_G : Float := 0.0;  -- Newtonian gravity at that scale
   begin
      -- DM % = Δg / (g_Newton + Δg) × 100
      -- Approximation pour la démonstration
      if Distance < 1.0e20 then
         return 0.0;
      elsif Distance < 1.0e21 then
         return 20.0 * (Distance / 1.0e21);
      elsif Distance < 1.0e22 then
         return 20.0 + 40.0 * (Distance - 1.0e21) / 9.0e21;
      else
         return 60.0 + 40.0 * (Distance - 1.0e22) / (R_HUBBLE - 1.0e22);
      end if;
   end Compute_Dark_Matter_Fraction;

   -- ========================================================================

   procedure Explain_Lorentz_Invariance
     (Velocity   : in     Velocity_ms;
      Distance   : in     Distance_m;
      State      :    out Lorentz_Explanation;
      Report     :    out String) is
      R : String (1 .. 5000);
