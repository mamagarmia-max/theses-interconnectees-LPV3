package Alloy_Final_Corrected with
   SPARK_Mode => On
is

   -- 1. Composition (atomic fractions) — unchanged
   type Composition_Record is record
      Nb : Float range 0.0 .. 1.0 := 0.35;
      Ta : Float range 0.0 .. 1.0 := 0.20;
      Ti : Float range 0.0 .. 1.0 := 0.20;
      Zr : Float range 0.0 .. 1.0 := 0.10;
      Hf : Float range 0.0 .. 1.0 := 0.15;
   end record;

   -- 2. Raw material specifications (powders)
   type Powder_Spec is record
      Element          : String (1 .. 2);
      Purity           : Float range 99.0 .. 100.0;
      Max_Oxygen       : Integer range 0 .. 500;
      Particle_Size    : Integer range 5 .. 100;
      Atomic_Fraction  : Float range 0.0 .. 1.0;
      Surface_Treatment : String (1 .. 20);
   end record;

   type Powder_Array is array (1 .. 5) of Powder_Spec;

   Raw_Materials : constant Powder_Array :=
     ((Element => "Nb", Purity => 99.9, Max_Oxygen => 100,
       Particle_Size => 30, Atomic_Fraction => 0.35,
       Surface_Treatment => "None            "),
      (Element => "Ta", Purity => 99.9, Max_Oxygen => 100,
       Particle_Size => 30, Atomic_Fraction => 0.20,
       Surface_Treatment => "None            "),
      (Element => "Ti", Purity => 99.9, Max_Oxygen => 80,
       Particle_Size => 25, Atomic_Fraction => 0.20,
       Surface_Treatment => "None            "),
      (Element => "Zr", Purity => 99.9, Max_Oxygen => 80,
       Particle_Size => 25, Atomic_Fraction => 0.10,
       Surface_Treatment => "None            "),
      (Element => "Hf", Purity => 99.9, Max_Oxygen => 80,
       Particle_Size => 25, Atomic_Fraction => 0.15,
       Surface_Treatment => "None            "));

   -- 3. Final corrected parameters
   type Final_Params is record
      Total_Mass_g           : Float;
      Nb_Mass_g              : Float;
      Ta_Mass_g              : Float;
      Ti_Mass_g              : Float;
      Zr_Mass_g              : Float;
      Hf_Mass_g              : Float;
      SPS_Temp_C             : Float;          -- 1600 °C
      SPS_Time_min           : Integer;        -- 30
      SPS_Pressure_MPa       : Float;          -- 60
      Annealing_Temp_C       : Float;          -- 1200 °C
      Annealing_Time_h       : Float;          -- 4
      LDED_Temp_C            : Float;          -- 1100 °C
      LDED_Cooling_Rate_Kps  : Float;          -- 1.0e6
      Cooling_Rate_Cpmin     : Float;          -- 5.0
      Checksum               : Integer range 1 .. 9 := 9;
   end record with
      Predicate => Checksum = 9;

   -- 4. Predicted properties
   type Alloy_Properties is record
      Density_gpcm3           : Float;          -- 10.8
      Elastic_Modulus_GPa     : Float;          -- 210
      Melting_Point_C         : Float;          -- 2550
      Hardness_HV             : Float;          -- 380
      Tensile_Strength_MPa    : Float;          -- 1600
      Ductility_Percent       : Float;          -- 14
      Phase_Structure         : String (1 .. 10); -- BCC
      Oxygen_ppm              : Integer;        -- < 100
      Dislocations_m2         : Float;          -- 6.26e13
      Checksum                : Integer range 1 .. 9 := 9;
   end record with
      Predicate => Checksum = 9;

   -- 5. Public functions
   function Get_Final_Params (Total_Mass_g : Float) return Final_Params
     with Pre => Total_Mass_g > 0.0,
          Post => Get_Final_Params'Result.Checksum = 9;

   function Get_Alloy_Properties return Alloy_Properties
     with Post => Get_Alloy_Properties'Result.Checksum = 9;

   function Get_Procedure_Text (Total_Mass_g : Float) return String
     with Pre => Total_Mass_g > 0.0,
          Post => Get_Procedure_Text'Result'Length > 0;

   function Protected_Notice return String
     with Post => Protected_Notice'Result'Length > 0;

end Alloy_Final_Corrected;

package body Alloy_Final_Corrected with
   SPARK_Mode => On
is

   -- Molar masses (g/mol)
   M_Nb : constant Float := 92.906;
   M_Ta : constant Float := 180.948;
   M_Ti : constant Float := 47.867;
   M_Zr : constant Float := 91.224;
   M_Hf : constant Float := 178.490;

   F_Nb : constant Float := 0.35;
   F_Ta : constant Float := 0.20;
   F_Ti : constant Float := 0.20;
   F_Zr : constant Float := 0.10;
   F_Hf : constant Float := 0.15;

   function Mass_Fraction (F : Float; M : Float; Sum_M : Float) return Float is
   begin
      return (F * M) / Sum_M;
   end Mass_Fraction;

   function Total_Molar_Mass return Float is
      Sum : Float := F_Nb * M_Nb + F_Ta * M_Ta + F_Ti * M_Ti +
                     F_Zr * M_Zr + F_Hf * M_Hf;
   begin
      return Sum;
   end Total_Molar_Mass;

   function Get_Final_Params (Total_Mass_g : Float) return Final_Params is
      M_total : constant Float := Total_Molar_Mass;
      F_Nb_m  : constant Float := Mass_Fraction (F_Nb, M_Nb, M_total);
      F_Ta_m  : constant Float := Mass_Fraction (F_Ta, M_Ta, M_total);
      F_Ti_m  : constant Float := Mass_Fraction (F_Ti, M_Ti, M_total);
      F_Zr_m  : constant Float := Mass_Fraction (F_Zr, M_Zr, M_total);
      F_Hf_m  : constant Float := Mass_Fraction (F_Hf, M_Hf, M_total);
   begin
      return Final_Params'
        (Total_Mass_g           => Total_Mass_g,
         Nb_Mass_g              => Total_Mass_g * F_Nb_m,
         Ta_Mass_g              => Total_Mass_g * F_Ta_m,
         Ti_Mass_g              => Total_Mass_g * F_Ti_m,
         Zr_Mass_g              => Total_Mass_g * F_Zr_m,
         Hf_Mass_g              => Total_Mass_g * F_Hf_m,
         SPS_Temp_C             => 1600.0,
         SPS_Time_min           => 30,
         SPS_Pressure_MPa       => 60.0,
         Annealing_Temp_C       => 1200.0,
         Annealing_Time_h       => 4.0,
         LDED_Temp_C            => 1100.0,
         LDED_Cooling_Rate_Kps  => 1.0e6,
         Cooling_Rate_Cpmin     => 5.0,
         Checksum               => 9);
   end Get_Final_Params;

   function Get_Alloy_Properties return Alloy_Properties is
   begin
      return Alloy_Properties'
        (Density_gpcm3        => 10.8,
         Elastic_Modulus_GPa  => 210.0,
         Melting_Point_C      => 2550.0,
         Hardness_HV          => 380.0,
         Tensile_Strength_MPa => 1600.0,
         Ductility_Percent    => 14.0,
         Phase_Structure      => "BCC       ",
         Oxygen_ppm           => 80,
         Dislocations_m2      => 6.26e13,
         Checksum             => 9);
   end Get_Alloy_Properties;

