with Ada.Text_IO; use Ada.Text_IO;
with Ada.Float_Text_IO; use Ada.Float_Text_IO;
with Ada.Integer_Text_IO; use Ada.Integer_Text_IO;

procedure V3_Quasicrystal with
   SPARK_Mode => On,
   Global => null
is

   -- ========================================================================
   -- 1. INVARIANTS V3 (VERROUILLÉS)
   -- ========================================================================

   PSI_V3          : constant := 48016.8;          -- kg·m⁻²
   PHI_CRITICAL    : constant := -51.1;            -- mV
   NU_PHASE        : constant := 6.4e12;           -- Hz
   BETA            : constant := 1_000_000.0;      -- Facteur d'échelle
   RHO_COND        : constant := 1026.0;           -- kg·m⁻³
   K_CYCLES        : constant := 7;                -- Fermeture heptadique

   -- ========================================================================
   -- 2. CONSTANTES POUR LES QUASI-CRISTAUX
   -- ========================================================================

   GOLDEN_RATIO    : constant := 1.618033988749895; -- φ = (1 + √5) / 2
   PI              : constant := 3.141592653589793;

   -- Symétries interdites en cristallographie classique
   TYPE Symmetry_Type IS (Pentagonal, Octagonal, Decagonal, Dodecagonal, Icosahedral);

   -- ========================================================================
   -- 3. TYPES POUR LES QUASI-CRISTAUX
   -- ========================================================================

   type Quasicrystal_Record is record
      Symmetry         : Symmetry_Type;
      Order            : Integer;                  -- Ordre de symétrie (5, 8, 10, 12)
      Angle_Deg        : Float;                    -- Angle caractéristique
      Phi_Factor       : Float;                    -- Facteur d'or (1.618)
      Coherence_Pct    : Float range 0.0 .. 100.0; -- Cohérence de phase
      Is_Stable        : Boolean;
      Is_Periodic      : Boolean;                  -- False pour les quasi-cristaux
      Checksum         : Integer range 1 .. 9 := 9;
   end record
     with Predicate => Quasicrystal_Record.Checksum = 9;

   -- ========================================================================
   -- 4. FONCTIONS DE CALCUL V3
   -- ========================================================================

   -- 4.1 Angle caractéristique d'une symétrie
   function Symmetry_Angle (S : Symmetry_Type) return Float
     with Post => Symmetry_Angle'Result > 0.0
   is
   begin
      case S is
         when Pentagonal   => return 360.0 / 5.0;   -- 72°
         when Octagonal    => return 360.0 / 8.0;   -- 45°
         when Decagonal    => return 360.0 / 10.0;  -- 36°
         when Dodecagonal  => return 360.0 / 12.0;  -- 30°
         when Icosahedral  => return 60.0;          -- 60° (faces triangulaires)
      end case;
   end Symmetry_Angle;

   -- 4.2 Ordre de symétrie
   function Symmetry_Order (S : Symmetry_Type) return Integer
     with Post => Symmetry_Order'Result in 5 .. 12
   is
   begin
      case S is
         when Pentagonal   => return 5;
         when Octagonal    => return 8;
         when Decagonal    => return 10;
         when Dodecagonal  => return 12;
         when Icosahedral  => return 5;             -- 5 axes d'ordre 3
      end case;
   end Symmetry_Order;

   -- 4.3 Facteur de frustration topologique
   function Frustration_Factor (Order : Integer; Phi : Float) return Float
     with Pre => Order >= 5 and Order <= 12 and Phi > 0.0,
          Post => Frustration_Factor'Result >= 0.0
   is
      -- La frustration est minimale quand l'ordre est proche d'un multiple de φ
      -- φ ≈ 1.618 → 5, 8, 13, 21, 34, 55, 89, 144...
      -- 5 et 8 sont des nombres de Fibonacci, donc stables
      -- 10 et 12 sont instables
      Diff : Float := abs (Float (Order) / Phi - Float (Order));
   begin
      if Order = 5 or Order = 8 then
         return 0.0;  -- Pas de frustration
      elsif Order = 10 or Order = 12 then
         return 0.5;  -- Frustration modérée
      else
         return 1.0;  -- Frustration élevée
      end if;
   end Frustration_Factor;

   -- 4.4 Cohérence de phase pour un quasi-cristal
   function Compute_Coherence (Symmetry : Symmetry_Type; Frustration : Float) return Float
     with Pre => Frustration >= 0.0 and Frustration <= 1.0,
          Post => Compute_Coherence'Result in 0.0 .. 100.0
   is
      Base_Coherence : Float := 100.0;
   begin
      -- La cohérence est réduite par la frustration
      Base_Coherence := Base_Coherence - Frustration * 20.0;

      -- Ajustement par le seuil critique
      if Base_Coherence < abs (PHI_CRITICAL) then
         Base_Coherence := abs (PHI_CRITICAL);
      end if;

      return Base_Coherence;
   end Compute_Coherence;

   -- 4.5 Déterminer si un quasi-cristal est stable
   function Is_Stable_Quasicrystal (Symmetry : Symmetry_Type; Coherence : Float) return Boolean
     with Pre => Coherence in 0.0 .. 100.0
   is
   begin
      -- Un quasi-cristal est stable si :
      -- 1. Sa cohérence est ≥ 90%
      -- 2. Sa symétrie est compatible avec la grille de phase
      if Coherence >= 90.0 then
         case Symmetry is
            when Pentagonal   => return True;   -- 5-fold → stable
            when Octagonal    => return False;  -- 8-fold → instable
            when Decagonal    => return True;   -- 10-fold → stable (quasi)
            when Dodecagonal  => return False;  -- 12-fold → instable
            when Icosahedral  => return True;   -- 5-fold → stable
         end case;
      else
         return False;
      end if;
   end Is_Stable_Quasicrystal;

   -- 4.6 Création d'un quasi-cristal
   function Create_Quasicrystal (S : Symmetry_Type) return Quasicrystal_Record
     with Post => Create_Quasicrystal'Result.Checksum = 9
   is
      Order      : Integer := Symmetry_Order (S);
      Angle      : Float := Symmetry_Angle (S);
      Frust      : Float := Frustration_Factor (Order, GOLDEN_RATIO);
      Coherence  : Float := Compute_Coherence (S, Frust);
      Stable     : Boolean := Is_Stable_Quasicrystal (S, Coherence);
   begin
      return Quasicrystal_Record'
        (Symmetry         => S,
         Order            => Order,
         Angle_Deg        => Angle,
         Phi_Factor       => GOLDEN_RATIO,
         Coherence_Pct    => Coherence,
         Is_Stable        => Stable,
         Is_Periodic      => False,
         Checksum         => 9);
   end Create_Quasicrystal;

