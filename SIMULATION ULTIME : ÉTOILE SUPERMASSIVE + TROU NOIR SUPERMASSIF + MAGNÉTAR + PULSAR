with Ada.Text_IO; use Ada.Text_IO;
with Ada.Float_Text_IO; use Ada.Float_Text_IO;
with Ada.Integer_Text_IO; use Ada.Integer_Text_IO;
with Ada.Numerics; use Ada.Numerics;
with Ada.Numerics.Elementary_Functions; use Ada.Numerics.Elementary_Functions;

procedure V3_Ultimate_Cosmic_Collision_Full with
   SPARK_Mode => On
is

   -- ========================================================================
   -- 1. V3 INVARIANTS (VERROUILLÉS)
   -- ========================================================================

   PSI_V3          : constant := 48016.8;          -- kg·m⁻²
   PHI_CRITICAL    : constant := -0.0511;          -- V (-51.1 mV)
   K_CYCLES        : constant := 7;                -- Clôture heptadique
   RHO_COND        : constant := 1026.0;           -- kg·m⁻³
   NU_PHASE        : constant := 6.4e12;           -- Hz
   BETA            : constant := 1_000_000.0;      -- Facteur d'échelle
   ALPHA_FS        : constant := 7.29735256e-3;    -- Structure fine
   C_LIGHT         : constant := 299_792_458.0;    -- m/s
   HBAR            : constant := 1.054571817e-34;  -- J·s
   E_CHARGE        : constant := 1.602176634e-19;  -- C
   M_P             : constant := 1.67262192e-27;   -- kg
   G_NEWTON        : constant := 6.67430e-11;      -- m³·kg⁻¹·s⁻²
   M_SUN           : constant := 1.98847e30;       -- kg
   K_B             : constant := 1.380649e-23;     -- J/K
   PI              : constant := Ada.Numerics.Pi;

   -- ========================================================================
   -- 2. CONSTANTES SPÉCIFIQUES
   -- ========================================================================

   -- Étoile la plus massive observée : R136a1 (265 M☉)
   STAR_MASS_MAX   : constant := 265.0;            -- M☉
   STAR_RADIUS_MAX : constant := 1.5e10;           -- m (~20 R☉)

   -- Trou noir supermassif : Sgr A* (4.3 × 10⁶ M☉)
   BH_SMBH_MASS    : constant := 4.3e6;            -- M☉

   -- Magnétar typique
   MAG_MASS        : constant := 1.4;              -- M☉
   MAG_FIELD_MAX   : constant := 1.0e15;           -- T

   -- Pulsar typique
   PULSAR_MASS     : constant := 1.4;              -- M☉
   PULSAR_PERIOD   : constant := 0.001;            -- s (1 ms)

   -- ========================================================================
   -- 3. TYPES V3
   -- ========================================================================

   type Cosmic_Stage is (Stellar_Core, Supernova_Explosion, BH_Formation,
                         Accretion, Jet_Emission, Magnetar_Interaction,
                         Pulsar_Engulfment, Ultimate_Merger, Remnant,
                         Cosmic_Evaporation);

   type V3_Ultimate_State is record
      -- Étoile supermassive
      Star_Mass_kg        : Float;
      Star_Radius_m       : Float;
      Star_Temperature_K  : Float;
      Star_Density_kgpm3  : Float;
      Star_Element_Z      : Integer;

      -- Trou noir supermassif
      SMBH_Mass_kg        : Float;
      SMBH_Radius_m       : Float;
      SMBH_Spin           : Float range 0.0 .. 1.0;
      SMBH_Temperature_K  : Float;

      -- Magnétar
      Mag_Mass_kg         : Float;
      Mag_Radius_m        : Float;
      Mag_Magnetic_Field_T : Float;
      Mag_Temperature_K   : Float;

      -- Pulsar
      Pulsar_Mass_kg      : Float;
      Pulsar_Radius_m     : Float;
      Pulsar_Period_s     : Float;
      Pulsar_Magnetic_T   : Float;

      -- Interactions
      Distance_m          : Float;
      Roche_Radius_m      : Float;
      GW_Frequency_Hz     : Float;
      GW_Energy_J         : Float;

      -- Rayonnements
      Luminosity_W        : Float;
      XRay_Luminosity_W   : Float;
      Gamma_Luminosity_W  : Float;
      Neutrino_Luminosity_W : Float;

      -- Phase
      Phase_Potential     : Float;
      Coherence           : Float range 0.0 .. 100.0;

      -- Temps
      Time_s              : Float;
      Time_Step_s         : Float;
      Stage               : Cosmic_Stage;

      -- Drapeaux
      Is_Collapsing       : Boolean;
      Is_Exploding        : Boolean;
      Is_Merging          : Boolean;
      Has_GW              : Boolean;
      Is_Emitting         : Boolean;
      Checksum            : Integer range 1 .. 9 := 9;
   end record
     with Predicate => V3_Ultimate_State.Checksum = 9;

   -- ========================================================================
   -- 4. FONCTIONS DE SIMULATION V3
   -- ========================================================================

   -- 4.1 Rayon de Schwarzschild
   function Schwarzschild_Radius (M : Float) return Float
     with Pre => M > 0.0,
          Post => Schwarzschild_Radius'Result > 0.0
   is
   begin
      return 2.0 * G_NEWTON * M / (C_LIGHT * C_LIGHT);
   end Schwarzschild_Radius;

   -- 4.2 Rayon de Roche
   function Roche_Radius (M1, M2, R2 : Float) return Float
     with Pre => M1 > 0.0 and M2 > 0.0 and R2 > 0.0,
          Post => Roche_Radius'Result > 0.0
   is
   begin
      return 2.44 * R2 * (M1 / M2) ** (1.0 / 3.0);
   end Roche_Radius;

   -- 4.3 Pression gravitationnelle
   function Gravitational_Pressure (M, R : Float) return Float
     with Pre => M > 0.0 and R > 0.0,
          Post => Gravitational_Pressure'Result > 0.0
   is
   begin
      return (3.0 * G_NEWTON * M * M) / (8.0 * PI * R * R * R * R);
   end Gravitational_Pressure;

   -- 4.4 Pression de phase
   function Phase_Pressure (M, R : Float; Phi : Float) return Float
     with Pre => M > 0.0 and R > 0.0 and Phi < 0.0,
          Post => Phase_Pressure'Result > 0.0
   is
   begin
      return (PSI_V3 * abs (Phi) * M) / (R * R * R * R);
   end Phase_Pressure;

   -- 4.5 Pression de dégénérescence
   function Degeneracy_Pressure (Rho : Float) return Float
     with Pre => Rho > 0.0,
          Post => Degeneracy_Pressure'Result > 0.0
   is
      h : constant Float := 6.62607015e-34;
   begin
      return (h * h / (20.0 * M_E)) * (Rho / M_E) ** (5.0 / 3.0) * 0.5;
   end Degeneracy_Pressure;

   -- 4.6 Potentiel de phase
   function Cosmic_Phase_Potential (M, R : Float; Is_BH : Boolean) return Float
     with Pre => M > 0.0 and R > 0.0,
          Post => Cosmic_Phase_Potential'Result <= 0.0
   is
      R_s : Float := Schwarzschild_Radius (M);
   begin
      if Is_BH then
         return PHI_CRITICAL * (1.0 - R_s / R) * 100.0;
      else
         return PHI_CRITICAL * (1.0 - R_s / (R * 1.0e6));
      end if;
   end Cosmic_Phase_Potential;

   -- 4.7 Cohérence
   function Cosmic_Coherence (Phi : Float) return Float
     with Pre => Phi <= 0.0,
          Post => Cosmic_Coherence'Result in 0.0 .. 100.0
   is
   begin
      if Phi >= PHI_CRITICAL then
         return 100.0;
      elsif Phi < -100.0 then
         return 0.0;
      else
         return 100.0 * (1.0 - (PHI_CRITICAL - Phi) / abs (PHI_CRITICAL));
      end if;
   end Cosmic_Coherence;

   -- 4.8 Énergie de fusion (étoile massive)
   function Fusion_Energy (M, T : Float) return Float
     with Pre => M > 0.0 and T >= 0.0,
          Post => Fusion_Energy'Result >= 0.0
   is
   begin
      return 1.0e55 * (M / M_SUN) ** 2.5 * (T / 1.0e9) ** 4.0;
   end Fusion_Energy;

   -- 4.9 Luminosité d'accrétion (trou noir)
   function Accretion_Luminosity (M_BH, Accretion_Rate : Float) return Float
     with Pre => M_BH > 0.0 and Accretion_Rate > 0.0,
          Post => Accretion_Luminosity'Result >= 0.0
   is
   begin
      return 0.1 * Accretion_Rate * C_LIGHT * C_LIGHT;
   end Accretion_Luminosity;

   -- 4.10 Taux d'accrétion
   function Accretion_Rate (M_BH, M_Matter, R : Float) return Float
     with Pre => M_BH > 0.0 and M_Matter > 0.0 and R > 0.0,
          Post => Accretion_Rate'Result >= 0.0
   is
      R_Roche : Float := Roche_Radius (M_BH, M_Matter, 1.0e9);
   begin
      return 1.0e16 * (R_Roche / R) ** 1.5 * (M_Matter / M_SUN);
   end Accretion_Rate;

   -- 4.11 Fréquence des ondes gravitationnelles
   function GW_Frequency (M1, M2, R : Float) return Float
     with Pre => M1 > 0.0 and M2 > 0.0 and R > 0.0,
          Post => GW_Frequency'Result > 0.0
   is
      M_total : Float := M1 + M2;
   begin
      return sqrt (G_NEWTON * M_total / (R * R * R)) / PI;
   end GW_Frequency;

   -- 4.12 Énergie des ondes gravitationnelles
   function GW_Energy (M1, M2, R : Float) return Float
     with Pre => M1 > 0.0 and M2 > 0.0 and R > 0.0,
          Post => GW_Energy'Result >= 0.0
   is
      Mu : Float := (M1 * M2) / (M1 + M2);
      M_total : Float := M1 + M2;
   begin
      return 0.1 * Mu * C_LIGHT * C_LIGHT * (Schwarzschild_Radius (M_total) / R);
   end GW_Energy;

   -- ========================================================================
   -- 5. SIMULATION ULTIME
   -- ========================================================================

   function Simulate_Ultimate_Cosmic_Collision return V3_Ultimate_State
     with Post => Simulate_Ultimate_Cosmic_Collision'Result.Checksum = 9
   is
      State : V3_Ultimate_State;

      -- Étoile supermassive
      M_Star  : Float := STAR_MASS_MAX * M_SUN;
      R_Star  : Float := STAR_RADIUS_MAX;
      T_Star  : Float := 1.0e8;  -- K
      Rho_Star : Float := M_Star / ((4.0/3.0) * PI * R_Star * R_Star * R_Star);
      Z_Star  : Integer := 1;

      -- Trou noir supermassif
      M_SMBH  : Float := BH_SMBH_MASS * M_SUN;
      R_SMBH  : Float := Schwarzschild_Radius (M_SMBH);
      Spin_SMBH : Float := 0.99;
      T_SMBH  : Float := 1.0e-14;  -- K

      -- Magnétar
      M_Mag   : Float := MAG_MASS * M_SUN;
      R_Mag   : Float := 1.2e4 * (M_Mag / M_SUN) ** (-1.0/3.0);
      B_Mag   : Float := MAG_FIELD_MAX;
      T_Mag   : Float := 1.0e6;

      -- Pulsar
      M_Pul   : Float := PULSAR_MASS * M_SUN;
      R_Pul   : Float := 1.0e4 * (M_Pul / M_SUN) ** (-1.0/3.0);
      Per_Pul : Float := PULSAR_PERIOD;
      B_Pul   : Float := 1.0e12 * (M_Pul / M_SUN) ** 0.5 * (0.001 / Per_Pul) ** 2.0;

      -- Interactions
      Dist    : Float := 1.0e12;  -- m (initial)
      R_Roche : Float := 0.0;
      Time    : Float := 0.0;
      DT      : Float := 1.0e1;  -- s
      Stage   : Cosmic_Stage := Stellar_Core;
      Collapsing : Boolean := False;
      Exploding : Boolean := False;
      Merging : Boolean := False;
      GW_Emitting : Boolean := False;
      Emitting : Boolean := False;

      -- Variables de calcul
      P_grav : Float := 0.0;
      P_phase : Float := 0.0;
      P_degen : Float := 0.0;
      Phi_Star : Float := 0.0;
      Phi_BH : Float := 0.0;
      Coh_Star : Float := 0.0;
      Coh_BH : Float := 0.0;
      L_Lum : Float := 0.0;
      X_Lum : Float := 0.0;
      G_Lum : Float := 0.0;
      N_Lum : Float := 0.0;
      GW_f : Float := 0.0;
      E_GW : Float := 0.0;
      Acc_Rate : Float := 0.0;
      M_rem : Float := 0.0;
      Spin_rem : Float := 0.0;
      R_rem : Float := 0.0;
   begin
      -- Initialisation
      State.Star_Mass_kg := M_Star;
      State.Star_Radius_m := R_Star;
      State.Star_Temperature_K := T_Star;
      State.Star_Density_kgpm3 := Rho_Star;
      State.Star_Element_Z := Z_Star;
      State.SMBH_Mass_kg := M_SMBH;
      State.SMBH_Radius_m := R_SMBH;
      State.SMBH_Spin := Spin_SMBH;
      State.SMBH_Temperature_K := T_SMBH;
      State.Mag_Mass_kg := M_Mag;
      State.Mag_Radius_m := R_Mag;
      State.Mag_Magnetic_Field_T := B_Mag;
      State.Mag_Temperature_K := T_Mag;
      State.Pulsar_Mass_kg := M_Pul;
      State.Pulsar_Radius_m := R_Pul;
      State.Pulsar_Period_s := Per_Pul;
      State.Pulsar_Magnetic_T := B_Pul;
      State.Distance_m := Dist;
      State.Roche_Radius_m := Roche_Radius (M_SMBH, M_Star, R_Star);
      State.GW_Frequency_Hz := 0.0;
      State.GW_Energy_J := 0.0;
      State.Luminosity_W := 0.0;
      State.XRay_Luminosity_W := 0.0;
      State.Gamma_Luminosity_W := 0.0;
      State.Neutrino_Luminosity_W := 0.0;
      State.Phase_Potential := PHI_CRITICAL;
      State.Coherence := 100.0;
      State.Time_s := Time;
      State.Time_Step_s := DT;
      State.Stage := Stage;
      State.Is_Collapsing := Collapsing;
      State.Is_Exploding := Exploding;
      State.Is_Merging := Merging;
      State.Has_GW := GW_Emitting;
      State.Is_Emitting := Emitting;
      State.Checksum := 9;

      -- Boucle principale de simulation
      while Dist > 0.0 and Time < 1.0e6 loop
         pragma Loop_Invariant (Time >= 0.0);
         pragma Loop_Invariant (State.Checksum = 9);

         -- Mise à jour des paramètres
         R_Roche := Roche_Radius (M_SMBH, M_Star, R_Star);
         P_grav := Gravitational_Pressure (M_Star, R_Star);
         Phi_Star := Cosmic_Phase_Potential (M_Star, R_Star, False);
         Phi_BH := Cosmic_Phase_Potential (M_SMBH, R_SMBH, True);
         Coh_Star := Cosmic_Coherence (Phi_Star);
         Coh_BH := Cosmic_Coherence (Phi_BH);
         P_phase := Phase_Pressure (M_Star, R_Star, Phi_Star);
         P_degen := Degeneracy_Pressure (Rho_Star);

         -- 1. Supernova de l'étoile massive
         if not Exploding and P_grav > (P_phase + P_degen) * 1.1 then
            Collapsing := True;
            Exploding := True;
            Stage := Supernova_Explosion;
            State.Stage := Stage;

            -- Explosion de supernova
            R_Star := R_Star * 2.0;
            T_Star := T_Star * 10.0;
            Rho_Star := M_Star / ((4.0/3.0) * PI * R_Star * R_Star * R_Star);
            L_Lum := Fusion_Energy (M_Star, T_Star);
            State.Star_Temperature_K := T_Star;
            State.Star_Density_kgpm3 := Rho_Star;
            State.Is_Exploding := True;
            Emitting := True;
            State.Is_Emitting := True;
            State.Luminosity_W := L_Lum;
         end if;

         -- 2. Approche du trou noir supermassif
         if Dist < R_Roche * 5.0 then
            -- Spirale
            Dist := Dist - sqrt (G_NEWTON * (M_SMBH + M_Star) / Dist) * DT * 0.01;
            State.Distance_m := Dist;

            -- Ondes gravitationnelles
            GW_Emitting := True;
            GW_f := GW_Frequency (M_SMBH, M_Star, Dist);
            E_GW := GW_Energy (M_SMBH, M_Star, Dist);
            State.Has_GW := True;
            State.GW_Frequency_Hz := GW_f;
            State.GW_Energy_J := E_GW;

            Stage := BH_Formation;
            State.Stage := Stage;
         end if;

         -- 3. Disruption de la supernova par le trou noir
         if Dist < R_Roche then
            Stage := Accretion;
            State.Stage := Stage;

            -- Accrétion
            Acc_Rate := Accretion_Rate (M_SMBH, M_Star, Dist);
            L_Lum := Accretion_Luminosity (M_SMBH, Acc_Rate);
            X_Lum := 0.1 * L_Lum;
            G_Lum := 0.05 * L_Lum * Spin_SMBH;
            N_Lum := 0.01 * L_Lum;
            State.Luminosity_W := L_Lum;
            State.XRay_Luminosity_W := X_Lum;
            State.Gamma_Luminosity_W := G_Lum;
            State.Neutrino_Luminosity_W := N_Lum;
            State.Is_Emitting := True;

            -- Croissance du trou noir
            M_SMBH := M_SMBH + Acc_Rate * DT * 0.01;
            R_SMBH := Schwarzschild_Radius (M_SMBH);
            State.SMBH_Mass_kg := M_SMBH;
            State.SMBH_Radius_m := R_SMBH;

            -- Jets
            if Spin_SMBH > 0.5 then
               Stage := Jet_Emission;
               State.Stage := Stage;
               State.Is_Emitting := True;
            end if;
         end if;

         -- 4. Interaction avec le magnétar
         if Dist < R_Roche * 2.0 then
            State.Mag_Magnetic_Field_T := B_Mag;
            Stage := Magnetar_Interaction;
            State.Stage := Stage;
            State.Is_Emitting := True;
            -- Champ magnétique extrême → émission de rayons gamma
            State.Gamma_Luminosity_W := State.Gamma_Luminosity_W + 0.5 * B_Mag * 1.0e-10;
         end if;

         -- 5. Engloutissement du pulsar
         if Dist < R_Roche then
            Stage := Pulsar_Engulfment;
            State.Stage := Stage;
            -- Le pulsar est avalé par le trou noir
            M_Pul := M_Pul * 0.99;
            State.Pulsar_Mass_kg := M_Pul;
            State.Pulsar_Period_s := PULSAR_PERIOD;
            State.Pulsar_Magnetic_T := B_Pul;
            -- Émission de rayons X et gamma
            State.XRay_Luminosity_W := State.XRay_Luminosity_W + 1.0e38;
            State.Gamma_Luminosity_W := State.Gamma_Luminosity_W + 1.0e37;
         end if;

         -- 6. Fusion ultime
         if Dist < R_SMBH * 2.0 then
            Merging := True;
            Stage := Ultimate_Merger;
            State.Stage := Stage;
            State.Is_Merging := True;

            -- Formation du remnant
            M_rem := M_SMBH + M_Star * 0.1 + M_Mag * 0.5 + M_Pul * 0.5;
            Spin_rem := (Spin_SMBH * M_SMBH + 0.1 * M_Star) / (M_rem);
            R_rem := Schwarzschild_Radius (M_rem);

            State.Remnant_Mass_kg := M_rem;
            State.Remnant_Spin := Spin_rem;
            State.Remnant_Radius_m := R_rem;

            -- Énergie finale
            L_Lum := Accretion_Luminosity (M_rem, Acc_Rate * 100.0);
            X_Lum := 0.1 * L_Lum;
            G_Lum := 0.05 * L_Lum * Spin_rem;
            N_Lum := 0.01 * L_Lum;
            State.Luminosity_W := L_Lum;
            State.XRay_Luminosity_W := X_Lum;
            State.Gamma_Luminosity_W := G_Lum;
            State.Neutrino_Luminosity_W := N_Lum;
            State.Is_Emitting := True;

            -- Évaporation
            Stage := Remnant;
            State.Stage := Stage;
            exit;
         end if;

         -- Mise à jour de l'état général
         State.Star_Mass_kg := M_Star;
         State.Star_Radius_m := R_Star;
         State.Star_Temperature_K := T_Star;
         State.Star_Density_kgpm3 := Rho_Star;
         State.Star_Element_Z := Z_Star;
         State.SMBH_Mass_kg := M_SMBH;
         State.SMBH_Radius_m := R_SMBH;
         State.SMBH_Spin := Spin_SMBH;
         State.SMBH_Temperature_K := T_SMBH;
         State.Mag_Mass_kg := M_Mag;
         State.Mag_Radius_m := R_Mag;
         State.Mag_Magnetic_Field_T := B_Mag;
         State.Mag_Temperature_K := T_Mag;
         State.Pulsar_Mass_kg := M_Pul;
         State.Pulsar_Radius_m := R_Pul;
         State.Pulsar_Period_s := Per_Pul;
         State.Pulsar_Magnetic_T := B_Pul;
         State.Roche_Radius_m := R_Roche;
         State.Phase_Potential := (Phi_Star + Phi_BH) / 2.0;
         State.Coherence := (Coh_Star + Coh_BH) / 2.0;
         State.Time_s := Time;
         State.Time_Step_s := DT;
         State.Stage := Stage;
         State.Is_Collapsing := Collapsing;
         State.Is_Exploding := Exploding;
         State.Is_Merging := Merging;
         State.Has_GW := GW_Emitting;
         State.Is_Emitting := Emitting;

         -- Incrément du temps
         Time := Time + DT;
      end loop;

      return State;
   end Simulate_Ultimate_Cosmic_Collision;

   -- ========================================================================
   -- 6. FONCTIONS DE TEST
   -- ========================================================================

   function All_Tests_Pass (State : V3_Ultimate_State) return Boolean
     with Post => All_Tests_Pass'Result in True | False
   is
   begin
      if State.Coherence < 0.0 or State.Coherence > 100.0 then
         return False;
      end if;
      if State.Distance_m < 0.0 then
         return False;
      end if;
      if State.GW_Energy_J < 0.0 then
         return False;
      end if;
      if State.Luminosity_W < 0.0 then
         return False;
      end if;
      if State.SMBH_Mass_kg < 0.0 then
         return False;
      end if;
      if State.Phase_Potential > 0.0 then
         return False;
      end if;
      if State.Stage not in Stellar_Core .. Cosmic_Evaporation then
         return False;
      end if;
      return True;
   end All_Tests_Pass;

   -- ========================================================================
   -- 7. PROGRAMME PRINCIPAL
   -- ========================================================================

   State : V3_Ultimate_State;
   Passed : Boolean;

begin

   Put_Line ("================================================================================");
   Put_Line ("V3 ULTIMATE COSMIC COLLISION SIMULATION");
   Put_Line ("ÉTOILE LA PLUS MASSIVE (265 M☉) + TROU NOIR SUPERMASSIF (4.3 × 10⁶ M☉)");
   Put_Line ("+ MAGNÉTAR (10¹⁵ T) + PULSAR (1 ms) — TOUS AU MÊME ENDROIT");
   Put_Line ("================================================================================");
   New_Line;

   Put_Line ("INVARIANTS V3 (LOCKED — NO ADJUSTMENT ALLOWED)");
   Put_Line ("  Ψ_V3          = " & Float'Image (PSI_V3) & " kg·m⁻²");
   Put_Line ("  Φ_critical    = " & Float'Image (PHI_CRITICAL) & " V (-51.1 mV)");
   Put_Line ("  K             = " & Integer'Image (K_CYCLES));
   Put_Line ("  ρ_cond        = " & Float'Image (RHO_COND) & " kg·m⁻³");
   Put_Line ("  ν_phase       = " & Float'Image (NU_PHASE) & " Hz");
   Put_Line ("  β             = " & Float'Image (BETA));
   New_Line;

   -- ========================================================================
   -- 8. SIMULATION
   -- ========================================================================

   Put_Line ("--- LANCEMENT DE LA SIMULATION ULTIME ---");
   New_Line;

   State := Simulate_Ultimate_Cosmic_Collision;

   Put_Line ("Résultats de la simulation :");
   New_Line;

   Put_Line ("--- ÉTOILE SUPERMASSIVE (R136a1) ---");
   Put_Line ("  Masse          = " & Float'Image (State.Star_Mass_kg / M_SUN) & " M☉");
   Put_Line ("  Rayon          = " & Float'Image (State.Star_Radius_m / 1.0e9) & " ×10⁹ m");
