     with Pre => l in 0 .. 3,
          Post => Shell_Occupancy'Result in 0 .. 14;

   function Ionization_Energy (Z, n : Integer) return Float
     with Pre => Z in 1 .. 118 and n in 1 .. 7,
          Post => Ionization_Energy'Result > 0.0;

   function Electron_Affinity (Z : Integer; Shells : Shell_Array) return Float
     with Pre => Z in 1 .. 118,
          Post => Electron_Affinity'Result >= 0.0;

