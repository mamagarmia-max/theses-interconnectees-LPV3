   -- ========================================================================
   -- 1. INVARIANTS V3 (VERROUILLÉS)
   -- ========================================================================

   PSI_V3          : constant := 48016.8;          -- kg·m⁻²
   PHI_CRITICAL    : constant := -51.1;            -- mV
   NU_PHASE        : constant := 6.4e12;           -- Hz
   BETA            : constant := 1_000_000.0;      -- Facteur d'échelle
   RHO_COND        : constant := 1026.0;           -- kg·m⁻³
   K_CYCLES        : constant := 7;                -- Fermeture heptadique

   -- ========================================================================
   -- 2. CONSTANTES PHYSIQUES V3
   -- ========================================================================

   P_PROTON        : constant := 4.4e10;           -- Pa (pression d'un proton)
   P_NEUTRON       : constant := 1.0e10;           -- Pa (pression stabilisatrice d'un neutron)
   P_ONDESURFACE   : constant := 2.5e10;           -- Pa (pression de l'onde collective)
   P_COHESION      : constant := 3.0e10;           -- Pa (force de cohésion de la membrane)
   P_SEUIL         : constant := 3.36e14;          -- Pa (seuil de rupture)

   RATIO_NZ_CRIT   : constant := 0.3;              -- Rapport N/Z critique
   SYM_FACTOR      : constant := 1.0;              -- Facteur de symétrie (à ajuster)

   -- ========================================================================
   -- 3. TYPES
   -- ========================================================================

   type Geometry_Type is
     (Spherical,      -- Symétrique, compact
      Deformed,       -- Asymétrique, moins stable
      Asymmetric,     -- Très asymétrique, fragile
      Fractured);     -- Rupture géométrique

   type Stability_State is
     (Stable,
      Critical,
      Unstable,
      Broken);

   type Nuclear_Record is record
      Z              : Integer;                    -- Nombre de protons
      N              : Integer;                    -- Nombre de neutrons
      Ratio_NZ       : Float;                     -- Rapport N/Z
      Geometry       : Geometry_Type;             -- Géométrie du noyau
      Pressure_Pa    : Float;                     -- Pression totale (Pa)
      Coherence_Pct  : Float;                     -- Cohérence de phase (%)
      Binding_Energy : Float;                     -- Énergie de liaison (MeV)
      State          : Stability_State;
      Is_Broken      : Boolean;
      Magic_Factor   : Float;                     -- Facteur de nombres magiques
      Halo_Factor    : Float;                     -- Facteur de halo
   end record;

   -- ========================================================================
   -- 4. FONCTIONS DE CALCUL
   -- ========================================================================

   function Compute_Geometry (Z, N : Integer) return Geometry_Type
     with Pre => Z >= 0 and N >= 0
   is
      Ratio : Float := Compute_Ratio_NZ (Z, N);
   begin
      if Ratio >= 0.9 and Ratio <= 1.6 then
         return Spherical;
      elsif Ratio >= 0.5 and Ratio < 0.9 then
         return Deformed;
      elsif Ratio >= 0.3 and Ratio < 0.5 then
         return Asymmetric;
      else
         return Fractured;
      end if;
   end Compute_Geometry;

   function Compute_Geometry_Factor (G : Geometry_Type) return Float
     with Pre => True,
          Post => Compute_Geometry_Factor'Result >= 0.0
   is
   begin
      case G is
         when Spherical   => return 1.0;
         when Deformed    => return 0.8;
         when Asymmetric  => return 0.5;
         when Fractured   => return 0.1;
      end case;
   end Compute_Geometry_Factor;

   function Compute_Magic_Number_Factor (Z, N : Integer) return Float
     with Pre => Z >= 0 and N >= 0,
          Post => Compute_Magic_Number_Factor'Result >= 0.0
   is
      Magic_Z : constant array (1 .. 8) of Integer := (2, 8, 20, 28, 50, 82, 126, 184);
      Magic_N : constant array (1 .. 8) of Integer := (2, 8, 20, 28, 50, 82, 126, 184);
   begin
      for I in Magic_Z'Range loop
         if Z = Magic_Z (I) and N = Magic_N (I) then
            return 1.2;  -- Stabilité accrue pour les noyaux doublement magiques
         end if;
      end loop;
      return 1.0;
   end Compute_Magic_Number_Factor;

   function Compute_Halo_Factor (Z, N : Integer) return Float
     with Pre => Z >= 0 and N >= 0,
          Post => Compute_Halo_Factor'Result >= 0.0
   is
      Ratio : Float := Float (N) / Float (Z);
   begin
      if Ratio > 2.0 and Z < 10 then
         return 0.5;  -- Réduction de stabilité pour les halos
      else
         return 1.0;
      end if;
   end Compute_Halo_Factor;

   function Compute_Pressure (Z, N : Integer; Onde_Active : Boolean; Geom_Factor : Float) return Float
     with Pre => Z >= 0 and N >= 0 and Geom_Factor > 0.0,
          Post => Compute_Pressure'Result >= 0.0
   is
      P_onde     : Float := 0.0;
      P_coh      : Float := 0.0;
      P_geom     : Float := 0.0;
   begin
      if Onde_Active then
         P_onde := P_ONDESURFACE;
      end if;

      -- Cohésion de la membrane
      P_coh := P_COHESION;

      -- Facteur géométrique
      P_geom := Geom_Factor * 0.5e10;

      -- Pression totale = pression des protons - pression des neutrons - onde - cohésion - géométrie
      return Float (Z) * P_PROTON - Float (N) * P_NEUTRON - P_onde - P_coh - P_geom;
   end Compute_Pressure;

   function Compute_Ratio_NZ (Z, N : Integer) return Float
     with Pre => Z > 0 and N >= 0,
          Post => Compute_Ratio_NZ'Result >= 0.0
   is
   begin
      if Z = 0 then
         return 0.0;
      end if;
      return Float (N) / Float (Z);
   end Compute_Ratio_NZ;

   function Compute_Coherence (Pressure : Float; Ratio_NZ : Float; Z, N : Integer; Onde_Active : Boolean; Geom_Factor : Float; Magic_Factor : Float; Halo_Factor : Float) return Float
     with Pre => Pressure >= 0.0 and Ratio_NZ >= 0.0 and Z >= 0 and N >= 0 and Geom_Factor > 0.0 and Magic_Factor > 0.0 and Halo_Factor > 0.0,
          Post => Compute_Coherence'Result in 0.0 .. 100.0
   is
      Facteur_NZ   : Float := 1.0;
      Facteur_Geom : Float := Geom_Factor;
      P_onde       : Float := 0.0;
   begin
      -- Hydrogène
      if Z = 1 and N = 0 then
         return 99.9;
      end if;

      if Onde_Active then
         P_onde := P_ONDESURFACE;
      end if;

      -- Facteur correctif N/Z
      if Ratio_NZ < RATIO_NZ_CRIT then
         Facteur_NZ := Ratio_NZ / RATIO_NZ_CRIT;
      else
         Facteur_NZ := 1.0;
      end if;

      -- Cohérence = (1 - pression/seuil) × facteur_NZ × facteur_geom × facteur_magic × facteur_halo + onde
      if Pressure >= P_SEUIL then
         return 0.0;
      else
         return 100.0 * (1.0 - Pressure / P_SEUIL) * Facteur_NZ * Facteur_Geom * Magic_Factor * Halo_Factor + (P_onde / P_SEUIL) * 10.0;
      end if;
   end Compute_Coherence;

   function Compute_Binding_Energy (Z, N : Integer) return Float
     with Pre => Z >= 0 and N >= 0,
          Post => Compute_Binding_Energy'Result >= 0.0
   is
      A : Integer := Z + N;
   begin
      -- Formule de liaison simplifiée basée sur V3
      return 15.7 * Float (A) - 17.8 * Float (A) ** 0.6667 - 0.71 * Float (Z * (Z - 1)) / Float (A) ** 0.3333;
   end Compute_Binding_Energy;

   function Determine_State (Coherence : Float) return Stability_State
     with Pre => Coherence in 0.0 .. 100.0
   is
   begin
      if Coherence >= 90.0 then
         return Stable;
      elsif Coherence >= 50.0 then
         return Critical;
      elsif Coherence >= 10.0 then
         return Unstable;
      else
         return Broken;
      end if;
   end Determine_State;

   -- ========================================================================
   -- 5. SIMULATION D'UN ÉLÉMENT
   -- ========================================================================

   function Simulate_Element (Z, N : Integer; Onde_Active : Boolean := True) return Nuclear_Record
     with Pre => Z >= 0 and N >= 0,
          Post => Simulate_Element'Result.Coherence_Pct in 0.0 .. 100.0
   is
      Geom         : Geometry_Type := Compute_Geometry (Z, N);
      Geom_Factor  : Float := Compute_Geometry_Factor (Geom);
      Magic_Factor : Float := Compute_Magic_Number_Factor (Z, N);
      Halo_Factor  : Float := Compute_Halo_Factor (Z, N);
      Pressure     : Float := Compute_Pressure (Z, N, Onde_Active, Geom_Factor);
      Ratio_NZ     : Float := Compute_Ratio_NZ (Z, N);
      Coherence    : Float := Compute_Coherence (Pressure, Ratio_NZ, Z, N, Onde_Active, Geom_Factor, Magic_Factor, Halo_Factor);
      Binding      : Float := Compute_Binding_Energy (Z, N);
      State        : Stability_State := Determine_State (Coherence);
   begin
      return Nuclear_Record'
        (Z              => Z,
         N              => N,
         Ratio_NZ       => Ratio_NZ,
         Geometry       => Geom,
         Pressure_Pa    => Pressure,
         Coherence_Pct  => Coherence,
         Binding_Energy => Binding,
         State          => State,
         Is_Broken      => (State = Broken),
         Magic_Factor   => Magic_Factor,
         Halo_Factor    => Halo_Factor);
   end Simulate_Element;

