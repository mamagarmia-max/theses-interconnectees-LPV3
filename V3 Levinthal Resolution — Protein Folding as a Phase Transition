   FOLD_TIME_REAL : constant := 1;              -- 1 ms

   -- ========================================================================
   -- 3. TYPES DE BASE
   -- ========================================================================

   subtype Config_Type is Integer range 0 .. 1000;
   subtype Time_Type is Integer range 0 .. 1_000_000_000_000_000; -- ns
   subtype Checksum_Type is Integer range 1 .. 9;
   subtype Percentage_Type is Integer range 0 .. 100;

   -- ========================================================================
   -- 4. SATURATING ARITHMETIC — SIMPLIFIÉE POUR GNATPROVE
   -- ========================================================================

   function Digital_Root (N : Integer) return Checksum_Type
     with Pre => N >= 0,
          Post => Digital_Root'Result in 1 .. 9
   is
      V : Integer := N;
      S : Integer := 0;
   begin
      if V < 0 then
         V := -V;
      end if;
      if V = 0 then
         return 9;
      end if;
      while V > 0 loop
         pragma Loop_Invariant (V >= 0 and S >= 0);
         S := S + (V mod 10);
         V := V / 10;
      end loop;
      while S > 9 loop
         pragma Loop_Invariant (S > 9);
         S := (S mod 10) + (S / 10);
      end loop;
      return Checksum_Type (S);
   end Digital_Root;

   function Clamp (Value, Min, Max : Integer) return Integer
     with Pre => Min <= Max,
          Post => Clamp'Result in Min .. Max
   is
   begin
      if Value < Min then
         return Min;
      elsif Value > Max then
         return Max;
      else
         return Value;
      end if;
   end Clamp;

   -- ========================================================================
   -- 5. MODÈLE STANDARD (LEVINTHAL)
   -- ========================================================================

   function Compute_Levinthal_Time (Configs : Integer) return Time_Type
     with Pre => Configs >= 0,
          Post => Compute_Levinthal_Time'Result >= 0
   is
      Time : Long_Long_Integer := 0;
   begin
      -- Temps classique : chaque configuration prend 1 ns
      -- 10^130 configurations → 10^130 ns → impossible
      Time := Long_Long_Integer (Configs) * 1_000_000;
      if Time > Long_Long_Integer (Time_Type'Last) then
         return Time_Type'Last;
      else
         return Time_Type (Time);
      end if;
   end Compute_Levinthal_Time;

   -- ========================================================================
   -- 6. MODÈLE V3 — TRANSITION DE PHASE
   -- ========================================================================

   function Compute_Phase_Coherence (Psi_V3, Phi_Critical, K_Cycles : Integer) return Percentage_Type
     with Pre => Psi_V3 >= 0 and Phi_Critical < 0 and K_Cycles >= 0,
          Post => Compute_Phase_Coherence'Result in 0 .. 100
   is
      Coherence : Integer := 0;
   begin
      -- Cohérence = fonction des invariants V3
      -- Plus Ψ_V3 est élevé, plus la cohérence est forte
      -- Φ_critical agit comme un attracteur (valeur absolue)
      -- k=7 assure la fermeture
      Coherence := (Psi_V3 / 1000) * (abs (Phi_Critical) / 1000) / 100;
      Coherence := Coherence + (K_Cycles * 10);
      Coherence := Coherence / 10;
      return Percentage_Type (Clamp (Coherence, 0, 100));
   end Compute_Phase_Coherence;

   function Compute_V3_Fold_Time (Phase_Coherence : Percentage_Type) return Integer
     with Pre => Phase_Coherence in 0 .. 100,
          Post => Compute_V3_Fold_Time'Result >= 0
