         return 1;
      elsif Phase_Coherence >= 90 then
         return 2;
      elsif Phase_Coherence >= 70 then
         return 5;
      elsif Phase_Coherence >= 50 then
         return 10;
      else
         return 100;
      end if;
   end Compute_V3_Fold_Time;

