use Ada.Text_IO;
use V3_Invariants;
use V3_Types;
use V3_Pressure_Gradient;
use V3_Phase_Locking;
use V3_Density_Curvature;
use V3_Comparison;

procedure V3_Main with
   SPARK_Mode => On
is
   --  100 test cases (multiple of 9 + 1 : 99 + 1 = 100)
   --  Modulo-9 verification : 100 mod 9 = 1, consistent with closure
   pragma Assert (100 mod Modulo_9 = 1);

   Tests : Test_Array := (others => (Observed  => 0,
                                     Computed  => 0,
                                     Tolerance => 1));
   Passing : Integer;
begin
   --  Initialization of test cases (example: 100 cases at zero)
   for I in Tests'Range loop
      Tests (I) := (Observed  => I,
                    Computed  => I,
                    Tolerance => 1);
      pragma Loop_Invariant (I in Tests'Range);
   end loop;

   --  Counting cases within tolerance
   Passing := Count_Passing (Tests);

   --  Proof : counter is bounded
   pragma Assert (Passing in 0 .. 100);

   --  Output
   Put_Line ("V3 — Results of the 100 test cases");
   Put_Line ("Cases within tolerance : " & Integer'Image (Passing));
   Put_Line ("Invariant Psi_V3 : " & Integer'Image (Psi_V3_Scaled));
   Put_Line ("Invariant Phi_Critical : " & Integer'Image (Phi_Critical_Scaled));
   Put_Line ("Invariant k : " & Integer'Image (K_Heptadic));
   Put_Line ("Invariant Modulo-9 : " & Integer'Image (Modulo_9));
end V3_Main;


