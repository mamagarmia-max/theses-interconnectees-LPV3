package V3_Density_Curvature with
   SPARK_Mode => On
is
   --  Light deviation by density gradient.
   --  Pre  : positive densities, positive distance.
   --  Post : bounded angle.
   function Light_Deviation
     (Density_Left  : Density_Type;
      Density_Right : Density_Type;
      Distance      : Distance_Type)
      return Integer
   with
      Pre  => Density_Left > 0
              and then Density_Right > 0
              and then Distance > 0,
      Post => Light_Deviation'Result in -1_000_000 .. 1_000_000;

   --  Effective curvature : second derivative of density.
   --  Pre  : positive distance.
   --  Post : bounded curvature.
   function Effective_Curvature
     (Density_Center : Density_Type;
      Density_Left   : Density_Type;
      Density_Right  : Density_Type;
      Distance       : Distance_Type)
      return Integer
   with
      Pre  => Distance > 0,
      Post => Effective_Curvature'Result in -1_000_000 .. 1_000_000;

end V3_Density_Curvature;


package body V3_Density_Curvature with
   SPARK_Mode => On
is
   function Light_Deviation
     (Density_Left  : Density_Type;
      Density_Right : Density_Type;
      Distance      : Distance_Type)
      return Integer
   is
      Diff : constant Long_Long_Integer :=
        Long_Long_Integer (Density_Right) - Long_Long_Integer (Density_Left);
      Raw  : Long_Long_Integer;
   begin
      Raw := Diff * 1_000 / Long_Long_Integer (Distance);
      if Raw > 1_000_000 then
         return 1_000_000;
      elsif Raw < -1_000_000 then
         return -1_000_000;
      else
         return Integer (Raw);
      end if;
   end Light_Deviation;

   function Effective_Curvature
     (Density_Center : Density_Type;
      Density_Left   : Density_Type;
      Density_Right  : Density_Type;
      Distance       : Distance_Type)
      return Integer
   is
      Second_Derivative : constant Long_Long_Integer :=
        Long_Long_Integer (Density_Left)
        - 2 * Long_Long_Integer (Density_Center)
        + Long_Long_Integer (Density_Right);
      Raw : Long_Long_Integer;
   begin
      Raw := Second_Derivative * 1_000
             / (Long_Long_Integer (Distance) * Long_Long_Integer (Distance));
      if Raw > 1_000_000 then
         return 1_000_000;
      elsif Raw < -1_000_000 then
         return -1_000_000;
      else
         return Integer (Raw);
      end if;
   end Effective_Curvature;

end V3_Density_Curvature;


--  ---------------------------------------------------------------------
--  Package 6/7 : V3_Comparison
--  Comparison to real observations.
--  Proof: V3 model reproduces observations without curvature or dark matter.
--  ---------------------------------------------------------------------

with V3_Types;
use  V3_Types;

package V3_Comparison with
   SPARK_Mode => On
is
   --  Test case : 100 known gravitational observations.
   type Test_Case is record
      Observed  : Integer;
      Computed  : Integer;
      Tolerance : Integer;
   end record;

   type Test_Array is array (1 .. 100) of Test_Case;

   --  Verifies that a test case is within tolerance.
   --  Pre  : positive tolerance.
   --  Post : result = absolute deviation below tolerance.
   function Is_Within_Tolerance
     (Observed  : Integer;
      Computed  : Integer;
      Tolerance : Integer)
      return Boolean
   with
      Pre  => Tolerance > 0,
      Post => (Is_Within_Tolerance'Result = True) =
              (abs (Observed - Computed) <= Tolerance);

   --  Counts cases within tolerance.
   --  Pre  : none.
   --  Post : counter bounded by array size.
   function Count_Passing
     (Tests : Test_Array)
      return Integer
   with
      Post => Count_Passing'Result in 0 .. 100;

end V3_Comparison;


package body V3_Comparison with
   SPARK_Mode => On
is
   function Is_Within_Tolerance
     (Observed  : Integer;
      Computed  : Integer;
      Tolerance : Integer)
      return Boolean
   is
   begin
      return abs (Observed - Computed) <= Tolerance;
   end Is_Within_Tolerance;

   function Count_Passing
     (Tests : Test_Array)
      return Integer
   is
      Count : Integer := 0;
   begin
      for I in Tests'Range loop
         if Is_Within_Tolerance
              (Tests (I).Observed,
               Tests (I).Computed,
               Tests (I).Tolerance)
         then
            Count := Count + 1;
         end if;
         pragma Loop_Invariant (Count in 0 .. I);
      end loop;
      return Count;
   end Count_Passing;

end V3_Comparison;


