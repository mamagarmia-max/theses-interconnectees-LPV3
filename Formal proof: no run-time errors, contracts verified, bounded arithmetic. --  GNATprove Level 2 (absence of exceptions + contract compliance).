--  Package 7/7 : V3_Main
--  Main program.
--  Runs the 100 test cases.
--  Verifies modulo-9 that the number of cases is consistent.
--  Output: number of cases within tolerance.
--  ---------------------------------------------------------------------

with Ada.Text_IO;
with V3_Invariants;
with V3_Types;
with V3_Pressure_Gradient;
with V3_Phase_Locking;
with V3_Density_Curvature;
