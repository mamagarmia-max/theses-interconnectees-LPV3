   -- 0.11 POINT D'ENTRÉE UNIVERSELLE (CIRCUIT EN 2 ÉTAGES)
   function Query_Universal (Noyau_Name : String; Question : String) return String
     with Pre  => Noyau_Name'Length > 0 and Question'Length > 0,
          Post => Query_Universal'Result'Length > 0
   is
      Trimmed_Name : String := Trim (Noyau_Name);
      Lower : String := Trimmed_Name;
      Rapport : String (1 .. 500);
      Rapport_Net : String (1 .. 500);
      Checksum_Avant : Checksum_Type;
      Checksum_Apres : Checksum_Type;
      Noyau_Trouve : Boolean := False;
      Noyau_Checksum : Checksum_Type;
   begin
      -- ================================================================
      -- ÉTAPE 1 : VÉRIFICATION DE L'INTÉGRITÉ DU SYSTÈME AVANT TRAITEMENT
      -- ================================================================
      Checksum_Avant := NC.Checksum;
      
      if NC.Checksum /= MODULO_9 then
         return Apply_Veto ("Checksum invalide avant traitement");
      end if;

      if NC.Coherence < 50.0 then
         return Apply_Veto ("Cohérence insuffisante (" & Float'Image (NC.Coherence) & "%)");
      end if;

      if Trimmed_Name'Length = 0 or Question'Length = 0 then
         return Apply_Veto ("Requête invalide (nom ou question vide)");
      end if;

      -- Normalisation du nom du noyau
      for I in Lower'Range loop
         if Lower (I) in 'A' .. 'Z' then
            Lower (I) := Character'Val (Character'Pos (Lower (I)) + 32);
         end if;
      end loop;

      -- ================================================================
      -- ÉTAPE 2 : EXÉCUTION DU NOYAU SPÉCIALISÉ (ISOLÉ)
      -- ================================================================
      for I in 1 .. Registry_Count loop
         declare
            Reg_Name : String := Registry (I).Name;
            Reg_Lower : String := Reg_Name;
         begin
            for J in Reg_Lower'Range loop
               if Reg_Lower (J) in 'A' .. 'Z' then
                  Reg_Lower (J) := Character'Val (Character'Pos (Reg_Lower (J)) + 32);
               end if;
            end loop;

            if Lower'Length >= 6 and then
               (Reg_Lower'Length >= 6 and then
                Lower (1 .. 6) = Reg_Lower (1 .. 6)) then
               if Registry (I).Active then
                  -- Sauvegarde de l'état local du noyau (isolation)
                  declare
                     Noyau_Report : String (1 .. 500);
                  begin
                     -- Exécution du noyau spécialisé
                     Noyau_Report := Registry (I).Analyze_Func (Question);
                     Noyau_Checksum := Digital_Root (Integer (Noyau_Report'Length));
                     Noyau_Trouve := True;
                     
                     -- ================================================================
                     -- ÉTAPE 3 : VÉRIFICATION QUE LE RAPPORT N'EST PAS PARASITÉ
                     -- ================================================================
                     -- 3.1 Vérifier que le rapport n'a pas été modifié par un autre module
                     if not Verify_Request (Noyau_Report) then
                        return Apply_Veto ("Rapport contaminé par une requête invalide");
                     end if;
                     
                     -- 3.2 Vérifier que le checksum du rapport est cohérent
                     if Noyau_Checksum /= MODULO_9 then
                        return Apply_Veto ("Rapport corrompu (checksum = " & 
                                          Integer'Image (Noyau_Checksum) & ")");
                     end if;
                     
                     -- 3.3 Vérifier qu'aucun autre module n'a modifié l'état global
                     if NC.Coherence < 99.0 then
                        return Apply_Veto ("État global contaminé (coherence = " & 
                                          Float'Image (NC.Coherence) & "%)");
                     end if;
                     
                     -- 3.4 Vérifier que le checksum global n'a pas changé
                     Checksum_Apres := NC.Checksum;
                     if Checksum_Avant /= Checksum_Apres then
                        return Apply_Veto ("Checksum global modifié pendant le traitement");
                     end if;
                     
                     -- ================================================================
                     -- ÉTAPE 4 : STOCKAGE DU RAPPORT PUR
                     -- ================================================================
                     Rapport_Net := Noyau_Report;
                     NC.Last_Noyau := Registry (I).Name;
                     NC.Path_Integrity := True;
                  end;
               else
                  return Apply_Veto ("Noyau " & Registry (I).Name & " est inactif");
               end if;
               exit;
            end if;
         end;
      end loop;

      -- Si aucun noyau n'a été trouvé
      if not Noyau_Trouve then
         return Apply_Veto ("Noyau inconnu : " & Noyau_Name);
      end if;

      -- ================================================================
      -- ÉTAPE 5 : SYNTHÈSE FINALE PAR LE NC
      -- ================================================================
      Checksum_Apres := NC.Checksum;
      
      -- Vérification finale que le chemin n'a pas été contaminé
      if not NC.Path_Integrity then
         return Apply_Veto ("Chemin corrompu — contamination détectée");
      end if;

      -- Vérification que le checksum n'a pas changé pendant le traitement
      if Checksum_Avant /= Checksum_Apres then
         return Apply_Veto ("Checksum modifié pendant le traitement");
      end if;

      -- Vérification que le dernier noyau exécuté est bien celui demandé
      if Trim (NC.Last_Noyau) /= Trim (Noyau_Name) then
         return Apply_Veto ("Noyau exécuté (" & Trim (NC.Last_Noyau) & 
                           ") différent du noyau demandé (" & Noyau_Name & ")");
      end if;

      -- Synthèse globale
      return Synthesize (Rapport_Net);

   exception
      when E : others =>
         return Apply_Veto ("Erreur système : " & Exception_Information (E));
   end Query_Universal;

