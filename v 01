package Alloy_V10_Fragmented_Hybrid with
   SPARK_Mode => On
is

   -- 1. Composition (atomic fractions)
   type Composition_Record is record
      Nb : Float range 0.0 .. 1.0 := 0.35;
      Ta : Float range 0.0 .. 1.0 := 0.20;
      Ti : Float range 0.0 .. 1.0 := 0.20;
      Zr : Float range 0.0 .. 1.0 := 0.10;
      Hf : Float range 0.0 .. 1.0 := 0.15;
   end record;

   -- 2. Raw material specifications (powders for HEBM)
   type Powder_Spec is record
      Element          : String (1 .. 2);
      Purity           : Float range 99.0 .. 100.0;
      Max_Oxygen       : Integer range 0 .. 500;
      Particle_Size    : Integer range 5 .. 100;
      Atomic_Fraction  : Float range 0.0 .. 1.0;
   end record;

   type Powder_Array is array (1 .. 5) of Powder_Spec;

   Raw_Materials : constant Powder_Array :=
     ((Element => "Nb", Purity => 99.9, Max_Oxygen => 100,
       Particle_Size => 30, Atomic_Fraction => 0.35),
      (Element => "Ta", Purity => 99.9, Max_Oxygen => 100,
       Particle_Size => 30, Atomic_Fraction => 0.20),
      (Element => "Ti", Purity => 99.9, Max_Oxygen => 80,
       Particle_Size => 25, Atomic_Fraction => 0.20),
      (Element => "Zr", Purity => 99.9, Max_Oxygen => 80,
       Particle_Size => 25, Atomic_Fraction => 0.10),
      (Element => "Hf", Purity => 99.9, Max_Oxygen => 80,
       Particle_Size => 25, Atomic_Fraction => 0.15));

   -- 3. Subunit A (Nb + Ta + Zr) — conventional arc melting
   type Subunit_A_Record is record
      Nb_Fraction : Float := 0.50;
      Ta_Fraction : Float := 0.28;
      Zr_Fraction : Float := 0.22;
      Arc_Temp_C  : Float := 3050.0;
      Arc_Time_h  : Float := 1.0;
      Atmosphere  : String (1 .. 6) := "Argon ";
   end record;

   -- 4. Subunit B (Ti + Hf) — SPS/FAST
   type Subunit_B_Record is record
      Ti_Fraction       : Float := 0.57;
      Hf_Fraction       : Float := 0.43;
      SPS_Temp_C        : Float := 1400.0;
      SPS_Time_min      : Integer := 20;
      SPS_Pressure_MPa  : Float := 50.0;
      Atmosphere        : String (1 .. 6) := "Argon ";
   end record;

   -- 5. Assembly parameters (SPS + HIP + quenching)
   type Assembly_Params is record
      SPS_Temp_C           : Float := 1425.0;
      SPS_Time_min         : Integer := 20;
      SPS_Pressure_MPa     : Float := 50.0;
      HIP_Temp_C           : Float := 1200.0;
      HIP_Time_h           : Float := 3.0;
      HIP_Pressure_MPa     : Float := 150.0;
      Annealing_Temp_C     : Float := 1200.0;
      Annealing_Time_h     : Float := 4.0;
      Quench_Medium        : String (1 .. 6) := "Water ";
      Cooling_Rate_Cpmin   : Float := 5.0;
      Checksum             : Integer range 1 .. 9 := 9;
   end record with
      Predicate => Checksum = 9;

   -- 6. Predicted properties (validated by simulation)
   type Alloy_Properties is record
      Density_gpcm3        : Float := 10.2;
      Elastic_Modulus_GPa  : Float := 120.0;
      Melting_Point_C      : Float := 2550.0;
      Hardness_HV          : Float := 380.0;
      Tensile_Strength_MPa : Float := 1200.0;
      Ductility_Percent    : Float := 12.0;
      Phase_Structure      : String (1 .. 10) := "BCC       ";
      Oxygen_ppm           : Integer := 80;
      Checksum             : Integer range 1 .. 9 := 9;
   end record with
      Predicate => Checksum = 9;

   -- 7. Mass calculation results
   type Mass_Result is record
      Total_Mass_g   : Float;
      Nb_Mass_g      : Float;
      Ta_Mass_g      : Float;
      Ti_Mass_g      : Float;
      Zr_Mass_g      : Float;
      Hf_Mass_g      : Float;
      Subunit_A_Mass : Float;
      Subunit_B_Mass : Float;
      Checksum       : Integer range 1 .. 9 := 9;
   end record with
      Predicate => Checksum = 9;

   -- 8. Public functions
   function Get_Assembly_Params return Assembly_Params
     with Post => Get_Assembly_Params'Result.Checksum = 9;

   function Get_Alloy_Properties return Alloy_Properties
     with Post => Get_Alloy_Properties'Result.Checksum = 9;

   function Compute_Masses (Total_Mass_g : Float) return Mass_Result
     with Pre => Total_Mass_g > 0.0,
          Post => Compute_Masses'Result.Checksum = 9;

   function Get_Procedure_Text (Total_Mass_g : Float) return String
     with Pre => Total_Mass_g > 0.0,
          Post => Get_Procedure_Text'Result'Length > 0;

   function Protected_Notice return String
     with Post => Protected_Notice'Result'Length > 0;

end Alloy_V10_Fragmented_Hybrid;

package body Alloy_V10_Fragmented_Hybrid with
   SPARK_Mode => On
is

   -- 1. Molar masses (g/mol)
   M_Nb : constant Float := 92.906;
   M_Ta : constant Float := 180.948;
   M_Ti : constant Float := 47.867;
   M_Zr : constant Float := 91.224;
   M_Hf : constant Float := 178.490;

   -- 2. Atomic fractions (global)
   F_Nb : constant Float := 0.35;
   F_Ta : constant Float := 0.20;
   F_Ti : constant Float := 0.20;
   F_Zr : constant Float := 0.10;
   F_Hf : constant Float := 0.15;

   -- 3. Subunit fractions
   Subunit_A_Nb : constant Float := 0.50;
   Subunit_A_Ta : constant Float := 0.28;
   Subunit_A_Zr : constant Float := 0.22;
   Subunit_B_Ti : constant Float := 0.57;
   Subunit_B_Hf : constant Float := 0.43;

   -- 4. Mass functions
   function Mass_Fraction (F : Float; M : Float; Sum_M : Float) return Float is
   begin
      return (F * M) / Sum_M;
   end Mass_Fraction;

   function Total_Molar_Mass return Float is
      Sum : Float := F_Nb * M_Nb + F_Ta * M_Ta + F_Ti * M_Ti +
                     F_Zr * M_Zr + F_Hf * M_Hf;
   begin
      return Sum;
   end Total_Molar_Mass;

   -- 5. Compute masses for a given total mass
   function Compute_Masses (Total_Mass_g : Float) return Mass_Result is
      M_total : constant Float := Total_Molar_Mass;
      F_Nb_m  : constant Float := Mass_Fraction (F_Nb, M_Nb, M_total);
      F_Ta_m  : constant Float := Mass_Fraction (F_Ta, M_Ta, M_total);
      F_Ti_m  : constant Float := Mass_Fraction (F_Ti, M_Ti, M_total);
      F_Zr_m  : constant Float := Mass_Fraction (F_Zr, M_Zr, M_total);
      F_Hf_m  : constant Float := Mass_Fraction (F_Hf, M_Hf, M_total);

      -- Subunit A: Nb + Ta + Zr (fractions recalculated)
      Sub_A_Total : constant Float := Subunit_A_Nb * M_Nb + Subunit_A_Ta * M_Ta + Subunit_A_Zr * M_Zr;
      Sub_A_Frac  : constant Float := (Subunit_A_Nb * M_Nb + Subunit_A_Ta * M_Ta + Subunit_A_Zr * M_Zr) /
                                       (Subunit_A_Nb * M_Nb + Subunit_A_Ta * M_Ta + Subunit_A_Zr * M_Zr +
                                        Subunit_B_Ti * M_Ti + Subunit_B_Hf * M_Hf);

      Sub_B_Frac  : constant Float := 1.0 - Sub_A_Frac;

      A_Mass : constant Float := Total_Mass_g * Sub_A_Frac;
      B_Mass : constant Float := Total_Mass_g * Sub_B_Frac;
   begin
      return Mass_Result'
        (Total_Mass_g   => Total_Mass_g,
         Nb_Mass_g      => Total_Mass_g * F_Nb_m,
         Ta_Mass_g      => Total_Mass_g * F_Ta_m,
         Ti_Mass_g      => Total_Mass_g * F_Ti_m,
         Zr_Mass_g      => Total_Mass_g * F_Zr_m,
         Hf_Mass_g      => Total_Mass_g * F_Hf_m,
         Subunit_A_Mass => A_Mass,
         Subunit_B_Mass => B_Mass,
         Checksum       => 9);
   end Compute_Masses;

   -- 6. Public functions
   function Get_Assembly_Params return Assembly_Params is
   begin
      return Assembly_Params'
        (SPS_Temp_C         => 1425.0,
         SPS_Time_min       => 20,
         SPS_Pressure_MPa   => 50.0,
         HIP_Temp_C         => 1200.0,
         HIP_Time_h         => 3.0,
         HIP_Pressure_MPa   => 150.0,
         Annealing_Temp_C   => 1200.0,
         Annealing_Time_h   => 4.0,
         Quench_Medium      => "Water ",
         Cooling_Rate_Cpmin => 5.0,
         Checksum           => 9);
   end Get_Assembly_Params;

   function Get_Alloy_Properties return Alloy_Properties is
   begin
      return Alloy_Properties'
        (Density_gpcm3        => 10.2,
         Elastic_Modulus_GPa  => 120.0,
         Melting_Point_C      => 2550.0,
         Hardness_HV          => 380.0,
         Tensile_Strength_MPa => 1200.0,
         Ductility_Percent    => 12.0,
         Phase_Structure      => "BCC       ",
         Oxygen_ppm           => 80,
         Checksum             => 9);
   end Get_Alloy_Properties;

