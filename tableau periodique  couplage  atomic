   -- ========================================================================
   -- 4. TYPES V3
   -- ========================================================================

   -- 4.1 Vortex de pression (proton)
   type Proton_Vortex is record
      Z                 : Integer range 0 .. 118;
      Radius_Fm         : Float;
      Pressure_GPa      : Float;
      Phase_Potential_V : Float;
      Magnetic_Field_T  : Float;
      Spin_Frequency_Hz : Float;
      Wave_Amplitude_Pa : Float;
   end record;

   -- 4.2 Régulateur de pression (neutron)
   type Pressure_Regulator is record
      N                      : Integer range 0 .. 200;
      Absorbtion_Cross_Section : Float;
      Magnetic_Contribution  : Float;
   end record;

   -- 4.3 Onde de surface (électron)
   type Surface_Wave_Type is (S, P, D, F);
   type Electron_Surface_Wave is record
      Kind          : Surface_Wave_Type;
      Principal_N   : Integer range 1 .. 7;
      Subshell_L    : Integer range 0 .. 3;
      Occupancy     : Integer range 0 .. 14;
      Radius_Bohr   : Float;
      Phase_Shift   : Float;
      EM_Mode       : Integer range 1 .. 10;
      Orbital_Angular_Momentum : Float;
      Magnetic_Quantum_Number : Integer range -3 .. 3;
      Wave_Amplitude_Pa : Float;
   end record;

   type Surface_Wave_Array is array (1 .. 7) of Electron_Surface_Wave;

   -- 4.4 Onde de cisaillement (photon) — PAS une particule
   type Shear_Wave is record
      Wavelength_M   : Float;
      Frequency_Hz   : Float;
      Energy_eV      : Float;
      Transition     : String (1 .. 10);
      Intensity_Rel  : Float range 0.0 .. 1.0;
   end record;

   type Shear_Wave_Array is array (1 .. 20) of Shear_Wave;

   -- 4.5 Propriétés électromagnétiques V3
   type EM_V3_Properties is record
      Magnetic_Moment_Jp_T : Float;
      Polarizability_m3   : Float;
      Ionization_Energy_eV : Float;
      Electron_Affinity_eV : Float;
      Electronegativity    : Float range 0.0 .. 4.0;
      Spectral_Series      : Shear_Wave_Array;
      Checksum             : Integer range 1 .. 9 := 9;
   end record
     with Predicate => EM_V3_Properties.Checksum = 9;

   -- 4.6 Type de liaison V3 (fusion de membranes)
   type Bond_Type_V3 is (Membrane_Fusion, Pressure_Gradient, Surface_Resonance, None);

   -- 4.7 Liaison chimique V3 (fusion de membranes)
   type V3_Membrane_Bond is record
      Bond_Type            : Bond_Type_V3;
      Atom1_Z              : Integer range 1 .. 118;
      Atom2_Z              : Integer range 1 .. 118;
      Bond_Length_Ang      : Float;
      Bond_Energy_eV       : Float;
      Bond_Order           : Integer range 0 .. 3;
      Phase_Coherence      : Float range 0.0 .. 100.0;
      Membrane_Fusion_Area_m2 : Float;
      Wave_Interference_Amplitude : Float;
      Checksum             : Integer range 1 .. 9 := 9;
   end record
     with Predicate => V3_Membrane_Bond.Checksum = 9;

   -- 4.8 Type de désintégration V3 (relaxation de phase)
   type Decay_Type_V3 is (Phase_Relaxation, Pressure_Ejection, Vortex_Collapse, Stable);

   -- 4.9 Désintégration V3
   type V3_Phase_Decay is record
      Isotope_Z         : Integer range 1 .. 118;
      Isotope_N         : Integer range 0 .. 200;
      Decay_Mode        : Decay_Type_V3;
      Half_Life_Seconds : Float;
      Decay_Energy_MeV  : Float;
      Daughter_Z        : Integer range 1 .. 118;
      Daughter_N        : Integer range 0 .. 200;
      Checksum          : Integer range 1 .. 9 := 9;
   end record
     with Predicate => V3_Phase_Decay.Checksum = 9;

   type Decay_Chain_V3_Array is array (1 .. 10) of V3_Phase_Decay;

   -- 4.10 Propriétés thermodynamiques V3
   type Thermo_V3_Properties is record
      Melting_Point_K      : Float;
      Boiling_Point_K      : Float;
      Specific_Heat_JpKgK  : Float;
      Thermal_Conductivity_Wp_mK : Float;
      Checksum             : Integer range 1 .. 9 := 9;
   end record
     with Predicate => Thermo_V3_Properties.Checksum = 9;

   -- 4.11 Harmonique de surface (muon, tau)
   type Harmonic_Type is (Fundamental, First_Harmonic, Second_Harmonic);

   type Surface_Harmonic is record
      Kind           : Harmonic_Type;
      Mode_Number    : Integer range 0 .. 2;
      Mass_Ratio     : Float;
      Mass_MeV       : Float;
      Half_Life_s    : Float;
      Decay_Channel  : String (1 .. 12);
      Checksum       : Integer range 1 .. 9 := 9;
   end record
     with Predicate => Surface_Harmonic.Checksum = 9;

   type Harmonic_Table is array (0 .. 2) of Surface_Harmonic;

   -- 4.12 État V3 (réseau + nœud)
   type V3_State is record
      Phase_Potential_V    : Float;
      Node_Density_kgpm3   : Float;
      Temperature_K        : Float;
      Phase_Velocity        : Float;
      Friction_Limit        : Float;
      Is_Node               : Boolean;
      Checksum              : Integer range 1 .. 9 := 9;
   end record
     with Predicate => V3_State.Checksum = 9;

   -- 4.13 Masse du proton V3 (dérivée, pas mesurée)
   type V3_Proton_Mass_Record is record
      Mass_V3_kg           : Float;          -- β × ρ_cond × V_core
      Mass_CODATA_kg       : Float;          -- 1.6726e-27 kg
      Ratio_V3_CODATA      : Float;          -- 2.46 × 10¹⁰
      Is_Pressure_Diff     : Boolean;        -- True = masse = pression différentielle
      Checksum             : Integer range 1 .. 9 := 9;
   end record
     with Predicate => V3_Proton_Mass_Record.Checksum = 9;

   -- 4.14 Masse de l'électron V3 (couche limite)
   type V3_Electron_Mass_Record is record
      Mass_V3_kg           : Float;          -- V_shell × ρ_shell
      Mass_CODATA_kg       : Float;          -- 9.109e-31 kg
      Boundary_Layer_m     : Float;          -- δ = r_p / (2π × α)
      Shell_Volume_m3      : Float;          -- V_shell = 4π × r_p² × δ
      Checksum             : Integer range 1 .. 9 := 9;
   end record
     with Predicate => V3_Electron_Mass_Record.Checksum = 9;

   -- 4.15 Atome V3 (nœud de phase)
   type V3_Phase_Node is record
      Symbol        : String (1 .. 3);
      Z             : Integer range 1 .. 118;
      N             : Integer range 0 .. 200;
      A             : Integer;
      Mass_Kg       : Float;
      Proton        : Proton_Vortex;
      Neutron       : Pressure_Regulator;
      Shells        : Surface_Wave_Array;
      EM            : EM_V3_Properties;
      Thermo        : Thermo_V3_Properties;
      Coherence     : Float range 0.0 .. 100.0;
      Is_Stable     : Boolean;
      Phase_Group   : Integer range 1 .. 18;
      Phase_Period  : Integer range 1 .. 7;
      Checksum      : Integer range 1 .. 9 := 9;
   end record
     with Predicate => V3_Phase_Node.Checksum = 9;

   type Node_Table is array (1 .. 118) of V3_Phase_Node;

   -- ========================================================================
   -- 5. FONCTIONS V3 — HADRONS (118 éléments)
   -- ========================================================================

   function Vortex_Radius (A : Integer) return Float
     with Pre => A > 0,
          Post => Vortex_Radius'Result > 0.0;

   function Vortex_Pressure (Z, N : Integer; R_m : Float) return Float
     with Pre => Z > 0 and N >= 0 and R_m > 0.0,
          Post => Vortex_Pressure'Result >= 0.0;

   function Phase_Potential (R_Vortex, R_Reference : Float) return Float
     with Pre => R_Reference > 0.0,
          Post => Phase_Potential'Result <= 0.0;

   function Compute_Coherence (Phi : Float) return Float
     with Post => Compute_Coherence'Result in 0.0 .. 100.0;

   function Surface_Wave_Radius (n, l : Integer; Z_eff : Float) return Float
     with Pre => n > 0 and l >= 0 and Z_eff > 0.0,
          Post => Surface_Wave_Radius'Result > 0.0;

   function Phase_State_Occupancy (l : Integer) return Integer
     with Pre => l in 0 .. 3,
          Post => Phase_State_Occupancy'Result in 0 .. 14;

   function Rupture_Pressure_Energy (Z, n : Integer) return Float
     with Pre => Z in 1 .. 118 and n in 1 .. 7,
          Post => Rupture_Pressure_Energy'Result > 0.0;

   function Differential_Pressure (Z : Integer; Waves : Surface_Wave_Array) return Float
     with Pre => Z in 1 .. 118,
          Post => Differential_Pressure'Result >= 0.0;

   function Pressure_Gradient (Z : Integer; Rupture, Diff : Float) return Float
     with Pre => Z in 1 .. 118 and Rupture > 0.0 and Diff >= 0.0,
          Post => Pressure_Gradient'Result in 0.0 .. 4.0;

   function Orbital_Magnetic_Moment (Z : Integer; Waves : Surface_Wave_Array) return Float
     with Pre => Z in 1 .. 118,
          Post => Orbital_Magnetic_Moment'Result >= 0.0;

   function Phase_Polarizability (Waves : Surface_Wave_Array) return Float
     with Post => Phase_Polarizability'Result >= 0.0;

   function Shear_Wave_Emission (Z, n1, n2 : Integer) return Shear_Wave
     with Pre => Z in 1 .. 118 and n1 > 0 and n2 > n1,
          Post => Shear_Wave_Emission'Result.Frequency_Hz > 0.0;

   function Vortex_Magnetic_Field (Z, A : Integer; R_Fm : Float) return Float
     with Pre => Z > 0 and A > 0 and R_Fm > 0.0,
          Post => Vortex_Magnetic_Field'Result >= 0.0;

   function Pressure_Wave_Amplitude (Z, n, l : Integer; Occupancy : Integer) return Float
     with Pre => Z in 1 .. 118 and n in 1 .. 7 and l in 0 .. 3,
          Post => Pressure_Wave_Amplitude'Result >= 0.0;

   -- ========================================================================
   -- 6. FONCTIONS DE LIAISON V3 (Fusion de membranes)
   -- ========================================================================

   function Membrane_Fusion_Distance (Z1, Z2 : Integer; Fusion_Order : Integer) return Float
     with Pre => Z1 in 1 .. 118 and Z2 in 1 .. 118 and Fusion_Order in 0 .. 3,
          Post => Membrane_Fusion_Distance'Result >= 0.0;

   function Membrane_Fusion_Energy (Z1, Z2 : Integer; R_Ang : Float) return Float
     with Pre => Z1 in 1 .. 118 and Z2 in 1 .. 118 and R_Ang > 0.0,
          Post => Membrane_Fusion_Energy'Result >= 0.0;

   function Determine_Fusion_Type (Z1, Z2 : Integer; Grad1, Grad2 : Float)
                                  return Bond_Type_V3
     with Pre => Z1 in 1 .. 118 and Z2 in 1 .. 118 and
                 Grad1 in 0.0 .. 4.0 and Grad2 in 0.0 .. 4.0;

   function Membrane_Fusion_Area (R1, R2 : Float) return Float
     with Pre => R1 >= 0.0 and R2 >= 0.0,
          Post => Membrane_Fusion_Area'Result >= 0.0;

   function Wave_Interference (A1, A2 : Float) return Float
     with Pre => A1 >= 0.0 and A2 >= 0.0,
          Post => Wave_Interference'Result >= 0.0;

   -- ========================================================================
   -- 7. FONCTIONS DE RELAXATION DE PHASE (radioactivité V3)
   -- ========================================================================

   function Phase_Relaxation_Time (Z, N : Integer) return Float
     with Pre => Z in 1 .. 118 and N in 0 .. 200,
          Post => Phase_Relaxation_Time'Result >= 0.0;

   function Predict_Relaxation_Mode (Z, N : Integer) return Decay_Type_V3
     with Pre => Z in 1 .. 118 and N in 0 .. 200;

   function Phase_Relaxation_Chain (Z_Start, N_Start : Integer) return Decay_Chain_V3_Array
     with Pre => Z_Start in 1 .. 118 and N_Start in 0 .. 200;

   -- ========================================================================
   -- 8. FONCTIONS THERMODYNAMIQUES V3
   -- ========================================================================

   function Friction_Gradient_Melting (Z : Integer) return Float
     with Pre => Z in 1 .. 118,
          Post => Friction_Gradient_Melting'Result >= 0.0;

   function Friction_Gradient_Boiling (Z : Integer) return Float
     with Pre => Z in 1 .. 118,
          Post => Friction_Gradient_Boiling'Result >= 0.0;

   function Phase_Capacity (Z : Integer) return Float
     with Pre => Z in 1 .. 118,
          Post => Phase_Capacity'Result >= 0.0;

   -- ========================================================================
   -- 9. FONCTIONS HARMONIQUES V3 (Muon, Tau)
   -- ========================================================================

   function First_Harmonic_Mass_Ratio return Float
     with Post => First_Harmonic_Mass_Ratio'Result > 0.0;

   function Second_Harmonic_Mass_Ratio return Float
     with Post => Second_Harmonic_Mass_Ratio'Result > 0.0;

   function Phase_Anomaly return Float
     with Post => Phase_Anomaly'Result >= 0.0;

   function Get_Harmonics return Harmonic_Table
     with Post => Get_Harmonics'Result (0).Checksum = 9 and
                  Get_Harmonics'Result (1).Checksum = 9 and
                  Get_Harmonics'Result (2).Checksum = 9;

   -- ========================================================================
   -- 10. FONCTIONS RÉSEAU/NEUD V3 (Einstein vs V3)
   -- ========================================================================

   function Phase_Velocity (Temperature_K : Float) return Float
     with Pre => Temperature_K >= 0.0,
          Post => Phase_Velocity'Result >= C_LIGHT;

   function Friction_Limit (Temperature_K : Float) return Float
     with Pre => Temperature_K >= 0.0,
          Post => Friction_Limit'Result > 0.0;

   function Get_V3_State (Z, N : Integer; T_K : Float) return V3_State
     with Pre => Z in 1 .. 118 and N in 0 .. 200 and T_K >= 0.0,
          Post => Get_V3_State'Result.Checksum = 9;

   -- ========================================================================
   -- 11. FONCTIONS DE MASSE V3 (Proton Mass + Electron Mass)
   -- ========================================================================

   function V3_Proton_Mass (R_p : Float) return Float
     with Pre => R_p > 0.0,
          Post => V3_Proton_Mass'Result > 0.0;

   function V3_K_Computer_Ratio (R_p : Float) return Float
     with Pre => R_p > 0.0,
          Post => V3_K_Computer_Ratio'Result > 0.0;

   function Mass_As_Pressure_Differential (P_vortex, P_ambient : Float; V_core : Float) return Float
     with Pre => P_vortex >= 0.0 and P_ambient >= 0.0 and V_core > 0.0,
          Post => Mass_As_Pressure_Differential'Result >= 0.0;

   function Boundary_Layer_Thickness (R_p : Float; Alpha : Float) return Float
     with Pre => R_p > 0.0 and Alpha > 0.0,
          Post => Boundary_Layer_Thickness'Result > 0.0;

   function Shell_Volume (R_p : Float; Delta : Float) return Float
     with Pre => R_p > 0.0 and Delta > 0.0,
          Post => Shell_Volume'Result > 0.0;

   function V3_Electron_Mass (R_p : Float; Alpha : Float) return Float
     with Pre => R_p > 0.0 and Alpha > 0.0,
          Post => V3_Electron_Mass'Result > 0.0;

   function Proton_Electron_Mass_Ratio (R_p : Float; Alpha : Float) return Float
     with Pre => R_p > 0.0 and Alpha > 0.0,
          Post => Proton_Electron_Mass_Ratio'Result > 0.0;

   function Get_V3_Proton_Mass_Record (R_p : Float) return V3_Proton_Mass_Record
     with Pre => R_p > 0.0,
          Post => Get_V3_Proton_Mass_Record'Result.Checksum = 9;

   function Get_V3_Electron_Mass_Record (R_p : Float; Alpha : Float) return V3_Electron_Mass_Record
     with Pre => R_p > 0.0 and Alpha > 0.0,
          Post => Get_V3_Electron_Mass_Record'Result.Checksum = 9;

   -- ========================================================================
   -- 12. FONCTIONS DE CHARGE V3 (pression différentielle)
   -- ========================================================================

   function Charge_As_Pressure (P_wave, P_ambient : Float; A_surface : Float) return Float
     with Pre => P_wave >= 0.0 and P_ambient >= 0.0 and A_surface > 0.0,
          Post => Charge_As_Pressure'Result >= 0.0;

   function Coulomb_As_Pressure_Gradient (q1, q2 : Float; R_m : Float; Epsilon_eff : Float) return Float
     with Pre => q1 >= 0.0 and q2 >= 0.0 and R_m > 0.0 and Epsilon_eff > 0.0,
          Post => Coulomb_As_Pressure_Gradient'Result >= 0.0;

   -- ========================================================================
   -- 13. FONCTIONS NEUTRINO V3 (onde longitudinale balistique)
   -- ========================================================================

   function Neutrino_Velocity (Gamma_long, Gamma_trans : Float) return Float
     with Pre => Gamma_long >= 0.0 and Gamma_trans > 0.0,
          Post => Neutrino_Velocity'Result >= C_LIGHT;

   function Neutrino_Energy (P_amplitude : Float; A_front : Float; Freq : Float) return Float
     with Pre => P_amplitude >= 0.0 and A_front > 0.0 and Freq > 0.0,
          Post => Neutrino_Energy'Result >= 0.0;

   -- ========================================================================
   -- 14. AIDE MÉMOIRE V3
   -- ========================================================================

   function Total_Waves (Waves : Surface_Wave_Array) return Integer
     with Post => Total_Waves'Result >= 0;

   function Phase_Group (Z : Integer) return Integer
     with Pre => Z in 1 .. 118,
          Post => Phase_Group'Result in 1 .. 18;

   function Phase_Period (Z : Integer) return Integer
     with Pre => Z in 1 .. 118,
          Post => Phase_Period'Result in 1 .. 7;

   function Critical_Pressure (R_m : Float) return Float
     with Pre => R_m > 0.0,
          Post => Critical_Pressure'Result > 0.0;

   -- ========================================================================
   -- 15. PREUVES V3 (10 obligations)
   -- ========================================================================

   function Check_Vortex_Conservation (Node : V3_Phase_Node) return Boolean
     with Post => Check_Vortex_Conservation'Result = (Node.A = Node.Z + Node.N);

   function Check_Wave_Conservation (Node : V3_Phase_Node) return Boolean
     with Post => Check_Wave_Conservation'Result = (Node.Z = Total_Waves (Node.Shells));

   function Check_Phase_Stability (Node : V3_Phase_Node) return Boolean
     with Post => Check_Phase_Stability'Result =
       (if Node.Is_Stable then Node.Coherence >= 90.0);

   function Check_Pressure_Limit (Node : V3_Phase_Node) return Boolean
     with Post => Check_Pressure_Limit'Result =
       (if Node.Is_Stable then Node.Proton.Pressure_GPa < Critical_Pressure (Node.Proton.Radius_Fm * 1.0e-15));

   function Check_Phase_Periodicity (Node : V3_Phase_Node) return Boolean
     with Post => Check_Phase_Periodicity'Result =
       (Node.Phase_Period = Phase_Period (Node.Z) and
        Node.Phase_Group = Phase_Group (Node.Z));

   function Check_Wave_Conservation_EM (Node : V3_Phase_Node) return Boolean
     with Post => Check_Wave_Conservation_EM'Result =
       (Total_EM_Wave_Energy (Node.EM) <= Node.Mass_Kg * C_LIGHT * C_LIGHT);

   function Check_Membrane_Coherence (Bond : V3_Membrane_Bond) return Boolean
     with Post => Check_Membrane_Coherence'Result =
       (Bond.Phase_Coherence >= 70.0 and Bond.Bond_Order >= 1);

   function Check_Phase_Relaxation (Decay : V3_Phase_Decay) return Boolean
     with Post => Check_Phase_Relaxation'Result =
       (Decay.Isotope_Z = Decay.Daughter_Z + (if Decay.Decay_Mode = Vortex_Collapse then 2 else 0) and
        Decay.Isotope_N = Decay.Daughter_N + (if Decay.Decay_Mode = Vortex_Collapse then 2 else 0));

   function Check_Proton_Mass (Record : V3_Proton_Mass_Record) return Boolean
     with Post => Check_Proton_Mass'Result =
       (Record.Ratio_V3_CODATA >= 2.4e10 and Record.Ratio_V3_CODATA <= 2.5e10);

   function Check_Electron_Mass (Record : V3_Electron_Mass_Record) return Boolean
     with Post => Check_Electron_Mass'Result =
       (abs (Record.Mass_V3_kg - Record.Mass_CODATA_kg) / Record.Mass_CODATA_kg < 0.001);

   -- ========================================================================
   -- 16. TABLE DES NEUDS (118 éléments V3)
   -- ========================================================================

   Nodes : constant Node_Table;

