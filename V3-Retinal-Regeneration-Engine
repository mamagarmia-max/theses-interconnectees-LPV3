           "  Anti-VEGF     : " & Float'Image (State.Anti_VEGF_Dose) & " µg" &
           ASCII.LF &
           "  Anti-IL-6     : " & Float'Image (State.Anti_IL6_Dose) & " µg" &
           ASCII.LF &
           ASCII.LF;
      begin
         for I in S'Range loop
            Report_Text (Index) := S (I);
            Index := Index + 1;
         end loop;
      end;

      declare
         S : constant String :=
           "📊 MÉTRIQUES DE VALIDATION :" &
           ASCII.LF &
           "  Efficacité prédite          : " & Float'Image (State.Predicted_Efficacy) & " %" &
           ASCII.LF &
           "  Intervalle de confiance     : [" &
           Float'Image (State.Confidence_Interval_Min) & " - " &
           Float'Image (State.Confidence_Interval_Max) & "] %" &
           ASCII.LF &
           "  Cohérence de phase          : " & Float'Image (State.Coherence) & " %" &
           ASCII.LF &
           "  Potentiel de phase          : " & Float'Image (State.Phase_Potential) & " mV" &
           ASCII.LF &
           "  Checksum V3                 : " & Integer'Image (State.Checksum) &
           ASCII.LF &
           ASCII.LF;
      begin
         for I in S'Range loop
            Report_Text (Index) := S (I);
            Index := Index + 1;
         end loop;
      end;

      declare
         S : constant String :=
           "🎯 CONCLUSION :" &
           ASCII.LF &
           (if State.Is_Cured then
              "  ✅ RÉGÉNÉRATION RÉTINIENNE COMPLÈTE EN " &
              Float'Image (State.Time_Days) & " JOURS" &
              ASCII.LF &
              "  ✅ ACUITÉ VISUELLE NORMALISÉE : " &
              Float'Image (State.Visual_Acuity) & " LogMAR" &
              ASCII.LF &
              "  ✅ CHAMP VISUEL RESTAURÉ : " &
              Float'Image (State.Visual_Field) & " %" &
              ASCII.LF &
              "  ✅ Pression intraoculaire normalisée : " &
              Float'Image (State.Intraocular_Pressure) & " mmHg" &
              ASCII.LF &
              "  ✅ Épaisseur maculaire normalisée : " &
              Float'Image (State.Macular_Thickness) & " µm" &
              ASCII.LF &
              "  ✅ LES 7 COUCHES RÉTINIENNES SONT RESTAURÉES" &
              ASCII.LF &
              "  ✅ LA RÉGÉNÉRATION EST DÉFINITIVE"
           elsif State.Is_Safe then
              "  ⏳ TRAITEMENT EN COURS — EFFICACITÉ ACTUELLE : " &
              Float'Image (State.Predicted_Efficacy) & " %" &
              ASCII.LF &
              "  ⏳ TEMPS RESTANT ESTIMÉ : " &
              Float'Image (28.0 - State.Time_Days) & " jours" &
              ASCII.LF &
              "  ⏳ POURSUIVRE LE TRAITEMENT"
           else
              "  ❌ ÉCHEC DE SÉCURITÉ — TRAITEMENT ARRÊTÉ" &
              ASCII.LF &
              "  ❌ RISQUE IDENTIFIÉ : " &
              (if State.Regenerine_Retinal > 95.0 then "PROLIFÉRATION EXCESSIVE" &
               elsif State.Coherence < 65.0 then "DÉCOHÉRENCE DE PHASE" &
               elsif State.Intraocular_Pressure > 35.0 then "HYPERTENSION OCULAIRE" &
               else "PERTURBATION STRUCTURELLE") &
              ASCII.LF &
              "  ❌ INTERVENTION NÉCESSAIRE"
           ) &
           ASCII.LF &
           ASCII.LF &
           "================================================================================ " &
           ASCII.LF &
           "Ψ_V3 = 48016.8 kg·m⁻² — LOCKED." &
           ASCII.LF &
           "Φ_critical = -51.1 mV — INVARIANT." &
           ASCII.LF &
           "k = 7 — HEPTADIC CLOSURE (7 COUCHES RÉTINIENNES)." &
           ASCII.LF &
           "Modulo-9 = 9 — INTÉGRITÉ STRUCTURELLE." &
           ASCII.LF &
           "================================================================================ ";
      begin
         for I in S'Range loop
            Report_Text (Index) := S (I);
            Index := Index + 1;
         end loop;
      end;

      Report := Report_Text;
   end Generate_Retinal_Report;

end V3.Retinal_Regeneration_Engine;

