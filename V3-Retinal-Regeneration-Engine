   procedure Optimize_Retinal_Dose
     (Target_Efficacy : in     Percentage;
      Pathology       : in     Retinal_Pathology;
      Severity        : in     Percentage;
      State           :    out Retinal_Regeneration_State) is
      Best_Efficacy  : Percentage := 0.0;
      Best_Dose_Nogo : Dose_Type := 0.0;
      Best_Dose_TGF  : Dose_Type := 0.0;
      Best_Dose_VEGF : Dose_Type := 0.0;
      Best_Dose_IL6  : Dose_Type := 0.0;
      Test_State     : Retinal_Regeneration_State;
   begin
      -- Optimisation par balayage des doses
      for Nogo in 0 .. 500 loop
         for TGF in 0 .. 500 loop
            for VEGF in 0 .. 500 loop
               for IL6 in 0 .. 500 loop
                  Simulate_Retinal_Regeneration (Test_State,
                                                 Pathology,
                                                 Severity,
                                                 Dose_Type (Nogo),
                                                 Dose_Type (TGF),
                                                 Dose_Type (VEGF),
                                                 Dose_Type (IL6),
                                                 28.0);

                  if Test_State.Predicted_Efficacy > Best_Efficacy then
                     Best_Efficacy := Test_State.Predicted_Efficacy;
                     Best_Dose_Nogo := Dose_Type (Nogo);
                     Best_Dose_TGF := Dose_Type (TGF);
                     Best_Dose_VEGF := Dose_Type (VEGF);
                     Best_Dose_IL6 := Dose_Type (IL6);
                     State := Test_State;
                  end if;
               end loop;
            end loop;
         end loop;
      end loop;

      if Best_Efficacy < Target_Efficacy then
         Simulate_Retinal_Regeneration (State,
                                        Pathology,
                                        Severity,
                                        500.0,
                                        500.0,
                                        500.0,
                                        500.0,
                                        28.0);
      end if;

      pragma Assert (State.Checksum = MODULO_9);
   end Optimize_Retinal_Dose;

