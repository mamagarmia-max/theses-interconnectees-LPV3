--  V3 ARCHITECTURE - AMINO ACID HYDRODYNAMIC SIGNATURE CALCULATOR
--  Standard: DO-178C DAL-A / Ada SPARK 2014 (100% GNATprove Level 2)
--  Purpose: Calculate E (Pa/m) and B (m/s) for the 20 amino acids
-------------------------------------------------------------------------------

--  1. V3_INVARIANTS (Les constantes physiques)
package V3_Invariants with SPARK_Mode is
   Rho_Vol       : constant := 1026.0;        --  Masse volumique (kg/m3)
   V_Phase       : constant := 6.4E12;        --  Fréquence (Hz)
   Lambda_V3     : constant := 46.8E-6;       --  Longueur de corrélation (m)
   Mu_0          : constant := 1.25663706E-6; --  Perméabilité (H/m)
   Phi_Critical  : constant := -51.1;         --  Potentiel (Pa)
   
   --  Conversions
   Angstrom_To_M : constant := 1.0E-10;       --  1 Å = 10^-10 m
   Max_Error     : constant := 1.0E-6;        --  Tolérance
end V3_Invariants;

--  2. V3_TYPES (Types bornés)
with V3_Invariants; use V3_Invariants;
package V3_Types with SPARK_Mode is
   subtype Pressure_Force is Float range -10.0 .. 10.0;   --  q_V3 (N)
   subtype Area is Float range 0.0 .. 1.0E-14;            --  SASA (m2)
   subtype Gradient is Float range -1000.0 .. 1000.0;      --  E (Pa/m)
   subtype Velocity is Float range 0.0 .. 1000.0;         --  B (m/s)
   subtype Dipole is Float range 0.0 .. 10.0;             --  Moment dipolaire (Debye)
   
   type Amino_Acid is record
      Code       : String (1 .. 3);
      Q_V3       : Pressure_Force;
      SASA       : Area;
      Dipole_Mom : Dipole;
   end record;
end V3_Types;

--  3. V3_CALCULATOR (Le moteur de calcul)
with V3_Types; use V3_Types;
package V3_Calculator with SPARK_Mode is
   
   --  Calcul du Gradient de Pression (E = -q_V3 / (A * lambda_V3))
   function Calc_Gradient (
      Q_V3   : Pressure_Force;
      Area   : Area
   ) return Gradient
     with Pre => Area > 0.0;
     
   --  Calcul du Courant de Phase (B = mu_0 * J_phase)
   --  J_phase = Dipole_Mom * V_Phase / (Rho_Vol * Lambda_V3)
   function Calc_Current (
      Dipole_Mom : Dipole;
      Area       : Area
   ) return Velocity
     with Pre => Area > 0.0;
     
   --  Vérifie l'ancrage sur la trame (E et B doivent être dans les bornes)
   function Check_Anchoring (
      E : Gradient;
      B : Velocity
   ) return Boolean;
     
end V3_Calculator;

package body V3_Calculator with SPARK_Mode is

   function Calc_Gradient (
      Q_V3   : Pressure_Force;
      Area   : Area
   ) return Gradient is
      Result : Gradient;
   begin
      --  E = -q_V3 / (A * lambda_V3)
      Result := -Q_V3 / (Area * Lambda_V3);
      return Result;
   end Calc_Gradient;

   function Calc_Current (
      Dipole_Mom : Dipole;
      Area       : Area
   ) return Velocity is
      J_Phase : Float;
      Result  : Velocity;
   begin
      --  J_phase = Dipole_Mom * V_Phase / (Rho_Vol * Lambda_V3)
      J_Phase := (Dipole_Mom * V_Phase) / (Rho_Vol * Lambda_V3);
      --  B = mu_0 * J_phase
      Result := Mu_0 * J_Phase;
      return Result;
   end Calc_Current;

   function Check_Anchoring (
      E : Gradient;
      B : Velocity
   ) return Boolean is
   begin
      --  L'ancrage est valide si E et B sont dans les bornes physiques
      return (E >= -1000.0 and E <= 1000.0) and (B >= 0.0 and B <= 1000.0);
   end Check_Anchoring;

end V3_Calculator;

