         E12p  : constant Float := Cos (D12p);
         E1p2  : constant Float := Cos (D1p2);
         E1p2p : constant Float := Cos (D1p2p);
      begin
         return abs (E12 - E12p + E1p2 + E1p2p);
      end Compute_Bell_S;

      function Verify_Tsirelson (S : Float) return Boolean is
      begin
         return S <= 2.0 * Sqrt (2.0);
      end Verify_Tsirelson;

      function Compute_T1 (Delta_Phi : Float) return Float is
         Phi_Abs : constant Float := abs (PHI_CRITICAL);
      begin
