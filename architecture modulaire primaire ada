      end Compute_T1;

      function Compute_T2 (Delta_Phi : Float) return Float is
         Phi_Abs : constant Float := abs (PHI_CRITICAL);
      begin
         if Delta_Phi = 0.0 then
            return Float'Last;
         else
            return TAU_PHASE / (1.0 - Exp (-Delta_Phi / Phi_Abs));
         end if;
      end Compute_T2;

      function Compute_GHZ (D1, D2, D3 : Float) return Float is
