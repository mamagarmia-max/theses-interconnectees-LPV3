   -- 1.4 DIGITAL ROOT (MODULO-9)
   function Digital_Root (N : Integer) return Checksum_Type is
      V : Integer := N;
      S : Integer := 0;
   begin
      if V < 0 then V := -V; end if;
      if V = 0 then return 9; end if;
      while V > 0 loop
         S := S + (V mod 10);
         V := V / 10;
      end loop;
      while S > 9 loop
         S := (S mod 10) + (S / 10);
      end loop;
      return Checksum_Type (S);
   end Digital_Root;

   function Digital_Root_Float (N : Float) return Checksum_Type is
   begin
      return Digital_Root (Integer (abs (N)));
   end Digital_Root_Float;

