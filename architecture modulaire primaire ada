   -- 1.3 FONCTIONS DE BASE — SATURATING ARITHMETIC
   function Saturating_Add (A, B : Float) return Float is
      R : Long_Long_Float;
   begin
      R := Long_Long_Float (A) + Long_Long_Float (B);
      if R > 1.0e308 then return 1.0e308;
      elsif R < -1.0e308 then return -1.0e308;
      else return Float (R); end if;
   end Saturating_Add;

   function Saturating_Sub (A, B : Float) return Float is
      R : Long_Long_Float;
   begin
      R := Long_Long_Float (A) - Long_Long_Float (B);
      if R > 1.0e308 then return 1.0e308;
      elsif R < -1.0e308 then return -1.0e308;
      else return Float (R); end if;
   end Saturating_Sub;

   function Saturating_Mul (A, B : Float) return Float is
      R : Long_Long_Float;
   begin
      R := Long_Long_Float (A) * Long_Long_Float (B);
      if R > 1.0e308 then return 1.0e308;
      elsif R < -1.0e308 then return -1.0e308;
      else return Float (R); end if;
   end Saturating_Mul;

   function Saturating_Div (A, B : Float) return Float is
      R : Long_Long_Float;
   begin
      if B = 0.0 then return 1.0e308; end if;
      R := Long_Long_Float (A) / Long_Long_Float (B);
      if R > 1.0e308 then return 1.0e308;
      elsif R < -1.0e308 then return -1.0e308;
      else return Float (R); end if;
   end Saturating_Div;

