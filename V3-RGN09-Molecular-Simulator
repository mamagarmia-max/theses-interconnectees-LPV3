   V3_RGN09_LogP        : constant := 2.8;           -- Partition coefficient
   V3_RGN09_PSA         : constant := 185.0;         -- Polar surface area (Å²)
   V3_RGN09_TPSA        : constant := 165.0;         -- Topological PSA
   V3_RGN09_RB          : constant := 8;             -- Rotatable bonds
   V3_RGN09_HBD         : constant := 4;             -- H-bond donors
   V3_RGN09_HBA         : constant := 10;            -- H-bond acceptors

   -- ========================================================================
