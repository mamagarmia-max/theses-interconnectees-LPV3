   PSI_V3          : constant := 48_016.8;          -- kg·m⁻²
   PHI_CRITICAL    : constant := -51.10;            -- mV
   PHI_BASAL       : constant := -70.00;            -- mV
   K_CYCLES        : constant := 7;                 -- Heptadic closure
   MODULO_9        : constant := 9;                 -- Structural integrity

   -- ========================================================================
