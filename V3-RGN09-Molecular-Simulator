   -- ========================================================================

   -- Domain A : Anti-TGF-β / Anti-VEGF (PDB 6M76 — TGFBR1 receptor)
   DOMAIN_A_MW          : constant := 420.3;         -- Da
   DOMAIN_A_AFFINITY    : constant := 0.050;         -- nM (Kd)
   DOMAIN_A_DSG         : constant := -5.8;          -- kcal/mol
