   DOMAIN_B_DSG         : constant := -6.0;          -- kcal/mol
   DOMAIN_B_TARGET      : constant String := "TrkB/PEDF";

   -- Hybrid molecule (calculated from domains)
   V3_RGN09_MW          : constant := 842.6;         -- Da
