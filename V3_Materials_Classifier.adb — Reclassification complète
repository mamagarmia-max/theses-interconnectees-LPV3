with Ada.Text_IO; use Ada.Text_IO;
with Ada.Float_Text_IO; use Ada.Float_Text_IO;
with Ada.Integer_Text_IO; use Ada.Integer_Text_IO;

procedure V3_Materials_Classifier with
   SPARK_Mode => On,
   Global => null
is

   -- ========================================================================
   -- 1. INVARIANTS V3 (VERROUILLÉS)
   -- ========================================================================

   PSI_V3          : constant := 48016.8;          -- kg·m⁻²
   PHI_CRITICAL    : constant := -51.1;            -- mV
   K_CYCLES        : constant := 7;                -- Fermeture heptadique
   RHO_COND        : constant := 1026.0;           -- kg·m⁻³
   NU_PHASE        : constant := 6.4e12;           -- Hz
   BETA            : constant := 1_000_000.0;

   -- ========================================================================
   -- 2. TYPES POUR LES MATÉRIAUX
   -- ========================================================================

   -- 2.1 Catégories V3 (basées sur la phase, pas sur le type)
   type V3_Phase_Class is
     (Phase_UltraStable,    -- Φ < -55 mV : diamant, carbure, etc.
      Phase_Stable,         -- -55 ≤ Φ < -52 mV : métaux nobles, céramiques
      Phase_Standard,       -- -52 ≤ Φ < -50 mV : aciers, alliages, polymères
      Phase_Ductile,        -- -50 ≤ Φ < -48 mV : aluminium, cuivre, or
      Phase_Soft,           -- -48 ≤ Φ < -45 mV : plomb, étain, zinc
      Phase_Volatile,       -- -45 ≤ Φ < -40 mV : gaz, éléments légers
      Phase_Critical);      -- Φ ≥ -40 mV : instables, radioactifs

   -- 2.2 Type de matériau (pour référence, mais NON utilisé pour le classement)
   type Material_Kind is
     (Pure_Metal, Alloy, Polymer, Ceramic, Composite, Gas, Semiconductor);

   -- 2.3 Enregistrement complet d'un matériau
   type Material_Record is record
      Name                 : String (1 .. 30);
      Kind                 : Material_Kind;
      Phase_Class          : V3_Phase_Class;
      Rupture_Stress_MPa   : Float;
      Melting_Point_K      : Float;
      Boiling_Point_K      : Float;
      Phase_Tension_mV     : Float;
      Thermal_Shift_mV     : Float;
      Predicted_Rupture    : Float;    -- Rupture prédite par V3 (MPa)
      Predicted_Melt_K     : Float;    -- Fusion prédite par V3 (K)
      Predicted_Boil_K     : Float;    -- Ébullition prédite par V3 (K)
      Deviation_Rupture    : Float;    -- Écart (%)
      Deviation_Melt       : Float;
      Deviation_Boil       : Float;
   end record;

   type Material_Array is array (1 .. 200) of Material_Record;

   -- ========================================================================
   -- 3. FONCTIONS DE CALCUL V3 (PRÉDICTION)
   -- ========================================================================

   -- 3.1 Prédiction de la contrainte de rupture à partir de la phase
   function Predict_Rupture (Phase_Tension : Float) return Float
     with Pre => Phase_Tension <= 0.0,
          Post => Predict_Rupture'Result >= 0.0
   is
      -- Rupture (MPa) = - (Phase_Tension × PSI_V3) / (BETA × 0.001)
      -- Inversement de Compute_Phase_Tension
   begin
      return -(Phase_Tension * PSI_V3) / (BETA * 0.001) /
             (1.0 + 1.0 / Float (K_CYCLES));
   end Predict_Rupture;

   -- 3.2 Prédiction de la température de fusion à partir de la phase
   function Predict_Melting (Phase_Tension : Float) return Float
     with Pre => Phase_Tension <= 0.0,
          Post => Predict_Melting'Result > 0.0
   is
      -- T_fusion (K) = 300 + (Phase_Tension + 51.1) × (-1000)
      -- Plus la phase est basse (plus négative), plus T_fusion est élevée
      T_0 : constant Float := 300.0;
   begin
      return T_0 + (Phase_Tension - PHI_CRITICAL) * (-1000.0);
   end Predict_Melting;

   -- 3.3 Prédiction de la température d'ébullition à partir de la phase
   function Predict_Boiling (Phase_Tension : Float) return Float
     with Pre => Phase_Tension <= 0.0,
          Post => Predict_Boiling'Result > 0.0
   is
      -- T_ébullition (K) = 500 + (Phase_Tension + 51.1) × (-2000)
      T_0 : constant Float := 500.0;
   begin
      return T_0 + (Phase_Tension - PHI_CRITICAL) * (-2000.0);
   end Predict_Boiling;

   -- 3.4 Détermination de la classe de phase V3
   function Get_Phase_Class (Phase_Tension : Float) return V3_Phase_Class
     with Pre => Phase_Tension <= 0.0
   is
   begin
      if Phase_Tension < -55.0 then
         return Phase_UltraStable;
      elsif Phase_Tension < -52.0 then
         return Phase_Stable;
      elsif Phase_Tension < -50.0 then
         return Phase_Standard;
      elsif Phase_Tension < -48.0 then
         return Phase_Ductile;
      elsif Phase_Tension < -45.0 then
         return Phase_Soft;
      elsif Phase_Tension < -40.0 then
         return Phase_Volatile;
      else
         return Phase_Critical;
      end if;
   end Get_Phase_Class;

   -- 3.5 Calcul de la tension de phase à partir de la rupture
   function Compute_Phase_Tension (Rupture_Stress : Float) return Float
     with Pre => Rupture_Stress > 0.0,
          Post => Compute_Phase_Tension'Result <= 0.0
   is
   begin
      return -(Rupture_Stress * 0.001 * BETA / PSI_V3) *
             (1.0 + 1.0 / Float (K_CYCLES));
   end Compute_Phase_Tension;

   -- ========================================================================
   -- 4. CRÉATION D'UN MATÉRIAU AVEC PRÉDICTIONS
   -- ========================================================================

   function Create_Material
     (Name       : String;
      Kind       : Material_Kind;
      Stress     : Float;
      T_melt     : Float;
      T_boil     : Float) return Material_Record
     with Pre => Stress > 0.0 and T_melt > 0.0 and T_boil > 0.0,
          Post => Create_Material'Result.Phase_Tension <= 0.0
   is
      Phase_Tension   : Float := Compute_Phase_Tension (Stress);
      Phase_Class     : V3_Phase_Class := Get_Phase_Class (Phase_Tension);
      Pred_Rupt       : Float := Predict_Rupture (Phase_Tension);
      Pred_Melt       : Float := Predict_Melting (Phase_Tension);
      Pred_Boil       : Float := Predict_Boiling (Phase_Tension);
      Dev_Rupt        : Float := abs (Pred_Rupt - Stress) / Stress * 100.0;
      Dev_Melt        : Float := abs (Pred_Melt - T_melt) / T_melt * 100.0;
      Dev_Boil        : Float := abs (Pred_Boil - T_boil) / T_boil * 100.0;
      Name_Fixed      : String (1 .. 30) := (others => ' ');
   begin
      -- Copie du nom (tronqué à 30 caractères)
      for I in 1 .. Integer'Min (Name'Length, 30) loop
         Name_Fixed (I) := Name (I);
      end loop;

      return Material_Record'
        (Name                 => Name_Fixed,
         Kind                 => Kind,
         Phase_Class          => Phase_Class,
         Rupture_Stress_MPa   => Stress,
         Melting_Point_K      => T_melt,
         Boiling_Point_K      => T_boil,
         Phase_Tension_mV     => Phase_Tension,
         Thermal_Shift_mV     => 0.0,  -- Non utilisé ici
         Predicted_Rupture    => Pred_Rupt,
         Predicted_Melt_K     => Pred_Melt,
         Predicted_Boil_K     => Pred_Boil,
         Deviation_Rupture    => Dev_Rupt,
         Deviation_Melt       => Dev_Melt,
         Deviation_Boil       => Dev_Boil);
   end Create_Material;

