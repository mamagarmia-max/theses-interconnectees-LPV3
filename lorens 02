   -- ========================================================================
   -- 4. PAROI COSMIQUE
   -- ========================================================================

   function Compute_Surface_Tension (Radius_Ratio : Float) return Float is
   begin
      if Radius_Ratio >= 1.0 then
         return Float (K_CYCLES);
      elsif Radius_Ratio > 0.9 then
         declare
            T : constant Float := (Radius_Ratio - 0.9) / 0.1;
         begin
            return Float (K_CYCLES) * T * T;
         end;
      else
         return 0.0;
      end if;
   end Compute_Surface_Tension;

   function Compute_Hydrodynamic_Pressure (Radius_Ratio : Float) return Float is
      P_Center : constant Float := 48016.8 * 299792458.0 * 299792458.0 / 1.38e26;
   begin
      if Radius_Ratio >= 1.0 then
         return 0.0;
      else
         return P_Center * (1.0 - Radius_Ratio * Radius_Ratio);
      end if;
   end Compute_Hydrodynamic_Pressure;

   -- ========================================================================
   -- 5. REBOND COSMIQUE
   -- ========================================================================

   function Compute_Rebound_Force (Scale_Factor : Float) return Float is
      R_Dynamic : constant Float := 1.38e26 * Scale_Factor;
      Lambda_Dynamic : constant Float := 1.1056e-52 / (Scale_Factor * Scale_Factor);
      m_p_abs : constant Float := Compute_Proton_Mass_Dynamic (Scale_Factor);
      F_Grav : constant Float := - (m_p_abs * 299792458.0 * 299792458.0) / (R_Dynamic * R_Dynamic);
      F_Tension : constant Float := Lambda_Dynamic * (R_Dynamic * R_Dynamic) * 4.0 * 3.1415926535;
   begin
      return F_Grav + F_Tension;
   end Compute_Rebound_Force;

   function Compute_Proton_Mass_Dynamic (Scale_Factor : Float) return Float is
      R_Dynamic : constant Float := 1.38e26 * Scale_Factor;
      Lambda_Dynamic : constant Float := 1.1056e-52 / (Scale_Factor * Scale_Factor);
   begin
      return 48016.8 / (R_Dynamic * 299792458.0 * 299792458.0 * Lambda_Dynamic);
   end Compute_Proton_Mass_Dynamic;

