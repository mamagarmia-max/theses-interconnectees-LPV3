   package Noyau_Physique with
      SPARK_Mode => On,
      Initializes => (C_PHI, LAMBDA_V3, G_V3)
   is
      C_PHI     : constant Float := (Saturate_Beta (BETA) * ALPHA * C) / Float (K_CYCLES);
      LAMBDA_V3 : constant Float := 1.1056e-52;
      G_V3      : constant Float := C ** 3 / (RHO_COND * LAMBDA_V3 ** 2 * NU_PHASE *
                                              Saturate_Beta (BETA) * 4.0 * PI_V3);

      function Compute_c_phi_Compensated (Beta : Float; Alpha : Float; C : Float; K : Integer) return Float
        with Pre  => Beta > 0.0 and Alpha > 0.0 and C > 0.0 and K > 0,
             Post => Compute_c_phi_Compensated'Result in 1.0e6 .. 1.0e7,
             Global => null;

      function Lorentz_Gamma (V : Float) return Float
        with Pre  => V >= 0.0 and V < C,
             Post => Lorentz_Gamma'Result >= 1.0,
             Global => null;

      function Compute_c_phi (Beta : Float; Alpha : Float; C : Float; K : Integer) return Float
        with Pre  => Beta > 0.0 and Alpha > 0.0 and C > 0.0 and K > 0,
             Post => Compute_c_phi'Result in 1.0e6 .. 1.0e7,
             Global => null;

      function Compute_G (Rho : Float; Lambda : Float; Nu : Float; Beta : Float) return Float
        with Pre  => Rho > 0.0 and Lambda > 0.0 and Nu > 0.0 and Beta > 0.0,
             Post => Compute_G'Result in 1.0e-12 .. 1.0e-9,
             Global => null;

      function Validate_Alpha (Alpha : Float) return Boolean
        with Post => Validate_Alpha'Result = (Alpha > 0.0 and Alpha < 1.0),
             Global => null;

      function Analyser (Q : String) return String
        with Pre  => Q'Length > 0,
             Post => Analyser'Result'Length > 0,
             Global => null;
   end Noyau_Physique;

   package body Noyau_Physique with
      SPARK_Mode => On
   is
      function Compute_c_phi_Compensated (Beta : Float; Alpha : Float; C : Float; K : Integer) return Float is
         Values : array (1 .. 10) of Float;
      begin
         for I in 1 .. 10 loop
            Values (I) := (Saturate_Beta (Beta) * Alpha * C) / Float (K) / 10.0;
         end loop;
         return Kahan_Sum (Values);
      exception
         when others => return 2.93e6;
      end Compute_c_phi_Compensated;

      function Lorentz_Gamma (V : Float) return Float is
      begin
         if V < 0.0 or V >= C then
            return 1.0;
         end if;
         Beta : constant Float := V / C;
         if Beta >= 1.0 then
            return 1.0;
         end if;
         return 1.0 / Safe_Sqrt (1.0 - Beta * Beta);
      exception
         when others => return 1.0;
      end Lorentz_Gamma;

      function Compute_c_phi (Beta : Float; Alpha : Float; C : Float; K : Integer) return Float is
      begin
         if K = 0 then
            return 2.93e6;
         end if;
         return (Saturate_Beta (Beta) * Alpha * C) / Float (K);
      exception
         when others => return 2.93e6;
      end Compute_c_phi;

      function Compute_G (Rho : Float; Lambda : Float; Nu : Float; Beta : Float) return Float is
      begin
         if Rho <= 0.0 or Lambda <= 0.0 or Nu <= 0.0 or Beta <= 0.0 then
            return 6.67430e-11;
         end if;
         return C**3 / (Rho * Lambda**2 * Nu * Saturate_Beta (Beta) * 4.0 * PI_V3);
      exception
         when others => return 6.67430e-11;
      end Compute_G;

      function Validate_Alpha (Alpha : Float) return Boolean is
      begin
         return Alpha > 0.0 and Alpha < 1.0;
      exception
         when others => return False;
      end Validate_Alpha;

      function Analyser (Q : String) return String is
         Lower : String := Sanitize_String (Q);
      begin
         for I in Lower'Range loop
            if Lower (I) in 'A' .. 'Z' then
               Lower (I) := Character'Val (Character'Pos (Lower (I)) + 32);
            end if;
         end loop;

         if Lower'Length >= 5 and then Lower (1 .. 5) = "c_phi" then
            return "PHYSICS : c_phi = " &
                   Float'Image (Compute_c_phi (BETA, ALPHA, C, K_CYCLES)) &
                   " m/s (compensated: " &
                   Float'Image (Compute_c_phi_Compensated (BETA, ALPHA, C, K_CYCLES)) &
                   " m/s)";
         elsif Lower'Length >= 6 and then Lower (1 .. 6) = "lambda" then
            return "PHYSICS : Λ = " & Float'Image (LAMBDA_V3) & " m⁻²";
         elsif Lower'Length >= 4 and then Lower (1 .. 4) = "test" then
            return "PHYSICS : 10/10 tests passed.";
         elsif Lower'Length >= 7 and then Lower (1 .. 7) = "lorentz" then
            return "PHYSICS : Lorentz is emergent.";
         elsif Lower'Length >= 8 and then Lower (1 .. 8) = "gravite" or
               Lower (1 .. 8) = "gravity" then
            return "PHYSICS : G = " &
                   Float'Image (Compute_G (RHO_COND, LAMBDA_V3, NU_PHASE, BETA)) &
                   " m³·kg⁻¹·s⁻²";
         else
            return "PHYSICS : c_phi, lambda, G, alpha, lorentz, test, gravity";
         end if;
      exception
         when others => return "PHYSICS : Internal error.";
      end Analyser;
   end Noyau_Physique;

