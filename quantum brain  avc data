         Distance_m      : Float := 0.1;
         Velocity_m_s    : Float := 0.0;
         Time_s          : Float := 0.0;
         Coherence       : Integer range 0 .. 100 := 100;
         Checksum        : Checksum_Type := 9;
      end record
        with Predicate => Propagation_State.Checksum = 9;

      function Compute_Velocity (T : Tissue_Type) return Float
        with Post => Compute_Velocity'Result > 0.0,
             Global => null;

