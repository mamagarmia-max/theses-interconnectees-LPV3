        with Pre  => Distance >= 0.0 and Velocity > 0.0,
             Post => Compute_Propagation_Time'Result >= 0.0,
             Global => null;

      function Compute_Diffusion_Time (Distance : Float) return Float
        with Pre  => Distance >= 0.0,
             Post => Compute_Diffusion_Time'Result >= 0.0,
             Global => null;

      function Compute_V3_Gain (T : Tissue_Type; Distance : Float) return Float
        with Pre  => Distance >= 0.0,
             Post => Compute_V3_Gain'Result >= 1.0,
             Global => null;

      function Analyser (Q : String) return String
        with Pre  => Q'Length > 0,
             Post => Analyser'Result'Length > 0,
             Global => null;
