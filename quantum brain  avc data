            Result.braking := Integer (Clamp (Float (State.approach_velocity) / 500.0, 0.0, 100.0));
            Result.evasion_z := Integer (Clamp (Float (State.relative_z) / 20.0, -5_000.0, 5_000.0));
            return Result;
         end if;

         Result.braking := 0;
         Result.evasion_z := 0;
         Result.integrity := 0;
