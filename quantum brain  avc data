   package body Noyau_Propagation_Tissulaire with
      SPARK_Mode => On
   is
      function Compute_Velocity (T : Tissue_Type) return Float is
      begin
         case T is
            when SYNCYTIUM    => return 1.5e3;
            when INTERSTITIAL => return 0.2 * C;
            when MIXED        => return 0.1 * C;
         end case;
      exception
         when others => return 1.5e3;
      end Compute_Velocity;

      function Compute_Propagation_Time (Distance, Velocity : Float) return Float is
      begin
         return Distance / Velocity;
      exception
         when others => return 0.0;
      end Compute_Propagation_Time;

      function Compute_Diffusion_Time (Distance : Float) return Float is
         D : constant Float := 1.0e-9;
      begin
         return Distance * Distance / (2.0 * D);
      exception
         when others => return 0.0;
      end Compute_Diffusion_Time;

      function Compute_V3_Gain (T : Tissue_Type; Distance : Float) return Float is
         T_diff : Float;
         T_v3   : Float;
      begin
         T_diff := Compute_Diffusion_Time (Distance);
         T_v3   := Compute_Propagation_Time (Distance, Compute_Velocity (T));
         if T_v3 = 0.0 then
            return 1.0;
         end if;
         return T_diff / T_v3;
      exception
         when others => return 1.0;
      end Compute_V3_Gain;

      function Analyser (Q : String) return String is
         Lower : String := Sanitize_String (Q);
         State : Propagation_State;
         Gain : Float;
      begin
         for I in Lower'Range loop
            if Lower (I) in 'A' .. 'Z' then
               Lower (I) := Character'Val (Character'Pos (Lower (I)) + 32);
            end if;
         end loop;

         if Lower'Length >= 5 and then Lower (1 .. 5) = "syncy" then
            State.Tissue := SYNCYTIUM;
            State.Velocity_m_s := Compute_Velocity (SYNCYTIUM);
            State.Distance_m := 0.1;
            State.Time_s := Compute_Propagation_Time (State.Distance_m, State.Velocity_m_s);
            Gain := Compute_V3_Gain (SYNCYTIUM, State.Distance_m);
            return "PROPAGATION SYNCYTIUM : Velocity = " &
                   Float'Image (State.Velocity_m_s) & " m/s" &
                   " | Time = " & Float'Image (State.Time_s) & " s" &
                   " | V3 gain = " & Float'Image (Gain) &
                   " | I²R = 0 (lossless)" &
                   " | Φ = " & Float'Image (PRO_PHI_CRITICAL) & " mV";

         elsif Lower'Length >= 6 and then Lower (1 .. 6) = "inters" then
            State.Tissue := INTERSTITIAL;
            State.Velocity_m_s := Compute_Velocity (INTERSTITIAL);
            State.Distance_m := 0.1;
            State.Time_s := Compute_Propagation_Time (State.Distance_m, State.Velocity_m_s);
            Gain := Compute_V3_Gain (INTERSTITIAL, State.Distance_m);
            return "PROPAGATION INTERSTITIEL : Velocity = " &
                   Float'Image (State.Velocity_m_s) & " m/s" &
                   " | Time = " & Float'Image (State.Time_s) & " s" &
                   " | V3 gain = " & Float'Image (Gain) &
                   " | EZ water = répéteur de phase" &
                   " | Φ = " & Float'Image (PRO_PHI_CRITICAL) & " mV";

         else
            return "PROPAGATION TISSULAIRE : " &
                   "syncy (syncytium), " &
                   "inters (interstitiel), " &
                   "soliton, balistique, OCS";
         end if;
      exception
         when others => return "PROPAGATION TISSULAIRE : Internal error.";
      end Analyser;
   end Noyau_Propagation_Tissulaire;

