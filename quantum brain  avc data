   package Noyau_Couplage_Photon_Proton with
      SPARK_Mode => On
   is
      CPP_PSI_V3       : constant Float := PSI_V3;
      CPP_PHI_CRITICAL : constant Float := PHI_CRITICAL;
      CPP_K            : constant Integer := K_CYCLES;
      CPP_MODULO       : constant Integer := MODULO_9;

      CPP_PROTON_SPEED : constant Float := 1.5e3;
      CPP_PHOTON_SPEED : constant Float := 0.2 * C;
      CPP_COUPLING_LENGTH : constant Float := 1.0e-8;
      CPP_BASE_FREQ    : constant Float := 396.0;

      type Meridian_Type is
        (MERIDIAN_LUNG, MERIDIAN_LARGE_INTESTINE, MERIDIAN_STOMACH,
         MERIDIAN_SPLEEN, MERIDIAN_HEART, MERIDIAN_SMALL_INTESTINE,
         MERIDIAN_BLADDER, MERIDIAN_KIDNEY, MERIDIAN_PERICARDIUM,
         MERIDIAN_TRIPLE_BURNER, MERIDIAN_GALLBLADDER, MERIDIAN_LIVER,
         MERIDIAN_GOVERNOR, MERIDIAN_CONCEPTION);

      type Acupuncture_Point is record
         Name            : String (1 .. 20);
         Meridian        : Meridian_Type;
         Number          : Integer range 1 .. 67;
         Phase_Potential : Float := CPP_PHI_CRITICAL;
         Resonance_Freq  : Float := 0.0;
         Coherence       : Integer range 0 .. 100 := 100;
         Checksum        : Checksum_Type := 9;
      end record
        with Predicate => Acupuncture_Point.Checksum = 9;

      type Meridian_State is record
         Meridian        : Meridian_Type := MERIDIAN_LUNG;
         Points          : array (1 .. 10) of Acupuncture_Point;
         Phase_Integrity : Integer range 0 .. 100 := 100;
         Qi_Flow         : Float := 1.0;
         Coherence       : Integer range 0 .. 100 := 100;
         Checksum        : Checksum_Type := 9;
      end record
        with Predicate => Meridian_State.Checksum = 9;

      function Compute_Coupling_Energy (Photon_Flux, Proton_Flux : Float) return Float
        with Pre  => Photon_Flux >= 0.0 and Proton_Flux >= 0.0,
             Post => Compute_Coupling_Energy'Result >= 0.0,
             Global => null;

      function Compute_Photon_Proton_Transfer (Photon_Freq, Proton_Freq : Float) return Float
        with Pre  => Photon_Freq > 0.0 and Proton_Freq > 0.0,
             Post => Compute_Photon_Proton_Transfer'Result in 0.0 .. 100.0,
             Global => null;

      function Compute_Resonance_Alignment (Point : Acupuncture_Point) return Integer
        with Post => Compute_Resonance_Alignment'Result in 0 .. 100,
             Global => null;

      function Get_Point_Frequency (Meridian : Meridian_Type; Point_Num : Integer) return Float
        with Pre  => Point_Num in 1 .. 67,
             Post => Get_Point_Frequency'Result > 0.0,
             Global => null;

      function Compute_Qi_Flow_Rate (Meridian : Meridian_Type; Phase_Integrity : Integer) return Float
        with Pre  => Phase_Integrity in 0 .. 100,
             Post => Compute_Qi_Flow_Rate'Result >= 0.0,
             Global => null;

      function Analyser (Q : String) return String
        with Pre  => Q'Length > 0,
             Post => Analyser'Result'Length > 0,
             Global => null;
   end Noyau_Couplage_Photon_Proton;

   package body Noyau_Couplage_Photon_Proton with
      SPARK_Mode => On
   is
      function Get_Meridian_Base_Freq (Meridian : Meridian_Type) return Float is
      begin
         case Meridian is
            when MERIDIAN_LUNG            => return 396.0;
            when MERIDIAN_LARGE_INTESTINE => return 417.0;
            when MERIDIAN_STOMACH         => return 528.0;
            when MERIDIAN_SPLEEN          => return 639.0;
            when MERIDIAN_HEART           => return 741.0;
            when MERIDIAN_SMALL_INTESTINE => return 852.0;
            when MERIDIAN_BLADDER         => return 396.0 * 2.0;
            when MERIDIAN_KIDNEY          => return 417.0 * 2.0;
            when MERIDIAN_PERICARDIUM     => return 528.0 * 2.0;
            when MERIDIAN_TRIPLE_BURNER   => return 639.0 * 2.0;
            when MERIDIAN_GALLBLADDER     => return 741.0 * 2.0;
            when MERIDIAN_LIVER           => return 852.0 * 2.0;
            when MERIDIAN_GOVERNOR        => return 396.0 * 3.0;
            when MERIDIAN_CONCEPTION      => return 417.0 * 3.0;
         end case;
      exception
         when others => return 396.0;
      end Get_Meridian_Base_Freq;

      function Get_Point_Frequency (Meridian : Meridian_Type; Point_Num : Integer) return Float is
         Base_Freq : Float;
         Harmonic : Integer;
      begin
         Base_Freq := Get_Meridian_Base_Freq (Meridian);
         Harmonic := (Point_Num - 1) mod 7 + 1;
         return Base_Freq * Float (Harmonic);
      exception
         when others => return 396.0;
      end Get_Point_Frequency;

      function Compute_Coupling_Energy (Photon_Flux, Proton_Flux : Float) return Float is
      begin
         if Proton_Flux = 0.0 then
            return 0.0;
         end if;
         return CPP_PSI_V3 * Photon_Flux * Proton_Flux / CPP_COUPLING_LENGTH;
      exception
         when others => return 0.0;
      end Compute_Coupling_Energy;

      function Compute_Photon_Proton_Transfer (Photon_Freq, Proton_Freq : Float) return Float is
         Efficiency : Float;
      begin
         Efficiency := 1.0 / (1.0 + abs (Photon_Freq - Proton_Freq) / Photon_Freq);
         return Clamp (Efficiency * 100.0, 0.0, 100.0);
      exception
         when others => return 50.0;
      end Compute_Photon_Proton_Transfer;

      function Compute_Resonance_Alignment (Point : Acupuncture_Point) return Integer is
         Alignment : Float;
      begin
         if Point.Phase_Potential >= 0.0 then
            return 0;
         end if;
         Alignment := 100.0 * (1.0 - abs (Point.Phase_Potential - CPP_PHI_CRITICAL) /
                                      abs (CPP_PHI_CRITICAL));
         return Integer (Clamp (Alignment, 0.0, 100.0));
      exception
         when others => return 50;
      end Compute_Resonance_Alignment;

      function Compute_Qi_Flow_Rate (Meridian : Meridian_Type; Phase_Integrity : Integer) return Float is
         Base_Flow : Float := 1.0;
         Freq : Float;
      begin
         Freq := Get_Meridian_Base_Freq (Meridian);
         Base_Flow := Float (Phase_Integrity) / 100.0 * Freq / CPP_BASE_FREQ;
         return Clamp (Base_Flow, 0.0, 10.0);
      exception
         when others => return 1.0;
      end Compute_Qi_Flow_Rate;

      function Analyser (Q : String) return String is
         Lower : String := Sanitize_String (Q);
         Point : Acupuncture_Point;
         M : Meridian_State;
         Coupling_E : Float;
         Transfer : Float;
      begin
         for I in Lower'Range loop
            if Lower (I) in 'A' .. 'Z' then
               Lower (I) := Character'Val (Character'Pos (Lower (I)) + 32);
            end if;
         end loop;

         if Lower'Length >= 7 and then Lower (1 .. 7) = "couplag" then
            Coupling_E := Compute_Coupling_Energy (5.0, 1.0);
            Transfer := Compute_Photon_Proton_Transfer (396.0, 396.0);
            return "COUPLAGE PHOTON-PROTON : " &
                   "Energy = " & Float'Image (Coupling_E) & " J" &
                   " | Transfer efficiency = " & Float'Image (Transfer) & "%" &
                   " | Φ critical = " & Float'Image (CPP_PHI_CRITICAL) & " mV" &
                   " | v_photon = 0.2c | v_proton = 1.5 km/s (Grotthuss)";

         elsif Lower'Length >= 5 and then Lower (1 .. 5) = "point" then
            Point.Name := "LI4                  ";
            Point.Meridian := MERIDIAN_LARGE_INTESTINE;
            Point.Number := 4;
            Point.Phase_Potential := CPP_PHI_CRITICAL;
            Point.Resonance_Freq := Get_Point_Frequency (Point.Meridian, Point.Number);
            Point.Coherence := 100;
            Point.Checksum := 9;
            return "POINT ACUPUNCTURE : " & Point.Name &
                   " | Meridian = Large Intestine" &
                   " | Number = " & Integer'Image (Point.Number) &
                   " | Resonance freq = " & Float'Image (Point.Resonance_Freq) & " Hz" &
                   " | Φ = " & Float'Image (Point.Phase_Potential) & " mV" &
                   " | Coherence = " & Integer'Image (Point.Coherence) & "%";

         elsif Lower'Length >= 6 and then Lower (1 .. 6) = "meridi" then
            M.Meridian := MERIDIAN_LUNG;
            for I in 1 .. 10 loop
               M.Points (I).Name := "LU" & Integer'Image (I) & "                 ";
               M.Points (I).Meridian := MERIDIAN_LUNG;
               M.Points (I).Number := I;
               M.Points (I).Phase_Potential := CPP_PHI_CRITICAL;
               M.Points (I).Resonance_Freq := Get_Point_Frequency (MERIDIAN_LUNG, I);
               M.Points (I).Coherence := 100 - (I - 1) * 2;
               M.Points (I).Checksum := 9;
            end loop;
            M.Phase_Integrity := 91;
            M.Qi_Flow := Compute_Qi_Flow_Rate (MERIDIAN_LUNG, M.Phase_Integrity);
            M.Coherence := M.Phase_Integrity;
            M.Checksum := 9;
            return "MÉRIDIEN : Lung (Poumon)" &
                   " | Points = 10" &
                   " | Phase integrity = " & Integer'Image (M.Phase_Integrity) & "%" &
                   " | Qi flow = " & Float'Image (M.Qi_Flow) &
                   " | Base freq = " & Float'Image (Get_Meridian_Base_Freq (MERIDIAN_LUNG)) & " Hz" &
                   " | Φ critical = " & Float'Image (CPP_PHI_CRITICAL) & " mV";

         elsif Lower'Length >= 4 and then Lower (1 .. 4) = "carte" then
            return "CARTE V3 DES MÉRIDIENS :" &
                   " | 14 méridiens principaux" &
                   " | 361 points d'acupuncture" &
                   " | Fréquences: 396-852 Hz (fondamentales)" &
                   " | Harmoniques: ×1, ×2, ×3 (cycle heptadique k=7)" &
                   " | Φ = -51.1 mV (seuil de résonance)" &
                   " | Couplage photon-proton actif";

         else
            return "COUPLAGE PHOTON-PROTON : " &
                   "couplag (efficacité), " &
                   "point (point acupuncture), " &
                   "meridi (méridien), " &
                   "carte (carte des méridiens)";
         end if;
      exception
         when others => return "COUPLAGE PHOTON-PROTON : Internal error.";
      end Analyser;
   end Noyau_Couplage_Photon_Proton;

