            Lower (I) := Character'Val (Character'Pos (Lower (I)) + 32);
         end if;
      end loop;

      if not Verify_Request (Sanitized_Question) then
         NC_Lock.Release;
         return Apply_Veto ("Contaminated request");
      end if;
      NC_Lock.Release;

      -- ============================================================
      -- [NOUVEAU] COMMANDES EMPIRIQUES
