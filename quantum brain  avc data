         begin
            NC.Last_Benchmark := Result;
            return "BENCHMARK : RMS Error = " & Float'Image (Result.RMS_Error) &
                   " % | Pass = " & Boolean'Image (Result.Pass);
         end;
      end if;

      if Lower'Length >= 5 and then Lower (1 .. 5) = "sens" then
         declare
            function Dummy_Func (P : Float) return Float is
            begin
               return P * PSI_V3 / 1000.0;
            end Dummy_Func;
            Result : constant Sensitivity_Result :=
              Run_Sensitivity_Analysis (Dummy_Func'Access, 1.0, 0.1, 100);
         begin
            NC.Last_Sensitivity := Result;
            return "SENSITIVITY : Stability = " & Float'Image (Result.Stability);
         end;
      end if;

      if Lower'Length >= 5 and then Lower (1 .. 5) = "monte" then
         declare
            function Dummy_Func (P : Float) return Float is
            begin
               return P * PSI_V3 / 1000.0;
            end Dummy_Func;
            Result : constant Stochastic_Result :=
              Run_Monte_Carlo (Dummy_Func'Access, 1.0, 0.1, 100, 0.5);
         begin
            NC.Last_MonteCarlo := Result;
            return "MONTE-CARLO : Mean = " & Float'Image (Result.Mean) &
