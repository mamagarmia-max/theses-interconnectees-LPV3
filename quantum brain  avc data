   package Noyau_Ordre_Protonique with
      SPARK_Mode => On
   is
      ORD_PSI_V3       : constant Float := PSI_V3;
      ORD_PHI_CRITICAL : constant Float := PHI_CRITICAL;
      ORD_K            : constant Integer := K_CYCLES;
      ORD_MODULO       : constant Integer := MODULO_9;

      type Pilier_Type is
        (PILIER_COLLAGENE, PILIER_EAU, PILIER_PROTON,
         PILIER_PHOTON, PILIER_BARRIERE, PILIER_TERRE);

      type Ordre_Protonique_State is record
         Collagene_Integrite    : Integer range 0 .. 100 := 100;
         Eau_Structured_Density : Integer range 0 .. 100 := 100;
         Proton_Flux            : Float := 1.0;
         Photon_Coherence       : Integer range 0 .. 100 := 100;
         Barriere_Integrite     : Integer range 0 .. 100 := 100;
         Terre_Connection       : Boolean := True;
         Phase_Potential        : Float := ORD_PHI_CRITICAL;
         Coherence              : Integer range 0 .. 100 := 100;
         Checksum               : Checksum_Type := 9;
      end record
        with Predicate => Ordre_Protonique_State.Checksum = 9;

      function Compute_Global_Coherence (S : Ordre_Protonique_State) return Integer
        with Post => Compute_Global_Coherence'Result in 0 .. 100,
             Global => null;

      function Compute_Proton_Grotthuss_Speed (Water_Density : Integer) return Float
        with Pre  => Water_Density in 0 .. 100,
             Post => Compute_Proton_Grotthuss_Speed'Result >= 0.0,
             Global => null;

      function Compute_Barriere_Shield (Potential : Float; Water_Density : Integer) return Integer
        with Pre  => Potential in -100.0 .. 0.0 and Water_Density in 0 .. 100,
             Post => Compute_Barriere_Shield'Result in 0 .. 100,
             Global => null;

      function Analyser (Q : String) return String
        with Pre  => Q'Length > 0,
             Post => Analyser'Result'Length > 0,
             Global => null;
   end Noyau_Ordre_Protonique;

   package body Noyau_Ordre_Protonique with
      SPARK_Mode => On
   is
      function Compute_Global_Coherence (S : Ordre_Protonique_State) return Integer is
         Score : Float;
      begin
         Score := (Float (S.Collagene_Integrite) +
                   Float (S.Eau_Structured_Density) +
                   Float (S.Photon_Coherence) +
                   Float (S.Barriere_Integrite) +
                   S.Proton_Flux * 100.0 +
                   (if S.Terre_Connection then 100.0 else 0.0)) / 6.0;
         return Integer (Clamp (Score, 0.0, 100.0));
      exception
         when others => return 50;
      end Compute_Global_Coherence;

      function Compute_Proton_Grotthuss_Speed (Water_Density : Integer) return Float is
      begin
         return 1.5e3 * Float (Water_Density) / 100.0;
      exception
         when others => return 1.5e3;
      end Compute_Proton_Grotthuss_Speed;

      function Compute_Barriere_Shield (Potential : Float; Water_Density : Integer) return Integer is
         Shield : Float;
      begin
         if Potential <= ORD_PHI_CRITICAL then
            Shield := 100.0 * Float (Water_Density) / 100.0;
         else
            Shield := 100.0 * (1.0 - (Potential - ORD_PHI_CRITICAL) / abs (ORD_PHI_CRITICAL));
         end if;
         return Integer (Clamp (Shield, 0.0, 100.0));
      exception
         when others => return 50;
      end Compute_Barriere_Shield;

      function Analyser (Q : String) return String is
         Lower : String := Sanitize_String (Q);
         State : Ordre_Protonique_State;
         Coherence : Integer;
         Speed : Float;
         Shield : Integer;
      begin
         for I in Lower'Range loop
            if Lower (I) in 'A' .. 'Z' then
               Lower (I) := Character'Val (Character'Pos (Lower (I)) + 32);
            end if;
         end loop;

         State.Collagene_Integrite := 100;
         State.Eau_Structured_Density := 100;
         State.Proton_Flux := 1.0;
         State.Photon_Coherence := 100;
         State.Barriere_Integrite := 100;
         State.Terre_Connection := True;
         State.Phase_Potential := ORD_PHI_CRITICAL;
         State.Checksum := 9;

         if Lower'Length >= 5 and then Lower (1 .. 5) = "ordre" then
            Coherence := Compute_Global_Coherence (State);
            return "ORDRE PROTONIQUE : Global coherence = " &
                   Integer'Image (Coherence) & "%" &
                   " | Φ = " & Float'Image (ORD_PHI_CRITICAL) & " mV" &
                   " | Six piliers actifs";

         elsif Lower'Length >= 5 and then Lower (1 .. 5) = "colla" then
            return "PILIER COLLAGÈNE : Integrity = " &
                   Integer'Image (State.Collagene_Integrite) & "%" &
                   " | Piézoélectricité active | Guide d'onde photonique" &
                   " | Φ = " & Float'Image (ORD_PHI_CRITICAL) & " mV";

         elsif Lower'Length >= 3 and then Lower (1 .. 3) = "eau" then
            Speed := Compute_Proton_Grotthuss_Speed (State.Eau_Structured_Density);
            return "PILIER EAU H₃O₂ : Density = " &
                   Integer'Image (State.Eau_Structured_Density) & "%" &
                   " | Grotthuss speed = " & Float'Image (Speed) & " m/s" &
                   " | Batterie cristalline active" &
                   " | Φ = " & Float'Image (ORD_PHI_CRITICAL) & " mV";

         elsif Lower'Length >= 6 and then Lower (1 .. 6) = "proton" then
            return "PILIER PROTON : Flux = " &
                   Float'Image (State.Proton_Flux) &
                   " | Grotthuss mechanism active | ATP synthase alimentée" &
                   " | Φ = " & Float'Image (ORD_PHI_CRITICAL) & " mV";

         elsif Lower'Length >= 6 and then Lower (1 .. 6) = "photon" then
            return "PILIER PHOTON : Coherence = " &
                   Integer'Image (State.Photon_Coherence) & "%" &
                   " | Biophotons cohérents | ADN = antenne laser" &
                   " | Φ = " & Float'Image (ORD_PHI_CRITICAL) & " mV";

         elsif Lower'Length >= 5 and then Lower (1 .. 5) = "barri" then
            Shield := Compute_Barriere_Shield (State.Phase_Potential, State.Eau_Structured_Density);
            return "PILIER BARRIÈRE IONIQUE : IONOS-SHIELD = " &
                   Integer'Image (Shield) & "%" &
                   " | Zone d'exclusion active | Répulsion électrostatique" &
                   " | Φ = " & Float'Image (ORD_PHI_CRITICAL) & " mV";

         elsif Lower'Length >= 4 and then Lower (1 .. 4) = "terre" then
            return "PILIER TERRE : Connection = " &
                   Boolean'Image (State.Terre_Connection) &
                   " | Stabilisation électromagnétique | Échange d'électrons" &
                   " | Φ = " & Float'Image (ORD_PHI_CRITICAL) & " mV";

         elsif Lower'Length >= 6 and then Lower (1 .. 6) = "pilier" then
            Shield := Compute_Barriere_Shield (State.Phase_Potential, State.Eau_Structured_Density);
            return "LES SIX PILIERS DE L'ORDRE PROTONIQUE :" &
                   " | 1. Collagène = " & Integer'Image (State.Collagene_Integrite) & "%" &
                   " | 2. Eau H₃O₂ = " & Integer'Image (State.Eau_Structured_Density) & "%" &
                   " | 3. Protons (Grotthuss) = actif" &
                   " | 4. Photons (cohérence) = " & Integer'Image (State.Photon_Coherence) & "%" &
                   " | 5. Barrière (IONOS-SHIELD) = " & Integer'Image (Shield) & "%" &
                   " | 6. Terre = " & Boolean'Image (State.Terre_Connection) &
                   " | Φ = " & Float'Image (ORD_PHI_CRITICAL) & " mV";

         else
            return "ORDRE PROTONIQUE : " &
                   "ordre (cohérence globale), " &
                   "colla (collagène), " &
                   "eau (H₃O₂), " &
                   "proton (flux), " &
                   "photon (cohérence), " &
                   "barri (IONOS-SHIELD), " &
                   "terre (mise à la terre), " &
                   "pilier (six piliers)";
         end if;
      exception
         when others => return "ORDRE PROTONIQUE : Internal error.";
      end Analyser;
   end Noyau_Ordre_Protonique;

