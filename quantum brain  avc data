                        return Apply_Veto ("Report contaminated by invalid request");
                     end if;

                     if Noyau_Checksum /= MODULO_9 then
                        return Apply_Veto ("Corrupted report (checksum = " &
                                          Integer'Image (Noyau_Checksum) & ")");
                     end if;

                     NC_Lock.Acquire;
                     if NC.Coherence < 99.0 then
                        NC_Lock.Release;
                        return Apply_Veto ("Global state contaminated (coherence = " &
                                          Float'Image (NC.Coherence) & "%)");
                     end if;

                     Checksum_Apres := NC.Checksum;
                     if Checksum_Avant /= Checksum_Apres then
                        NC_Lock.Release;
                        return Apply_Veto ("Global checksum modified during processing");
                     end if;

                     Rapport_Net := Noyau_Report;
                     NC.Last_Noyau := Registry (I).Name;
                     NC.Path_Integrity := True;
                     NC_Lock.Release;
                  end;
               else
                  return Apply_Veto ("Nucleus " & Registry (I).Name & " is inactive");
               end if;
               exit;
            end if;
         end;
      end loop;

      if not Noyau_Trouve then
         return Apply_Veto ("Unknown nucleus : " & Noyau_Name);
      end if;

      NC_Lock.Acquire;
      Checksum_Apres := NC.Checksum;

      if not NC.Path_Integrity then
         NC_Lock.Release;
         return Apply_Veto ("Path corrupted — contamination detected");
      end if;

      if Checksum_Avant /= Checksum_Apres then
         NC_Lock.Release;
         return Apply_Veto ("Checksum modified during processing");
      end if;

      if Trim (NC.Last_Noyau) /= Trim (Noyau_Name) then
         NC_Lock.Release;
         return Apply_Veto ("Executed nucleus (" & Trim (NC.Last_Noyau) &
                           ") differs from requested nucleus (" & Noyau_Name & ")");
      end if;
      NC_Lock.Release;

      return Synthesize (Rapport_Net);

   exception
      when E : others =>
         return Apply_Veto ("System error : " & Exception_Information (E));
   end Query_Universal;

