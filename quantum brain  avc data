   -- 0.3.1 KAHAN SUMMATION
   function Kahan_Sum (Values : array (Integer range <>) of Float) return Float
     with Pre  => Values'Length > 0,
          Post => Kahan_Sum'Result in -1.0e308 .. 1.0e308,
          Global => null
   is
      Sum   : Float := 0.0;
      C     : Float := 0.0;
      Y, T  : Float;
   begin
      for I in Values'Range loop
         pragma Loop_Invariant (I in Values'Range);
         pragma Loop_Invariant (Sum in -1.0e308 .. 1.0e308);
         Y := Values (I) - C;
         T := Sum + Y;
         C := (T - Sum) - Y;
         Sum := T;
      end loop;
      return Sum;
   exception
      when others => return 0.0;
   end Kahan_Sum;

