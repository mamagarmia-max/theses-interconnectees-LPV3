         Report : Validation_Report;
      begin
         Report.Module_Name := Module & "                         ";
         Report.Psi_V3_Ok := Approx_Equal (Psi, VAL_PSI_V3, 0.1);
         Report.Phi_Critical_Ok := Approx_Equal (Phi, VAL_PHI_CRITICAL, 0.01);
