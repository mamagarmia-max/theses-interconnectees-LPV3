   type Material_Record is record
      Name                 : Material_Type;
      Rupture_Stress_MPa   : Float;                 -- Contrainte de rupture (MPa)
      Melting_Point_K      : Float;                 -- Température de fusion (K)
      Boiling_Point_K      : Float;                 -- Température d'ébullition (K)
      Phase_Tension_mV     : Float;                 -- Tension de phase (mV)
      Thermal_Shift_mV     : Float;                 -- Décalage thermique (mV)
      Thermal_Energy_J     : Float;                 -- Énergie thermique dissipée (J)
      Rupture_Temp_K       : Float;                 -- Température de rupture (K)
      Is_Rupture_Valid     : Boolean;               -- Rupture validée ?
      Is_Thermal_Valid     : Boolean;               -- Effet thermique validé ?
      Deviation            : Float;                 -- Écart (%)
   end record;

   type Material_Array is array (1 .. 100) of Material_Record;

   -- ========================================================================
   -- 3. FONCTIONS DE CALCUL V3
   -- ========================================================================

   -- 3.1 Calcul de la tension de phase à partir de la contrainte de rupture
   function Compute_Phase_Tension (Rupture_Stress : Float) return Float
     with Pre => Rupture_Stress > 0.0,
          Post => Compute_Phase_Tension'Result <= 0.0
   is
   begin
      -- 1 MPa ≈ 0.1 mV (ajusté par les invariants V3)
      return -(Rupture_Stress * 0.001 * BETA / PSI_V3) *
             (1.0 + 1.0 / Float (K_CYCLES));
   end Compute_Phase_Tension;

   -- 3.2 Calcul du décalage thermique (effet de la température sur la phase)
   function Compute_Thermal_Shift (Temperature_K : Float) return Float
     with Pre => Temperature_K > 0.0,
          Post => Compute_Thermal_Shift'Result <= 0.0
   is
      T_0 : constant Float := 300.0;  -- Température de référence (K)
   begin
      -- Le décalage thermique est proportionnel à (T - T_0)
      -- Coefficient : -0.01 mV/K (déterminé empiriquement)
      return -0.01 * (Temperature_K - T_0);
   end Compute_Thermal_Shift;

   -- 3.3 Calcul de l'énergie thermique dissipée lors de la rupture
   function Compute_Thermal_Energy (Rupture_Stress : Float; Volume_m3 : Float) return Float
     with Pre => Rupture_Stress > 0.0 and Volume_m3 > 0.0,
          Post => Compute_Thermal_Energy'Result >= 0.0
   is
      -- Énergie thermique = (contrainte × volume) × facteur de dissipation
      -- Facteur de dissipation = 0.85 (85% de l'énergie mécanique devient chaleur)
      Dissipation_Factor : constant Float := 0.85;
   begin
      return Rupture_Stress * 1e6 * Volume_m3 * Dissipation_Factor;
   end Compute_Thermal_Energy;

   -- 3.4 Calcul de la température de rupture (augmentation thermique)
   function Compute_Rupture_Temperature (Thermal_Energy : Float; Mass_kg : Float; Cp_JpKgK : Float) return Float
     with Pre => Thermal_Energy >= 0.0 and Mass_kg > 0.0 and Cp_JpKgK > 0.0,
          Post => Compute_Rupture_Temperature'Result >= 0.0
   is
      T_0 : constant Float := 300.0;  -- Température initiale (K)
   begin
      return T_0 + Thermal_Energy / (Mass_kg * Cp_JpKgK);
   end Compute_Rupture_Temperature;

   -- 3.5 Calcul de la tension de phase corrigée par la température
   function Compute_Corrected_Phase_Tension (Base_Tension, Thermal_Shift : Float) return Float
     with Pre => Base_Tension <= 0.0 and Thermal_Shift <= 0.0,
          Post => Compute_Corrected_Phase_Tension'Result <= 0.0
   is
   begin
      return Base_Tension + Thermal_Shift;
   end Compute_Corrected_Phase_Tension;

   -- ========================================================================
   -- 4. GÉNÉRATION DES DONNÉES (100 MATÉRIAUX)
   -- ========================================================================

   function Create_Material
     (M          : Material_Type;
      Stress     : Float;
      T_melt     : Float;
      T_boil     : Float;
      Volume     : Float;
      Mass       : Float;
      Cp         : Float) return Material_Record
     with Pre => Stress > 0.0 and T_melt > 0.0 and T_boil > 0.0 and
                 Volume > 0.0 and Mass > 0.0 and Cp > 0.0,
          Post => Create_Material'Result.Is_Rupture_Valid and
                  Create_Material'Result.Is_Thermal_Valid
   is
      Base_Tension   : Float := Compute_Phase_Tension (Stress);
      Thermal_Shift  : Float := Compute_Thermal_Shift (T_melt);
      Corrected_Tension : Float := Compute_Corrected_Phase_Tension (Base_Tension, Thermal_Shift);
      Thermal_Energy : Float := Compute_Thermal_Energy (Stress, Volume);
      Rupture_Temp   : Float := Compute_Rupture_Temperature (Thermal_Energy, Mass, Cp);
      Deviation      : Float := abs (Corrected_Tension - PHI_CRITICAL) / abs (PHI_CRITICAL) * 100.0;
   begin
      return Material_Record'
        (Name                 => M,
         Rupture_Stress_MPa   => Stress,
         Melting_Point_K      => T_melt,
         Boiling_Point_K      => T_boil,
         Phase_Tension_mV     => Corrected_Tension,
         Thermal_Shift_mV     => Thermal_Shift,
         Thermal_Energy_J     => Thermal_Energy,
         Rupture_Temp_K       => Rupture_Temp,
         Is_Rupture_Valid     => (Deviation <= 10.0),
         Is_Thermal_Valid     => (Rupture_Temp > T_melt and Rupture_Temp < T_boil),
         Deviation            => Deviation);
   end Create_Material;

