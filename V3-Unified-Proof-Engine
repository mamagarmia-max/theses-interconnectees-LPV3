   -- ========================================================================
   -- 4.1 COMPUTE_LAMBDA_V3
   -- ========================================================================

   function Compute_Lambda_V3
     (Psi_V3  : Float;
      R_Hubble : Float;
      C       : Float;
      Rho     : Float) return Float is
   begin
      return Psi_V3 / (R_Hubble * C * C * Rho);
   end Compute_Lambda_V3;

   -- ========================================================================
   -- 4.2 COMPUTE_PROTON_MASS_ABS
   -- ========================================================================

   function Compute_Proton_Mass_Abs
     (Psi_V3  : Float;
      Lambda  : Float;
      R       : Float;
      C       : Float) return Float is
   begin
      return Psi_V3 / (R * C * C * Lambda);
   end Compute_Proton_Mass_Abs;

   -- ========================================================================
   -- 4.3 COMPUTE_PHASE_VELOCITY
   -- ========================================================================

   function Compute_Phase_Velocity
     (Beta    : Float;
      Alpha   : Float;
      C       : Float;
      K       : Integer) return Float is
   begin
      return (Beta * Alpha * C) / Float (K);
   end Compute_Phase_Velocity;

   -- ========================================================================
   -- 4.4 COMPUTE_UHECR_CORRECTION
   -- ========================================================================

   function Compute_UHECR_Correction
     (Delta_Phi : Float;
      Distance  : Float;
      Cutoff    : Float) return Float is
      Ratio : Float := Distance / Cutoff;
   begin
      return Delta_Phi * Exp (-(Ratio * Ratio));
   end Compute_UHECR_Correction;

   -- ========================================================================
   -- 4.5 COMPUTE_DARK_ENERGY_W
   -- ========================================================================

   function Compute_Dark_Energy_w
     (Scale_Factor : Float;
      Epsilon      : Float) return Float is
   begin
      if Scale_Factor <= 0.0 then
         return -1.0;
      end if;
      return -1.0 + Epsilon * Log (Scale_Factor);
   end Compute_Dark_Energy_w;

   -- ========================================================================
   -- 4.6 COMPUTE_DARK_MATTER_FRACTION
   -- ========================================================================

   function Compute_Dark_Matter_Fraction
     (Distance : Float) return Float is
   begin
      if Distance < 1.0e20 then
         return 0.0;
      elsif Distance < 1.0e21 then
         return 20.0 * (Distance - 1.0e20) / 9.0e20;
      elsif Distance < 1.0e22 then
         return 20.0 + 65.0 * (Distance - 1.0e21) / 9.0e21;
      else
         declare
            Separation : constant Float :=
              1.0 + (Distance - 1.0e22) / 1.0e24;
            Result : constant Float := 85.0 * Separation;
         begin
            if Result > 95.0 then
               return 95.0;
            else
               return Result;
            end if;
         end;
      end if;
   end Compute_Dark_Matter_Fraction;

