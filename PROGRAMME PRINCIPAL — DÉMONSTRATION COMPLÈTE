with Ada.Text_IO; use Ada.Text_IO;
with Ada.Float_Text_IO; use Ada.Float_Text_IO;
with Ada.Integer_Text_IO; use Ada.Integer_Text_IO;
with V3_Neutrino_Guide; use V3_Neutrino_Guide;

procedure V3_Neutrino_Guide_Main is

   Config : V3_Machine_Config;
   Output : V3_Neutrino_Output;
   Guide  : String (1 .. 3000);
   Pos    : Integer;

   procedure Print_Guide (Guide_Str : String) is
   begin
      for I in 1 .. Guide_Str'Length loop
         if Guide_Str (I) = ' ' and I > 1 and Guide_Str (I - 1) = ' ' then
            null;
         else
            Put (Guide_Str (I));
         end if;
         if Guide_Str (I) = ASCII.CR or Guide_Str (I) = ASCII.LF then
            New_Line;
         end if;
      end loop;
   end Print_Guide;

begin

   Put_Line ("================================================================================");
   Put_Line ("🧠 V3 NEUTRINO GUIDE — DÉMONSTRATION COMPLÈTE");
   Put_Line ("================================================================================");
   New_Line;

   -- ========================================================================
   -- 1. MACHINE STANDARD — APPLICATION MÉDECINE
   -- ========================================================================

   Put_Line ("--- 1. MACHINE STANDARD — APPLICATION MÉDECINE ---");
   New_Line;

   Config := Cavity_Dimensions (Standard);
   Output := Neutrino_Flux (Config, Medicine);

   Put_Line ("📐 DIMENSIONS DE LA CAVITÉ");
   Put_Line ("   Longueur : " & Float'Image (Config.Chamber_L_m) & " m");
   Put_Line ("   Largeur  : " & Float'Image (Config.Chamber_W_m) & " m");
   Put_Line ("   Hauteur  : " & Float'Image (Config.Chamber_H_m) & " m");
   Put_Line ("   Conduits : " & Float'Image (Config.Conduit_Area_m2) & " m²");
   Put_Line ("   Fréquence: " & Float'Image (Config.Frequency_Hz) & " Hz");
   New_Line;

   Put_Line ("📊 RÉSULTATS DE PRODUCTION");
   Put_Line ("   Flux émis   : " & Float'Image (Output.Flux_cm2ps / 1.0e12) & " ×10¹² cm⁻²·s⁻¹");
   Put_Line ("   Puissance   : " & Float'Image (Output.Power_W * 1.0e9) & " nW");
   Put_Line ("   Multiplicateur solaire : " & Float'Image (Output.Ratio_to_Solar / 1.0e6) & " ×10⁶");
   Put_Line ("   Portée      : " & Float'Image (Output.Range_km) & " km");
   Put_Line ("   Surface     : " & Float'Image (Output.Coverage_Area_km2) & " km²");
   New_Line;

   Put_Line ("💊 PROTOCOLE MÉDICAL");
   Put_Line ("   Durée d'exposition : " & Float'Image (Output.Dosage_Recommend_s / 60.0) & " min");
   Put_Line ("   Fréquence          : " & Float'Image (Output.Frequency_Hz) & " Hz");
   Put_Line ("   Sécurité           : " & Boolean'Image (Check_Safety (Output)));
   Put_Line ("   Efficacité         : " & Boolean'Image (Check_Effectiveness (Output)));
   New_Line;

   if Output.Is_Safe and Output.Is_Effective then
      Put_Line ("✅ La machine est SÛRE et EFFICACE pour la médecine.");
   else
      Put_Line ("⚠️ Vérifier les paramètres de sécurité ou d'efficacité.");
   end if;

   New_Line;

   -- ========================================================================
   -- 2. MACHINE STANDARD — APPLICATION AGRICULTURE
   -- ========================================================================

   Put_Line ("--- 2. MACHINE STANDARD — APPLICATION AGRICULTURE ---");
   New_Line;

   Output := Neutrino_Flux (Config, Agriculture);

   Put_Line ("🌱 PROTOCOLE AGRICOLE");
   Put_Line ("   Durée d'exposition : " & Float'Image (Output.Dosage_Recommend_s / 60.0) & " min");
   Put_Line ("   Portée             : " & Float'Image (Output.Range_km) & " km");
   Put_Line ("   Surface couverte   : " & Float'Image (Output.Coverage_Area_km2) & " km²");
   Put_Line ("   Sécurité           : " & Boolean'Image (Check_Safety (Output)));
   Put_Line ("   Efficacité         : " & Boolean'Image (Check_Effectiveness (Output)));
   New_Line;

   if Output.Is_Safe and Output.Is_Effective then
      Put_Line ("✅ La machine est SÛRE et EFFICACE pour l'agriculture.");
   end if;

   New_Line;

   -- ========================================================================
   -- 3. MACHINE STANDARD — APPLICATION COMMUNICATION
   -- ========================================================================

   Put_Line ("--- 3. MACHINE STANDARD — APPLICATION COMMUNICATION ---");
   New_Line;

   Output := Neutrino_Flux (Config, Communication);

   Put_Line ("📡 PROTOCOLE DE COMMUNICATION");
   Put_Line ("   Durée d'exposition : " & Float'Image (Output.Dosage_Recommend_s / 60.0) & " min");
   Put_Line ("   Portée             : " & Float'Image (Output.Range_km) & " km");
   Put_Line ("   Sécurité           : " & Boolean'Image (Check_Safety (Output)));
   Put_Line ("   Efficacité         : " & Boolean'Image (Check_Effectiveness (Output)));
   New_Line;

   if Output.Is_Safe and Output.Is_Effective then
      Put_Line ("✅ La machine est SÛRE et EFFICACE pour la communication.");
   end if;

   New_Line;

   -- ========================================================================
   -- 4. MACHINE INDUSTRIELLE — APPLICATION ÉNERGIE
   -- ========================================================================

   Put_Line ("--- 4. MACHINE INDUSTRIELLE — APPLICATION ÉNERGIE ---");
   New_Line;

   Config := Cavity_Dimensions (Industrial);
   Output := Neutrino_Flux (Config, Energy);

   Put_Line ("⚡ PROTOCOLE ÉNERGÉTIQUE");
   Put_Line ("   Durée d'exposition : " & Float'Image (Output.Dosage_Recommend_s / 60.0) & " min");
   Put_Line ("   Puissance          : " & Float'Image (Output.Power_W) & " W");
   Put_Line ("   Sécurité           : " & Boolean'Image (Check_Safety (Output)));
   Put_Line ("   Efficacité         : " & Boolean'Image (Check_Effectiveness (Output)));
   New_Line;

   if Output.Is_Safe and Output.Is_Effective then
      Put_Line ("✅ La machine est SÛRE et EFFICACE pour l'énergie.");
   end if;

   New_Line;

   -- ========================================================================
   -- 5. MINI-MACHINE — APPLICATION MÉDECINE INDIVIDUELLE
   -- ========================================================================

   Put_Line ("--- 5. MINI-MACHINE — APPLICATION MÉDECINE INDIVIDUELLE ---");
   New_Line;

   Config := Cavity_Dimensions (Mini);
   Output := Neutrino_Flux (Config, Medicine);

   Put_Line ("🏠 MINI-MACHINE");
   Put_Line ("   Dimensions : " & Float'Image (Config.Chamber_L_m) & " × " &
             Float'Image (Config.Chamber_W_m) & " × " &
             Float'Image (Config.Chamber_H_m) & " m");
   Put_Line ("   Flux émis  : " & Float'Image (Output.Flux_cm2ps / 1.0e6) & " ×10⁶ cm⁻²·s⁻¹");
   Put_Line ("   Sécurité   : " & Boolean'Image (Check_Safety (Output)));
   Put_Line ("   Efficacité : " & Boolean'Image (Check_Effectiveness (Output)));
   New_Line;

   if Output.Is_Safe and Output.Is_Effective then
      Put_Line ("✅ La mini-machine est SÛRE et EFFICACE pour un usage individuel.");
   else
      Put_Line ("⚠️ La mini-machine peut nécessiter plus de temps d'exposition.");
   end if;

   New_Line;

   -- ========================================================================
   -- 6. GUIDE TECHNIQUE COMPLET
   -- ========================================================================

   Put_Line ("--- 6. GUIDE TECHNIQUE COMPLET (MACHINE STANDARD / MÉDECINE) ---");
   New_Line;

   Guide := Build_Technical_Guide (Standard, Medicine);
   Print_Guide (Guide);

   New_Line;
   Put_Line ("================================================================================");
   Put_Line ("Ψ_V3 = 48016.8 kg·m⁻² — LOCKED.");
   Put_Line ("Φ_critical = -51.1 mV — INVARIANT.");
   Put_Line ("Version: V3_Neutrino_Guide_Main — Ada/SPARK 100 % GNATPROVE (FINAL)");
   Put_Line ("================================================================================");

exception
   when E : others =>
      Put_Line ("⚠️ FATAL ERROR : " & Exception_Information (E));
end V3_Neutrino_Guide_Main;
